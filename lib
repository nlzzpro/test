    else
        OpenWindow(true)
    end

    Nely.Window = Window
    return Window
end

--==================================================================
--  GLOBAL API
--==================================================================

function Nely:SetTheme(name)
    local theme = Nely.Themes[name]
    if not theme then return false end
    Nely.Theme = theme
    return true
end

function Nely:Destroy()
    if Nely.Window then Nely.Window:Destroy() end
end

return Nely
