            })

            -- Every friend API here yields and is rate limited, so this runs
            -- off the main flow and fills the card in as answers land.
            task.spawn(function()
                local inServer = {}
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local ok, isFriend = pcall(function()
                            return LocalPlayer:IsFriendsWith(player.UserId)
                        end)
                        if ok and isFriend then
                            table.insert(inServer, player)
                        end
                    end
                end

                if #inServer > 0 then
                    headLabel.Text     = ("%d friend%s in this server")
                        :format(#inServer, #inServer == 1 and "" or "s")
                    avatarStrip.Visible = true

                    for index, friend in ipairs(inServer) do
                        if index > 8 then break end
                        local chip = New("Frame", {
                            Size             = UDim2.fromOffset(34, 34),
                            BackgroundColor3 = theme.Elevated,
                            BorderSizePixel  = 0,
                            LayoutOrder      = index,
                            ZIndex           = 19,
                            Parent           = avatarStrip,
                        }, {
                            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                            New("UIStroke", { Color = theme.Success, Thickness = 1.5, Transparency = 0.4 }),
                        })

                        New("ImageLabel", {
                            Size                   = UDim2.new(1, -4, 1, -4),
                            Position               = UDim2.fromScale(0.5, 0.5),
                            AnchorPoint            = Vector2.new(0.5, 0.5),
                            BackgroundTransparency = 1,
                            Image                  = AvatarUrl(friend.UserId, 100),
                            ZIndex                 = 20,
                            Parent                 = chip,
                        }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

                        local hover = New("TextButton", {
                            Size                   = UDim2.fromScale(1, 1),
                            BackgroundTransparency = 1,
                            AutoButtonColor        = false,
                            Text                   = "",
                            ZIndex                 = 21,
                            Parent                 = chip,
                        })
                        hover.MouseButton1Click:Connect(function()
                            Nely:Notify({
                                Title   = friend.DisplayName,
                                Content = "@" .. friend.Name .. " is in this server.",
                                Icon    = "users",
                                Color   = theme.Success,
                            })
                        end)
                    end
                else
                    headLabel.Text = "No friends in this server"
                end

                local onlineCount = 0
                local ok, online = pcall(function()
                    return LocalPlayer:GetFriendsOnline(200)
                end)
                if ok and type(online) == "table" then
                    onlineCount = #online
                end

                local totalCount = 0
                pcall(function()
                    local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
                    local guard = 0
                    repeat
                        totalCount = totalCount + #pages:GetCurrentPage()
                        guard = guard + 1
                        if pages.IsFinished or guard >= 12 then break end
                        pages:AdvanceToNextPageAsync()
                    until false
                end)

                summary.Text = ("%d online  ·  %d total")
                    :format(onlineCount, math.max(totalCount, onlineCount))
            end)

            return { Instance = card, Destroy = function() card:Destroy() end }
        end

