local function New(class, props, children)
    local inst = Instance.new(class)
    local parent
    for key, value in pairs(props or {}) do
        if key == "Parent" then
            parent = value
        else
            inst[key] = value
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(radius)
    return New("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function Stroke(color, thickness, transparency)
    return New("UIStroke", {
        Color            = color or Nely.Theme.Border,
        Thickness        = thickness or 1,
        Transparency     = transparency or 0,
        ApplyStrokeMode  = Enum.ApplyStrokeMode.Border,
    })
end

local function Pad(t, b, l, r)
    return New("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or l or 0),
    })
end

local function List(padding, direction, sort)
    return New("UIListLayout", {
        Padding          = UDim.new(0, padding or 8),
        FillDirection    = direction or Enum.FillDirection.Vertical,
        SortOrder        = sort or Enum.SortOrder.LayoutOrder,
    })
end

local function Gradient(colors, rotation, transparency)
    return New("UIGradient", {
        Color        = colors,
        Rotation     = rotation or 90,
        Transparency = transparency or NumberSequence.new(0),
    })
end

--==================================================================
--  SOFT SHADOW  (layered frames, zero asset dependency)
--==================================================================

local function Shadow(parent, spread, opacity, radius)
    spread  = spread  or 18
    opacity = opacity or 0.55
    radius  = radius  or 14
    local holder = New("Frame", {
        Name                   = "Shadow",
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex                 = (parent.ZIndex or 1) - 1,
        Parent                 = parent,
    })
    local layers = 7
    for i = 1, layers do
        local ratio = i / layers
        New("Frame", {
            Size                   = UDim2.new(1, spread * ratio * 2, 1, spread * ratio * 2),
            Position               = UDim2.fromScale(0.5, 0.5),
            AnchorPoint            = Vector2.new(0.5, 0.5),
            BackgroundColor3       = Color3.new(0, 0, 0),
            BackgroundTransparency = 1 - (opacity / layers) * (1 - ratio * 0.55),
            BorderSizePixel        = 0,
            ZIndex                 = holder.ZIndex,
            Parent                 = holder,
        }, { Corner(radius + spread * ratio) })
    end
    return holder
end

