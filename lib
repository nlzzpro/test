                elapsed = elapsed + dt
                if elapsed < 0.5 then return end

                fpsValue.Text = tostring(math.floor(frames / elapsed + 0.5))
                frames, elapsed = 0, 0

                playersValue.Text = ("%d/%d"):format(#Players:GetPlayers(), Players.MaxPlayers)

                local ok, ping = pcall(function()
                    return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                pingValue.Text = ok and (math.floor(ping + 0.5) .. " ms") or "—"

                local total   = math.floor(workspace.DistributedGameTime)
                uptimeValue.Text = ("%02d:%02d:%02d")
                    :format(total / 3600, (total % 3600) / 60, total % 60)
            end)
            table.insert(Nely.Connections, statsConn)

            return {
                Destroy = function()
                    statsConn:Disconnect()
                    statRow:Destroy()
                    detail:Destroy()
                end,
            }
        end

        ------------------------------------------------------------
        -- Friends card
        ------------------------------------------------------------

        function Tab:CreateFriendsCard()
            local card = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.2,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ZIndex                 = 17,
                Parent                 = page,
            }, { Corner(11), Stroke(theme.BorderSoft, 1, 0.45), Pad(12, 12, 12, 12), List(9) })

            local header = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 18),
                BackgroundTransparency = 1,
                LayoutOrder            = 1,
                ZIndex                 = 18,
                Parent                 = card,
            })

            local headIcon = Icons.Render("users", header, 14, theme.Accent, 19)
            headIcon.Position    = UDim2.new(0, 0, 0.5, 0)
            headIcon.AnchorPoint = Vector2.new(0, 0.5)

            local headLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -24, 1, 0),
                Position               = UDim2.fromOffset(21, 0),
                BackgroundTransparency = 1,
                Text                   = "Checking friends",
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 19,
                Parent                 = header,
            })

            -- avatars of friends who are in this server
            local avatarStrip = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 34),
                BackgroundTransparency = 1,
                LayoutOrder            = 2,
                Visible                = false,
                ZIndex                 = 18,
                Parent                 = card,
            }, {
                New("UIListLayout", {
                    Padding       = UDim.new(0, 6),
                    FillDirection = Enum.FillDirection.Horizontal,
                    SortOrder     = Enum.SortOrder.LayoutOrder,
                }),
            })

            local summary = New("TextLabel", {
                Size                   = UDim2.new(1, 0, 0, 15),
                BackgroundTransparency = 1,
                Text                   = "Loading friend list",
                TextColor3             = theme.TextDim,
                TextSize               = 11,
                Font                   = Enum.Font.Gotham,
                TextXAlignment         = Enum.TextXAlignment.Left,
                LayoutOrder            = 3,
                ZIndex                 = 18,
                Parent                 = card,
            })

            -- Every friend API here yields and is rate limited, so this runs
            -- off the main flow and fills the card in as answers land.
            task.spawn(function()
                local inServer = {}
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local ok, isFriend = pcall(function()
                            return LocalPlayer:IsFriendsWith(player.UserId)
                        end)
                        if ok and isFriend then
                            table.insert(inServer, player)
                        end
                    end
                end

                if #inServer > 0 then
                    headLabel.Text     = ("%d friend%s in this server")
                        :format(#inServer, #inServer == 1 and "" or "s")
                    avatarStrip.Visible = true

                    for index, friend in ipairs(inServer) do
                        if index > 8 then break end
                        local chip = New("Frame", {
                            Size             = UDim2.fromOffset(34, 34),
                            BackgroundColor3 = theme.Elevated,
                            BorderSizePixel  = 0,
                            LayoutOrder      = index,
                            ZIndex           = 19,
                            Parent           = avatarStrip,
                        }, {
                            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                            New("UIStroke", { Color = theme.Success, Thickness = 1.5, Transparency = 0.4 }),
                        })

                        New("ImageLabel", {
                            Size                   = UDim2.new(1, -4, 1, -4),
                            Position               = UDim2.fromScale(0.5, 0.5),
                            AnchorPoint            = Vector2.new(0.5, 0.5),
                            BackgroundTransparency = 1,
                            Image                  = AvatarUrl(friend.UserId, 100),
                            ZIndex                 = 20,
                            Parent                 = chip,
                        }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

                        local hover = New("TextButton", {
                            Size                   = UDim2.fromScale(1, 1),
                            BackgroundTransparency = 1,
                            AutoButtonColor        = false,
                            Text                   = "",
                            ZIndex                 = 21,
                            Parent                 = chip,
                        })
                        hover.MouseButton1Click:Connect(function()
                            Nely:Notify({
                                Title   = friend.DisplayName,
                                Content = "@" .. friend.Name .. " is in this server.",
                                Icon    = "users",
                                Color   = theme.Success,
                            })
                        end)
                    end
                else
                    headLabel.Text = "No friends in this server"
                end

                local onlineCount = 0
                local ok, online = pcall(function()
                    return LocalPlayer:GetFriendsOnline(200)
                end)
                if ok and type(online) == "table" then
                    onlineCount = #online
                end

                local totalCount = 0
                pcall(function()
                    local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
                    local guard = 0
                    repeat
                        totalCount = totalCount + #pages:GetCurrentPage()
                        guard = guard + 1
                        if pages.IsFinished or guard >= 12 then break end
                        pages:AdvanceToNextPageAsync()
                    until false
                end)

                summary.Text = ("%d online  ·  %d total")
                    :format(onlineCount, math.max(totalCount, onlineCount))
            end)

            return { Instance = card, Destroy = function() card:Destroy() end }
        end

