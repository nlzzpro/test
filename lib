local remoteCache = {}

local function CacheRemoteImage(url)
    if remoteCache[url] then return remoteCache[url] end

    local httpRequest = (syn and syn.request) or (http and http.request)
                        or http_request or request
    if not (httpRequest and writefile and getcustomasset and isfolder and makefolder) then
        return nil
    end

    local ok, asset = pcall(function()
        if not isfolder("nely_cache") then makefolder("nely_cache") end

        -- rbxcdn hands back WebP by default and Roblox's decoder wants PNG
        local target = url:gsub("/Webp/", "/Png/")

        local response = httpRequest({ Url = target, Method = "GET" })
        local body = response and (response.Body or response.body)
        if not body or #body == 0 then return nil end

        local hash = 5381
        for i = 1, #url do
            hash = (hash * 33 + string.byte(url, i)) % 4294967296
        end

        local path = ("nely_cache/%d.png"):format(hash)
        writefile(path, body)
        return getcustomasset(path)
    end)

    if ok and asset then
        remoteCache[url] = asset
        return asset
    end
    return nil
end

-- Calls back with a usable content string, possibly several frames later.
-- Never calls back at all if the source can't be resolved on this executor.
local function ResolveImageAsync(source, callback)
    if not source or source == "" then return end

    if tonumber(source) then
        callback("rbxassetid://" .. source)
        return
    end
    if string.match(source, "^rbx") then
        callback(source)
        return
    end

    task.spawn(function()
        local cached = CacheRemoteImage(source)
        if cached then callback(cached) end
    end)
end

local function ResolveGameImage(entry, callback)
    local function Thumb(universeId)
        callback(("rbxthumb://type=GameIcon&id=%d&w=256&h=256"):format(universeId))
    end

    -- explicit universe id: renders on the spot, nothing to look up
    if entry.UniverseId then
        Thumb(entry.UniverseId)
        return
    end

    local image = entry.Image
    if image and image ~= "" then
        if tonumber(image) then
            callback("rbxassetid://" .. image)
            return
        end
        if string.match(image, "^rbx") then
            callback(image)
            return
        end
    end

    -- place id: needs the universe lookup before rbxthumb will accept it
    if entry.PlaceId then
        local cached = universeCache[entry.PlaceId]
        if cached then
            Thumb(cached)
        else
            table.insert(universeQueue, { placeId = entry.PlaceId, callback = Thumb })
            ProcessUniverseQueue()
        end
        return
    end

    if image and image ~= "" then
        ResolveImageAsync(image, callback)
    end
end

--==================================================================
--  INTERACTION HELPERS
--==================================================================

-- Root runs IgnoreGuiInset = true, which means its coordinate space already
-- lines up with what GetMouseLocation returns. Adding GetGuiInset() on top
-- shifts everything down by the height of the Roblox topbar, so the drawn
-- cursor sits ~36px below the real pointer and every click lands above its
-- target. One helper, used everywhere, so this can't drift apart again.
local function GetPointer()
    return UserInputService:GetMouseLocation()
end

local function Ripple(button, zindex)
    local pos  = GetPointer()
    local abs  = button.AbsolutePosition
    local size = button.AbsoluteSize
    local rx = math.clamp((pos.X - abs.X) / math.max(size.X, 1), 0, 1)
    local ry = math.clamp((pos.Y - abs.Y) / math.max(size.Y, 1), 0, 1)

    local ripple = New("Frame", {
        Size                   = UDim2.fromOffset(0, 0),
        Position               = UDim2.fromScale(rx, ry),
        AnchorPoint            = Vector2.new(0.5, 0.5),
        BackgroundColor3       = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.86,
        BorderSizePixel        = 0,
        ZIndex                 = zindex or (button.ZIndex + 3),
        Parent                 = button,
    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local reach = math.max(size.X, size.Y) * 2.2
    local tw = TweenService:Create(ripple, EASE.Glide, {
        Size                   = UDim2.fromOffset(reach, reach),
        BackgroundTransparency = 1,
    })
    tw:Play()
    tw.Completed:Connect(function() ripple:Destroy() end)
end

local function Draggable(handle, target, onDragEnd)
    local dragging, dragStart, startPos = false, nil, nil
    local moved = 0

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            moved     = 0
            dragStart = input.Position
            startPos  = target.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                    if onDragEnd then onDragEnd(moved) end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            moved = math.max(moved, delta.Magnitude)
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

