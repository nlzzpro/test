                    TextXAlignment         = Enum.TextXAlignment.Right,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 19,
                    Parent                 = holder,
                })
                return holder, value
            end

            local _,        gameValue   = DetailRow("Game", 1)
            local jobHolder, jobValue   = DetailRow("Job ID", 2)
            local _,        uptimeValue = DetailRow("Uptime", 3)

            gameValue.Text = "Loading"
            task.spawn(function()
                local ok, info = pcall(function()
                    return game:GetService("MarketplaceService")
                        :GetProductInfo(game.PlaceId)
                end)
                gameValue.Text = (ok and info and info.Name) or "Place " .. game.PlaceId
            end)

            jobValue.Text = game.JobId ~= "" and game.JobId or "Studio"

            -- click the Job ID row to copy it
            local jobCopy = New("TextButton", {
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 20,
                Parent                 = jobHolder,
            })
            jobCopy.MouseEnter:Connect(function()
                Tween(jobValue, { TextColor3 = theme.Accent }, EASE.Snap)
            end)
            jobCopy.MouseLeave:Connect(function()
                Tween(jobValue, { TextColor3 = theme.TextSub }, EASE.Snap)
            end)
            jobCopy.MouseButton1Click:Connect(function()
                local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
                if copy then
                    copy(game.JobId)
                    Nely:Notify({ Title = "Job ID copied", Content = game.JobId, Icon = "copy" })
                else
                    Nely:Notify({
                        Title   = "No clipboard",
                        Content = "Your executor doesn't expose a clipboard function.",
                        Icon    = "alert",
                        Color   = theme.Warning,
                    })
                end
            end)

            -- live stats
            local frames, elapsed = 0, 0
            local statsConn = RunService.RenderStepped:Connect(function(dt)
                frames  = frames + 1
                elapsed = elapsed + dt
                if elapsed < 0.5 then return end

                fpsValue.Text = tostring(math.floor(frames / elapsed + 0.5))
                frames, elapsed = 0, 0

                playersValue.Text = ("%d/%d"):format(#Players:GetPlayers(), Players.MaxPlayers)

                local ok, ping = pcall(function()
                    return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                pingValue.Text = ok and (math.floor(ping + 0.5) .. " ms") or "—"

                local total   = math.floor(workspace.DistributedGameTime)
                uptimeValue.Text = ("%02d:%02d:%02d")
                    :format(total / 3600, (total % 3600) / 60, total % 60)
            end)
            table.insert(Nely.Connections, statsConn)

            return {
                Destroy = function()
                    statsConn:Disconnect()
                    statRow:Destroy()
                    detail:Destroy()
                end,
            }
        end

