                if cfg.Numeric then box.Text = box.Text:gsub("%D", "") end
                if flag then Nely.Flags[flag] = box.Text end
                if cfg.Callback and (not cfg.Enter or enterPressed) then
                    task.spawn(cfg.Callback, box.Text)
                end
            end)

            local api = {
                CurrentValue = box.Text,
                Set     = function(_, text) box.Text = text end,
                Destroy = function() row:Destroy() end,
            }
