    ----------------------------------------------------------------
    -- Search
    --
    -- Walks every element row in every tab. Rows are matched on the text
    -- of their descendant TextLabels rather than a registry, so elements
    -- added later are searchable without registering anything.
    ----------------------------------------------------------------

    if opts.SearchBar ~= false then
        -- SearchBar = "topbar" floats the field across the top of the window
        -- instead of stacking it above the tab list. It needs real width to
        -- look deliberate, so on a phone-sized window it falls back to the
        -- sidebar rather than colliding with the title and the controls.
        local inTopbar = (opts.SearchBar == "topbar") and not compact

        local wrap = New("Frame", {
            Name                   = "WindowSearch",
            Size                   = inTopbar and UDim2.fromOffset(268, 30)
                                              or  UDim2.new(1, -16, 0, 28),
            Position               = inTopbar and UDim2.new(0.5, 26, 0.5, 0)
                                              or  UDim2.fromOffset(8, 8),
            AnchorPoint            = inTopbar and Vector2.new(0.5, 0.5) or Vector2.new(0, 0),
            BackgroundColor3       = inTopbar and theme.Backdrop or theme.Surface,
            BackgroundTransparency = inTopbar and 0.15 or 0.25,
            BorderSizePixel        = 0,
            ZIndex                 = inTopbar and 21 or 17,
            Parent                 = inTopbar and topbar or sidebar,
        }, { Corner(inTopbar and 9 or 8), Stroke(theme.BorderSoft, 1, 0.5) })

        local sIcon = Icons.Render("search", wrap, inTopbar and 14 or 12,
            theme.TextDim, (inTopbar and 22 or 18))
        sIcon.Position    = UDim2.new(0, inTopbar and 11 or 9, 0.5, 0)
        sIcon.AnchorPoint = Vector2.new(0, 0.5)

        local sBox = New("TextBox", {
            Size                   = UDim2.new(1, inTopbar and -40 or -32, 1, 0),
            Position               = UDim2.fromOffset(inTopbar and 32 or 26, 0),
            BackgroundTransparency = 1,
            Text                   = "",
            PlaceholderText        = inTopbar and "Search functions" or "Search",
            PlaceholderColor3      = theme.TextDim,
            TextColor3             = theme.Text,
            TextSize               = inTopbar and 13 or 12,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            ClearTextOnFocus       = false,
            ZIndex                 = inTopbar and 23 or 18,
            Parent                 = wrap,
        })

        if inTopbar then
            -- Nothing is stacked above the tab list, and the rail has no
            -- sidebar box to hide: searchWrap stays nil so LayoutTabList
            -- gives the list the full height.

            -- Let the game badge measure against the search field instead
            -- of the title, so the two can never overlap.
            topbarSearch = wrap

            -- The field used to be a fixed 268px pinned to the centre, which
            -- on a narrow window walked straight over the title. It now takes
            -- a share of whatever the topbar has spare and right-aligns
            -- against the credit pill, leaving the left half to the game name.
            local function FitSearch()
                local total = topbar.AbsoluteSize.X
                if total <= 0 then return end

                local right = total - CONTROLS_W - 12
                if creditPill and creditPill.Visible then
                    right = right - creditPill.AbsoluteSize.X - 10
                end

                local room = right - (TitleBlockEnd() + 24)
                if room < 190 then
                    wrap.Visible = false
                    FitGameBadge()
                    return
                end

                wrap.Visible  = true
                wrap.Size     = UDim2.fromOffset(
                    math.clamp(math.floor(room * 0.45), 150, 300), 30)
                wrap.Position = UDim2.new(0, right, 0.5, 0)
                FitGameBadge()
            end

            wrap.AnchorPoint = Vector2.new(1, 0.5)
            topbar:GetPropertyChangedSignal("AbsoluteSize"):Connect(FitSearch)
            FitSearch()
            task.defer(FitSearch)
        else
            searchWrap = wrap
        end

        LayoutTabList()

        local function RowText(row)
            local parts = {}
            for _, child in ipairs(row:GetDescendants()) do
                if child:IsA("TextLabel") and child.Text ~= "" then
                    table.insert(parts, child.Text)
                end
            end
            return string.lower(table.concat(parts, " "))
        end

        -- Groups and columns nest their rows, so a flat pass over the page's
        -- direct children would only ever match the container. Filter walks
        -- into anything tagged as a container and reports back whether it
        -- kept anything, so an empty group hides itself instead of leaving a
        -- titled card with nothing under it.
        local function Filter(host, query)
            local kept = false
            for _, child in ipairs(host:GetChildren()) do
                if child:IsA("GuiObject") then
                    if child:GetAttribute("NelySticky") then
                        -- A group's own header. It rides along with whatever
                        -- survives inside the group and never counts as a
                        -- match itself, otherwise typing a group's title
                        -- would leave a titled card with nothing under it.
                        child.Visible = true
                    elseif child:GetAttribute("NelyContainer") then
                        local inner = Filter(child, query)
                        child.Visible = inner
                        kept = kept or inner
                    else
                        local match = query == ""
                            or string.find(RowText(child), query, 1, true) ~= nil
                        child.Visible = match
                        kept = kept or match
                    end
                end
            end
            if query == "" then return true end
            return kept
        end

        sBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = string.lower(sBox.Text)
            for _, tab in ipairs(Window.Tabs) do
                Filter(tab.Page, query)
            end
        end)

        local sStroke = wrap:FindFirstChildOfClass("UIStroke")
        sBox.Focused:Connect(function()
            Tween(sStroke, { Color = theme.Accent, Transparency = 0.2 }, EASE.Snap)
            TintIcon(sIcon, theme.Accent)
        end)
        sBox.FocusLost:Connect(function()
            Tween(sStroke, { Color = theme.BorderSoft, Transparency = 0.5 }, EASE.Snap)
            TintIcon(sIcon, theme.TextDim)
        end)
    end

    ----------------------------------------------------------------
    -- Command palette
    --
    -- Ctrl+K anywhere in the game. Type, and it searches every row in
    -- every tab at once, not just the tab you are looking at. Pick one
    -- and it switches tab, scrolls the row into view and pulses it.
    --
    -- The index is built when the palette opens rather than kept in
    -- sync, because rows come and go (groups collapse, hubs add tabs
    -- after load) and a stale registry would point at destroyed
    -- instances. Walking a few hundred frames once per open is free.
    --
    -- Matching is subsequence, not substring: "aimf" finds "Aim field
    -- of view". Consecutive hits score higher so exact prefixes win.
    ----------------------------------------------------------------

    local paletteOpen = false

    if opts.CommandPalette ~= false then
        local scrim = New("TextButton", {
            Name                   = "PaletteScrim",
            Size                   = UDim2.fromScale(1, 1),
            BackgroundColor3       = Color3.new(0, 0, 0),
            BackgroundTransparency = 1,
            AutoButtonColor        = false,
            Text                   = "",
