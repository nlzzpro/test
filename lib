local EASE = {
    Instant = TweenInfo.new(0.10, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out),
    Snap    = TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
    Smooth  = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    Glide   = TweenInfo.new(0.42, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
    Pop     = TweenInfo.new(0.38, Enum.EasingStyle.Back,  Enum.EasingDirection.Out),
}

local function Tween(inst, props, preset)
    local tw = TweenService:Create(inst, preset or EASE.Smooth, props)
    tw:Play()
    return tw
end

--==================================================================
--  SPRING SOLVER  (critically-ish damped, frame independent)
--==================================================================

local Spring = {}
Spring.__index = Spring

function Spring.new(initial, stiffness, damping)
    return setmetatable({
        Position  = initial,
        Velocity  = 0,
        Target    = initial,
        Stiffness = stiffness or 180,
        Damping   = damping or 22,
    }, Spring)
end

function Spring:Step(dt)
    dt = math.min(dt, 1 / 30)
    local displacement = self.Position - self.Target
    local accel = (-self.Stiffness * displacement) - (self.Damping * self.Velocity)
    self.Velocity = self.Velocity + accel * dt
    self.Position = self.Position + self.Velocity * dt
    return self.Position
end

function Spring:Settled()
    return math.abs(self.Position - self.Target) < 0.001 and math.abs(self.Velocity) < 0.001
end

--==================================================================
--  INSTANCE HELPERS
