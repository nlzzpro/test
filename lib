--==================================================================
--  IMAGE RESOLUTION
--
--  rbxthumb://type=GameIcon keys off the UNIVERSE id, not the place id.
--  Feeding it a place id doesn't error — it just returns Roblox's default
--  placeholder icon, which is exactly what a wrong id looks like.
--
--  There is no in-game way to convert one to the other: GetProductInfo
--  does not carry a UniverseId field. It takes an API call:
--      apis.roblox.com/universes/v1/places/{placeId}/universe
--
--  So entries can supply either, and the cost differs:
--
--    UniverseId = 66654133      instant, zero network, always works
--    PlaceId    = 142823291     one lookup, then cached to disk forever
--    Image      = "rbxassetid://6500905731"
--    Image      = "https://..."  needs writefile + getcustomasset
--==================================================================

local HttpService = game:GetService("HttpService")

local function HttpGetJson(url)
    local body

    local httpRequest = (syn and syn.request) or (http and http.request)
                        or http_request or request
    if httpRequest then
        local ok, response = pcall(httpRequest, { Url = url, Method = "GET" })
        if ok and response then body = response.Body or response.body end
    end

    if not body then
        local ok, result = pcall(function() return game:HttpGet(url) end)
        if ok then body = result end
    end

    if not body or body == "" then return nil end

    local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    return ok and decoded or nil
end

--------------------------------------------------------------------
--  Universe id lookup: queued, staggered, and cached to disk so the
--  requests only ever happen once per place across every session.
--------------------------------------------------------------------

local UNIVERSE_CACHE_FILE = "nely_cache/universes.json"

local universeCache   = {}
local universeQueue   = {}
local universeRunning = false

local function LoadUniverseCache()
    if not (isfile and readfile) then return end
    pcall(function()
        if not isfile(UNIVERSE_CACHE_FILE) then return end
        for placeId, universeId in pairs(HttpService:JSONDecode(readfile(UNIVERSE_CACHE_FILE))) do
            universeCache[tonumber(placeId) or placeId] = universeId
        end
    end)
end

local function SaveUniverseCache()
    if not (writefile and isfolder and makefolder) then return end
    pcall(function()
        if not isfolder("nely_cache") then makefolder("nely_cache") end
        local plain = {}
        for placeId, universeId in pairs(universeCache) do
            plain[tostring(placeId)] = universeId
        end
        writefile(UNIVERSE_CACHE_FILE, HttpService:JSONEncode(plain))
    end)
end

LoadUniverseCache()

local function ProcessUniverseQueue()
    if universeRunning then return end
    universeRunning = true

    task.spawn(function()
        local fetched = false

        while #universeQueue > 0 do
            local job = table.remove(universeQueue, 1)
            local cached = universeCache[job.placeId]

            if cached then
                job.callback(cached)
            else
                local data = HttpGetJson(
                    ("https://apis.roblox.com/universes/v1/places/%d/universe"):format(job.placeId))
                local universeId = data and data.universeId

                if universeId then
                    universeCache[job.placeId] = universeId
                    fetched = true
                    job.callback(universeId)
                end

                -- stagger, or thirty cards at once trips Roblox's rate limiter
                -- and most of them come back empty
                task.wait(0.12)
            end
        end

        universeRunning = false
        if fetched then SaveUniverseCache() end
    end)
end

