function Icons.Render(name, parent, size, color, zindex)
    local holder = New("Frame", {
        Name                   = "Icon",
        Size                   = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        ZIndex                 = zindex or (parent.ZIndex + 1),
        Parent                 = parent,
    })
    local drawer = Icons[name]
    if drawer then drawer(holder) end
    for _, part in ipairs(holder:GetDescendants()) do
        if part:IsA("Frame") then
            part.BackgroundColor3 = color
        elseif part:IsA("UIStroke") then
            part.Color = color
        end
    end
    return holder
end

local function TintIcon(icon, color)
    for _, part in ipairs(icon:GetDescendants()) do
        if part:IsA("Frame") and part.BackgroundTransparency < 1 then
            Tween(part, { BackgroundColor3 = color }, EASE.Snap)
        elseif part:IsA("UIStroke") then
            Tween(part, { Color = color }, EASE.Snap)
        end
    end
end

