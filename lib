            local placeName = (ok and info and info.Name) or subtitle
            if placeName == "" or not placeName then return end

            -- Trim: place names run long and would push past the controls.
            local limit = compact and 16 or 32
            if #placeName > limit then
                placeName = string.sub(placeName, 1, limit - 1) .. "\u{2026}"
            end
            nameLabel.Text = placeName
            badge.Visible  = true

            ResolveGameImage({ PlaceId = game.PlaceId }, function(asset)
                if asset and badge.Parent then thumb.Image = asset end
            end)
        end)
    end

