                Tween(track, { BackgroundColor3 = state and theme.Accent or theme.Elevated }, EASE.Snap)
                Tween(knob, { Position = UDim2.new(0, state and 20 or 3, 0.5, 0) }, EASE.Pop)
                if flag then Nely.Flags[flag] = state end
                api.CurrentValue = state
                if fire and cfg.Callback then task.spawn(cfg.Callback, state) end
            end

            hit.MouseEnter:Connect(function()
                Tween(row, { BackgroundTransparency = 0.05, BackgroundColor3 = theme.SurfaceAlt }, EASE.Snap)
