                BackgroundColor3       = theme.Accent,
                BackgroundTransparency = 0.15,
                BorderSizePixel        = 0,
                ZIndex                 = 18,
                Parent                 = card,
            }, { Corner(8) })

            local pillIcon = Icons.Render("copy", copyPill, 12, Color3.new(1, 1, 1), 19)
            pillIcon.Position    = UDim2.new(0, 10, 0.5, 0)
            pillIcon.AnchorPoint = Vector2.new(0, 0.5)

            local pillLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -26, 1, 0),
                Position               = UDim2.fromOffset(24, 0),
                BackgroundTransparency = 1,
                Text                   = "Copy",
                TextColor3             = Color3.new(1, 1, 1),
                TextSize               = 12,
                Font                   = Enum.Font.GothamBold,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 19,
                Parent                 = copyPill,
            })

            local cardStroke = card:FindFirstChildOfClass("UIStroke")

            card.MouseEnter:Connect(function()
                Tween(card, { BackgroundTransparency = 0 }, EASE.Snap)
                Tween(wash, { BackgroundTransparency = 0.88 }, EASE.Snap)
                Tween(cardStroke, { Color = theme.Accent, Transparency = 0.25 }, EASE.Snap)
                Tween(copyPill, { BackgroundTransparency = 0 }, EASE.Snap)
            end)
            card.MouseLeave:Connect(function()
                Tween(card, { BackgroundTransparency = 0.15 }, EASE.Snap)
                Tween(wash, { BackgroundTransparency = 0.94 }, EASE.Snap)
                Tween(cardStroke, { Color = theme.BorderSoft, Transparency = 0.4 }, EASE.Snap)
                Tween(copyPill, { BackgroundTransparency = 0.15 }, EASE.Snap)
            end)

            card.MouseButton1Click:Connect(function()
                Ripple(card, 22)
                local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
                if copy then
                    copy(full)
                    pillLabel.Text = "Copied"
                    Nely:Notify({
                        Title   = "Invite copied",
                        Content = pretty .. " is on your clipboard.",
                        Icon    = "check",
                        Color   = theme.Success,
                    })
                    task.delay(2, function() pillLabel.Text = "Copy" end)
                else
                    Nely:Notify({
                        Title   = "No clipboard",
                        Content = "Join manually at " .. pretty,
                        Icon    = "alert",
                        Color   = theme.Warning,
                    })
                end
            end)

            return { Instance = card, Destroy = function() card:Destroy() end }
        end

        if #Window.Tabs == 1 then
            task.defer(Activate)
        end

        return Tab
    end

    ----------------------------------------------------------------
    -- Prebuilt home tab
    ----------------------------------------------------------------

    function Window:CreateHomeTab(homeOpts)
        homeOpts = homeOpts or {}
        local Home = Window:CreateTab({
            Name = homeOpts.Name or "Home",
            Icon = homeOpts.Icon or "home",
        })

        Home:CreateProfileCard()

        Home:CreateSection("Server")
        Home:CreateServerCard()

        Home:CreateSection("Friends")
        Home:CreateFriendsCard()

        if homeOpts.DiscordInvite then
            Home:CreateSection("Community")
            Home:CreateDiscordCard({ Invite = homeOpts.DiscordInvite })
        end

        return Home
    end

