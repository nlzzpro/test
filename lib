        local function Activate()
            if Window.ActiveTab == Tab then return end
            local previous = Window.ActiveTab
            Window.ActiveTab = Tab

            for _, other in ipairs(Window.Tabs) do
                local active = (other == Tab)
                Tween(other.Button, {
                    BackgroundTransparency = active and 0.55 or 1,
                }, EASE.Snap)
                Tween(other._label, {
                    TextColor3 = active and theme.Text or theme.TextDim,
                }, EASE.Snap)
                TintIcon(other._icon, active and theme.Accent or theme.TextDim)
            end

            local targetY = btn.AbsolutePosition.Y - sidebar.AbsolutePosition.Y + 8
            Tween(indicator, { Position = UDim2.fromOffset(0, targetY) }, EASE.Glide)

            if previous then
                Tween(previous.Page, { Position = UDim2.fromOffset(-18, 0) }, EASE.Snap)
                task.delay(0.16, function()
                    if Window.ActiveTab ~= previous then previous.Page.Visible = false end
                end)
            end

            page.Visible  = true
            page.Position = UDim2.fromOffset(18, 0)
            Tween(page, { Position = UDim2.fromOffset(0, 0) }, EASE.Glide)
        end

        Tab._label  = label
        Tab._icon   = icon
        Tab.Activate = Activate

        btn.MouseEnter:Connect(function()
            if Window.ActiveTab == Tab then return end
            Tween(btn, { BackgroundTransparency = 0.8 }, EASE.Snap)
            Tween(label, { TextColor3 = theme.TextSub }, EASE.Snap)
        end)
        btn.MouseLeave:Connect(function()
            if Window.ActiveTab == Tab then return end
            Tween(btn, { BackgroundTransparency = 1 }, EASE.Snap)
            Tween(label, { TextColor3 = theme.TextDim }, EASE.Snap)
        end)
        btn.MouseButton1Click:Connect(function()
            Ripple(btn, 19)
            Activate()
        end)

