            ZIndex                 = 802,
            Parent                 = mark,
        })

        New("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 18),
            Position               = UDim2.fromOffset(0, 68),
            BackgroundTransparency = 1,
            Text                   = opts.LoadingTitle or title,
            TextColor3             = theme.Text,
            TextSize               = 14,
            Font                   = Enum.Font.GothamBold,
            ZIndex                 = 801,
            Parent                 = splash,
        })

        local bar = New("Frame", {
            Size             = UDim2.new(1, -60, 0, 3),
            Position         = UDim2.new(0.5, 0, 1, -22),
            AnchorPoint      = Vector2.new(0.5, 0),
            BackgroundColor3 = theme.Elevated,
            BorderSizePixel  = 0,
            ZIndex           = 801,
            Parent           = splash,
        }, { Corner(2) })

        local barFill = New("Frame", {
            Size             = UDim2.fromScale(0, 1),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel  = 0,
            ZIndex           = 802,
            Parent           = bar,
        }, { Corner(2) })

        splash.Size = UDim2.fromOffset(270, 108)
        Tween(splash, { Size = UDim2.fromOffset(300, 120) }, EASE.Pop)
        Tween(Blur, { Size = 10 }, EASE.Glide)
        TweenService:Create(barFill, TweenInfo.new(1.05, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.fromScale(1, 1),
        }):Play()

        task.delay(1.2, function()
            Tween(splash, { Size = UDim2.fromOffset(270, 108), BackgroundTransparency = 1 }, EASE.Smooth)
            task.delay(0.28, function()
                splash:Destroy()
