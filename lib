        function Tab:CreateKeybind(cfg, flag)
            cfg = cfg or {}
            local current = cfg.CurrentBind or "None"
            local listening = false

            local row = Row(cfg.Description and 54 or 44)
            RowText(row, cfg.Name or "Keybind", cfg.Description)

            local pill = New("TextButton", {
                Size             = UDim2.fromOffset(84, 27),
                Position         = UDim2.new(1, -14, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = theme.Elevated,
                AutoButtonColor  = false,
                Text             = current,
                TextColor3       = theme.TextSub,
                TextSize         = 12,
                Font             = Enum.Font.GothamBold,
                ZIndex           = 19,
                Parent           = row,
            }, { Corner(8), Stroke(theme.Border, 1, 0.55) })

            pill.MouseButton1Click:Connect(function()
                listening = true
                pill.Text = "Press key"
                Tween(pill, { BackgroundColor3 = theme.Accent, TextColor3 = Color3.new(1, 1, 1) }, EASE.Snap)
            end)

            local bindConn = UserInputService.InputBegan:Connect(function(input, processed)
                if not listening or processed then return end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                listening = false
                current   = input.KeyCode.Name
                pill.Text = current
                Tween(pill, { BackgroundColor3 = theme.Elevated, TextColor3 = theme.TextSub }, EASE.Snap)
                if flag then Nely.Flags[flag] = current end
                if cfg.OnChanged then task.spawn(cfg.OnChanged, input.KeyCode) end
            end)
            table.insert(Nely.Connections, bindConn)

            local fireConn = UserInputService.InputBegan:Connect(function(input, processed)
                if listening or processed then return end
                if input.KeyCode.Name == current and cfg.Callback then
                    task.spawn(cfg.Callback)
                end
            end)
            table.insert(Nely.Connections, fireConn)

            return {
                CurrentBind = current,
                Set = function(_, key) current = key; pill.Text = key end,
                Destroy = function() row:Destroy() end,
            }
        end

