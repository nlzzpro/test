        ------------------------------------------------------------
        -- Colorpicker
        ------------------------------------------------------------

        function Tab:CreateColorpicker(cfg, flag)
            cfg = cfg or {}
            local current = cfg.CurrentValue or theme.Accent
            local hue, sat, val = current:ToHSV()
            local expanded = false
            local rowHeight = ROW_H

            local row = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, rowHeight),
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.25,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 17,
                Parent                 = page,
            }, { Corner(11), Stroke(theme.BorderSoft, 1, 0.45) })

            local lp = RowIcon(row, cfg.Icon)

            local cpLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -lp - 74, 0, 16),
                Position               = UDim2.new(0, lp, 0, math.floor(rowHeight / 2) - 8),
                BackgroundTransparency = 1,
                Text                   = cfg.Name or "Colour",
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })
            InfoDot(row, cpLabel, cfg.Info, 22)

            local swatch = New("Frame", {
                Size             = UDim2.fromOffset(38, 22),
                Position         = UDim2.new(1, -16, 0, math.floor(rowHeight / 2) - 11),
                AnchorPoint      = Vector2.new(1, 0),
                BackgroundColor3 = current,
                BorderSizePixel  = 0,
                ZIndex           = 18,
                Parent           = row,
            }, { Corner(7), Stroke(theme.Border, 1, 0.4) })

            -- saturation / value field
            local field = New("Frame", {
                Size             = UDim2.new(1, -28, 0, 96),
                Position         = UDim2.fromOffset(14, rowHeight + 4),
                BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
                BorderSizePixel  = 0,
                ZIndex           = 18,
                Parent           = row,
            }, { Corner(8) })

            New("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0, ZIndex = 19, Parent = field,
            }, {
                Corner(8),
                Gradient(ColorSequence.new(Color3.new(1, 1, 1)), 0,
                    NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(1, 1),
                    })),
            })

            New("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0, ZIndex = 20, Parent = field,
            }, {
                Corner(8),
                Gradient(ColorSequence.new(Color3.new(0, 0, 0)), 90,
                    NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(1, 0),
                    })),
            })

            local cursor = New("Frame", {
                Size             = UDim2.fromOffset(10, 10),
                Position         = UDim2.fromScale(sat, 1 - val),
                AnchorPoint      = Vector2.new(0.5, 0.5),
                BackgroundTransparency = 1,
                ZIndex           = 22,
                Parent           = field,
            }, {
                New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }),
            })

            -- hue strip
            local hueStrip = New("Frame", {
                Size             = UDim2.new(1, -28, 0, 12),
                Position         = UDim2.fromOffset(14, rowHeight + 108),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel  = 0,
                ZIndex           = 18,
                Parent           = row,
            }, {
                Corner(6),
                Gradient(ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,   0,   0)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255,   0)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromRGB(  0, 255,   0)),
                    ColorSequenceKeypoint.new(0.50, Color3.fromRGB(  0, 255, 255)),
                    ColorSequenceKeypoint.new(0.67, Color3.fromRGB(  0,   0, 255)),
                    ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,   0, 255)),
                    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,   0,   0)),
                }), 0),
            })

            local hueKnob = New("Frame", {
                Size             = UDim2.fromOffset(6, 18),
                Position         = UDim2.fromScale(hue, 0.5),
                AnchorPoint      = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel  = 0,
                ZIndex           = 20,
                Parent           = hueStrip,
            }, { Corner(3), Stroke(theme.Backdrop, 1, 0.3) })

            local api = { CurrentValue = current }

            local function Emit(fire)
                local colour = Color3.fromHSV(hue, sat, val)
                api.CurrentValue = colour
                swatch.BackgroundColor3 = colour
                field.BackgroundColor3  = Color3.fromHSV(hue, 1, 1)
                if flag then Nely.Flags[flag] = colour end
                if fire and cfg.Callback then task.spawn(cfg.Callback, colour) end
            end

            local draggingField, draggingHue = false, false

            local fieldHit = New("TextButton", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                AutoButtonColor = false, Text = "", ZIndex = 21, Parent = field,
            })
            fieldHit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingField = true
                end
            end)

            local hueHit = New("TextButton", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                AutoButtonColor = false, Text = "", ZIndex = 21, Parent = hueStrip,
            })
            hueHit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingHue = true
                end
            end)

            local pickConn = RunService.RenderStepped:Connect(function()
                if not (draggingField or draggingHue) then return end
                local point = GetPointer()

                if draggingField then
                    sat = math.clamp((point.X - field.AbsolutePosition.X)
                        / math.max(field.AbsoluteSize.X, 1), 0, 1)
                    val = 1 - math.clamp((point.Y - field.AbsolutePosition.Y)
                        / math.max(field.AbsoluteSize.Y, 1), 0, 1)
                    cursor.Position = UDim2.fromScale(sat, 1 - val)
                    Emit(true)
                end

                if draggingHue then
                    hue = math.clamp((point.X - hueStrip.AbsolutePosition.X)
                        / math.max(hueStrip.AbsoluteSize.X, 1), 0, 1)
                    hueKnob.Position = UDim2.fromScale(hue, 0.5)
                    Emit(true)
                end
            end)
            table.insert(Nely.Connections, pickConn)

            local releaseConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    draggingField, draggingHue = false, false
                end
            end)
            table.insert(Nely.Connections, releaseConn)

            local header = New("TextButton", {
                Size                   = UDim2.new(1, 0, 0, rowHeight),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 21,
                Parent                 = row,
            })
            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                Tween(row, {
                    Size = UDim2.new(1, 0, 0, expanded and (rowHeight + 136) or rowHeight),
                }, EASE.Glide)
            end)

            api.Set = function(_, colour)
                hue, sat, val = colour:ToHSV()
                cursor.Position   = UDim2.fromScale(sat, 1 - val)
                hueKnob.Position  = UDim2.fromScale(hue, 0.5)
                Emit(true)
            end
            api.Destroy = function() row:Destroy() end
            if flag then Nely.Flags[flag] = current end
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

