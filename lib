        function Tab:CreateDropdown(cfg, flag)
            cfg = cfg or {}
            local options  = cfg.Options or {}
            local multi    = cfg.MultipleOptions == true
            local selected = {}
            for _, v in ipairs(cfg.CurrentOption or {}) do selected[v] = true end

            local expanded = false
            local rowHeight = ROW_H

            local row = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, rowHeight),
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.25,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 17,
                Parent                 = page,
            }, { Corner(11), Stroke(theme.BorderSoft, 1, 0.45) })

            local lp = RowIcon(row, cfg.Icon)

            local ddLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -lp - 144, 0, 16),
                Position               = UDim2.new(0, lp, 0, math.floor(rowHeight / 2) - 8),
                BackgroundTransparency = 1,
                Text                   = cfg.Name or "Dropdown",
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })
            InfoDot(row, ddLabel, cfg.Info, 22)

            local function SummaryText()
                local picked = {}
                for _, opt in ipairs(options) do
                    if selected[opt] then table.insert(picked, opt) end
                end
                if #picked == 0 then return "None" end
                if #picked <= 2 then return table.concat(picked, ", ") end
                return #picked .. " selected"
            end

            local summary = New("TextLabel", {
                Size                   = UDim2.fromOffset(130, 16),
                Position               = UDim2.new(1, -36, 0, math.floor(rowHeight / 2) - 8),
                AnchorPoint            = Vector2.new(1, 0),
                BackgroundTransparency = 1,
                Text                   = SummaryText(),
                TextColor3             = theme.TextSub,
                TextSize               = 12,
                Font                   = Enum.Font.Gotham,
                TextXAlignment         = Enum.TextXAlignment.Right,
                TextTruncate           = Enum.TextTruncate.AtEnd,
                ZIndex                 = 18,
                Parent                 = row,
            })

            local caret = Icons.Render("chevron", row, 13, theme.TextDim, 18)
            caret.Position    = UDim2.new(1, -16, 0, math.floor(rowHeight / 2) - 6)
            caret.AnchorPoint = Vector2.new(1, 0.5)

            local optionHost = New("Frame", {
                Size                   = UDim2.new(1, -20, 0, 0),
                Position               = UDim2.fromOffset(10, rowHeight),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ZIndex                 = 18,
                Parent                 = row,
            }, { List(4), Pad(0, 10, 0, 0) })

            local entries = {}

            local function Refresh()
                summary.Text = SummaryText()
                for opt, entry in pairs(entries) do
                    local on = selected[opt] == true
                    Tween(entry.frame, {
                        BackgroundColor3       = on and theme.Accent or theme.Elevated,
                        BackgroundTransparency = on and 0.78 or 0.35,
                    }, EASE.Snap)
                    Tween(entry.label, { TextColor3 = on and theme.Text or theme.TextSub }, EASE.Snap)
                    entry.check.Visible = on
                end
            end

            local function BuildOptions()
                for _, child in ipairs(optionHost:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                entries = {}
                for index, opt in ipairs(options) do
                    local entry = New("TextButton", {
                        Size                   = UDim2.new(1, 0, 0, 30),
                        BackgroundColor3       = theme.Elevated,
                        BackgroundTransparency = 0.35,
                        AutoButtonColor        = false,
                        Text                   = "",
                        LayoutOrder            = index,
                        ZIndex                 = 19,
                        Parent                 = optionHost,
                    }, { Corner(8) })

                    local label = New("TextLabel", {
                        Size                   = UDim2.new(1, -40, 1, 0),
                        Position               = UDim2.fromOffset(11, 0),
                        BackgroundTransparency = 1,
                        Text                   = opt,
                        TextColor3             = theme.TextSub,
                        TextSize               = 12,
                        Font                   = Enum.Font.Gotham,
                        TextXAlignment         = Enum.TextXAlignment.Left,
                        ZIndex                 = 20,
                        Parent                 = entry,
                    })

                    local check = Icons.Render("check", entry, 13, theme.Accent, 20)
                    check.Position    = UDim2.new(1, -10, 0.5, 0)
                    check.AnchorPoint = Vector2.new(1, 0.5)
                    check.Visible     = selected[opt] == true

                    entry.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt] or nil
                        else
                            selected = { [opt] = true }
                        end
                        Refresh()
                        if flag then Nely.Flags[flag] = multi and selected or opt end
                        if cfg.Callback then
                            if multi then
                                local picked = {}
                                for _, o in ipairs(options) do
                                    if selected[o] then table.insert(picked, o) end
                                end
                                task.spawn(cfg.Callback, picked)
                            else
                                task.spawn(cfg.Callback, opt)
                            end
                        end
                    end)

                    entries[opt] = { frame = entry, label = label, check = check }
                end
                Refresh()
            end

            BuildOptions()

            local header = New("TextButton", {
                Size                   = UDim2.new(1, 0, 0, rowHeight),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 21,
                Parent                 = row,
            })

            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                local target = expanded
                    and (rowHeight + optionHost.AbsoluteSize.Y + 4)
                    or rowHeight
                Tween(row, { Size = UDim2.new(1, 0, 0, target) }, EASE.Glide)
                Tween(caret, { Rotation = expanded and 180 or 0 }, EASE.Glide)
            end)

            local api = {
                CurrentOption = selected,
                Set = function(_, newCfg)
                    if newCfg.Options then options = newCfg.Options; BuildOptions() end
                    if newCfg.CurrentOption then
                        selected = {}
                        for _, v in ipairs(newCfg.CurrentOption) do selected[v] = true end
                        Refresh()
                    end
                end,
                Destroy = function() row:Destroy() end,
            }
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

        ------------------------------------------------------------
        -- Keybind
        ------------------------------------------------------------

        -- Mode decides what the key actually does, and the chip in front of
        -- the key shows which one is live:
        --
        --   Press   fires the callback once per press          (the default,
        --           and what every existing script already expects)
        --   Hold    fires Callback(true) down, Callback(false) up
        --   Toggle  flips a state and fires Callback(state)
        --
        -- Clicking the chip cycles it, so a hub gets all three without
        -- shipping three separate controls.
        local KEYBIND_MODES = { "Press", "Hold", "Toggle" }

        function Tab:CreateKeybind(cfg, flag)
            cfg = cfg or {}
            local current   = cfg.CurrentBind or "None"
            local listening = false
            local held      = false
            local toggled   = false

            local modeIndex = 1
            for index, name in ipairs(KEYBIND_MODES) do
                if cfg.Mode == name then modeIndex = index end
            end
            local locked = cfg.LockMode == true

            local row = Row(cfg.Description and ROW_HD or ROW_H)
            RowText(row, cfg.Name or "Keybind", cfg.Description, RowIcon(row, cfg.Icon), cfg.Info)

            local pill = New("TextButton", {
                Size             = UDim2.fromOffset(84, 27),
                Position         = UDim2.new(1, -14, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = theme.Elevated,
                AutoButtonColor  = false,
                Text             = current,
                TextColor3       = theme.TextSub,
                TextSize         = 12,
                Font             = Enum.Font.GothamBold,
                ZIndex           = 19,
                Parent           = row,
            }, { Corner(8), Stroke(theme.Border, 1, 0.55) })

            -- Sits flush against the key pill so the pair reads as one
            -- control: [ HOLD ][ E ]
            local chip = New("TextButton", {
                Size             = UDim2.fromOffset(52, 27),
                Position         = UDim2.new(1, -100, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = theme.Elevated,
                BackgroundTransparency = 0.45,
                AutoButtonColor  = false,
                Text             = string.upper(KEYBIND_MODES[modeIndex]),
                TextColor3       = theme.TextDim,
                TextSize         = 9,
                Font             = Enum.Font.GothamBold,
                ZIndex           = 19,
                Parent           = row,
            }, { Corner(8) })

            AttachTooltip(chip, locked and "Trigger mode" or "Click to change trigger mode")

            local function SetMode(index)
                modeIndex = ((index - 1) % #KEYBIND_MODES) + 1
                chip.Text = string.upper(KEYBIND_MODES[modeIndex])
                held, toggled = false, false
                if cfg.OnModeChanged then
                    task.spawn(cfg.OnModeChanged, KEYBIND_MODES[modeIndex])
                end
            end

            if not locked then
                chip.MouseEnter:Connect(function()
                    Tween(chip, { BackgroundTransparency = 0.15, TextColor3 = theme.Text }, EASE.Snap)
                end)
                chip.MouseLeave:Connect(function()
                    Tween(chip, { BackgroundTransparency = 0.45, TextColor3 = theme.TextDim }, EASE.Snap)
                end)
                chip.MouseButton1Click:Connect(function() SetMode(modeIndex + 1) end)
            end

            pill.MouseButton1Click:Connect(function()
                listening = true
                pill.Text = "Press key"
                Tween(pill, { BackgroundColor3 = theme.Accent, TextColor3 = Color3.new(1, 1, 1) }, EASE.Snap)
            end)

            local bindConn = UserInputService.InputBegan:Connect(function(input, processed)
                if not listening or processed then return end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                listening = false
                current   = input.KeyCode.Name
                pill.Text = current
                Tween(pill, { BackgroundColor3 = theme.Elevated, TextColor3 = theme.TextSub }, EASE.Snap)
                if flag then Nely.Flags[flag] = current end
                if cfg.OnChanged then task.spawn(cfg.OnChanged, input.KeyCode) end
            end)
            table.insert(Nely.Connections, bindConn)

            local fireConn = UserInputService.InputBegan:Connect(function(input, processed)
                if listening or processed then return end
                if input.KeyCode.Name ~= current then return end
                local mode = KEYBIND_MODES[modeIndex]
                if mode == "Hold" then
                    if held then return end
                    held = true
                    if cfg.Callback then task.spawn(cfg.Callback, true) end
                elseif mode == "Toggle" then
                    toggled = not toggled
                    if cfg.Callback then task.spawn(cfg.Callback, toggled) end
                else
                    if cfg.Callback then task.spawn(cfg.Callback) end
                end
            end)
            table.insert(Nely.Connections, fireConn)

            local releaseConn = UserInputService.InputEnded:Connect(function(input, processed)
                if input.KeyCode.Name ~= current then return end
                if KEYBIND_MODES[modeIndex] ~= "Hold" or not held then return end
                held = false
                if cfg.Callback then task.spawn(cfg.Callback, false) end
            end)
            table.insert(Nely.Connections, releaseConn)

            local api = {
                CurrentBind = current,
                Mode        = KEYBIND_MODES[modeIndex],
                Set = function(_, key) current = key; pill.Text = key end,
                SetMode = function(_, name)
                    for index, candidate in ipairs(KEYBIND_MODES) do
                        if candidate == name then SetMode(index) end
                    end
                    api.Mode = KEYBIND_MODES[modeIndex]
                end,
                Destroy = function() row:Destroy() end,
            }
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

