        -- Curve editor
        --
        -- A draggable cubic bezier, for anything shaped like an easing
        -- response: aim smoothing, sensitivity ramps, fade profiles. The
        -- ends are pinned at (0,0) and (1,1); the two handles in between
        -- are what you drag.
        --
        -- There is no line primitive in Roblox GUI, so the curve is drawn
        -- as a run of thin rotated Frames sampled along the bezier. 34
        -- segments is the point where the joins stop being visible at this
        -- size without wasting instances.
        --
        -- :Sample(x) is the part a hub actually calls at runtime. A bezier
        -- is parametric, so x is not t; solving for t by bisection is
        -- cheap here and avoids the lookup table a shipping easing curve
        -- would otherwise need.
        ------------------------------------------------------------

        local CURVE_SEGMENTS = 34

        function Tab:CreateCurve(cfg, flag)
            cfg = cfg or {}
            local p1x = math.clamp(cfg.P1X or 0.25, 0, 1)
            local p1y = math.clamp(cfg.P1Y or 0.10, -0.5, 1.5)
            local p2x = math.clamp(cfg.P2X or 0.75, 0, 1)
            local p2y = math.clamp(cfg.P2Y or 0.90, -0.5, 1.5)

            local graphH = cfg.Height or 132

            local row = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, graphH + 62),
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.25,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 17,
                Parent                 = page,
            }, { Corner(11), Stroke(theme.BorderSoft, 1, 0.45) })

            local lp = RowIcon(row, cfg.Icon)

            local curveLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -lp - 20, 0, 16),
                Position               = UDim2.fromOffset(lp, 13),
                BackgroundTransparency = 1,
                Text                   = cfg.Name or "Curve",
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })
            InfoDot(row, curveLabel, cfg.Info, 19)

            local graph = New("Frame", {
                Name             = "Graph",
                Size             = UDim2.new(1, -28, 0, graphH),
                Position         = UDim2.fromOffset(14, 38),
                BackgroundColor3 = theme.Backdrop,
                BackgroundTransparency = 0.25,
                BorderSizePixel  = 0,
                ClipsDescendants = true,
                ZIndex           = 18,
                Parent           = row,
            }, { Corner(9), Stroke(theme.BorderSoft, 1, 0.6) })

            -- grid
            for i = 1, 5 do
                local t = i / 6
                New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 1),
                    Position         = UDim2.fromScale(0, t),
                    BackgroundColor3 = theme.BorderSoft,
                    BackgroundTransparency = 0.45,
                    BorderSizePixel  = 0,
                    ZIndex           = 19,
                    Parent           = graph,
                })
                New("Frame", {
                    Size             = UDim2.new(0, 1, 1, 0),
                    Position         = UDim2.fromScale(t, 0),
                    BackgroundColor3 = theme.BorderSoft,
                    BackgroundTransparency = 0.45,
                    BorderSizePixel  = 0,
                    ZIndex           = 19,
                    Parent           = graph,
                })
            end

            local segments = {}
            for i = 1, CURVE_SEGMENTS do
                segments[i] = New("Frame", {
                    Size             = UDim2.fromOffset(2, 2),
                    AnchorPoint      = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel  = 0,
                    ZIndex           = 21,
                    Parent           = graph,
                }, { Corner(1) })
            end

            -- guide lines from each pinned end out to its handle
            local guides = {}
            for i = 1, 2 do
                guides[i] = New("Frame", {
                    Size             = UDim2.fromOffset(1, 1),
                    AnchorPoint      = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = theme.TextDim,
                    BackgroundTransparency = 0.55,
                    BorderSizePixel  = 0,
                    ZIndex           = 20,
                    Parent           = graph,
                })
            end

            local function Anchor(x, y, colour)
                return New("Frame", {
                    Size             = UDim2.fromOffset(7, 7),
                    Position         = UDim2.fromScale(x, 1 - y),
                    AnchorPoint      = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = colour,
                    BorderSizePixel  = 0,
                    ZIndex           = 22,
                    Parent           = graph,
                }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            end

            Anchor(0, 0, theme.TextDim)
            Anchor(1, 1, theme.TextDim)

            local function Handle(x, y)
                return New("Frame", {
                    Size             = UDim2.fromOffset(11, 11),
                    Position         = UDim2.fromScale(x, 1 - y),
                    AnchorPoint      = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = theme.AccentSoft,
                    BorderSizePixel  = 0,
                    ZIndex           = 23,
                    Parent           = graph,
                }, {
                    New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                    New("UIStroke", { Color = theme.Backdrop, Thickness = 2, Transparency = 0.2 }),
                })
            end

            local h1 = Handle(p1x, p1y)
            local h2 = Handle(p2x, p2y)

            local readout = New("TextLabel", {
                Size                   = UDim2.new(1, -28, 0, 14),
                Position               = UDim2.fromOffset(14, graphH + 42),
                BackgroundTransparency = 1,
                Text                   = "",
                TextColor3             = theme.TextDim,
                TextSize               = 10,
                Font                   = Enum.Font.Code,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })

            local api = {}

            local function BezierAt(t)
                local u = 1 - t
                local x = 3 * u * u * t * p1x + 3 * u * t * t * p2x + t * t * t
                local y = 3 * u * u * t * p1y + 3 * u * t * t * p2y + t * t * t
                return x, y
            end

            -- Lays one thin frame between two points in the graph's pixel
            -- space: midpoint, length, and the angle between them.
            local function Segment(frame, ax, ay, bx, by, thickness)
                local dx, dy = bx - ax, by - ay
                local length = math.sqrt(dx * dx + dy * dy)
                frame.Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2)
                frame.Size     = UDim2.fromOffset(math.max(length, 1), thickness or 2)
                frame.Rotation = math.deg(math.atan2(dy, dx))
            end

            local function Redraw()
                local size = graph.AbsoluteSize
                if size.X < 2 then return end

                local prevX, prevY = 0, size.Y
                for i = 1, CURVE_SEGMENTS do
                    local t = i / CURVE_SEGMENTS
                    local bx, by = BezierAt(t)
                    local px = bx * size.X
                    local py = (1 - by) * size.Y
                    Segment(segments[i], prevX, prevY, px, py, 2)
                    segments[i].BackgroundColor3 = theme.Accent
                    prevX, prevY = px, py
                end

                Segment(guides[1], 0, size.Y, p1x * size.X, (1 - p1y) * size.Y, 1)
                Segment(guides[2], size.X, 0, p2x * size.X, (1 - p2y) * size.Y, 1)

                h1.Position = UDim2.fromScale(p1x, 1 - p1y)
                h2.Position = UDim2.fromScale(p2x, 1 - p2y)

                readout.Text = ("P1 %.2f, %.2f      P2 %.2f, %.2f")
                    :format(p1x, p1y, p2x, p2y)

                api.CurrentValue = { p1x, p1y, p2x, p2y }
                if flag then Nely.Flags[flag] = api.CurrentValue end
            end

            local dragging = nil

            local function HandleHit(target, which)
                local hit = New("TextButton", {
                    Size                   = UDim2.fromOffset(26, 26),
                    Position               = UDim2.fromScale(0.5, 0.5),
                    AnchorPoint            = Vector2.new(0.5, 0.5),
                    BackgroundTransparency = 1,
                    AutoButtonColor        = false,
                    Text                   = "",
                    ZIndex                 = 24,
                    Parent                 = target,
                })
                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = which
                        Tween(target, { Size = UDim2.fromOffset(14, 14) }, EASE.Pop)
                    end
                end)
                return hit
            end

            HandleHit(h1, 1)
            HandleHit(h2, 2)

            local moveConn = RunService.RenderStepped:Connect(function()
                if not dragging then return end
                local point = GetPointer()
                local pos, size = graph.AbsolutePosition, graph.AbsoluteSize
                local nx = math.clamp((point.X - pos.X) / math.max(size.X, 1), 0, 1)
                local ny = 1 - math.clamp((point.Y - pos.Y) / math.max(size.Y, 1), 0, 1)
                if dragging == 1 then p1x, p1y = nx, ny else p2x, p2y = nx, ny end
                Redraw()
                if cfg.Callback then task.spawn(cfg.Callback, p1x, p1y, p2x, p2y) end
            end)
            table.insert(Nely.Connections, moveConn)

            local dropConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if not dragging then return end
                Tween(dragging == 1 and h1 or h2, { Size = UDim2.fromOffset(11, 11) }, EASE.Pop)
                dragging = nil
            end)
            table.insert(Nely.Connections, dropConn)

            -- AbsoluteSize is zero until the page has laid out, and the
            -- curve is drawn in pixel space, so the first paint waits for it.
            graph:GetPropertyChangedSignal("AbsoluteSize"):Connect(Redraw)
            task.defer(Redraw)

            api.CurrentValue = { p1x, p1y, p2x, p2y }

            function api.Sample(_, x)
                x = math.clamp(x or 0, 0, 1)
                local low, high = 0, 1
                for _ = 1, 18 do
                    local mid = (low + high) / 2
                    local bx = select(1, BezierAt(mid))
                    if bx < x then low = mid else high = mid end
                end
                return select(2, BezierAt((low + high) / 2))
            end

            api.Set = function(_, a, b, c, d)
                if type(a) == "table" then a, b, c, d = a[1], a[2], a[3], a[4] end
                p1x, p1y = math.clamp(a or p1x, 0, 1), b or p1y
                p2x, p2y = math.clamp(c or p2x, 0, 1), d or p2y
                Redraw()
                if cfg.Callback then task.spawn(cfg.Callback, p1x, p1y, p2x, p2y) end
            end

            api.Destroy = function() row:Destroy() end
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

