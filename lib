    ----------------------------------------------------------------
    -- Tab sections
    --
    -- A labelled group in the sidebar that owns its own tabs, so a hub
    -- with twenty scripts can file them under headings instead of one
    -- flat list. Sections and loose tabs share a single order counter,
    -- which is what keeps a section's tabs sitting under its heading
    -- rather than drifting to the bottom of the list.
    ----------------------------------------------------------------

    function Window:CreateTabSection(sectionOpts)
        sectionOpts = type(sectionOpts) == "string"
            and { Title = sectionOpts }
            or (sectionOpts or {})

        Window._tabOrder = Window._tabOrder + 1

        -- Icon and title share one horizontal layout. Previously the icon
        -- was centred while the title was bottom-aligned in a full-height
        -- label, which stacked them instead of setting them side by side.
        local header = New("Frame", {
            Name                   = "Section",
            Size                   = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1,
            LayoutOrder            = Window._tabOrder,
            ZIndex                 = 17,
            Parent                 = tabList,
        }, {
            New("UIListLayout", {
                Padding           = UDim.new(0, 6),
                FillDirection     = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                SortOrder         = Enum.SortOrder.LayoutOrder,
            }),
            Pad(10, 0, 5, 0),
        })

        if sectionOpts.Icon then
            local mark = Icons.Render(sectionOpts.Icon, header, 12, theme.TextDim, 18)
            mark.LayoutOrder = 1
        end

        New("TextLabel", {
            Size                   = UDim2.fromOffset(0, 14),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                   = string.upper(sectionOpts.Title or "Section"),
            TextColor3             = theme.TextDim,
            TextSize               = 10,
            Font                   = Enum.Font.GothamBold,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextYAlignment         = Enum.TextYAlignment.Center,
            LayoutOrder            = 2,
            ZIndex                 = 18,
            Parent                 = header,
        })

        local Section = { Title = sectionOpts.Title, Tabs = {}, _header = header }

        function Section:CreateTab(tabOpts)
            local tab = Window:CreateTab(tabOpts)
            table.insert(Section.Tabs, tab)
            tab.Section = Section
            return tab
        end

        -- Collapse hides the tabs but never the active one, so the page
        -- can't be left showing content whose tab has disappeared.
        function Section:SetCollapsed(collapsed)
            Section.Collapsed = collapsed
            for _, tab in ipairs(Section.Tabs) do
                tab.Button.Visible = (not collapsed) or (Window.ActiveTab == tab)
            end
        end

        table.insert(Window.TabSections, Section)
        return Section
    end

    ----------------------------------------------------------------
    -- Tabs
    ----------------------------------------------------------------

    function Window:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        Window._tabOrder = Window._tabOrder + 1
        local order    = Window._tabOrder
        local tabName  = tabOpts.Name or ("Tab " .. order)
        local iconName = tabOpts.Icon or "layers"

        local Tab = { Name = tabName, Sections = {} }

        -- sidebar button
        local btn = New("TextButton", {
            Name                   = tabName,
            Size                   = UDim2.new(1, 0, 0, 38),
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 1,
            AutoButtonColor        = false,
            Text                   = "",
            LayoutOrder            = order,
            ClipsDescendants       = true,
            ZIndex                 = 17,
            Parent                 = tabList,
        }, { Corner(9) })

        -- The active marker lives on the button rather than sliding down a
        -- shared rail: the rail was positioned from AbsolutePosition, which
        -- drifts out of alignment the moment the tab list is scrolled.
        local marker = New("Frame", {
            Name                   = "Marker",
            Size                   = UDim2.fromOffset(3, 0),
            Position               = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundColor3       = theme.Accent,
            BorderSizePixel        = 0,
            ZIndex                 = 19,
            Parent                 = btn,
        }, { Corner(2) })

        local icon = Icons.Render(iconName, btn, 16, theme.TextDim, 18)
        icon.Position    = UDim2.new(0, 13, 0.5, 0)
        icon.AnchorPoint = Vector2.new(0, 0.5)

        local label = New("TextLabel", {
            Size                   = UDim2.new(1, -44, 1, 0),
            Position               = UDim2.fromOffset(38, 0),
            BackgroundTransparency = 1,
            Text                   = tabName,
            TextColor3             = theme.TextDim,
            TextSize               = 13,
            Font                   = Enum.Font.GothamMedium,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextTruncate           = Enum.TextTruncate.AtEnd,
            ZIndex                 = 18,
            Parent                 = btn,
        })

        -- page
        local page = New("ScrollingFrame", {
            Name                   = tabName .. "Page",
            Size                   = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
            ScrollBarThickness     = 3,
            ScrollBarImageColor3   = theme.Border,
            ScrollBarImageTransparency = 0.2,
            CanvasSize             = UDim2.new(),
            AutomaticCanvasSize    = Enum.AutomaticSize.Y,
            ScrollingDirection     = Enum.ScrollingDirection.Y,
            ElasticBehavior        = Enum.ElasticBehavior.WhenScrollable,
            Visible                = false,
            ZIndex                 = 16,
            Parent                 = content,
        }, {
            List(12),
            Pad(18, 24, 18, 16),
        })

        Tab.Page   = page
        Tab.Button = btn
        Tab._order = 0

        local function Activate()
            if Window.ActiveTab == Tab then return end
            local previous = Window.ActiveTab
            Window.ActiveTab = Tab

            for _, other in ipairs(Window.Tabs) do
                local active = (other == Tab)
                Tween(other.Button, {
                    BackgroundTransparency = active and 0.55 or 1,
                }, EASE.Snap)
                Tween(other._label, {
                    TextColor3 = active and theme.Text or theme.TextDim,
                }, EASE.Snap)
                TintIcon(other._icon, active and theme.Accent or theme.TextDim)
                Tween(other._marker, {
                    Size = UDim2.fromOffset(3, active and 20 or 0),
                }, EASE.Glide)
            end

            if previous then
                Tween(previous.Page, { Position = UDim2.fromOffset(-18, 0) }, EASE.Snap)
                task.delay(0.16, function()
                    if Window.ActiveTab ~= previous then previous.Page.Visible = false end
                end)
            end

            page.Visible  = true
            page.Position = UDim2.fromOffset(18, 0)
            Tween(page, { Position = UDim2.fromOffset(0, 0) }, EASE.Glide)
        end

        Tab._label  = label
        Tab._icon   = icon
        Tab._marker = marker
        Tab.Activate = Activate

        btn.MouseEnter:Connect(function()
            if Window.ActiveTab == Tab then return end
            Tween(btn, { BackgroundTransparency = 0.8 }, EASE.Snap)
            Tween(label, { TextColor3 = theme.TextSub }, EASE.Snap)
        end)
        btn.MouseLeave:Connect(function()
            if Window.ActiveTab == Tab then return end
            Tween(btn, { BackgroundTransparency = 1 }, EASE.Snap)
            Tween(label, { TextColor3 = theme.TextDim }, EASE.Snap)
        end)
        btn.MouseButton1Click:Connect(function()
            -- Ripple sat at ZIndex 19, above the icon (18) and label (18), so
            -- every click swept a white disc across them. It belongs behind
            -- the content, not over it.
            Ripple(btn, 17)
            Activate()
        end)

        table.insert(Window.Tabs, Tab)

        ------------------------------------------------------------
        -- Element scaffolding
        ------------------------------------------------------------

        local function NextOrder()
            Tab._order = Tab._order + 1
            return Tab._order
        end

        local function Row(height, parent)
            local row = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, height or 50),
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.25,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 17,
                Parent                 = parent or page,
            }, { Corner(11), Stroke(theme.BorderSoft, 1, 0.45) })
            return row
        end

        -- Optional leading icon. Every element accepts `Icon = "name"`;
        -- when one is present the text block shifts right to make room,
        -- so a tab can mix decorated and plain rows without misaligning.
        -- Pinned to the top of the row, not centred in it. A 0.5 scale
        -- anchor re-centres itself every time the row grows, which is why
        -- the badge slid down the moment a dropdown or colorpicker opened.
        -- Offset from the row's *collapsed* height keeps it beside the name.
        local function RowIcon(row, iconName)
            if not iconName then return 16 end
            local top = math.floor(row.Size.Y.Offset / 2) - 13
            local badge = New("Frame", {
                Size                   = UDim2.fromOffset(26, 26),
                Position               = UDim2.fromOffset(14, top),
                AnchorPoint            = Vector2.new(0, 0),
                BackgroundColor3       = theme.Elevated,
                BackgroundTransparency = 0.25,
                BorderSizePixel        = 0,
                ZIndex                 = 18,
                Parent                 = row,
            }, { Corner(8) })

            local glyph = Icons.Render(iconName, badge, 15, theme.AccentSoft, 19)
            glyph.Position    = UDim2.fromScale(0.5, 0.5)
            glyph.AnchorPoint = Vector2.new(0.5, 0.5)

            row:SetAttribute("HasIcon", true)
            return 50
        end

        -- 16px gutters and a 20px gap between title and description. The
        -- previous 14/17 pairing put the two lines close enough that they
        -- read as one block.
        local function RowText(row, name, description, leftPad)
            leftPad = leftPad or 16
            local hasDesc = description and description ~= ""
            New("TextLabel", {
                Size                   = UDim2.new(1, -leftPad - 134, 0, 16),
                Position               = UDim2.new(0, leftPad, 0.5, hasDesc and -11 or 0),
                AnchorPoint            = Vector2.new(0, 0.5),
                BackgroundTransparency = 1,
                Text                   = name,
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                TextTruncate           = Enum.TextTruncate.AtEnd,
                ZIndex                 = 18,
                Parent                 = row,
            })
            if hasDesc then
                New("TextLabel", {
                    Size                   = UDim2.new(1, -leftPad - 134, 0, 14),
                    Position               = UDim2.new(0, leftPad, 0.5, 10),
                    AnchorPoint            = Vector2.new(0, 0.5),
                    BackgroundTransparency = 1,
                    Text                   = description,
