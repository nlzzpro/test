--==================================================================
--  CUSTOM CURSOR
--  Dot tracks the pointer exactly. Ring trails behind it with
--  frame-rate independent smoothing, so it feels weighted rather
--  than glued on. Only takes over while the pointer is over the UI.
--==================================================================

local Cursor = { Enabled = true, Active = false, Built = false }
Nely.Cursor = Cursor

local function BuildCursor(theme)
    if Cursor.Built then return end
    Cursor.Built = true

    Cursor.Ring = New("Frame", {
        Name                   = "CursorRing",
        Size                   = UDim2.fromOffset(24, 24),
        AnchorPoint            = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Visible                = false,
        ZIndex                 = 990,
        Parent                 = Root,
    }, {
        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
        New("UIStroke", { Color = theme.Accent, Thickness = 1.5, Transparency = 0.25 }),
    })

    Cursor.Dot = New("Frame", {
        Name             = "CursorDot",
        Size             = UDim2.fromOffset(5, 5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.AccentSoft,
        BorderSizePixel  = 0,
        Visible          = false,
        ZIndex           = 991,
        Parent           = Root,
    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    Cursor.Targets  = {}
    Cursor.RingPos  = GetPointer()
    Cursor.Held     = false

    local function PointerInsideAnyTarget(point)
        for _, target in ipairs(Cursor.Targets) do
            if target.Visible then
                local pos, size = target.AbsolutePosition, target.AbsoluteSize
                if point.X >= pos.X and point.X <= pos.X + size.X
               and point.Y >= pos.Y and point.Y <= pos.Y + size.Y then
                    return true
                end
            end
        end
        return false
    end

    local function SetActive(active)
        if Cursor.Active == active then return end
        Cursor.Active = active
        Cursor.Ring.Visible = active
        Cursor.Dot.Visible  = active
        UserInputService.MouseIconEnabled = not active
        if active then
            Cursor.Ring.Size = UDim2.fromOffset(34, 34)
            Tween(Cursor.Ring, { Size = UDim2.fromOffset(24, 24) }, EASE.Pop)
        end
    end

    local moveConn = RunService.RenderStepped:Connect(function(dt)
        if not Cursor.Enabled then
            if Cursor.Active then SetActive(false) end
            return
        end

        local point = GetPointer()

        SetActive(PointerInsideAnyTarget(point))
        if not Cursor.Active then return end

        Cursor.Dot.Position = UDim2.fromOffset(point.X, point.Y)

        -- 1 - e^(-k*dt) keeps the trail identical at 30fps and 240fps
        local alpha = 1 - math.exp(-16 * dt)
        Cursor.RingPos = Cursor.RingPos:Lerp(point, alpha)
        Cursor.Ring.Position = UDim2.fromOffset(Cursor.RingPos.X, Cursor.RingPos.Y)
    end)
    table.insert(Nely.Connections, moveConn)

    local downConn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not Cursor.Active then return end
        Cursor.Held = true
        Tween(Cursor.Ring, { Size = UDim2.fromOffset(16, 16) }, EASE.Pop)
        Tween(Cursor.Dot, { Size = UDim2.fromOffset(8, 8) }, EASE.Pop)
    end)
    table.insert(Nely.Connections, downConn)

    local upConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not Cursor.Held then return end
        Cursor.Held = false
        Tween(Cursor.Ring, { Size = UDim2.fromOffset(24, 24) }, EASE.Pop)
        Tween(Cursor.Dot, { Size = UDim2.fromOffset(5, 5) }, EASE.Pop)
    end)
    table.insert(Nely.Connections, upConn)
end

function Nely:SetCursorEnabled(state)
    Cursor.Enabled = state
    if not state and Cursor.Built then
        Cursor.Ring.Visible = false
        Cursor.Dot.Visible  = false
        Cursor.Active       = false
        UserInputService.MouseIconEnabled = true
    end
end

--==================================================================
--  TOOLTIPS
--
--  One floating card, reused by every hint in the interface. It hangs
--  off Root rather than off the row that owns it: a page is a
--  ScrollingFrame, so a tooltip parented inside one gets clipped at the
--  page edge exactly when it needs to overhang.
--
--  Any element accepts `Info = "text"` and grows a small (i) beside its
--  name. Nothing is positioned until the card has measured itself, so a
--  two-word hint and a three-line one both land correctly.
--==================================================================

local Tip = { Frame = nil, Label = nil, Fade = nil }

local function EnsureTip()
    if Tip.Frame then return end

    Tip.Frame = New("Frame", {
        Name                   = "Tooltip",
        Size                   = UDim2.fromOffset(232, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundColor3       = Nely.Theme.Elevated,
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Visible                = false,
        ZIndex                 = 980,
        Parent                 = Root,
    }, {
        Corner(9),
        Stroke(Nely.Theme.Border, 1, 0.3),
        Pad(8, 8, 11, 11),
    })

    Tip.Label = New("TextLabel", {
        -- Fixed width plus TextWrapped, not AutomaticSize.X: a long hint
        -- on one line would run off the side of the screen.
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text                   = "",
        TextColor3             = Nely.Theme.TextSub,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Top,
        TextWrapped            = true,
        LineHeight             = 1.25,
        ZIndex                 = 981,
        Parent                 = Tip.Frame,
    })
end

local function HideTip()
    if not Tip.Frame then return end
    if Tip.Fade then Tip.Fade:Cancel() end
    Tip.Frame.Visible = false
    Tip.Frame.BackgroundTransparency = 1
    Tip.Label.TextTransparency = 1
end

local function ShowTip(text, anchor)
    EnsureTip()
    local theme = Nely.Theme
    Tip.Frame.BackgroundColor3 = theme.Elevated
    Tip.Label.TextColor3       = theme.TextSub
    local stroke = Tip.Frame:FindFirstChildOfClass("UIStroke")
    if stroke then stroke.Color = theme.Border end

    Tip.Label.Text    = text
    Tip.Frame.Visible = true
    Tip.Frame.BackgroundTransparency = 1
    Tip.Label.TextTransparency = 1

    -- One frame of slack so AutomaticSize has produced a real height
    -- before anything is measured against it.
    task.defer(function()
        if not (Tip.Frame and Tip.Frame.Visible and anchor.Parent) then return end

        local pos  = anchor.AbsolutePosition
        local size = anchor.AbsoluteSize
        local tip  = Tip.Frame.AbsoluteSize
        local view = workspace.CurrentCamera
            and workspace.CurrentCamera.ViewportSize
            or Vector2.new(1280, 720)

        local x = pos.X + size.X / 2 - tip.X / 2
        local y = pos.Y - tip.Y - 8
        -- Above by default, below when there is no room above.
        if y < 8 then y = pos.Y + size.Y + 8 end
        x = math.clamp(x, 8, math.max(8, view.X - tip.X - 8))

        Tip.Frame.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
        Tip.Fade = Tween(Tip.Frame, { BackgroundTransparency = 0.02 }, EASE.Snap)
        Tween(Tip.Label, { TextTransparency = 0 }, EASE.Snap)
    end)
end

local function AttachTooltip(obj, text)
    if not text or text == "" then return end
    obj.MouseEnter:Connect(function() ShowTip(text, obj) end)
    obj.MouseLeave:Connect(HideTip)
end

