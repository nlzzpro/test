    ----------------------------------------------------------------
    -- Search
    --
    -- Walks every element row in every tab. Rows are matched on the text
    -- of their descendant TextLabels rather than a registry, so elements
    -- added later are searchable without registering anything.
    ----------------------------------------------------------------

    if opts.SearchBar ~= false then
        local searchWrap = New("Frame", {
            Name                   = "WindowSearch",
            Size                   = UDim2.new(1, -16, 0, 28),
            Position               = UDim2.fromOffset(8, 8),
            BackgroundColor3       = theme.Surface,
            BackgroundTransparency = 0.25,
            BorderSizePixel        = 0,
            ZIndex                 = 17,
            Parent                 = sidebar,
        }, { Corner(8), Stroke(theme.BorderSoft, 1, 0.5) })

        local sIcon = Icons.Render("search", searchWrap, 12, theme.TextDim, 18)
        sIcon.Position    = UDim2.new(0, 9, 0.5, 0)
        sIcon.AnchorPoint = Vector2.new(0, 0.5)

        local sBox = New("TextBox", {
            Size                   = UDim2.new(1, -32, 1, 0),
            Position               = UDim2.fromOffset(26, 0),
            BackgroundTransparency = 1,
            Text                   = "",
            PlaceholderText        = "Search",
            PlaceholderColor3      = theme.TextDim,
            TextColor3             = theme.Text,
            TextSize               = 12,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            ClearTextOnFocus       = false,
            ZIndex                 = 18,
            Parent                 = searchWrap,
        })

        -- push the tab list down to make room
        tabList.Size     = UDim2.new(1, -14, 1, -58)
        tabList.Position = UDim2.fromOffset(7, 46)

        local function RowText(row)
            local parts = {}
            for _, child in ipairs(row:GetDescendants()) do
                if child:IsA("TextLabel") and child.Text ~= "" then
                    table.insert(parts, child.Text)
                end
            end
            return string.lower(table.concat(parts, " "))
        end

        sBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = string.lower(sBox.Text)

            for _, tab in ipairs(Window.Tabs) do
                for _, row in ipairs(tab.Page:GetChildren()) do
                    if row:IsA("GuiObject") then
                        if query == "" then
                            row.Visible = true
                        else
                            row.Visible = string.find(RowText(row), query, 1, true) ~= nil
                        end
                    end
                end
            end
        end)

        local sStroke = searchWrap:FindFirstChildOfClass("UIStroke")
        sBox.Focused:Connect(function()
            Tween(sStroke, { Color = theme.Accent, Transparency = 0.2 }, EASE.Snap)
            TintIcon(sIcon, theme.Accent)
        end)
        sBox.FocusLost:Connect(function()
            Tween(sStroke, { Color = theme.BorderSoft, Transparency = 0.5 }, EASE.Snap)
            TintIcon(sIcon, theme.TextDim)
        end)
    end

    ----------------------------------------------------------------
    -- Config persistence
    --
    -- Flags are the source of truth, so anything with a flag persists
    -- without registering a save handler. Elements expose :Set, and the
    -- loader calls it, so restoring a value fires its callback exactly
    -- as a user click would — no divergence between the two paths.
    ----------------------------------------------------------------

    local configFolder = opts.Folder or "NelyLib"
    Window.Elements = Window.Elements or {}

    function Window:RegisterElement(flag, element)
        if flag then Window.Elements[flag] = element end
        return element
    end

    function Window:SaveConfig(name)
        if not (writefile and isfolder and makefolder) then return false, "no filesystem" end
        local ok, err = pcall(function()
            if not isfolder(configFolder) then makefolder(configFolder) end

            -- JSONEncode rejects a table holding both string keys and array
            -- entries, so the payload goes under its own key rather than
            -- being splatted alongside __type.
            local plain = {}
            for flag, value in pairs(Nely.Flags) do
                if typeof(value) == "Color3" then
                    plain[flag] = {
                        __type = "Color3",
                        rgb    = { value.R, value.G, value.B },
                    }
                elseif type(value) == "table" then
                    local list = {}
                    for key, on in pairs(value) do
                        if on then table.insert(list, key) end
                    end
                    table.sort(list)
                    plain[flag] = { __type = "set", values = list }
                else
                    plain[flag] = value
                end
            end

            writefile(("%s/%s.json"):format(configFolder, name or "default"),
                game:GetService("HttpService"):JSONEncode(plain))
        end)
        return ok, err
    end

    function Window:LoadConfig(name)
        if not (isfile and readfile) then return false, "no filesystem" end
        local path = ("%s/%s.json"):format(configFolder, name or "default")

        local ok, err = pcall(function()
            if not isfile(path) then return end
            local saved = game:GetService("HttpService"):JSONDecode(readfile(path))

            for flag, value in pairs(saved) do
                local element = Window.Elements[flag]
                if element and element.Set then
                    if type(value) == "table" and value.__type == "Color3" then
                        local rgb = value.rgb or { 1, 1, 1 }
                        element:Set(Color3.new(rgb[1], rgb[2], rgb[3]))
                    elseif type(value) == "table" and value.__type == "set" then
                        element:Set({ CurrentOption = value.values or {} })
                    else
                        element:Set(value)
                    end
                end
            end
        end)
        return ok, err
    end

    function Window:ListConfigs()
        if not listfiles then return {} end
        local names = {}
        pcall(function()
            for _, path in ipairs(listfiles(configFolder)) do
                local name = path:match("([^/\\]+)%.json$")
                if name then table.insert(names, name) end
            end
        end)
        table.sort(names)
        return names
    end

    ----------------------------------------------------------------
    -- Prebuilt home tab
    ----------------------------------------------------------------

    function Window:CreateHomeTab(homeOpts)
        homeOpts = homeOpts or {}
        local Home = Window:CreateTab({
            Name = homeOpts.Name or "Home",
            Icon = homeOpts.Icon or "home",
        })

        Home:CreateProfileCard()

        Home:CreateSection("Server")
        Home:CreateServerCard()

        Home:CreateSection("Friends")
        Home:CreateFriendsCard()

        if homeOpts.DiscordInvite then
            Home:CreateSection("Community")
            Home:CreateDiscordCard({ Invite = homeOpts.DiscordInvite })
        end

        return Home
    end

    ----------------------------------------------------------------
    -- Loading screen
    ----------------------------------------------------------------

    if opts.LoadingEnabled ~= false then
        shell.Visible = false

        local splash = New("Frame", {
            Name             = "Splash",
            Size             = UDim2.fromOffset(300, 120),
            Position         = UDim2.fromScale(0.5, 0.5),
            AnchorPoint      = Vector2.new(0.5, 0.5),
            BackgroundColor3 = theme.Surface,
            BorderSizePixel  = 0,
            ZIndex           = 800,
            Parent           = Root,
        }, { Corner(16), Stroke(theme.Border, 1, 0.35) })
        Shadow(splash, 24, 0.6, 16)

        local mark = New("Frame", {
            Size             = UDim2.fromOffset(38, 38),
            Position         = UDim2.new(0.5, 0, 0, 22),
            AnchorPoint      = Vector2.new(0.5, 0),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel  = 0,
            ZIndex           = 801,
            Parent           = splash,
        }, {
            Corner(11),
            Gradient(ColorSequence.new({
                ColorSequenceKeypoint.new(0, theme.AccentSoft),
                ColorSequenceKeypoint.new(1, theme.AccentDeep),
            }), 135),
        })

        BrandMark(mark, title, opts.Logo, 20, 11, 802)

        New("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 18),
            Position               = UDim2.fromOffset(0, 68),
            BackgroundTransparency = 1,
            Text                   = opts.LoadingTitle or title,
            TextColor3             = theme.Text,
            TextSize               = 14,
            Font                   = Enum.Font.GothamBold,
            ZIndex                 = 801,
            Parent                 = splash,
        })

        local bar = New("Frame", {
            Size             = UDim2.new(1, -60, 0, 3),
            Position         = UDim2.new(0.5, 0, 1, -22),
            AnchorPoint      = Vector2.new(0.5, 0),
            BackgroundColor3 = theme.Elevated,
            BorderSizePixel  = 0,
            ZIndex           = 801,
            Parent           = splash,
        }, { Corner(2) })

        local barFill = New("Frame", {
            Size             = UDim2.fromScale(0, 1),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel  = 0,
            ZIndex           = 802,
            Parent           = bar,
        }, { Corner(2) })

        splash.Size = UDim2.fromOffset(270, 108)
        Tween(splash, { Size = UDim2.fromOffset(300, 120) }, EASE.Pop)
        Tween(Blur, { Size = 10 }, EASE.Glide)
        TweenService:Create(barFill, TweenInfo.new(1.05, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.fromScale(1, 1),
        }):Play()

        task.delay(1.2, function()
            Tween(splash, { Size = UDim2.fromOffset(270, 108), BackgroundTransparency = 1 }, EASE.Smooth)
            task.delay(0.28, function()
                splash:Destroy()
                OpenWindow(true)
            end)
        end)
    else
        OpenWindow(true)
    end

    Nely.Window = Window
    return Window
end

--==================================================================
--  KEY SYSTEM
--
--  Gate a script behind a key. Keys can be a fixed list or fetched from
--  a URL that returns the key as plain text. Saves on success so the
--  prompt only appears once per machine.
--
--  Worth being clear about what this is: client-side gating. Anyone who
--  can read the script can read past it. It's for distribution control,
--  not security — treat it that way.
--==================================================================

function Nely:KeySystem(opts)
    opts = opts or {}
    local theme    = Nely.Theme
    local title    = opts.Title or "Key required"
    local note     = opts.Note or "Enter your key to continue."
    local saveFile = opts.SaveKey ~= false and ((opts.Folder or "NelyLib") .. "/key.txt") or nil
    local resolved = false
    local granted  = false

    local function Accepts(candidate)
        if opts.Keys then
            for _, key in ipairs(opts.Keys) do
                if candidate == key then return true end
            end
        end
        if opts.KeyUrl then
            local ok, remote = pcall(function() return game:HttpGet(opts.KeyUrl) end)
            if ok and remote then
                return candidate == (remote:gsub("%s+$", ""):gsub("^%s+", ""))
            end
        end
        return false
    end

    -- an already-saved key skips the prompt entirely
    if saveFile and isfile and readfile then
        local ok, saved = pcall(function()
            return isfile(saveFile) and readfile(saveFile) or nil
        end)
        if ok and saved and Accepts(saved) then
            return true
        end
    end

    local overlay = New("Frame", {
        Name                   = "KeyOverlay",
        Size                   = UDim2.fromScale(1, 1),
        BackgroundColor3       = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ZIndex                 = 900,
        Parent                 = Root,
    })

    local card = New("Frame", {
        Size             = UDim2.fromOffset(320, 0),
        Position         = UDim2.fromScale(0.5, 0.5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.SurfaceAlt,
        BorderSizePixel  = 0,
        ZIndex           = 902,
        Parent           = overlay,
    }, { Corner(16), Stroke(theme.Border, 1, 0.35), Pad(20, 18, 20, 20), List(0) })

    local iconWrap = New("Frame", {
        Size                   = UDim2.fromOffset(42, 42),
        BackgroundColor3       = theme.Accent,
        BackgroundTransparency = 0.86,
        BorderSizePixel        = 0,
        LayoutOrder            = 1,
        ZIndex                 = 903,
        Parent                 = card,
    }, { Corner(12) })
    local kIcon = Icons.Render("key", iconWrap, 22, theme.Accent, 904)
    kIcon.Position    = UDim2.fromScale(0.5, 0.5)
    kIcon.AnchorPoint = Vector2.new(0.5, 0.5)

    New("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
        LayoutOrder = 2, ZIndex = 903, Parent = card })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = theme.Text,
        TextSize               = 17,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        LayoutOrder            = 3,
        ZIndex                 = 903,
        Parent                 = card,
    })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text                   = note,
        TextColor3             = theme.TextSub,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Top,
        TextWrapped            = true,
        LineHeight             = 1.25,
        LayoutOrder            = 4,
        ZIndex                 = 903,
        Parent                 = card,
    })

    New("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
        LayoutOrder = 5, ZIndex = 903, Parent = card })

    local field = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = theme.Elevated,
        BorderSizePixel  = 0,
        LayoutOrder      = 6,
        ZIndex           = 903,
        Parent           = card,
    }, { Corner(9), Stroke(theme.Border, 1, 0.5) })

    local box = New("TextBox", {
        Size                   = UDim2.new(1, -20, 1, 0),
        Position               = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text                   = "",
        PlaceholderText        = opts.Placeholder or "Paste your key",
        PlaceholderColor3      = theme.TextDim,
        TextColor3             = theme.Text,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ClearTextOnFocus       = false,
        ZIndex                 = 904,
        Parent                 = field,
    })

    New("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1,
        LayoutOrder = 7, ZIndex = 903, Parent = card })

    local row = New("Frame", {
        Size                   = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        LayoutOrder            = 8,
        ZIndex                 = 903,
        Parent                 = card,
    }, {
        New("UIListLayout", {
            Padding       = UDim.new(0, 8),
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder     = Enum.SortOrder.LayoutOrder,
        }),
    })

    local function MakeButton(text, primary, order)
        local btn = New("TextButton", {
            Size             = UDim2.new(opts.GetKeyUrl and 0.5 or 1, -4, 1, 0),
            BackgroundColor3 = primary and theme.Accent or theme.Elevated,
            AutoButtonColor  = false,
            Text             = text,
            TextColor3       = primary and Color3.new(1, 1, 1) or theme.TextSub,
            TextSize         = 13,
            Font             = Enum.Font.GothamBold,
            LayoutOrder      = order,
            ZIndex           = 904,
            Parent           = row,
        }, { Corner(9) })
        return btn
    end

    if opts.GetKeyUrl then
        local getBtn = MakeButton("Get key", false, 1)
        getBtn.MouseButton1Click:Connect(function()
            local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
            if copy then
                copy(opts.GetKeyUrl)
                getBtn.Text = "Link copied"
                task.delay(2, function() getBtn.Text = "Get key" end)
            end
        end)
    end

    local submitBtn = MakeButton("Unlock", true, 2)

    local fieldStroke = field:FindFirstChildOfClass("UIStroke")

    local function Submit()
        local candidate = (box.Text or ""):gsub("%s+$", ""):gsub("^%s+", "")
        if candidate == "" then return end

        if Accepts(candidate) then
            granted = true
            if saveFile and writefile and isfolder and makefolder then
                pcall(function()
                    local folder = opts.Folder or "NelyLib"
                    if not isfolder(folder) then makefolder(folder) end
                    writefile(saveFile, candidate)
                end)
            end
            Tween(fieldStroke, { Color = theme.Success, Transparency = 0.1 }, EASE.Snap)
            Tween(overlay, { BackgroundTransparency = 1 }, EASE.Smooth)
            Tween(card, { Size = UDim2.fromOffset(300, 0) }, EASE.Smooth)
            task.delay(0.3, function() overlay:Destroy() end)
            resolved = true
        else
            Tween(fieldStroke, { Color = theme.Danger, Transparency = 0.1 }, EASE.Snap)
            local origin = card.Position
            for offset = 1, 3 do
                Tween(card, { Position = origin + UDim2.fromOffset(6, 0) }, EASE.Instant)
                task.wait(0.05)
                Tween(card, { Position = origin - UDim2.fromOffset(6, 0) }, EASE.Instant)
                task.wait(0.05)
            end
            Tween(card, { Position = origin }, EASE.Instant)
            task.delay(1.2, function()
                Tween(fieldStroke, { Color = theme.Border, Transparency = 0.5 }, EASE.Snap)
            end)
        end
    end

    submitBtn.MouseButton1Click:Connect(Submit)
    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then Submit() end
    end)

    card.Size = UDim2.fromOffset(300, 0)
    Tween(overlay, { BackgroundTransparency = 0.4 }, EASE.Smooth)
    Tween(card, { Size = UDim2.fromOffset(320, 0) }, EASE.Pop)
    Tween(Blur, { Size = 12 }, EASE.Glide)

    repeat task.wait(0.1) until resolved
    return granted
end

--==================================================================
--  GLOBAL API
--==================================================================

function Nely:SetTheme(name)
    local newTheme = Nely.Themes[name]
    if not newTheme then return false end
    local oldTheme = Nely.Theme
    if newTheme == oldTheme then return true end

    -- Every colour already painted came from a slot in the old theme, so a
    -- reverse lookup on the old palette tells us which slot any given colour
    -- belongs to. That means no element has to register itself up front.
    local function Key(color)
        return ("%d|%d|%d"):format(
            math.round(color.R * 255),
            math.round(color.G * 255),
            math.round(color.B * 255)
        )
    end

    local slotOf = {}
    for slot, color in pairs(oldTheme) do
        slotOf[Key(color)] = slot
    end

    local function Translate(color)
        local slot = slotOf[Key(color)]
        return slot and newTheme[slot] or nil
    end

    local function Swap(inst, prop)
        local swapped = Translate(inst[prop])
        if swapped then inst[prop] = swapped end
    end

    for _, inst in ipairs(Root:GetDescendants()) do
        if inst:IsA("GuiObject") then
            Swap(inst, "BackgroundColor3")
        end
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            Swap(inst, "TextColor3")
        end
        if inst:IsA("TextBox") then
            Swap(inst, "PlaceholderColor3")
        end
        if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
            Swap(inst, "ImageColor3")
        end
        if inst:IsA("ScrollingFrame") then
            Swap(inst, "ScrollBarImageColor3")
        end
        if inst:IsA("UIStroke") then
            Swap(inst, "Color")
        end
        if inst:IsA("UIGradient") then
            local points, changed = {}, false
            for _, keypoint in ipairs(inst.Color.Keypoints) do
                local swapped = Translate(keypoint.Value)
                if swapped then changed = true end
                table.insert(points,
                    ColorSequenceKeypoint.new(keypoint.Time, swapped or keypoint.Value))
            end
            if changed then inst.Color = ColorSequence.new(points) end
        end
    end

    Nely.Theme = newTheme
    return true
end

function Nely:Destroy()
    if Nely.Window then Nely.Window:Destroy() end
end

return Nely
