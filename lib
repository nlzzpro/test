--  WINDOW
--==================================================================

function Nely:CreateWindow(opts)
    opts = opts or {}
    local theme = Nely.Themes[opts.Theme or "Cobalt"] or Nely.Themes.Cobalt
    Nely.Theme = theme

    local title     = opts.Title     or "Nely Hub"
    local subtitle  = opts.Subtitle  or ""
    local toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift

    ----------------------------------------------------------------
    -- Responsive sizing
    --
    -- A fixed 660x470 is fine on a desktop monitor and enormous on a
    -- phone, where it can exceed the screen. Size is derived from the
    -- viewport instead, then clamped, so the same script is usable on
    -- both without a separate mobile build.
    ----------------------------------------------------------------

    local viewport = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize
        or Vector2.new(1280, 720)

    local compact = viewport.X < 700 or UserInputService.TouchEnabled

    local function Fit(fraction, low, high, axis)
        return math.floor(math.clamp(axis * fraction, low, high))
    end

    -- Deliberately smaller than the last build. Rows grew at the same
    -- time, so a tab holding two elements now fills its page instead of
    -- leaving a dead area below them.
    local winSize = opts.Size or UDim2.fromOffset(
        Fit(compact and 0.92 or 0.40, 310, 560, viewport.X),
        Fit(compact and 0.68 or 0.54, 280, 410, viewport.Y)
    )

    local sidebarW = opts.SidebarWidth or (compact and 118 or 146)
    local topbarH  = compact and 42 or 46

    -- Rows are taller on desktop than the previous build. Paired with the
    -- smaller window above, a tab with one or two elements now reads as
    -- full rather than mostly empty.
    --
    -- Density = "compact" trades that breathing room for reach: a settings
    -- page with twenty rows stops needing three screens of scrolling. The
    -- rows keep their internals, they just lose vertical padding.
    local dense  = opts.Density == "compact"
    local ROW_H  = dense and (compact and 42 or 46) or (compact and 50 or 56)
    local ROW_HD = dense and (compact and 54 or 60) or (compact and 62 or 70)

    local Window = {
        Tabs        = {},
        ActiveTab   = nil,
        Minimized   = false,
        Destroyed   = false,
        CurrentSize = winSize,
        Compact     = compact,
        Dense       = dense,
        TabSections = {},
        _tabOrder   = 0,
        _dependents = {},
    }

    -- Called by any flagged toggle after it settles, so rows that declared
    -- `Depends = "ThatFlag"` grey themselves out without polling.
    function Window:_Sync(flag, value)
        local list = Window._dependents[flag]
        if not list then return end
        for _, entry in ipairs(list) do
            local want = value and true or false
            if entry.invert then want = not want end
            if entry.api and entry.api.SetEnabled then
                entry.api:SetEnabled(want)
            end
        end
    end

    local minSize = opts.MinSize or Vector2.new(
        math.min(compact and 300 or 480, winSize.X.Offset),
        math.min(compact and 260 or 340, winSize.Y.Offset)
    )
    local maxSize = opts.MaxSize or Vector2.new(
        math.max(math.floor(viewport.X * 0.96), winSize.X.Offset),
        math.max(math.floor(viewport.Y * 0.92), winSize.Y.Offset)
    )

    ----------------------------------------------------------------
    -- Shell
    ----------------------------------------------------------------

    local shell = New("Frame", {
        Name             = "Window",
        Size             = winSize,
        Position         = UDim2.fromScale(0.5, 0.5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Backdrop,
        BackgroundTransparency = opts.Transparent == false and 0 or 0.04,
        BorderSizePixel  = 0,
        -- must stay false: the shadow lives inside the shell and would be clipped away.
        -- the content frame does its own clipping for page transitions.
        ClipsDescendants = false,
        ZIndex           = 10,
        Parent           = Root,
    }, {
        Corner(16),
        Stroke(theme.Border, 1, 0.3),
    })
    Shadow(shell, 30, 0.65, 16)
    Window.Frame = shell

    -- Ambient accent wash behind everything
    New("Frame", {
        Size                   = UDim2.fromScale(1, 1),
        BackgroundColor3       = theme.Accent,
        BackgroundTransparency = 0.955,
        BorderSizePixel        = 0,
        ZIndex                 = 10,
        Parent                 = shell,
    }, {
        Corner(16),
        Gradient(ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Accent),
            ColorSequenceKeypoint.new(0.55, theme.Backdrop),
            ColorSequenceKeypoint.new(1, theme.Backdrop),
        }), 145),
    })

    ----------------------------------------------------------------
    -- Topbar
    ----------------------------------------------------------------

    local topbar = New("Frame", {
        Name                   = "Topbar",
        Size                   = UDim2.new(1, 0, 0, topbarH),
        BackgroundTransparency = 1,
        ZIndex                 = 20,
        Parent                 = shell,
    })

    New("Frame", {
        Size             = UDim2.new(1, -32, 0, 1),
        Position         = UDim2.new(0, 16, 1, 0),
        BackgroundColor3 = theme.BorderSoft,
        BorderSizePixel  = 0,
        ZIndex           = 20,
        Parent           = topbar,
    })

    -- Logo mark
    local logo = New("Frame", {
        Size             = UDim2.fromOffset(26, 26),
        Position         = UDim2.new(0, 16, 0.5, 0),
        AnchorPoint      = Vector2.new(0, 0.5),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel  = 0,
        ZIndex           = 21,
        Parent           = topbar,
    }, {
        Corner(8),
        Gradient(ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.AccentSoft),
            ColorSequenceKeypoint.new(1, theme.AccentDeep),
        }), 135),
    })

    BrandMark(logo, title, opts.Logo, 15, 8, 22)

    New("TextLabel", {
        Name                   = "Title",
        Size                   = UDim2.fromOffset(220, 16),
        Position               = UDim2.new(0, 52, 0.5, subtitle ~= "" and -8 or 0),
        AnchorPoint            = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = theme.Text,
        TextSize               = 15,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 21,
        Parent                 = topbar,
    })

    if subtitle ~= "" then
        New("TextLabel", {
            Size                   = UDim2.fromOffset(240, 14),
            Position               = UDim2.new(0, 52, 0.5, 9),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Text                   = subtitle,
            TextColor3             = theme.TextDim,
            TextSize               = 11,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            ZIndex                 = 21,
            Parent                 = topbar,
        })
    end

    ----------------------------------------------------------------
    -- Current-game badge
    --
    -- Sits beside the hub name so you can see at a glance which place
    -- the script is running in. The name comes from MarketplaceService
    -- and the thumbnail from the same universe resolver the game grid
    -- uses, so this costs one lookup that is already cached.
    --
    -- It lives on the LEFT, immediately after the title, separated by a
    -- hairline. That is where the free width is: the right-hand side has
    -- to share with the credit pill and three window controls, which is
    -- what was squeezing long place names down to an ellipsis.
    -- GameBadge = "right" puts it back beside the credit.
    ----------------------------------------------------------------

    -- CONTROLS_W has to clear every window control. Three 28px buttons at
    -- -14 / -48 / -82 means the leftmost one ends at -110, so anything that
    -- starts at -88 lands underneath the rail button. That was the credit
    -- pill sitting on top of the collapse button.
    local CONTROLS_W  = 122
    local badgeOnLeft = opts.GameBadge ~= "right"

    -- Right rail: the credit pill, and the game badge too when it has been
    -- sent back over here. Laid out on one line and right-aligned so neither
    -- has to know how wide the other is.
    local topbarRight = New("Frame", {
        Name                   = "TopbarRight",
        Size                   = UDim2.fromOffset(0, 24),
        Position               = UDim2.new(1, -CONTROLS_W, 0.5, 0),
        AnchorPoint            = Vector2.new(1, 0.5),
        AutomaticSize          = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex                 = 21,
        Parent                 = topbar,
    }, {
        New("UIListLayout", {
            Padding             = UDim.new(0, 10),
            FillDirection       = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment   = Enum.VerticalAlignment.Center,
            SortOrder           = Enum.SortOrder.LayoutOrder,
        }),
    })

    -- Forward declarations: the badge measures itself against whatever else
    -- ends up on the topbar, and both of those are built further down.
    local creditPill
    local topbarSearch
    local FitGameBadge = function() end

    -- Where the title block ends, so the badge and the divider know where
    -- to start. Measured rather than guessed, because the fixed 220px title
    -- label is a container, not the width of the text inside it.
    local function TitleBlockEnd()
        local titleW = TextService:GetTextSize(
            title, 15, Enum.Font.GothamBold, Vector2.new(9999, 40)).X
        local subW = subtitle ~= "" and TextService:GetTextSize(
            subtitle, 11, Enum.Font.Gotham, Vector2.new(9999, 40)).X or 0
        return 52 + math.max(titleW, subW)
    end

    if opts.ShowGame ~= false then
        local divider
        if badgeOnLeft then
            divider = New("Frame", {
                Name             = "TopbarDivider",
                Size             = UDim2.fromOffset(1, 20),
                Position         = UDim2.new(0, TitleBlockEnd() + 16, 0.5, 0),
                AnchorPoint      = Vector2.new(0, 0.5),
                BackgroundColor3 = theme.BorderSoft,
                BorderSizePixel  = 0,
                Visible          = false,
                ZIndex           = 21,
                Parent           = topbar,
            })
        end

        local badge = New("Frame", {
            Name                   = "GameBadge",
            Size                   = UDim2.fromOffset(0, 24),
            Position               = badgeOnLeft
                and UDim2.new(0, TitleBlockEnd() + 33, 0.5, 0) or nil,
            AnchorPoint            = badgeOnLeft and Vector2.new(0, 0.5) or nil,
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 0.3,
            BorderSizePixel        = 0,
            Visible                = false,
            LayoutOrder            = 1,
            ZIndex                 = 21,
            Parent                 = badgeOnLeft and topbar or topbarRight,
        }, { Corner(7), Stroke(theme.BorderSoft, 1, 0.5), Pad(0, 0, 5, 9) })

        local thumb = New("ImageLabel", {
            Size                   = UDim2.fromOffset(16, 16),
            Position               = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundColor3       = theme.SurfaceAlt,
            BackgroundTransparency = 0.4,
            BorderSizePixel        = 0,
            ScaleType              = Enum.ScaleType.Crop,
            ZIndex                 = 22,
            Parent                 = badge,
        }, { Corner(5) })

        local nameLabel = New("TextLabel", {
            Size                   = UDim2.fromOffset(0, 24),
            Position               = UDim2.fromOffset(21, 0),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                   = "",
            TextColor3             = theme.TextSub,
            TextSize               = 11,
            Font                   = Enum.Font.GothamMedium,
            TextXAlignment         = Enum.TextXAlignment.Left,
            ZIndex                 = 22,
            Parent                 = badge,
        })

        Window.GameBadge = badge

        ------------------------------------------------------------
        -- Fitting the place name
        --
        -- This used to cut at a fixed character count, which is why a
        -- long game name came out as three dots however much room the
        -- window actually had. Now it measures: everything else on the
        -- topbar reports its own width, the badge takes what is left,
        -- and it only ellipsises when the text genuinely does not fit.
        -- Recomputed whenever the window is resized.
        ------------------------------------------------------------

        local fullName   = ""
        local lastFitted = nil

        local function Measure(text, size, font)
            return TextService:GetTextSize(
                text, size, font, Vector2.new(9999, 40)
            ).X
        end

        FitGameBadge = function()
            if fullName == "" then return end

            local total = topbar.AbsoluteSize.X
            if total <= 0 then return end

            local leftEdge, rightEdge

            if badgeOnLeft then
                -- Runs from just past the title to whatever claims the middle
                -- of the bar first: the topbar search, or the right-hand rail.
                leftEdge = TitleBlockEnd() + 33
                if topbarSearch and topbarSearch.Visible then
                    rightEdge = (topbarSearch.AbsolutePosition.X
                              - topbar.AbsolutePosition.X) - 14
                else
                    rightEdge = total - CONTROLS_W - 12
                    if creditPill and creditPill.Visible then
                        rightEdge = rightEdge - creditPill.AbsoluteSize.X - 10
                    end
                end
            else
                if topbarSearch and topbarSearch.Visible then
                    leftEdge = (topbarSearch.AbsolutePosition.X
                             - topbar.AbsolutePosition.X)
                             + topbarSearch.AbsoluteSize.X + 14
                else
                    leftEdge = TitleBlockEnd() + 18
                end
                rightEdge = total - CONTROLS_W
                if creditPill and creditPill.Visible then
                    rightEdge = rightEdge - creditPill.AbsoluteSize.X - 10
                end
            end

            -- 21px thumbnail column + 14px of padding inside the pill.
            local room = (rightEdge - leftEdge) - 35

            if room < 46 then
                badge.Visible = false
                if divider then divider.Visible = false end
                return
            end

            local fitted = fullName
            if Measure(fitted, 11, Enum.Font.GothamMedium) > room then
                -- Shrink from the end. Place names are short enough that a
                -- linear walk costs less than the setup for a binary search.
                local n = #fullName
                while n > 1 do
                    local try = string.sub(fullName, 1, n) .. "\u{2026}"
                    if Measure(try, 11, Enum.Font.GothamMedium) <= room then
                        fitted = try
                        break
                    end
                    n = n - 1
                end
                if n <= 1 then fitted = "\u{2026}" end
            end

            badge.Visible = true
            if divider then divider.Visible = true end
            if fitted ~= lastFitted then
                lastFitted     = fitted
                nameLabel.Text = fitted
            end
        end

        topbar:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            FitGameBadge()
        end)

        task.spawn(function()
            local ok, info = pcall(function()
                return game:GetService("MarketplaceService")
                    :GetProductInfo(game.PlaceId)
            end)
            local placeName = (ok and info and info.Name) or subtitle
            if placeName == "" or not placeName then return end

            fullName = placeName
            AttachTooltip(badge, placeName)
            FitGameBadge()
            task.defer(FitGameBadge)

            ResolveGameImage({ PlaceId = game.PlaceId }, function(asset)
                if asset and badge.Parent then thumb.Image = asset end
            end)
        end)
    end

    -- Window controls
    local function ControlButton(iconName, xOffset, hoverColor)
        local btn = New("TextButton", {
            Size                   = UDim2.fromOffset(28, 28),
            Position               = UDim2.new(1, xOffset, 0.5, 0),
            AnchorPoint            = Vector2.new(1, 0.5),
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 1,
            AutoButtonColor        = false,
            Text                   = "",
            ZIndex                 = 22,
            Parent                 = topbar,
        }, { Corner(8) })

        local icon = Icons.Render(iconName, btn, 14, theme.TextSub, 23)
        icon.Position    = UDim2.fromScale(0.5, 0.5)
        icon.AnchorPoint = Vector2.new(0.5, 0.5)

        btn.MouseEnter:Connect(function()
            Tween(btn, { BackgroundTransparency = 0.15 }, EASE.Snap)
            TintIcon(icon, hoverColor or theme.Text)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, { BackgroundTransparency = 1 }, EASE.Snap)
            TintIcon(icon, theme.TextSub)
        end)
        return btn
    end

    local closeBtn = ControlButton("close", -14, theme.Danger)
    local minBtn   = ControlButton("minimize", -48, theme.Warning)
    local railBtn  = ControlButton("grid", -82, theme.Accent)
    AttachTooltip(railBtn, "Collapse the sidebar to icons")

    -- CONTROLS_W above has to stay in step with the leftmost button here.

    ----------------------------------------------------------------
    -- Credit pill
    ----------------------------------------------------------------

    if opts.Credit then
        local credit = New("TextButton", {
            Name                   = "Credit",
            Size                   = UDim2.fromOffset(0, 24),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 0.35,
            AutoButtonColor        = false,
            Text                   = "",
            LayoutOrder            = 2,
            ZIndex                 = 22,
            Parent                 = topbarRight,
        }, { Corner(7), Pad(0, 0, 8, 9) })

        creditPill = credit
        credit:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            FitGameBadge()
        end)

        local creditIcon = Icons.Render("github", credit, 12, theme.TextDim, 23)
        creditIcon.Position    = UDim2.new(0, 0, 0.5, 0)
        creditIcon.AnchorPoint = Vector2.new(0, 0.5)

        local creditLabel = New("TextLabel", {
            Size                   = UDim2.fromOffset(0, 22),
            Position               = UDim2.fromOffset(17, 0),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                   = opts.Credit,
            TextColor3             = theme.TextDim,
            TextSize               = 11,
            Font                   = Enum.Font.GothamMedium,
            ZIndex                 = 23,
            Parent                 = credit,
        })

        credit.MouseEnter:Connect(function()
            Tween(credit, { BackgroundTransparency = 0.1 }, EASE.Snap)
            Tween(creditLabel, { TextColor3 = theme.Text }, EASE.Snap)
            TintIcon(creditIcon, theme.Accent)
        end)
        credit.MouseLeave:Connect(function()
            Tween(credit, { BackgroundTransparency = 0.35 }, EASE.Snap)
            Tween(creditLabel, { TextColor3 = theme.TextDim }, EASE.Snap)
            TintIcon(creditIcon, theme.TextDim)
        end)
        credit.MouseButton1Click:Connect(function()
            Ripple(credit, 24)
            local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
            local url  = opts.CreditUrl
                or ("https://github.com/" .. opts.Credit:gsub("^@", ""))
            if copy then
                copy(url)
                Nely:Notify({
                    Title   = "Copied",
                    Content = url,
                    Icon    = "github",
                    Color   = theme.Success,
                })
            end
        end)
    end

    ----------------------------------------------------------------
    -- Sidebar
    ----------------------------------------------------------------

    local sidebar = New("Frame", {
        Name                   = "Sidebar",
        Size                   = UDim2.new(0, sidebarW, 1, -topbarH),
        Position               = UDim2.fromOffset(0, topbarH),
        BackgroundTransparency = 1,
        ZIndex                 = 15,
        Parent                 = shell,
    })

    New("Frame", {
        Size             = UDim2.new(0, 1, 1, -24),
        Position         = UDim2.new(1, 0, 0, 12),
        BackgroundColor3 = theme.BorderSoft,
        BorderSizePixel  = 0,
        ZIndex           = 15,
        Parent           = sidebar,
    })

    -- Tabs scroll. A fixed Frame silently clipped tabs past the sixth
    -- once a hub had enough of them; this scrolls and grows its own
    -- canvas from the layout, so any number of tabs stays reachable.
    local tabList = New("ScrollingFrame", {
        Name                   = "Tabs",
        Size                   = UDim2.new(1, -14, 1, -20),
        Position               = UDim2.fromOffset(7, 10),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ScrollBarThickness     = 2,
        ScrollBarImageColor3   = theme.Border,
        ScrollBarImageTransparency = 0.4,
        CanvasSize             = UDim2.new(),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        ScrollingDirection     = Enum.ScrollingDirection.Y,
        ElasticBehavior        = Enum.ElasticBehavior.WhenScrollable,
        ZIndex                 = 16,
        Parent                 = sidebar,
    }, { List(6), Pad(0, 10, 0, 0) })

    ----------------------------------------------------------------
    -- Player card
    --
    -- Anchored to the bottom of the sidebar: headshot, display name and
    -- @username. It survives the rail by dropping to just the avatar,
    -- which is the one part still recognisable at 58px wide.
    --
    -- The headshot comes from rbxthumb://, so it needs no HTTP call and
    -- no executor support — Roblox resolves it internally.
    ----------------------------------------------------------------

    local PLAYER_CARD_H = 62
    local playerCard, playerAvatar, playerName, playerSub

    if opts.PlayerCard ~= false then
        local me = Players.LocalPlayer

        playerCard = New("TextButton", {
            Name                   = "PlayerCard",
            Size                   = UDim2.new(1, -14, 0, 46),
            Position               = UDim2.new(0, 7, 1, -10),
            AnchorPoint            = Vector2.new(0, 1),
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 0.45,
            AutoButtonColor        = false,
            Text                   = "",
            ZIndex                 = 17,
            Parent                 = sidebar,
        }, { Corner(11), Stroke(theme.BorderSoft, 1, 0.55) })

        -- Hairline above the card so it reads as a separate zone from
        -- the tab list rather than another tab.
        New("Frame", {
            Size             = UDim2.new(1, -20, 0, 1),
            Position         = UDim2.new(0, 10, 1, -PLAYER_CARD_H - 2),
            AnchorPoint      = Vector2.new(0, 1),
            BackgroundColor3 = theme.BorderSoft,
            BackgroundTransparency = 0.35,
            BorderSizePixel  = 0,
            ZIndex           = 16,
            Parent           = sidebar,
        })

        playerAvatar = New("ImageLabel", {
            Size                   = UDim2.fromOffset(30, 30),
            Position               = UDim2.new(0, 8, 0.5, 0),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundColor3       = theme.SurfaceAlt,
            BackgroundTransparency = 0.25,
            BorderSizePixel        = 0,
            Image                  = ("rbxthumb://type=AvatarHeadShot&id=%d&w=60&h=60")
                                       :format(me and me.UserId or 1),
            ScaleType              = Enum.ScaleType.Crop,
            ZIndex                 = 18,
            Parent                 = playerCard,
        }, { Corner(9), Stroke(theme.Accent, 1, 0.55) })

        playerName = New("TextLabel", {
            Size                   = UDim2.new(1, -50, 0, 13),
            Position               = UDim2.new(0, 46, 0.5, -7),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Text                   = me and me.DisplayName or "Player",
            TextColor3             = theme.Text,
            TextSize               = 12,
            Font                   = Enum.Font.GothamMedium,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextTruncate           = Enum.TextTruncate.AtEnd,
            ZIndex                 = 18,
            Parent                 = playerCard,
        })

        playerSub = New("TextLabel", {
            Size                   = UDim2.new(1, -50, 0, 12),
            Position               = UDim2.new(0, 46, 0.5, 8),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Text                   = "@" .. (me and me.Name or "player"),
            TextColor3             = theme.TextDim,
            TextSize               = 10,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextTruncate           = Enum.TextTruncate.AtEnd,
            ZIndex                 = 18,
            Parent                 = playerCard,
        })

        local exec = "unknown executor"
        pcall(function()
            if identifyexecutor then exec = (identifyexecutor()) end
        end)

        AttachTooltip(playerCard, ("%s  ·  uid %d  ·  %s")
            :format(me and me.Name or "player", me and me.UserId or 0, exec))

        playerCard.MouseEnter:Connect(function()
            Tween(playerCard, { BackgroundTransparency = 0.2 }, EASE.Snap)
        end)
        playerCard.MouseLeave:Connect(function()
            Tween(playerCard, { BackgroundTransparency = 0.45 }, EASE.Snap)
        end)
        playerCard.MouseButton1Click:Connect(function()
            -- ZIndex 17, so the ripple sweeps behind the avatar and the
            -- name labels (18) instead of washing over them.
            Ripple(playerCard, 17)
            local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
            if copy and me then
                copy(me.Name)
                Nely:Notify({
                    Title   = "Copied username",
                    Content = me.Name,
                    Icon    = "user",
                    Color   = theme.Success,
                })
            end
        end)
    end

    ----------------------------------------------------------------
    -- Content host
    ----------------------------------------------------------------

    local content = New("Frame", {
        Name                   = "Content",
        Size                   = UDim2.new(1, -sidebarW, 1, -topbarH),
        Position               = UDim2.fromOffset(sidebarW, topbarH),
        BackgroundTransparency = 1,
        ClipsDescendants       = true,
        ZIndex                 = 15,
        Parent                 = shell,
    })

    ----------------------------------------------------------------
    -- Sidebar rail
    --
    -- Collapses the sidebar down to its icons and gives the page the
    -- reclaimed width. Tab names move into tooltips rather than being
    -- dropped, so a railed sidebar is still navigable by someone who
    -- doesn't recognise every glyph yet.
    ----------------------------------------------------------------

    local RAIL_W  = 58
    local railed  = false
    local searchWrap                       -- assigned by the search block below

    -- One place that owns the tab list's geometry. Three things want to move
    -- it — the sidebar search, the player card, and the rail — and when each
    -- of them set it directly the last one to run won.
    local function LayoutTabList()
        local top    = (searchWrap and searchWrap.Visible) and 46 or 10
        local bottom = playerCard and (PLAYER_CARD_H + 4) or 10
        tabList.Position = UDim2.fromOffset(7, top)
        tabList.Size     = UDim2.new(1, -14, 1, -(top + bottom))
    end

    local function ApplyRail(state, animate)
        railed = state and true or false
        Window.Railed = railed
        local width = railed and RAIL_W or sidebarW
        local ease  = animate == false and EASE.Instant or EASE.Glide

        Tween(sidebar, { Size = UDim2.new(0, width, 1, -topbarH) }, ease)
        Tween(content, {
            Size     = UDim2.new(1, -width, 1, -topbarH),
            Position = UDim2.new(0, width, 0, topbarH),
        }, ease)

        for _, tab in ipairs(Window.Tabs) do
            if tab._label then
                Tween(tab._label, { TextTransparency = railed and 1 or 0 }, EASE.Snap)
                tab._label.Active = not railed
            end
            if tab._icon then
                -- 44px of usable button width inside the rail, 16px glyph.
                Tween(tab._icon, {
                    Position = UDim2.new(0, railed and 14 or 13, 0.5, 0),
                }, ease)
            end
        end

        for _, section in ipairs(Window.TabSections) do
            local header = section._header
            if header then
                local lbl = header:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.Visible = not railed end
                local pad = header:FindFirstChildOfClass("UIPadding")
                if pad then
                    pad.PaddingLeft = UDim.new(0, railed and 16 or 5)
                end
            end
        end

        -- The sidebar search box has nowhere to go at 58px wide, so it
        -- steps aside and the tab list takes back the space.
        if searchWrap then
            searchWrap.Visible = not railed
        end

        -- The player card keeps its avatar and drops the text, so the rail
        -- still shows you who you are logged in as.
        if playerCard then
            Tween(playerCard, {
                Size = railed and UDim2.new(1, -14, 0, 44)
                              or  UDim2.new(1, -14, 0, 46),
            }, ease)
            Tween(playerAvatar, {
                Position = UDim2.new(0, railed and 7 or 8, 0.5, 0),
            }, ease)
            Tween(playerName, { TextTransparency = railed and 1 or 0 }, EASE.Snap)
            Tween(playerSub,  { TextTransparency = railed and 1 or 0 }, EASE.Snap)
        end

        LayoutTabList()
    end

    Window.Railed = false
    LayoutTabList()   -- SearchBar = false never reaches the search block

    function Window:SetRail(state)
        ApplyRail(state, true)
    end
    function Window:ToggleRail()
