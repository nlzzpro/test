            Name             = "Palette",
            Size             = UDim2.fromOffset(520, 60),
            Position         = UDim2.new(0.5, 0, 0, 120),
            AnchorPoint      = Vector2.new(0.5, 0),
            BackgroundColor3 = theme.Surface,
            BorderSizePixel  = 0,
            -- Deliberately NOT clipping: the drop shadow is a child, and
            -- clipping would eat it. The results list is a ScrollingFrame,
            -- which clips its own contents, so nothing spills during the
            -- open animation anyway.
            ZIndex           = 901,
            Parent           = scrim,
        }, {
            Corner(14),
            Stroke(theme.Border, 1, 0.25),
            New("UISizeConstraint", { MaxSize = Vector2.new(560, 420) }),
        })

