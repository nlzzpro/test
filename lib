--------------------------------------------------------------------
--  CUSTOM THEMES
--  Only the slots you care about need supplying. Anything left out is
--  inherited from Base (default Cobalt), so a two-line theme is a
--  legitimate theme — you aren't forced to hand-pick seventeen greys
--  to change the accent colour.
--------------------------------------------------------------------

function Nely:AddTheme(spec)
    assert(type(spec) == "table" and spec.Name, "AddTheme needs a table with a Name")

    local base = Nely.Themes[spec.Base or "Cobalt"] or Nely.Themes.Cobalt
    local theme = {}
    for slot, color in pairs(base) do
        theme[slot] = color
    end
    for slot, color in pairs(spec) do
        if slot ~= "Name" and slot ~= "Base" and typeof(color) == "Color3" then
            theme[slot] = color
        end
    end

    Nely.Themes[spec.Name] = theme
    return theme
end

function Nely:GetThemes()
    local names = {}
    for name in pairs(Nely.Themes) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

