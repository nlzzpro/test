    local function OpenWindow(animate)
        Window.Minimized = false
        shell.Visible = true
        orb.Visible = false
        Tween(Blur, { Size = 14 }, EASE.Glide)
        if animate ~= false then
            local target = Window.CurrentSize
            shell.Size = UDim2.fromOffset(target.X.Offset * 0.9, target.Y.Offset * 0.9)
            shell.BackgroundTransparency = 1
            Tween(shell, { Size = target, BackgroundTransparency = 0.04 }, EASE.Pop)
        end
    end

    local function MinimizeWindow()
        Window.Minimized = true
        Tween(Blur, { Size = 0 }, EASE.Smooth)
        local current = Window.CurrentSize
        Tween(shell, {
            Size                   = UDim2.fromOffset(current.X.Offset * 0.86, current.Y.Offset * 0.86),
            BackgroundTransparency = 1,
        }, EASE.Smooth)
        task.delay(0.26, function()
            if Window.Destroyed then return end
            shell.Visible = false
            orb.Visible   = true
            orb.Size      = UDim2.fromOffset(0, 0)
            Tween(orb, { Size = UDim2.fromOffset(50, 50) }, EASE.Pop)
        end)
    end

    function Window:Destroy()
        Window.Destroyed = true
        UserInputService.MouseIconEnabled = true
        Tween(Blur, { Size = 0 }, EASE.Smooth)
        Tween(shell, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, EASE.Smooth)
        Tween(orb, { Size = UDim2.fromOffset(0, 0) }, EASE.Smooth)
        task.delay(0.4, function()
            for _, conn in ipairs(Nely.Connections) do
                pcall(function() conn:Disconnect() end)
            end
            pcall(function() Blur:Destroy() end)
            pcall(function() Root:Destroy() end)
            Nely.Unloaded = true
        end)
