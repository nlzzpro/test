--==================================================================
--  BRAND MARK
--  Draws the hub's monogram, with a custom logo layered over it when one
--  is supplied. The letter stays underneath on purpose: if the logo is
--  still downloading, was rejected, or is awaiting Roblox moderation, the
--  mark reads as intentional instead of collapsing into an empty square.
--==================================================================

local function BrandMark(parent, title, logo, textSize, radius, zindex)
    New("TextLabel", {
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text                   = string.sub(title, 1, 1):upper(),
        TextColor3             = Color3.new(1, 1, 1),
        TextSize               = textSize,
        Font                   = Enum.Font.GothamBold,
        ZIndex                 = zindex,
        Parent                 = parent,
    })

    if not logo or logo == "" then return end

    local image = New("ImageLabel", {
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image                  = "",
        ImageTransparency      = 1,
        ScaleType              = Enum.ScaleType.Fit,
        ZIndex                 = zindex + 1,
        Parent                 = parent,
    }, { Corner(radius) })

    ResolveImageAsync(logo, function(content)
        image.Image = content
        Tween(image, { ImageTransparency = 0 }, EASE.Smooth)
    end)
end

