    })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = theme.Text,
        TextSize               = 17,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        LayoutOrder            = 3,
        ZIndex                 = 703,
        Parent                 = card,
    })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text                   = content,
        TextColor3             = theme.TextSub,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Top,
        TextWrapped            = true,
        LineHeight             = 1.25,
        LayoutOrder            = 4,
        ZIndex                 = 703,
        Parent                 = card,
    })

    New("Frame", {
        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
        LayoutOrder = 5, ZIndex = 703, Parent = card,
    })

    local row = New("Frame", {
        Size                   = UDim2.new(1, 0, 0, 38),
        BackgroundTransparency = 1,
        LayoutOrder            = 6,
        ZIndex                 = 703,
        Parent                 = card,
    }, {
        New("UIListLayout", {
            Padding       = UDim.new(0, 8),
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder     = Enum.SortOrder.LayoutOrder,
        }),
    })

    local function close()
        Tween(overlay, { BackgroundTransparency = 1 }, EASE.Smooth)
        Tween(card, { Size = UDim2.fromOffset(310, 0) }, EASE.Smooth)
        task.delay(0.3, function() overlay:Destroy() end)
    end

    local width = 1 / math.max(#buttons, 1)
    for index, spec in ipairs(buttons) do
        local isPrimary = spec.Primary == true
        local base      = isPrimary and theme.Accent or theme.Elevated
        local btn = New("TextButton", {
            Size             = UDim2.new(width, -4, 1, 0),
            BackgroundColor3 = base,
            AutoButtonColor  = false,
            Text             = "",
            LayoutOrder      = index,
            ZIndex           = 704,
            ClipsDescendants = true,
            Parent           = row,
        }, { Corner(10) })

        New("TextLabel", {
            Size                   = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text                   = spec.Title or "OK",
            TextColor3             = isPrimary and Color3.new(1, 1, 1) or theme.TextSub,
            TextSize               = 13,
            Font                   = Enum.Font.GothamBold,
            ZIndex                 = 705,
            Parent                 = btn,
        })

        btn.MouseEnter:Connect(function()
            Tween(btn, { BackgroundColor3 = isPrimary and theme.AccentSoft or theme.Hover }, EASE.Snap)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, { BackgroundColor3 = base }, EASE.Snap)
        end)
        btn.MouseButton1Click:Connect(function()
            Ripple(btn, 706)
            task.wait(0.05)
            close()
            if spec.Callback then task.spawn(spec.Callback) end
        end)
    end

    card.Size = UDim2.fromOffset(310, 0)
    Tween(overlay, { BackgroundTransparency = 0.45 }, EASE.Smooth)
    Tween(card, { Size = UDim2.fromOffset(340, 0) }, EASE.Pop)

    return { Close = close }
end

