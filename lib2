    function Window:CreateTab(cfg)
        cfg = cfg or {}
        Window._order = Window._order + 1
        local order  = Window._order
        local name   = cfg.Name or ("Tab " .. order)
        local hue    = cfg.IconColor or AutoHue(order)

        local Tab = { Name = name, Hue = hue }

        local btn = New("TextButton", {
            Name = name,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Theme.Elevated, BackgroundTransparency = 1,
            AutoButtonColor = false, Text = "",
            LayoutOrder = order, ClipsDescendants = true,
            ZIndex = 17, Parent = tabList,
        }, { Corner(10) })

        -- circular tinted plate behind the glyph, the way the reference
        -- hubs do it: colour lives in the plate, not the label
        local plate = New("Frame", {
            Size = UDim2.fromOffset(26, 26),
            Position = UDim2.new(0, 7, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = hue, BackgroundTransparency = 0.75,
            BorderSizePixel = 0, ZIndex = 18, Parent = btn,
        }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

        local icon = RenderIcon(cfg.Icon or "layers", plate, 14, hue, 19)
        icon.AnchorPoint = Vector2.new(0.5, 0.5)
        icon.Position = UDim2.fromScale(0.5, 0.5)

        local label = New("TextLabel", {
            Position = UDim2.fromOffset(43, 0),
            Size = UDim2.new(1, -52, 1, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = Theme.TextDim, TextSize = 12.5, Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 18, Parent = btn,
        })

        local page = New("ScrollingFrame", {
            Name = name .. "Page",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Border,
            ScrollBarImageTransparency = 0.3,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Visible = false, ZIndex = 15, Parent = content,
        }, { List(9), Pad(14, 18, 16, 16) })

        Tab.Button, Tab.Page = btn, page

        local function activate()
            if activeTab == Tab then return end
            for _, other in ipairs(Window.Tabs) do
                local on = other == Tab
                Tween(other.Button, { BackgroundTransparency = on and 0.55 or 1 }, EASE.Snap)
                Tween(other._label, { TextColor3 = on and Theme.Text or Theme.TextDim }, EASE.Snap)
                Tween(other._plate, { BackgroundTransparency = on and 0.45 or 0.8 }, EASE.Snap)
                Tween(other._icon, { ImageTransparency = on and 0 or 0.35 }, EASE.Snap)
                if other.Page ~= page then
                    other.Page.Visible = false
                end
            end
            -- crossfade the incoming page
            page.Visible = true
            page.Position = UDim2.fromOffset(0, 10)
            Tween(page, { Position = UDim2.fromOffset(0, 0) }, EASE.Glide)
            activeTab = Tab
        end

        Tab._label, Tab._plate, Tab._icon = label, plate, icon
        Tab.Activate = activate

        btn.MouseEnter:Connect(function()
            if activeTab ~= Tab then Tween(btn, { BackgroundTransparency = 0.8 }, EASE.Snap) end
        end)
        btn.MouseLeave:Connect(function()
            if activeTab ~= Tab then Tween(btn, { BackgroundTransparency = 1 }, EASE.Snap) end
        end)
        btn.MouseButton1Click:Connect(function()
            Ripple(btn)
            activate()
        end)

        table.insert(Window.Tabs, Tab)
        icon.ImageTransparency = 0.35
        if #Window.Tabs == 1 then activate() end

