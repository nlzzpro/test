local function Ripple(button, zindex)
    local pos  = GetPointer()
    local abs  = button.AbsolutePosition
    local size = button.AbsoluteSize
    local rx = math.clamp((pos.X - abs.X) / math.max(size.X, 1), 0, 1)
    local ry = math.clamp((pos.Y - abs.Y) / math.max(size.Y, 1), 0, 1)

    local ripple = New("Frame", {
        Size                   = UDim2.fromOffset(0, 0),
        Position               = UDim2.fromScale(rx, ry),
        AnchorPoint            = Vector2.new(0.5, 0.5),
        BackgroundColor3       = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.86,
        BorderSizePixel        = 0,
        ZIndex                 = zindex or (button.ZIndex + 3),
        Parent                 = button,
    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local reach = math.max(size.X, size.Y) * 2.2
    local tw = TweenService:Create(ripple, EASE.Glide, {
        Size                   = UDim2.fromOffset(reach, reach),
        BackgroundTransparency = 1,
    })
    tw:Play()
    tw.Completed:Connect(function() ripple:Destroy() end)
end

local function ClampPosition(size, pos)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize
    if not vp or vp.X <= 0 then return pos end
    local halfX, halfY = size.X / 2, size.Y / 2

    local cx = vp.X * pos.X.Scale + pos.X.Offset
    local cy = vp.Y * pos.Y.Scale + pos.Y.Offset

    cx = math.clamp(cx, math.min(halfX, vp.X - halfX), math.max(halfX, vp.X - halfX))
    cy = math.clamp(cy, halfY, math.max(halfY, vp.Y - halfY))

    return UDim2.new(0, math.floor(cx), 0, math.floor(cy))
end

local function ClampIntoViewport(frame)
    frame.Position = ClampPosition(frame.AbsoluteSize, frame.Position)
end

local function Draggable(handle, target, onDragEnd)
    local dragging, dragStart, startPos = false, nil, nil
    local moved = 0

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            moved     = 0
            dragStart = input.Position
            startPos  = target.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                    if onDragEnd then onDragEnd(moved) end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            moved = math.max(moved, delta.Magnitude)
            local wanted = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )

            Tween(target, { Position = ClampPosition(target.AbsoluteSize, wanted) }, EASE.Drag)
        end
    end)
end

