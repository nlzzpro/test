    }, { Corner(2) })

    local row = New("Frame", {
        Name                   = "Row",
        Size                   = UDim2.fromOffset(0, 30),
        Position               = UDim2.fromOffset(12, 0),
        AutomaticSize          = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex                 = 801,
        Parent                 = pill,
    }, {
        Pad(0, 0, 0, 12),
        New("UIListLayout", {
            Padding           = UDim.new(0, 9),
            FillDirection     = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder         = Enum.SortOrder.LayoutOrder,
        }),
    })

    local order = 0
    local function Cell(text, color, font, size)
        order = order + 1
        return New("TextLabel", {
            Size                   = UDim2.fromOffset(0, 30),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                   = text,
            TextColor3             = color,
            TextSize               = size or 12,
            Font                   = font or Enum.Font.GothamMedium,
            LayoutOrder            = order,
            ZIndex                 = 802,
            Parent                 = row,
        })
    end

    local function Sep()
        order = order + 1
        New("Frame", {
            Size             = UDim2.fromOffset(1, 12),
            BackgroundColor3 = theme.Border,
            BackgroundTransparency = 0.4,
            BorderSizePixel  = 0,
            LayoutOrder      = order,
            ZIndex           = 802,
            Parent           = row,
        })
    end

    local label = Cell(opts.Text or "Nely", theme.Text, Enum.Font.GothamBold, 13)
    Sep()
    local fpsCell  = opts.ShowFPS  ~= false and Cell("-- fps", theme.TextSub, Enum.Font.Code) or nil
    local pingCell = opts.ShowPing ~= false and Cell("-- ms",  theme.TextSub, Enum.Font.Code) or nil
    local timeCell = opts.ShowTime ~= false and Cell("--:--",  theme.TextDim, Enum.Font.Code) or nil

    Draggable(pill, pill)

    local frames, window, conn = 0, 0, nil

    conn = RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        window = window + dt

        if window >= 1 then
            if fpsCell then
                fpsCell.Text = string.format("%d fps", math.floor(frames / window + 0.5))
            end
            frames, window = 0, 0

            if pingCell then
                local ok, ms = pcall(function()
                    return game:GetService("Stats").Network
                        .ServerStatsItem["Data Ping"]:GetValue()
                end)
                pingCell.Text = ok and string.format("%d ms", math.floor(ms)) or "-- ms"
            end
            if timeCell then
                timeCell.Text = os.date("%H:%M")
            end
        end
    end)

    local api = { Instance = pill }

    function api:SetText(text) label.Text = text end

    function api:SetEnabled(state)
        pill.Visible = state and true or false
    end

    function api:Destroy()
        if conn then conn:Disconnect() end
        pill:Destroy()
        if Nely._watermark == api then Nely._watermark = nil end
    end

    if opts.Enabled == false then pill.Visible = false end

    table.insert(Nely.Connections, conn)

    Nely._watermark = api
    return api
end

function Nely:CreateWindow(opts)
    opts = opts or {}
    local theme, themeName = ResolveTheme(opts.Theme)
    theme = theme or Nely.Themes.Metallic
    Nely.ThemeName = themeName or "Metallic"
    Nely.Theme = theme

    local title     = opts.Title     or "Nely Hub"
    local subtitle  = opts.Subtitle  or ""
    local toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift

    local viewport = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize
        or Vector2.new(1280, 720)

    local compact = viewport.X < 700 or UserInputService.TouchEnabled

    local function Fit(fraction, low, high, axis)
        return math.floor(math.clamp(axis * fraction, low, high))
    end

    local marginX = compact and 12 or 40
    local marginY = compact and 12 or 40
    local fitW = math.max(260, math.floor(viewport.X - marginX * 2))
    local fitH = math.max(200, math.floor(viewport.Y - marginY * 2))

    local wantW = opts.Size and opts.Size.X.Offset
                or Fit(compact and 0.92 or 0.40, 310, 560, viewport.X)
    local wantH = opts.Size and opts.Size.Y.Offset
                or Fit(compact and 0.68 or 0.54, 280, 410, viewport.Y)
    wantW, wantH = math.floor(wantW), math.floor(wantH)

    local winSize = UDim2.fromOffset(wantW, wantH)

    local sidebarW = opts.SidebarWidth or (compact and 136 or 168)
    sidebarW = math.floor(math.min(sidebarW, math.max(96, winSize.X.Offset * 0.34)))
    local topbarH  = compact and 42 or 46

    local dense  = opts.Density == "compact"
    local ROW_H  = dense and (compact and 42 or 46) or (compact and 50 or 56)
    local ROW_HD = dense and (compact and 54 or 60) or (compact and 62 or 70)

    local Window = {
        Tabs        = {},
        ActiveTab   = nil,
        Minimized   = false,
        Destroyed   = false,
        CurrentSize = winSize,
        Compact     = compact,
        Dense       = dense,
        FitScale    = 1,
        TabSections = {},
        _tabOrder   = 0,
        _dependents = {},
    }

    function Window:_Sync(flag, value)
        local list = Window._dependents[flag]
        if not list then return end
        for _, entry in ipairs(list) do
            local want = value and true or false
            if entry.invert then want = not want end
            if entry.api and entry.api.SetEnabled then
                entry.api:SetEnabled(want)
            end
        end
    end

    local minSize = opts.MinSize or Vector2.new(
        math.min(compact and 300 or 480, winSize.X.Offset),
        math.min(compact and 260 or 340, winSize.Y.Offset)
    )

    local maxSize = Vector2.new(
        opts.MaxSize and opts.MaxSize.X or math.huge,
        opts.MaxSize and opts.MaxSize.Y or math.huge
    )
    maxSize = Vector2.new(
        math.max(maxSize.X, winSize.X.Offset),
        math.max(maxSize.Y, winSize.Y.Offset)
    )

    local glass = opts.Glass
    if glass == nil then glass = 0.14 end
    if opts.Transparent == false then glass = 0 end

    local shell = New("Frame", {
        Name             = "Window",
        Size             = winSize,
        Position         = UDim2.fromScale(0.5, 0.5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Backdrop,
        BackgroundTransparency = glass,
        BorderSizePixel  = 0,

        ClipsDescendants = false,
        ZIndex           = 10,
        Parent           = Root,
    }, {
        Corner(18),
        Stroke(theme.Border, 1, 0.15),
    })
    Shadow(shell, 42, 0.72, 18)
    Window.Frame = shell

    local shellScale = New("UIScale", { Scale = 1, Parent = shell })

    local MIN_SCALE = 0.6

    local function RecomputeFitScale(designW, designH, animate)
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or viewport
        if vp.X <= 0 or vp.Y <= 0 then return Window.FitScale end

        local mX = vp.X < 700 and 12 or 40
        local mY = vp.Y < 700 and 12 or 40
        local availW = math.max(260, math.floor(vp.X - mX * 2))
        local availH = math.max(200, math.floor(vp.Y - mY * 2))

        local scale = math.clamp(math.min(availW / designW, availH / designH), MIN_SCALE, 1)
        Window.FitScale = scale

        local target = scale * (Window.Minimized and 0.05 or 1)
        if animate == false then
            shellScale.Scale = target
        else
            Tween(shellScale, { Scale = target }, EASE.Snap)
        end

        ClampIntoViewport(shell)
        return scale
    end

    RecomputeFitScale(wantW, wantH, false)

    do
        local cam = workspace.CurrentCamera
        if cam then
            local conn
            conn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                if Window.Destroyed then
                    pcall(function() conn:Disconnect() end)
                    return
                end
                local vp = cam.ViewportSize
                if vp.X <= 0 or vp.Y <= 0 then return end
                RecomputeFitScale(wantW, wantH)
            end)
            table.insert(Nely.Connections, conn)
        end
    end

