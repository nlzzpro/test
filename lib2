function Nely:Notify(cfg)
    cfg = cfg or {}
    local colour = cfg.Color or Theme.Accent
    local card = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.06,
        BorderSizePixel = 0, ZIndex = 801, Parent = Toasts,
    }, { Corner(13), Pad(12, 12, 14, 14), List(3) })
    New("UIStroke", { Color = colour, Thickness = 1, Transparency = 0.5, Parent = card })
    Shadow(card, 24, 0.68)

    New("Frame", {
        Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(-8, 8),
        BackgroundColor3 = colour, BorderSizePixel = 0, ZIndex = 803, Parent = card,
    }, { Corner(2) })

    local head = New("Frame", {
        Size = UDim2.new(1, 0, 0, 17), BackgroundTransparency = 1,
        LayoutOrder = 1, ZIndex = 802, Parent = card,
    })
    local ic = RenderIcon(cfg.Icon or "bolt", head, 14, colour, 803)
    ic.Position = UDim2.fromOffset(0, 1)
    New("TextLabel", {
        Position = UDim2.fromOffset(21, 0), Size = UDim2.new(1, -21, 1, 0),
        BackgroundTransparency = 1, Text = tostring(cfg.Title or "Notice"),
        TextColor3 = Theme.Text, TextSize = 13, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 803, Parent = head,
    })
    if cfg.Content and cfg.Content ~= "" then
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = tostring(cfg.Content),
            TextColor3 = Theme.TextSub, TextSize = 11.5, Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            LayoutOrder = 2, ZIndex = 802, Parent = card,
        })
    end

    -- progress bar draining toward dismissal, so a toast never just
    -- vanishes without warning
    local bar = New("Frame", {
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = colour,
        BackgroundTransparency = 0.35, BorderSizePixel = 0,
        LayoutOrder = 3, ZIndex = 803, Parent = card,
    }, { Corner(1) })

    card.BackgroundTransparency = 1
    card.Position = UDim2.fromOffset(50, 0)
    Tween(card, { BackgroundTransparency = 0.06, Position = UDim2.fromOffset(0, 0) }, EASE.Pop)

    local life = cfg.Duration or 4
    Tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, TweenInfo.new(life, Enum.EasingStyle.Linear))
    task.delay(life, function()
        Tween(card, { BackgroundTransparency = 1, Position = UDim2.fromOffset(50, 0) }, EASE.Glide)
        task.delay(0.3, function() pcall(function() card:Destroy() end) end)
    end)
end

