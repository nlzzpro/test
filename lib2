            local grid = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = 2,
                ZIndex                 = 18,
                Parent                 = holder,
            }, {
                New("UIGridLayout", {
                    CellSize            = UDim2.fromOffset(cell.X, cell.Y),
                    CellPadding         = UDim2.fromOffset(9, 9),
                    SortOrder           = Enum.SortOrder.LayoutOrder,
                    HorizontalAlignment = Enum.HorizontalAlignment.Left,
                }),
            })

            local api = { Instance = holder }

            local function BuildCard(item, index)
                local card = New("TextButton", {
                    Name                   = tostring(item.Name or item.Id or index),
                    BackgroundColor3       = theme.Surface,
                    BackgroundTransparency = 0.15,
                    AutoButtonColor        = false,
                    Text                   = "",
                    LayoutOrder            = index,
                    ClipsDescendants       = true,
                    ZIndex                 = 19,
                    Parent                 = grid,
                }, { Corner(12), Stroke(theme.BorderSoft, 1, 0.4) })

                local art = New("Frame", {
                    Size                   = UDim2.new(1, -12, 1, -34),
                    Position               = UDim2.fromOffset(6, 6),
                    BackgroundColor3       = theme.SurfaceAlt,
                    BackgroundTransparency = 0.35,
                    BorderSizePixel        = 0,
                    ClipsDescendants       = true,
                    ZIndex                 = 20,
                    Parent                 = card,
                }, { Corner(9) })

                -- Letter tile underneath, same reasoning as GameGrid: a
                -- dead image link shows a deliberate initial instead of a
                -- hole in the layout.
                local letter = New("TextLabel", {
                    Size                   = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text                   = string.upper(string.sub(tostring(item.Name or "?"), 1, 1)),
                    TextColor3             = theme.TextDim,
                    TextTransparency       = 0.35,
                    TextSize               = 26,
                    Font                   = Enum.Font.GothamBold,
                    ZIndex                 = 21,
                    Parent                 = art,
                })

                if item.Image and item.Image ~= "" then
                    -- ImageTransparency stays at 0 for the lifetime of this
                    -- label, and that is not a style choice.
                    --
                    -- Roblox will not download a fully transparent image.
                    -- The old code created the label at transparency 1 and
                    -- had the fallback set it back to 1 on failure, which
                    -- meant the "it failed" branch guaranteed it could
                    -- never succeed: twenty of twenty-five crosshairs sat
                    -- as dead letters forever, even after scrolling to them.
                    --
                    -- So only the LETTER is toggled. An undecoded image
                    -- draws nothing, so showing both is safe, and the
                    -- letter simply disappears once the artwork arrives.
                    local pic = New("ImageLabel", {
                        Size                   = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        Image                  = tostring(item.Image),
                        ImageTransparency      = 0,
                        ScaleType              = Enum.ScaleType.Fit,
                        ZIndex                 = 22,
                        Parent                 = art,
                    })

                    -- Hidden for the first beat so a fast asset never
                    -- flashes a placeholder, then shown while we wait.
                    letter.TextTransparency = 1
                    task.spawn(function()
                        local waited = 0
                        while pic.Parent do
                            if pic.IsLoaded then
                                if letter.TextTransparency < 1 then
                                    Tween(letter, { TextTransparency = 1 }, EASE.Smooth)
                                end
                                return
                            end
                            waited = waited + 0.25
                            if waited > 0.6 and letter.TextTransparency > 0.9 then
                                Tween(letter, { TextTransparency = 0.4 }, EASE.Smooth)
                            end
                            task.wait(0.25)
                        end
                    end)
                end

                New("TextLabel", {
                    AnchorPoint            = Vector2.new(0, 1),
                    Position               = UDim2.new(0, 8, 1, -6),
                    Size                   = UDim2.new(1, -16, 0, 14),
                    BackgroundTransparency = 1,
                    Text                   = tostring(item.Name or "?"),
                    TextColor3             = theme.TextSub,
                    TextSize               = 11,
                    Font                   = Enum.Font.GothamMedium,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 21,
                    Parent                 = card,
                })

                if item.Badge and item.Badge ~= "" then
                    local badge = New("Frame", {
                        Position               = UDim2.fromOffset(9, 9),
                        Size                   = UDim2.fromOffset(0, 15),
                        AutomaticSize          = Enum.AutomaticSize.X,
                        BackgroundColor3       = item.BadgeRainbow
                                                  and Color3.fromRGB(255, 255, 255)
                                                  or (item.BadgeColor or theme.Accent),
                        BorderSizePixel        = 0,
                        ZIndex                 = 24,
                        Parent                 = card,
                    }, { Corner(5), Pad(0, 0, 6, 6) })

                    -- A chroma weapon cycles colour in game; a flat label
                    -- for it would be a lie, so the badge carries the same
                    -- spectrum.
                    if item.BadgeRainbow then
                        Gradient(ColorSequence.new({
                            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 108, 108)),
                            ColorSequenceKeypoint.new(0.30, Color3.fromRGB(255, 214, 122)),
                            ColorSequenceKeypoint.new(0.62, Color3.fromRGB(122, 238, 190)),
                            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(168, 150, 255)),
                        })).Parent = badge
                    end

                    New("TextLabel", {
                        Size                   = UDim2.fromOffset(0, 15),
                        AutomaticSize          = Enum.AutomaticSize.X,
                        BackgroundTransparency = 1,
                        Text                   = string.upper(tostring(item.Badge)),
                        TextColor3             = Color3.fromRGB(18, 18, 22),
                        TextSize               = 8.5,
                        Font                   = Enum.Font.GothamBold,
                        ZIndex                 = 25,
                        Parent                 = badge,
                    })
                end

                local stroke = card:FindFirstChildOfClass("UIStroke")
                card.MouseEnter:Connect(function()
                    Tween(card, { BackgroundTransparency = 0 }, EASE.Snap)
                    if stroke then
                        Tween(stroke, { Color = theme.Accent, Transparency = 0.1 }, EASE.Snap)
                    end
                end)
                card.MouseLeave:Connect(function()
                    Tween(card, { BackgroundTransparency = 0.15 }, EASE.Snap)
                    if stroke then
                        Tween(stroke, { Color = theme.BorderSoft, Transparency = 0.4 }, EASE.Snap)
                    end
                end)
                card.MouseButton1Click:Connect(function()
                    Ripple(card, 22)
                    -- OnSelect matches GameGrid; Callback matches every
                    -- other control in this library. Both are accepted so
                    -- neither habit silently does nothing.
                    local fn = cfg.OnSelect or cfg.Callback
                    if fn then task.spawn(fn, item.Id or item.Name, item) end
                end)
                return card
            end

            -- Drawing several hundred cards in one frame locks the client,
            -- so rendering is batched. The token makes a newer Render
            -- abandon an in-flight one instead of interleaving with it,
            -- which is what produces duplicated cards when someone types
            -- quickly into a filter.
            local token = 0
            function api:Render(list)
                list = list or {}
                token = token + 1
                local mine = token
                for _, c in ipairs(grid:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                local shown = math.min(#list, cap)
                status.Text = (#list == 0) and (cfg.Empty or "Nothing matches")
                    or (#list .. " items" .. (#list > cap and ("  --  showing " .. cap) or ""))
                task.spawn(function()
                    for i = 1, shown do
                        if token ~= mine then return end
                        BuildCard(list[i], i)
                        if i % batch == 0 then task.wait() end
                    end
                end)
            end

            api.Set = function(_, list) api:Render(list) end
            api.Destroy = function() holder:Destroy() end
            api:Render(cfg.Items)
            return api
        end

        function Tab:CreateGameGrid(cfg)
            CloseSection()   -- a block sits between cards, not inside one
            cfg = cfg or {}
            local games    = cfg.Games or {}
            local onSelect = cfg.OnSelect

            -- Roblox titles carry emoji and tags: "🧟 Survive", "[🐝] 99 Nights",
            -- "Brookhaven 🏡RP". Sorting on the raw string files those under
            -- their first byte, which lands them in the "#" bucket instead of
            -- under S, 9 and B. Strip anything non-alphanumeric off the front
            -- for ordering only — the card still shows the full title.
            local function SortableName(name)
                local cleaned = name:gsub("[^%w%s]", ""):gsub("^%s+", "")
                return cleaned ~= "" and cleaned or name
            end

            table.sort(games, function(a, b)
                return string.lower(SortableName(a.Name)) < string.lower(SortableName(b.Name))
            end)

            -- search field
            local searchRow = New("Frame", {
                Size             = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = theme.Surface,
                BackgroundTransparency = 0.2,
                BorderSizePixel  = 0,
                LayoutOrder      = NextOrder(),
                ZIndex           = 17,
                Parent           = ElementHost(),
            }, { Corner(10), Stroke(theme.BorderSoft, 1, 0.4) })

            local searchIcon = Icons.Render("search", searchRow, 15, theme.TextDim, 18)
            searchIcon.Position    = UDim2.new(0, 12, 0.5, 0)
            searchIcon.AnchorPoint = Vector2.new(0, 0.5)

            local searchBox = New("TextBox", {
                Size                   = UDim2.new(1, -46, 1, 0),
                Position               = UDim2.fromOffset(36, 0),
                BackgroundTransparency = 1,
                Text                   = "",
                PlaceholderText        = cfg.Placeholder or "Search games",
                PlaceholderColor3      = theme.TextDim,
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.Gotham,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ClearTextOnFocus       = false,
                ZIndex                 = 18,
                Parent                 = searchRow,
            })

            local counter = New("TextLabel", {
                Size                   = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                Text                   = #games .. " games  ·  sorted A–Z",
                TextColor3             = theme.TextDim,
                TextSize               = 11,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                LayoutOrder            = NextOrder(),
                ZIndex                 = 17,
                Parent                 = ElementHost(),
            })

            -- deterministic pastel per game name, used for the letter-avatar fallback
            local function ColorFor(name)
                local hash = 0
                for i = 1, #name do
                    hash = (hash * 31 + string.byte(name, i)) % 360
                end
                return Color3.fromHSV(hash / 360, 0.45, 0.55)
            end

            local groups = {}
            local cards  = {}

            local function LetterGroup(letter)
                if groups[letter] then return groups[letter] end

                local holder = New("Frame", {
                    Name                   = "Group" .. letter,
                    Size                   = UDim2.new(1, 0, 0, 0),
                    AutomaticSize          = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    LayoutOrder            = string.byte(letter),
                    ZIndex                 = 17,
                    Parent                 = ElementHost(),
                }, { List(8) })

                local head = New("Frame", {
                    Size                   = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    LayoutOrder            = 1,
                    ZIndex                 = 17,
                    Parent                 = holder,
                })

                New("TextLabel", {
                    Size                   = UDim2.fromOffset(20, 20),
                    BackgroundTransparency = 1,
                    Text                   = letter,
                    TextColor3             = theme.Accent,
                    TextSize               = 13,
                    Font                   = Enum.Font.GothamBold,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    ZIndex                 = 18,
                    Parent                 = head,
                })

                New("Frame", {
                    Size             = UDim2.new(1, -28, 0, 1),
                    Position         = UDim2.new(0, 24, 0.5, 0),
                    BackgroundColor3 = theme.BorderSoft,
                    BorderSizePixel  = 0,
                    ZIndex           = 18,
                    Parent           = head,
                })

                local grid = New("Frame", {
                    Size                   = UDim2.new(1, 0, 0, 0),
                    AutomaticSize          = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    LayoutOrder            = 2,
                    ZIndex                 = 17,
                    Parent                 = holder,
                }, {
                    New("UIGridLayout", {
                        CellSize      = UDim2.fromOffset(138, 158),
                        CellPadding   = UDim2.fromOffset(10, 10),
                        SortOrder     = Enum.SortOrder.LayoutOrder,
                        HorizontalAlignment = Enum.HorizontalAlignment.Left,
                    }),
                })

                groups[letter] = { holder = holder, grid = grid, count = 0 }
                return groups[letter]
            end

            for index, gameData in ipairs(games) do
                local letter = string.upper(string.sub(SortableName(gameData.Name), 1, 1))
                if not letter:match("%w") then letter = "#" end
                local group = LetterGroup(letter)
                group.count = group.count + 1

                local card = New("TextButton", {
                    Name             = gameData.Name,
                    BackgroundColor3 = theme.Surface,
                    BackgroundTransparency = 0.15,
                    AutoButtonColor  = false,
                    Text             = "",
                    LayoutOrder      = index,
                    ClipsDescendants = true,
                    ZIndex           = 18,
                    Parent           = group.grid,
                }, { Corner(12), Stroke(theme.BorderSoft, 1, 0.4) })

                local art = New("Frame", {
                    Size             = UDim2.new(1, -14, 0, 96),
                    Position         = UDim2.fromOffset(7, 7),
                    BackgroundColor3 = ColorFor(gameData.Name),
                    BorderSizePixel  = 0,
                    ClipsDescendants = true,
                    ZIndex           = 19,
                    Parent           = card,
                }, {
                    Corner(9),
                    Gradient(ColorSequence.new({
                        ColorSequenceKeypoint.new(0, ColorFor(gameData.Name)),
                        ColorSequenceKeypoint.new(1, theme.Backdrop),
                    }), 140),
                })

                -- The letter tile always sits underneath. If the image link is
                -- missing, broken, or rejected by the executor, the ImageLabel
                -- just renders nothing and the letter shows through — so a bad
                -- link degrades into something deliberate rather than a hole.
                New("TextLabel", {
                    Size                   = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text                   = string.upper(string.sub(gameData.Name, 1, 1)),
                    TextColor3             = Color3.new(1, 1, 1),
                    TextTransparency       = 0.25,
                    TextSize               = 40,
                    Font                   = Enum.Font.GothamBold,
                    ZIndex                 = 20,
                    Parent                 = art,
                })

                local artwork = New("ImageLabel", {
                    Size                   = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Image                  = "",
                    ImageTransparency      = 1,
                    ScaleType              = Enum.ScaleType.Crop,
                    ZIndex                 = 21,
                    Parent                 = art,
                }, { Corner(9) })

                ResolveGameImage(gameData, function(content)
                    artwork.Image = content
                    Tween(artwork, { ImageTransparency = 0 }, EASE.Smooth)
                end)

                -- bottom scrim so the name always reads
                New("Frame", {
                    Size                   = UDim2.new(1, 0, 0, 40),
                    Position               = UDim2.new(0, 0, 1, -40),
                    BackgroundColor3       = theme.Backdrop,
                    BorderSizePixel        = 0,
                    ZIndex                 = 22,
                    Parent                 = art,
                }, {
                    Gradient(
                        ColorSequence.new(theme.Backdrop),
                        90,
                        NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 1),
                            NumberSequenceKeypoint.new(1, 0.25),
                        })
                    ),
                })

                New("TextLabel", {
                    Size                   = UDim2.new(1, -16, 0, 30),
                    Position               = UDim2.fromOffset(9, 108),
                    BackgroundTransparency = 1,
                    Text                   = gameData.Name,
                    TextColor3             = theme.Text,
                    TextSize               = 12,
                    Font                   = Enum.Font.GothamMedium,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextYAlignment         = Enum.TextYAlignment.Top,
                    TextWrapped            = true,
                    ZIndex                 = 19,
                    Parent                 = card,
                })

                local glow = New("Frame", {
                    Size                   = UDim2.fromScale(1, 1),
                    BackgroundColor3       = theme.Accent,
                    BackgroundTransparency = 1,
                    BorderSizePixel        = 0,
                    ZIndex                 = 18,
                    Parent                 = card,
                }, { Corner(12) })

                local cardStroke = card:FindFirstChildOfClass("UIStroke")

                card.MouseEnter:Connect(function()
                    Tween(card, { BackgroundColor3 = theme.SurfaceAlt, BackgroundTransparency = 0 }, EASE.Snap)
                    Tween(glow, { BackgroundTransparency = 0.93 }, EASE.Snap)
                    Tween(cardStroke, { Color = theme.Accent, Transparency = 0.25 }, EASE.Snap)
                    Tween(art, { Position = UDim2.fromOffset(7, 4) }, EASE.Smooth)
                end)
                card.MouseLeave:Connect(function()
                    Tween(card, { BackgroundColor3 = theme.Surface, BackgroundTransparency = 0.15 }, EASE.Snap)
                    Tween(glow, { BackgroundTransparency = 1 }, EASE.Snap)
                    Tween(cardStroke, { Color = theme.BorderSoft, Transparency = 0.4 }, EASE.Snap)
                    Tween(art, { Position = UDim2.fromOffset(7, 7) }, EASE.Smooth)
                end)
                card.MouseButton1Click:Connect(function()
                    Ripple(card, 24)
                    if onSelect then task.spawn(onSelect, gameData) end
                end)

                table.insert(cards, { card = card, data = gameData, letter = letter })
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local query = string.lower(searchBox.Text)
                local visible = 0
                local perLetter = {}

                for _, entry in ipairs(cards) do
                    local match = query == ""
                        or string.find(string.lower(entry.data.Name), query, 1, true) ~= nil
                    entry.card.Visible = match
                    if match then
                        visible = visible + 1
                        perLetter[entry.letter] = (perLetter[entry.letter] or 0) + 1
                    end
                end

                for letter, group in pairs(groups) do
                    group.holder.Visible = (perLetter[letter] or 0) > 0
                end

                counter.Text = query == ""
                    and (#games .. " games  ·  sorted A–Z")
                    or  (visible .. " of " .. #games .. " match \"" .. searchBox.Text .. "\"")
            end)

            local boxStroke = searchRow:FindFirstChildOfClass("UIStroke")
            searchBox.Focused:Connect(function()
                Tween(boxStroke, { Color = theme.Accent, Transparency = 0.2 }, EASE.Snap)
                TintIcon(searchIcon, theme.Accent)
            end)
            searchBox.FocusLost:Connect(function()
                Tween(boxStroke, { Color = theme.BorderSoft, Transparency = 0.4 }, EASE.Snap)
                TintIcon(searchIcon, theme.TextDim)
            end)

            return {
                Search  = function(_, text) searchBox.Text = text end,
                Destroy = function()
                    searchRow:Destroy()
                    counter:Destroy()
                    for _, group in pairs(groups) do group.holder:Destroy() end
                end,
            }
        end

