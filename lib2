        local function Lockable(row, api, radius)
            local scrim = New("Frame", {
                Name                   = "Lock",
                Size                   = UDim2.fromScale(1, 1),
                BackgroundColor3       = theme.Backdrop,
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                Visible                = false,
                ZIndex                 = 30,
                Parent                 = row,
            }, { Corner(radius or 11) })

            local stash = nil
            api.Enabled = true

            api.SetEnabled = function(_, state)
                state = state ~= false
                if api.Enabled == state then return end
                api.Enabled = state

                if not state then
                    stash = {}
                    for _, d in ipairs(row:GetDescendants()) do
                        if d ~= scrim
                        and (d:IsA("TextButton") or d:IsA("TextBox") or d:IsA("ImageButton")) then
                            stash[d] = d.Visible
                            d.Visible = false
                        end
                    end
                    scrim.Visible = true
                    Tween(scrim, { BackgroundTransparency = 0.45 }, EASE.Snap)
                else
                    if stash then
                        for d, wasVisible in pairs(stash) do
                            if d.Parent then d.Visible = wasVisible end
                        end
                        stash = nil
                    end
                    Tween(scrim, { BackgroundTransparency = 1 }, EASE.Snap)
                    task.delay(0.2, function()
                        if api.Enabled then scrim.Visible = false end
                    end)
                end
            end

            api.SetLocked = function(_, locked) api:SetEnabled(not locked) end
            return api
        end

        local function BindDepend(api, spec)
            if not spec or not api.SetEnabled then return end
            local invert = false
            local flag = spec
            if string.sub(spec, 1, 1) == "!" then
                invert = true
                flag = string.sub(spec, 2)
            end
            Window._dependents[flag] = Window._dependents[flag] or {}
            table.insert(Window._dependents[flag], { api = api, invert = invert })

            local current = Nely.Flags[flag] and true or false
            if invert then current = not current end
            api:SetEnabled(current)
        end

