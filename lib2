-- `Themed = { Prop = "Token" }` in a props table registers a semantic
-- theme binding as the instance is built, so structural surfaces declare
-- their token at the point of creation instead of in a separate pass
-- somebody has to remember to update.
local function New(class, props, children)
    local inst = Instance.new(class)
    local parent, themed
    for key, value in pairs(props or {}) do
        if key == "Parent" then
            parent = value
        elseif key == "Themed" then
            themed = value
        else
            inst[key] = value
        end
    end
    if themed then
        for prop, token in pairs(themed) do
            ThemeBindings[inst] = ThemeBindings[inst] or {}
            ThemeBindings[inst][prop] = token
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(radius)
