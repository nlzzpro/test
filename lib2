                local state = tcfg.CurrentValue == true
                local disabled = tcfg.Disabled == true
                local row = Row(tcfg.Description and ROW_D or ROW)
                RowText(row, tcfg.Name or "Toggle", tcfg.Description, tcfg.Info, disabled)

                local track = New("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(40, 22),
                    BackgroundColor3 = state and Theme.Accent or Theme.Elevated,
                    BackgroundTransparency = disabled and 0.6 or (state and 0.05 or 0.2),
                    BorderSizePixel = 0, ZIndex = 20, Parent = row,
                }, { Round() })
                local knob = New("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, state and 21 or 3, 0.5, 0),
                    Size = UDim2.fromOffset(16, 16),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundTransparency = disabled and 0.4 or 0,
                    BorderSizePixel = 0, ZIndex = 21, Parent = track,
                }, { Round() })

                local api = { Instance = row }
                function api:Set(v, silent)
                    state = v and true or false
                    if flag then Nely.Flags[flag] = state end
                    Tween(track, {
                        BackgroundColor3 = state and Theme.Accent or Theme.Elevated,
                        BackgroundTransparency = state and 0.05 or 0.2,
                    }, EASE.Snap)
                    Tween(knob, { Position = UDim2.new(0, state and 21 or 3, 0.5, 0) }, EASE.Pop)
                    if tcfg.Callback and not silent then task.spawn(tcfg.Callback, state) end
                end
                function api:SetDisabled(d)
                    disabled = d and true or false
                    Tween(track, { BackgroundTransparency = disabled and 0.6
                                   or (state and 0.05 or 0.2) }, EASE.Snap)
                end

                if not disabled then
                    local hit = New("TextButton", {
                        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                        AutoButtonColor = false, Text = "", ZIndex = 22, Parent = row,
                    })
                    Hoverable(row, hit)
                    hit.MouseButton1Click:Connect(function() Ripple(row) api:Set(not state) end)
                end

                if flag then Nely.Flags[flag] = state end
                if state and tcfg.Callback then task.spawn(tcfg.Callback, true) end
                return W:RegisterElement(flag, api)
            end

            function G:CreateSlider(scfg, flag)
                scfg = scfg or {}
                local range = scfg.Range or { 0, 100 }
                local inc   = scfg.Increment or 1
                local value = scfg.CurrentValue or range[1]
                local row = Row(ROW)
                RowText(row, scfg.Name or "Slider", nil, scfg.Info)

                local readout = Themed(New("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -150, 0.5, 0), Size = UDim2.fromOffset(70, 16),
                    BackgroundTransparency = 1,
                    Text = tostring(value) .. (scfg.Suffix or ""),
                    TextColor3 = Theme.TextSub, TextSize = 11.5, Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 20, Parent = row,
                }), "TextColor3", "TextSub")

                local bar = New("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(132, 5), BackgroundColor3 = Theme.Elevated,
                    BackgroundTransparency = 0.25, BorderSizePixel = 0,
                    ZIndex = 20, Parent = row,
                }, { Round() })
                Themed(bar, "BackgroundColor3", "Elevated")
                local a0 = (value - range[1]) / math.max(range[2] - range[1], 1)
                local fill = New("Frame", {
                    Size = UDim2.fromScale(a0, 1), BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0, ZIndex = 21, Parent = bar,
                }, { Round() })
                local grip = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(a0, 0.5),
                    Size = UDim2.fromOffset(13, 13),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0, ZIndex = 22, Parent = bar,
                }, { Round() })

                local api = { Instance = row }
                function api:Set(v, silent)
                    v = math.clamp(v, range[1], range[2])
                    v = math.floor(v / inc + 0.5) * inc
                    if inc < 1 then v = tonumber(string.format("%.2f", v)) end
                    value = v
                    if flag then Nely.Flags[flag] = v end
                    local a = (v - range[1]) / math.max(range[2] - range[1], 1)
                    Tween(fill, { Size = UDim2.fromScale(a, 1) }, EASE.Snap)
                    Tween(grip, { Position = UDim2.fromScale(a, 0.5) }, EASE.Snap)
                    readout.Text = tostring(v) .. (scfg.Suffix or "")
                    if scfg.Callback and not silent then task.spawn(scfg.Callback, v) end
                end

                local dragging = false
                local function fromX(px)
                    local a = math.clamp((px - bar.AbsolutePosition.X)
                              / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                    api:Set(range[1] + a * (range[2] - range[1]))
                end
                local hit = New("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                    Size = UDim2.fromOffset(142, 26), BackgroundTransparency = 1,
                    AutoButtonColor = false, Text = "", ZIndex = 23, Parent = row,
                })
                hit.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                       or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        Tween(grip, { Size = UDim2.fromOffset(17, 17) }, EASE.Snap)
                        fromX(i.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                       or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1
                       or i.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        Tween(grip, { Size = UDim2.fromOffset(13, 13) }, EASE.Snap)
                    end
                end)

                if flag then Nely.Flags[flag] = value end
                return W:RegisterElement(flag, api)
            end

            function G:CreateDropdown(dcfg, flag)
                dcfg = dcfg or {}
                local options  = dcfg.Options or {}
                local multi    = dcfg.MultiSelect == true
                local selected = {}
                for _, v in ipairs(dcfg.CurrentOption or {}) do selected[v] = true end

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, ROW), BackgroundColor3 = Theme.SurfaceAlt,
                    BackgroundTransparency = 1, BorderSizePixel = 0,
                    ClipsDescendants = true, ZIndex = 18, Parent = card,
                }, { Corner(10) })
                RowText(row, dcfg.Name or "Dropdown", nil, dcfg.Info)

                local pill = Themed(New("Frame", {
                    AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 7),
                    Size = UDim2.fromOffset(150, 24), BackgroundColor3 = Theme.Elevated,
                    BackgroundTransparency = 0.25, BorderSizePixel = 0,
                    ZIndex = 20, Parent = row,
                }, { Corner(8), Stroke("BorderSoft", 1, 0.5) }), "BackgroundColor3", "Elevated")
                local valueLabel = Themed(New("TextLabel", {
                    Position = UDim2.fromOffset(9, 0), Size = UDim2.new(1, -28, 1, 0),
                    BackgroundTransparency = 1, Text = "--", TextColor3 = Theme.TextSub,
                    TextSize = 11.5, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 21, Parent = pill,
                }), "TextColor3", "TextSub")
                local caret = RenderIcon("chevron-down", pill, 12, "TextDim", 21)
                caret.AnchorPoint = Vector2.new(1, 0.5)
                caret.Position = UDim2.new(1, -8, 0.5, 0)

                local host = New("Frame", {
                    Position = UDim2.fromOffset(0, ROW), Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                    ZIndex = 19, Parent = row,
                }, { List(3), Pad(0, 8, 10, 10) })

                local function summary()
                    local picked = {}
                    for _, o in ipairs(options) do if selected[o] then picked[#picked + 1] = o end end
                    valueLabel.Text = #picked > 0 and table.concat(picked, ", ") or "--"
                end

                local entries = {}
                local function build()
                    for _, c in ipairs(host:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    entries = {}
                    for i, opt in ipairs(options) do
                        local e = New("TextButton", {
                            Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Elevated,
                            BackgroundTransparency = 0.35, AutoButtonColor = false,
                            Text = "", LayoutOrder = i, ZIndex = 20, Parent = host,
                        }, { Corner(7) })
                        New("TextLabel", {
                            Position = UDim2.fromOffset(9, 0), Size = UDim2.new(1, -32, 1, 0),
                            BackgroundTransparency = 1, Text = tostring(opt),
                            TextColor3 = Theme.TextSub, TextSize = 11, Font = Enum.Font.Gotham,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextTruncate = Enum.TextTruncate.AtEnd,
                            ZIndex = 21, Parent = e,
                        })
                        local tick = RenderIcon("check", e, 11, "Accent", 21)
                        tick.AnchorPoint = Vector2.new(1, 0.5)
                        tick.Position = UDim2.new(1, -8, 0.5, 0)
                        tick.Visible = selected[opt] == true
                        entries[opt] = tick
                        e.MouseButton1Click:Connect(function()
                            if multi then selected[opt] = (not selected[opt]) or nil
                            else selected = { [opt] = true } end
                            for o, t in pairs(entries) do t.Visible = selected[o] == true end
                            summary()
                            if flag then Nely.Flags[flag] = multi and selected or opt end
                            if dcfg.Callback then
                                if multi then
                                    local picked = {}
                                    for _, o in ipairs(options) do
                                        if selected[o] then picked[#picked + 1] = o end
                                    end
                                    task.spawn(dcfg.Callback, picked)
                                else
                                    task.spawn(dcfg.Callback, opt)
                                end
                            end
                        end)
                    end
                end
                build() summary()

                local expanded = false
                local header = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, ROW), BackgroundTransparency = 1,
                    AutoButtonColor = false, Text = "", ZIndex = 22, Parent = row,
                })
                Hoverable(row, header)
                header.MouseButton1Click:Connect(function()
                    expanded = not expanded
                    Tween(row, { Size = UDim2.new(1, 0, 0,
                        expanded and (ROW + host.AbsoluteSize.Y + 8) or ROW) }, EASE.Glide)
                    Tween(caret, { Rotation = expanded and 180 or 0 }, EASE.Glide)
                end)

                local api = { Instance = row }
                function api:Set(newCfg)
                    if type(newCfg) == "table" and newCfg.Options then
                        options = newCfg.Options build()
                    end
                    if type(newCfg) == "table" and newCfg.CurrentOption then
                        selected = {}
                        for _, v in ipairs(newCfg.CurrentOption) do selected[v] = true end
                        for o, t in pairs(entries) do t.Visible = selected[o] == true end
                    end
                    summary()
                end
                return W:RegisterElement(flag, api)
            end

            function G:CreateInput(icfg, flag)
                icfg = icfg or {}
                local row = Row(ROW)
                RowText(row, icfg.Name or "Input", nil, icfg.Info)
                local wrap = Themed(New("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(150, 24), BackgroundColor3 = Theme.Elevated,
                    BackgroundTransparency = 0.25, BorderSizePixel = 0,
                    ZIndex = 20, Parent = row,
                }, { Corner(8), Stroke("BorderSoft", 1, 0.5) }), "BackgroundColor3", "Elevated")
                local box = Themed(New("TextBox", {
                    Position = UDim2.fromOffset(9, 0), Size = UDim2.new(1, -18, 1, 0),
                    BackgroundTransparency = 1, Text = "",
                    PlaceholderText = icfg.PlaceholderText or "",
                    PlaceholderColor3 = Theme.TextDim, TextColor3 = Theme.Text,
                    TextSize = 11.5, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
                    ZIndex = 21, Parent = wrap,
                }), "TextColor3", "Text")
                local api = { Instance = row }
                function api:Set(v, silent)
                    box.Text = tostring(v or "")
                    if flag then Nely.Flags[flag] = box.Text end
                    if icfg.Callback and not silent then task.spawn(icfg.Callback, box.Text) end
                end
                box.Focused:Connect(function()
                    Tween(wrap, { BackgroundTransparency = 0.05 }, EASE.Snap)
                end)
                -- live filtering feels broken if it only fires on focus loss
                box:GetPropertyChangedSignal("Text"):Connect(function()
                    if flag then Nely.Flags[flag] = box.Text end
                    if icfg.Live ~= false and icfg.Callback then
                        task.spawn(icfg.Callback, box.Text)
                    end
                end)
                box.FocusLost:Connect(function()
                    Tween(wrap, { BackgroundTransparency = 0.25 }, EASE.Snap)
                    if icfg.Live == false and icfg.Callback then
                        task.spawn(icfg.Callback, box.Text)
                    end
                end)
                return W:RegisterElement(flag, api)
            end

            function G:CreateKeybind(kcfg, flag)
                kcfg = kcfg or {}
                local row = Row(ROW)
                RowText(row, kcfg.Name or "Keybind", nil, kcfg.Info)
                local listening = false
                local chip = Themed(New("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(78, 24), BackgroundColor3 = Theme.Elevated,
                    BackgroundTransparency = 0.25, AutoButtonColor = false,
                    Text = tostring(kcfg.CurrentBind or "Unknown"),
                    TextColor3 = Theme.TextSub, TextSize = 11, Font = Enum.Font.GothamMedium,
                    ZIndex = 20, Parent = row,
                }, { Corner(8), Stroke("BorderSoft", 1, 0.5) }), "BackgroundColor3", "Elevated")
                -- HOLD hint, like the reference
                Themed(New("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -96, 0.5, 0),
                    Size = UDim2.fromOffset(34, 14), BackgroundTransparency = 1,
                    Text = "HOLD", TextColor3 = Theme.TextDim, TextSize = 9,
                    Font = Enum.Font.GothamBold, ZIndex = 20, Parent = row,
                }), "TextColor3", "TextDim")

                chip.MouseButton1Click:Connect(function()
                    listening = true chip.Text = "..."
                    Tween(chip, { BackgroundTransparency = 0.02 }, EASE.Snap)
                end)
                UserInputService.InputBegan:Connect(function(i, typing)
                    if not listening or typing then return end
                    if i.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        chip.Text = i.KeyCode.Name
                        Tween(chip, { BackgroundTransparency = 0.25 }, EASE.Snap)
                        if flag then Nely.Flags[flag] = i.KeyCode end
                        if kcfg.OnChanged then task.spawn(kcfg.OnChanged, i.KeyCode) end
                    end
                end)
                local api = { Instance = row }
                function api:Set(k)
                    if typeof(k) == "EnumItem" then
                        chip.Text = k.Name
                        if flag then Nely.Flags[flag] = k end
                        if kcfg.OnChanged then task.spawn(kcfg.OnChanged, k) end
                    end
                end
                return W:RegisterElement(flag, api)
            end

            function G:CreateColorpicker(ccfg, flag)
                ccfg = ccfg or {}
                local colour = ccfg.CurrentValue or Theme.Accent
                local row = Row(ROW)
                RowText(row, ccfg.Name or "Colour", nil, ccfg.Info)
                local swatch = New("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(40, 22), BackgroundColor3 = colour,
                    AutoButtonColor = false, Text = "", BorderSizePixel = 0,
                    ZIndex = 20, Parent = row,
                }, { Corner(7), Stroke("Border", 1, 0.4) })

                local strip = New("Frame", {
                    Position = UDim2.new(0, 12, 0, ROW - 6), Size = UDim2.new(1, -24, 0, 0),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
                    ClipsDescendants = true, ZIndex = 20, Parent = row,
                }, {
                    Corner(6),
                    New("UIGradient", { Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                        ColorSequenceKeypoint.new(0.34, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(0.51, Color3.fromRGB(0, 255, 255)),
                        ColorSequenceKeypoint.new(0.68, Color3.fromRGB(0, 0, 255)),
                        ColorSequenceKeypoint.new(0.85, Color3.fromRGB(255, 0, 255)),
                        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
                    }) }),
                })

                local api = { Instance = row }
                function api:Set(c, silent)
                    if typeof(c) ~= "Color3" then return end
                    colour = c
                    swatch.BackgroundColor3 = c
                    if flag then Nely.Flags[flag] = c end
                    if ccfg.Callback and not silent then task.spawn(ccfg.Callback, c) end
                end

                local open = false
                swatch.MouseButton1Click:Connect(function()
                    open = not open
                    Tween(row, { Size = UDim2.new(1, 0, 0, open and (ROW + 32) or ROW) }, EASE.Glide)
                    Tween(strip, { Size = UDim2.new(1, -24, 0, open and 18 or 0) }, EASE.Glide)
                end)
                local picking = false
                local function pick(px)
                    local a = math.clamp((px - strip.AbsolutePosition.X)
                              / math.max(strip.AbsoluteSize.X, 1), 0, 1)
                    api:Set(Color3.fromHSV(a, 0.72, 1))
                end
                strip.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                       or i.UserInputType == Enum.UserInputType.Touch then
                        picking = true pick(i.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if picking and (i.UserInputType == Enum.UserInputType.MouseMovement
                       or i.UserInputType == Enum.UserInputType.Touch) then pick(i.Position.X) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                       or i.UserInputType == Enum.UserInputType.Touch then picking = false end
                end)

                if flag then Nely.Flags[flag] = colour end
                return W:RegisterElement(flag, api)
            end

            ------------------------------------------------------------
            -- ITEM GRID
            ------------------------------------------------------------
            function G:CreateItemGrid(gridCfg)
                gridCfg = gridCfg or {}
                local cardW = gridCfg.CardWidth or 92
                local cardH = gridCfg.CardHeight or 106

                local wrap = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, ZIndex = 18, Parent = card,
                }, { List(7), Pad(6, 8, 8, 8) })

                local count = Themed(New("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
                    Text = "", TextColor3 = Theme.TextDim, TextSize = 10.5,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
                    LayoutOrder = 1, ZIndex = 19, Parent = wrap,
                }), "TextColor3", "TextDim")

                local grid = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 19, Parent = wrap,
                }, {
                    New("UIGridLayout", {
                        CellSize = UDim2.fromOffset(cardW, cardH),
                        CellPadding = UDim2.fromOffset(7, 7),
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        HorizontalAlignment = Enum.HorizontalAlignment.Left,
                    }),
                })

                local api = { Instance = wrap }

                local function makeCard(item, order)
                    local c = Themed(New("TextButton", {
                        BackgroundColor3 = Theme.Elevated, BackgroundTransparency = 0.3,
                        AutoButtonColor = false, Text = "", LayoutOrder = order,
                        ClipsDescendants = true, ZIndex = 20, Parent = grid,
                    }, { Corner(10), Stroke("BorderSoft", 1, 0.45) }),
                        "BackgroundColor3", "Elevated")

                    New("ImageLabel", {
                        Name = "Art", Position = UDim2.fromOffset(0, 5),
                        Size = UDim2.new(1, 0, 1, -26), BackgroundTransparency = 1,
                        Image = tostring(item.Image or ""), ScaleType = Enum.ScaleType.Fit,
                        ZIndex = 21, Parent = c,
                    })

                    Themed(New("TextLabel", {
                        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4),
                        Size = UDim2.new(1, -6, 0, 13), BackgroundTransparency = 1,
                        Text = tostring(item.Name or "?"), TextColor3 = Theme.TextSub,
                        TextSize = 10, Font = Enum.Font.GothamMedium,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        ZIndex = 21, Parent = c,
                    }, { Pad(0, 0, 5, 0) }), "TextColor3", "TextSub")

                    if item.Badge and item.Badge ~= "" then
                        local badge = New("Frame", {
                            Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(0, 13),
                            AutomaticSize = Enum.AutomaticSize.X,
                            BackgroundColor3 = item.BadgeRainbow and Color3.fromRGB(255, 255, 255)
                                               or (item.BadgeColor or Theme.Accent),
                            BorderSizePixel = 0, ZIndex = 23, Parent = c,
                        }, { Corner(4), Pad(0, 0, 4, 4) })
                        if item.BadgeRainbow then
                            New("UIGradient", { Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 96, 96)),
                                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 226, 118)),
                                ColorSequenceKeypoint.new(0.66, Color3.fromRGB(116, 240, 190)),
                                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(168, 140, 255)),
                            }), Parent = badge })
                        end
                        New("TextLabel", {
                            Size = UDim2.fromOffset(0, 13), AutomaticSize = Enum.AutomaticSize.X,
                            BackgroundTransparency = 1,
                            Text = string.upper(tostring(item.Badge)),
                            TextColor3 = Color3.fromRGB(20, 20, 28), TextSize = 8,
                            Font = Enum.Font.GothamBold, ZIndex = 24, Parent = badge,
                        })
                    end

                    local st = c:FindFirstChildOfClass("UIStroke")
                    c.MouseEnter:Connect(function()
                        Tween(c, { BackgroundTransparency = 0.08 }, EASE.Snap)
                        if st then Tween(st, { Color = Theme.Accent, Transparency = 0 }, EASE.Snap) end
                    end)
                    c.MouseLeave:Connect(function()
                        Tween(c, { BackgroundTransparency = 0.3 }, EASE.Snap)
                        if st then
                            Tween(st, { Color = Theme.BorderSoft, Transparency = 0.45 }, EASE.Snap)
                        end
                    end)
                    c.MouseButton1Click:Connect(function()
                        Ripple(c)
                        if gridCfg.Callback then
                            task.spawn(gridCfg.Callback, item.Id or item.Name, item)
                        end
                    end)
                    return c
                end

                -- Drawing hundreds of cards in one frame locks the client,
                -- so the grid renders in batches with a yield between them.
                local BATCH = 36
                local cap = gridCfg.MaxCards or 260
                local token = 0
                function api:Render(list)
                    token = token + 1
                    local mine = token
                    for _, c in ipairs(grid:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    local shown = math.min(#list, cap)
                    count.Text = #list .. " items"
                        .. (#list > cap and ("  --  showing first " .. cap) or "")
                    task.spawn(function()
                        for i = 1, shown do
                            if token ~= mine then return end
                            makeCard(list[i], i)
                            if i % BATCH == 0 then task.wait() end
                        end
                    end)
                end
                function api:Set(list) api:Render(list or {}) end
                api:Render(gridCfg.Items or {})
                return api
            end

            return G
        end

        ----------------------------------------------------------------
        -- v3 compatibility: a section starts a new card, and controls
        -- created straight on the tab go into the current card.
        ----------------------------------------------------------------
        function Tab:CreateSection(title)
            return Tab:CreateGroup({ Title = title })
        end

        local function ensure()
            if not currentGroup then currentGroup = Tab:CreateGroup({}) end
            return currentGroup
        end

        for _, fn in ipairs({ "CreateToggle", "CreateSlider", "CreateDropdown", "CreateInput",
                              "CreateKeybind", "CreateColorpicker", "CreateButton",
                              "CreateParagraph", "CreateDivider", "CreateLabel",
                              "CreateItemGrid" }) do
            Tab[fn] = function(_, a, b) return ensure()[fn](ensure(), a, b) end
        end

        return Tab
    end

    -- search filters rail buttons by tab name
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(searchBox.Text)
        for _, tab in ipairs(W.Tabs) do
            tab.Button.Visible = q == "" or string.find(string.lower(tab.Name), q, 1, true) ~= nil
        end
    end)

    table.insert(Nely.Windows, W)
    return W
end

return Nely
