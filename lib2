    --
    --   OrbImage   = "138846809155036"   -- a fixed asset, e.g. your logo
    --   OrbPlaceId = 142823291           -- a fixed game's icon
    --   OrbImage   = false               -- no image, brand mark only
    --
    -- OrbPlaceId is the one a single-game script wants: the icon then
    -- stays that game's icon no matter where the script is executed.
    ------------------------------------------------------------

    -- Default is the Nely mark and nothing else. The game thumbnail is now
    -- opt-in via OrbPlaceId or OrbImage = "game": a collapsed Nely window
    -- should look like Nely, not like whatever place it happens to be in.
    if opts.OrbImage == nil and opts.OrbPlaceId == nil then
        -- Brand mark only.
    elseif opts.OrbImage == false then
        -- Explicitly nothing.
    elseif opts.OrbImage and opts.OrbImage ~= "game" then
        ResolveImageAsync(opts.OrbImage, function(asset)
            if asset and orbImage.Parent then
                orbImage.Image = asset
                Tween(orbImage, { ImageTransparency = 0 }, EASE.Smooth)
                ClearOrbBrand()
            end
        end)
    else
        ResolveGameImage({ PlaceId = opts.OrbPlaceId or game.PlaceId }, function(asset)  -- luacheck: ignore
            if asset and orbImage.Parent then
                orbImage.Image = asset
                Tween(orbImage, { ImageTransparency = 0 }, EASE.Smooth)
                ClearOrbBrand()
            end
        end)
    end

    -- breathing halo
    -- The old halo was a ring that expanded 32% and faded, twice a second
    -- -- a notification badge's behaviour on something that is not
    -- notifying you of anything. This just breathes the edge brightness,
    -- slowly, so the control reads as live without demanding attention.
    local orbRim = orb:FindFirstChildOfClass("UIStroke")

    local haloClock = 0
    local haloConn = RunService.RenderStepped:Connect(function(dt)
        if not orb.Visible or not orbRim then return end
        haloClock = haloClock + dt
        local pulse = (math.sin(haloClock * 1.1) + 1) * 0.5
        orbRim.Transparency = 0.5 - pulse * 0.22
    end)
    table.insert(Nely.Connections, haloConn)

    Hover(orb, function(inside)
        Tween(orb, {
            BackgroundColor3       = inside and theme.Elevated or theme.Surface,
            BackgroundTransparency = inside and 0 or 0.05,
        }, EASE.Snap)
    end)

    ----------------------------------------------------------------
    -- Open / minimize / close
    ----------------------------------------------------------------

    ----------------------------------------------------------------
    -- Why these animate a UIScale instead of Size
    --
    -- Tweening shell.Size looked wrong, and it is worth being precise
    -- about why. The shell does not clip, and its children are only
    -- partly scale-sized: the sidebar is a fixed 168px wide, the topbar
    -- a fixed 46px tall, and every piece of text is a fixed point size.
    -- So shrinking the shell did not shrink the window — it shrank the
    -- backdrop out from under content that stayed exactly where it was,
    -- and on close, when the target was zero, the whole interface was
    -- left hanging in space around a frame with no size at all.
    --
    -- UIScale scales the entire subtree, text and fixed offsets and all,
    -- so the window behaves like one object. Scale is reset to 1 once
    -- the window is open, so dragging and resizing never see it.
    ----------------------------------------------------------------

    local shellScale = New("UIScale", { Scale = 1, Parent = shell })
    local orbScale   = New("UIScale", { Scale = 1, Parent = orb })

    -- Where the shell sits when it is not flying anywhere. Captured before
    -- the first minimize and restored on open, so a window the user dragged
    -- somewhere comes back to where they left it.
    local homePosition = shell.Position

    ----------------------------------------------------------------
    -- RESPONSIVE MANAGER
    --
    -- The old build measured the viewport once, at construction, and then
    -- never looked again. That is fine until something changes it -- and
    -- on Roblox plenty does: rotating a phone, resizing a desktop window,
    -- Roblox's own UI entering or leaving fullscreen. The window would
    -- stay sized for a screen that no longer existed, sometimes hanging
    -- off the edge with its close button unreachable.
    --
    -- Three modes rather than a continuum, because a continuum means the
    -- layout is subtly different at every width and testable at none:
    --
    --   mobile   < 620px   rail the sidebar, maximise the shell
    --   compact  < 900px   narrower sidebar, shorter topbar
    --   desktop  >= 900px  full width sidebar
    --
    -- Row heights are deliberately NOT re-derived. They are baked into
    -- every control at build time, and re-flowing them would mean
    -- rebuilding the entire tree on a rotation -- a worse outcome than
    -- rows that are 4px taller than ideal.
    ----------------------------------------------------------------

    -- Auto sizing only applies when the hub did not name a size. Someone
    -- who passed Size = UDim2.fromOffset(800, 600) meant it.
    local autoSized      = (opts.Size == nil)
    local responsive     = opts.Responsive ~= false
    Window.Responsive    = responsive
    Window.Mode          = "desktop"
    local resizeHooks    = {}

    function Window:OnResize(fn)
        if type(fn) ~= "function" then return function() end end
        table.insert(resizeHooks, fn)
        return function()
            for i, entry in ipairs(resizeHooks) do
                if entry == fn then table.remove(resizeHooks, i) return end
            end
        end
    end

    local function ModeFor(width)
        if width < Design.Breakpoint.Mobile  then return "mobile"  end
        if width < Design.Breakpoint.Compact then return "compact" end
        return "desktop"
    end

    -- Keep the shell on screen. A window remembered from a 1920-wide
    -- session must not open at x=1600 on a phone.
    local function ClampToViewport(vp)
        local abs = shell.AbsoluteSize
        if abs.X <= 0 or abs.Y <= 0 then return end
        local half = abs / 2                     -- shell is centre anchored
        local pos  = shell.Position
        local x    = pos.X.Scale * vp.X + pos.X.Offset
        local y    = pos.Y.Scale * vp.Y + pos.Y.Offset
        local cx   = math.clamp(x, half.X, math.max(half.X, vp.X - half.X))
        local cy   = math.clamp(y, half.Y, math.max(half.Y, vp.Y - half.Y))
        if math.abs(cx - x) > 0.5 or math.abs(cy - y) > 0.5 then
            shell.Position = UDim2.fromOffset(cx, cy)
        end
    end

    local function ApplyLayout(vp, mode, animate)
        local ease = animate == false and EASE.Instant or EASE.Glide

        -- Sidebar and topbar are locals captured by ApplyRail and the tab
        -- layout, so reassigning them here is enough for everything
        -- downstream to agree on the new numbers.
        if not opts.SidebarWidth then
            sidebarW = (mode == "desktop") and 214
                    or (mode == "compact") and 186
                    or 164
        end
        topbarH = (mode == "desktop") and 52 or 46

        if autoSized and not Window._userSized then
            -- Height floors are driven by the sidebar, not by taste. The
            -- sidebar has to fit a search box (46), the player card (~100),
            -- the topbar (46) and enough tab rows to be worth having. At
            -- 333px -- what the previous numbers produced on a 617px tall
            -- viewport -- the fifth tab fell below the fold, and a tab list
            -- that needs scrolling to reach five items reads as broken even
            -- though it scrolls fine.
            -- Desktop targets 760-860 wide. That is the width at which a
            -- 220px sidebar still leaves two readable columns of cards; go
            -- narrower and the second column stops being worth having.
            --
            -- Mobile takes most of the viewport but never all of it: a
            -- window flush against every edge looks like a crash screen,
            -- and the drag handle needs somewhere to live.
            local w, h
            if mode == "mobile" then
                w = Fit(0.92, 300, 560, vp.X)
                h = Fit(0.82, 360, 680, vp.Y)
            elseif mode == "compact" then
                w = Fit(0.86, 420, 700, vp.X)
                h = Fit(0.80, 380, 580, vp.Y)
            else
                w = Fit(0.58, 760, 860, vp.X)
                h = Fit(0.68, 500, 580, vp.Y)
            end
            Window.CurrentSize = UDim2.fromOffset(w, h)
            Tween(shell, { Size = Window.CurrentSize }, ease)
        end

        -- On a phone the sidebar is a third of the screen. Rail it, unless
        -- the user has explicitly toggled the rail themselves this session.
        if not Window._userRailed then
            local wantRail = (mode == "mobile")
            if wantRail ~= (Window.Railed and true or false) then
                ApplyRail(wantRail, animate)
            else
                ApplyRail(Window.Railed, false)
            end
        else
            ApplyRail(Window.Railed, false)
        end

        Tween(topbar, { Size = UDim2.new(1, 0, 0, topbarH) }, ease)
        LayoutTabList()
        ClampToViewport(vp)
    end

    local function Reflow(animate)
        if Window.Destroyed then return end
        local cam = workspace.CurrentCamera
        local vp  = cam and cam.ViewportSize or Vector2.new(1280, 720)
        if vp.X <= 0 or vp.Y <= 0 then return end

        local mode    = responsive and ModeFor(vp.X) or Window.Mode
        local changed = (mode ~= Window.Mode)
        Window.Mode     = mode
        Window.Viewport = vp

        ApplyLayout(vp, mode, animate)

        for i = #resizeHooks, 1, -1 do
            local ok = pcall(resizeHooks[i], vp, mode, changed)
            if not ok then table.remove(resizeHooks, i) end
        end
    end
    Window.Reflow = function(_, animate) Reflow(animate) end

    -- The camera itself can be replaced (respawn, some games swap it), so
    -- the ViewportSize listener has to be re-bound rather than connected
    -- once and forgotten.
    do
        local vpConn
        local function Watch(cam)
            if vpConn then vpConn:Disconnect() vpConn = nil end
            if not cam then return end
            vpConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                Reflow(true)
            end)
            table.insert(Window._conns, vpConn)
        end
        Watch(workspace.CurrentCamera)
        Track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            Watch(workspace.CurrentCamera)
            Reflow(true)
        end))
    end

    -- First pass without animation: this is the initial layout, not a
    -- change of one.
    Window.Mode = ModeFor((workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)).X)
    task.defer(function()
        if not Window.Destroyed then Reflow(false) end
    end)


    -- Centre of the orb expressed in the shell's terms. The shell is centre
    -- anchored and so is the orb, so this is just the orb's own position.
    local function OrbAnchor()
        return orb.Position
    end

    local function OpenWindow(animate)
        local fromOrb    = Window.Minimized
        Window.Minimized = false
        shell.Visible    = true
        -- blurTarget is 0 when the user turned blur off, so opening the
        -- window must not quietly switch it back on.
        Tween(Blur, { Size = BlurDepth() }, EASE.Glide)

        -- The orb used to blink out of existence. It now retracts, which
        -- also covers the moment the shell is growing over the top of it.
        if orb.Visible then
            Tween(orbScale, { Scale = 0 }, EASE.Collapse)
            task.delay(0.22, function()
                if not Window.Destroyed and not Window.Minimized then
                    orb.Visible = false
                end
            end)
        end

        if animate == false then
            shellScale.Scale = 1
            shell.Position   = homePosition
            -- `glass` is the configured value; 0.04 here was a hardcoded
            -- leftover that silently overrode it on every open, which is
            -- why the window rendered nearly solid however Glass was set.
            shell.BackgroundTransparency = glass
            return
        end

        -- Mirror of the minimize: the shell starts at the orb's footprint
        -- and expands, so it reads as coming out of the control rather than
        -- fading in over it.
        if fromOrb then
            shell.Size     = UDim2.fromOffset(ORB, ORB)
            shell.Position = OrbAnchor()
            Tween(shell, { Size = Window.CurrentSize }, EASE.Fly)
        end

        -- Grow out of wherever it collapsed to, then settle home. Position
        -- and scale run on the same clock so it reads as one movement.
        --
        -- Coming back from the orb the shell is already parked on top of it
        -- at 5%. On a first open there is nothing to grow from, so it starts
        -- just under full size: enough for the spring to have something to
        -- do, not so much that the window lurches.
        if not fromOrb then
            shellScale.Scale = 0.92
            shell.Position   = homePosition
        end

        -- `glass` is the configured value; 0.04 here was a hardcoded
            -- leftover that silently overrode it on every open, which is
            -- why the window rendered nearly solid however Glass was set.
            shell.BackgroundTransparency = glass
        Tween(shell, { Position = homePosition }, EASE.Fly)
        Tween(shellScale, { Scale = 1 }, EASE.Spring)
    end

    local function MinimizeWindow()
        if Window.Minimized then return end
        Window.Minimized = true
        Tween(Blur, { Size = 0 }, EASE.Smooth)

        homePosition = shell.Position
        local token  = Generation()

        orb.Visible    = true
        orbScale.Scale = 0

        -- 1. Contents go first. The window should look like it is emptying
        --    before it folds, not like a screenshot being scaled down.
        if Window.ActiveTab and Window.ActiveTab._wrap
           and Window.ActiveTab._wrap:IsA("CanvasGroup") then
            Tween(Window.ActiveTab._wrap, { GroupTransparency = 1 }, EASE.Snap)
        end
        Tween(sidebar, { Position = UDim2.fromOffset(-sidebarW, topbarH) }, EASE.Page)
        Tween(topbar,  { BackgroundTransparency = 1 }, EASE.Snap)
        for _, child in ipairs(topbar:GetDescendants()) do
            if child:IsA("TextLabel") then
                Tween(child, { TextTransparency = 1 }, EASE.Snap)
            elseif child:IsA("ImageLabel") then
                Tween(child, { ImageTransparency = 1 }, EASE.Snap)
            end
        end

        -- 2. Then the frame itself compresses into the orb's footprint --
        --    a real size change, so the corners visibly travel inward.
        task.delay(0.08, function()
            if not Current(token) or not Window.Minimized then return end
            Tween(shell, {
                Position = OrbAnchor(),
                Size     = UDim2.fromOffset(ORB, ORB),
            }, EASE.Fly)
            Tween(shellScale, { Scale = 0.9 }, EASE.Smooth)
        end)

        -- 3. Hand over to the orb.
        task.delay(0.34, function()
            if Window.Destroyed or not Window.Minimized then return end
            shell.Visible    = false
            shell.Size       = Window.CurrentSize
            shellScale.Scale = 1
            -- Restore what step 1 faded, ready for the next open.
            sidebar.Position = UDim2.fromOffset(0, topbarH)
            for _, child in ipairs(topbar:GetDescendants()) do
                if child:IsA("TextLabel") then
                    child.TextTransparency = 0
                elseif child:IsA("ImageLabel") then
                    child.ImageTransparency = 0
                end
            end
            if Window.ActiveTab and Window.ActiveTab._wrap
               and Window.ActiveTab._wrap:IsA("CanvasGroup") then
                Window.ActiveTab._wrap.GroupTransparency = 0
            end
            Tween(orbScale, { Scale = 1 }, EASE.Spring)
        end)
    end

    function Window:Destroy()
        if Window.Destroyed then return end
        Window.Destroyed = true
        UserInputService.MouseIconEnabled = true

        Tween(Blur, { Size = 0 }, EASE.Smooth)

        -- 1. Empty the window. Content leaves before the frame does, so
        --    the close reads as the interface standing down rather than
        --    the whole thing being deleted mid-frame.
        if Window.ActiveTab and Window.ActiveTab._wrap
           and Window.ActiveTab._wrap:IsA("CanvasGroup") then
            Tween(Window.ActiveTab._wrap, { GroupTransparency = 1 }, EASE.Instant)
        end
        Tween(sidebar, { Position = UDim2.fromOffset(-sidebarW, topbarH) }, EASE.Snap)
        for _, child in ipairs(topbar:GetDescendants()) do
            if child:IsA("TextLabel") then
                Tween(child, { TextTransparency = 1 }, EASE.Instant)
            elseif child:IsA("ImageLabel") then
                Tween(child, { ImageTransparency = 1 }, EASE.Instant)
            end
        end

        -- 2. Then the frame settles down and away. A slight swell first
        --    (Collapse eases Back/In) so it has weight on the way out.
        task.delay(0.1, function()
            Tween(shellScale, { Scale = 0.92 }, EASE.Smooth)
            Tween(shell, { BackgroundTransparency = 1 }, EASE.Smooth)
        end)
        Tween(orbScale, { Scale = 0 }, EASE.Collapse)

        -- Bump the generation first. Anything already queued with
        -- task.delay -- a tab fade, a dropdown close, an orb settle --
        -- checks this and gives up, rather than tweening a frame that is
        -- about to be destroyed.
        Generation()

        task.delay(0.4, function()
            -- Window-scoped listeners: the ViewportSize watcher, the camera
            -- watcher, anything registered through Track. These used to
            -- outlive the window, so running a hub twice in one session
            -- left the first window's handlers firing against dead frames.
            for _, conn in ipairs(Window._conns) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(Window._conns)

            -- Theme hooks are plain functions on a module-level list, so
            -- they outlive the window unless explicitly removed.
            for _, off in ipairs(Window._themeHooks) do pcall(off) end
            table.clear(Window._themeHooks)

            for _, conn in ipairs(Nely.Connections) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(Nely.Connections)

            -- Stop every in-flight tween before the instances go away.
            CancelTweens(shell)
            CancelTweens(orb)

            pcall(function() Blur:Destroy() end)
            pcall(function() Root:Destroy() end)
            Nely.Window   = nil
            Nely.Unloaded = true
        end)
    end

    closeBtn.MouseButton1Click:Connect(function()
        Ripple(closeBtn, 24)
        Nely:Dialog({
            Title   = L("dialog.close_title", title),
            Content = L("dialog.close_body"),
            Icon    = "alert",
            Buttons = {
                { Title = "Cancel" },
                { Title = "Close", Primary = true, Callback = function() Window:Destroy() end },
            },
        })
    end)

    minBtn.MouseButton1Click:Connect(function()
        Ripple(minBtn, 24)
        MinimizeWindow()
    end)

    Draggable(orb, orb, function(moved)
        if moved < 6 then OpenWindow(true) end
    end)

    Draggable(topbar, shell)

    local keyConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed or Window.Destroyed then return end
        if input.KeyCode == toggleKey then
            if Window.Minimized then OpenWindow(true) else MinimizeWindow() end
        end
    end)
    table.insert(Nely.Connections, keyConn)

    function Window:Open()  OpenWindow(true) end
    function Window:Close() MinimizeWindow() end
    function Window:Toggle()
        if Window.Minimized then OpenWindow(true) else MinimizeWindow() end
    end

    -- custom cursor takes over while the pointer sits on the shell or the orb
    if opts.CustomCursor ~= false then
        BuildCursor(theme)
        table.insert(Cursor.Targets, shell)
        table.insert(Cursor.Targets, orb)
    end

    ----------------------------------------------------------------
    -- Tab sections
    --
    -- A labelled group in the sidebar that owns its own tabs, so a hub
    -- with twenty scripts can file them under headings instead of one
    -- flat list. Sections and loose tabs share a single order counter,
    -- which is what keeps a section's tabs sitting under its heading
    -- rather than drifting to the bottom of the list.
    ----------------------------------------------------------------

    function Window:CreateTabSection(sectionOpts)
        sectionOpts = type(sectionOpts) == "string"
            and { Title = sectionOpts }
            or (sectionOpts or {})

        Window._tabOrder = Window._tabOrder + 1

        -- Caption row for a group of tabs. The section icon used to sit to
        -- the left of the title; the sidebar reads cleaner with the tab
        -- glyphs carrying all the iconography, so the title stands alone.
        local header = New("Frame", {
            Name                   = "Section",
            Size                   = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1,
            LayoutOrder            = Window._tabOrder,
            ZIndex                 = 17,
            Parent                 = tabList,
        }, {
            New("UIListLayout", {
                Padding           = UDim.new(0, 6),
                FillDirection     = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                SortOrder         = Enum.SortOrder.LayoutOrder,
            }),
            Pad(10, 0, 5, 0),
        })

        New("TextLabel", {
            Size                   = UDim2.fromOffset(0, 14),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                   = string.upper(sectionOpts.Title or "Section"),
            TextColor3             = theme.TextDim,
            TextSize               = 10,
            Font                   = Enum.Font.GothamBold,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextYAlignment         = Enum.TextYAlignment.Center,
            LayoutOrder            = 2,
            ZIndex                 = 18,
            Parent                 = header,
        })

        local Section = { Title = sectionOpts.Title, Tabs = {}, _header = header }

        function Section:CreateTab(tabOpts)
            local tab = Window:CreateTab(tabOpts)
            table.insert(Section.Tabs, tab)
            tab.Section = Section
            return tab
        end

        -- Collapse hides the tabs but never the active one, so the page
        -- can't be left showing content whose tab has disappeared.
        function Section:SetCollapsed(collapsed)
            Section.Collapsed = collapsed
            for _, tab in ipairs(Section.Tabs) do
                tab.Button.Visible = (not collapsed) or (Window.ActiveTab == tab)
            end
        end

        table.insert(Window.TabSections, Section)
        return Section
    end

    ----------------------------------------------------------------
    -- Tabs
    ----------------------------------------------------------------

    -- V4 tab hues.
    --
    -- Golden-angle hue rotation. It guarantees adjacent tabs never share a
    -- colour, which is genuinely useful -- but ONLY when the hub asked for
    -- colour. It is no longer the default: a sidebar of twelve unrelated
    -- rainbow icons reads as a toy, and it fights a metallic logo for
    -- attention. Monochrome now, colour on request via Window.ColorfulTabs
    -- or a per-tab IconColor.
    local function AutoHue(index)
        local hue = ((index - 1) * 0.618033988749895) % 1
        return Color3.fromHSV(hue, 0.55, 1)
    end

    local function TabHue(index)
        if Window.ColorfulTabs then return AutoHue(index) end
        return nil   -- nil means "follow the theme", resolved live below
    end

    -- The single authority on what every sidebar tab looks like. Called by
    -- Activate and again after any theme change; `animate = false` on the
    -- theme path because SetTheme is already animating everything else and
    -- a second overlapping tween on the same properties just muddies it.
    local function PaintTabs(animate)
        local ease = (animate == false) and EASE.Instant or EASE.Snap
        for _, tab in ipairs(Window.Tabs) do
            local active = (Window.ActiveTab == tab)
            local hue    = tab.IconColor or theme.Accent

            -- The row itself: an elevated pill when selected, nothing at all
            -- when not. Depth carries the state, not colour.
            Tween(tab.Button, {
                BackgroundColor3       = theme.Elevated,
                BackgroundTransparency = active and 0.28 or 1,
            }, ease)

            if tab._label then
                Tween(tab._label, {
                    TextColor3       = active and theme.Text or theme.TextSub,
                    TextTransparency = Window.Railed and 1 or 0,
                }, ease)
                tab._label.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
            end

            if tab._icon then
                TintIcon(tab._icon, active and theme.Text or hue)
                Tween(tab._icon, {
                    ImageTransparency = active and 0 or 0.45,
                }, ease)
            end

            -- Leading indicator. Grows out of nothing rather than sliding
            -- down a shared rail, so it cannot drift out of alignment when
            -- the tab list is scrolled.
            if tab._marker then
                Tween(tab._marker, {
                    BackgroundColor3 = theme.Accent,
                    Size             = UDim2.fromOffset(3, active and 18 or 0),
                }, (animate == false) and EASE.Instant or EASE.Glide)
            end
        end
    end
    Window.PaintTabs = function(_, animate) PaintTabs(animate) end

    -- Re-assert selection after a theme change. Without this the active
    -- chip reverts to the resting colour and stays there until the user
    -- happens to click a different tab.
    table.insert(Window._themeHooks, Nely:OnTheme(function()
        if not Window.Destroyed then PaintTabs(false) end
    end))

    function Window:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        Window._tabOrder = Window._tabOrder + 1
        local order     = Window._tabOrder
        local localeKey = tabOpts.LocaleKey
        local tabName   = tabOpts.Name or (localeKey and L(localeKey)) or ("Tab " .. order)
        local iconName  = tabOpts.Icon or "layers"
        -- Two values, deliberately. `tabHue` may be nil, meaning "this tab
        -- has no opinion, follow the theme" -- that nil is what lets the
        -- accent track a theme change, because every later read is
        -- `Tab.IconColor or theme.Accent`. `iconColor` is the concrete
        -- colour to paint with right now.
        local tabHue    = tabOpts.IconColor or TabHue(order)
        local iconColor = tabHue or theme.Accent

        local Tab = { Name = tabName, Sections = {}, IconColor = tabHue }

        ------------------------------------------------------------
        -- Navigation row
        --
        -- One TextButton, and everything drawn on it is inert. That is a
        -- hard requirement, not a style choice: Roblox hands the click to
        -- the topmost Active object, so a single decorative label with
        -- Active = true is enough to make half the row dead. NoInput at the
        -- end of this function is what guarantees the whole rectangle is
        -- one target.
        ------------------------------------------------------------

        local ROW_TAB_H = UserInputService.TouchEnabled and 44 or 40

        local btn = New("TextButton", {
            Name                   = tabName,
            Size                   = UDim2.new(1, 0, 0, ROW_TAB_H),
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 1,
            AutoButtonColor        = false,
            Text                   = "",
            LayoutOrder            = order,
            ClipsDescendants       = true,
            ZIndex                 = 17,
            Parent                 = tabList,
        }, { Corner(Design.Radius.SM + 2) })

        local marker = New("Frame", {
            Name                   = "Marker",
            Size                   = UDim2.fromOffset(3, 0),
            Position               = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundColor3       = theme.Accent,
            BorderSizePixel        = 0,
            ZIndex                 = 19,
            Parent                 = btn,
        }, { Corner(2) })

        -- Bare glyph. No tile, no tint square.
        local icon = Icons.Render(iconName, btn, 17, iconColor, 18)
        icon.AnchorPoint       = Vector2.new(0, 0.5)
        icon.Position          = UDim2.new(0, 15, 0.5, 0)
        icon.ImageTransparency = 0.45

        local label = New("TextLabel", {
            Size                   = UDim2.new(1, -56, 1, 0),
            Position               = UDim2.fromOffset(43, 0),
            BackgroundTransparency = 1,
            Text                   = tabName,
            TextColor3             = theme.TextSub,
            TextSize               = Design.Text.Control,
            Font                   = Enum.Font.GothamMedium,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextTruncate           = Enum.TextTruncate.AtEnd,
            ZIndex                 = 18,
            Parent                 = btn,
        })
        if localeKey then BindText(label, "Text", localeKey) end

        -- Optional tag. Flat text, no filled pill -- a coloured capsule next
        -- to a muted nav row was louder than the selected row itself.
        local tagChip
        if tabOpts.Tag and tabOpts.Tag ~= "" then
            tagChip = New("TextLabel", {
                Name                   = "Tag",
                AnchorPoint            = Vector2.new(1, 0.5),
                Position               = UDim2.new(1, -12, 0.5, 0),
                Size                   = UDim2.fromOffset(0, 14),
                AutomaticSize          = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text                   = string.upper(tostring(tabOpts.Tag)),
                TextColor3             = tabOpts.TagColor or theme.AccentDeep,
                TextSize               = 9,
                Font                   = Enum.Font.GothamBold,
                ZIndex                 = 19,
                Parent                 = btn,
            })
            label.Size = UDim2.new(1, -96, 1, 0)
        end
        Tab._tag = tagChip

        ------------------------------------------------------------
        -- Page
        --
        -- Three layers now, where there used to be one flat list of rows:
        --
        --   page      the scroller
        --    header   page title + description -- the top of the hierarchy
        --    grid     one or two columns of section cards
        --
        -- The page title is deliberately the largest text on screen. In
        -- the old build the biggest thing on a page was whichever control
        -- happened to be first, so every page looked like a list and none
        -- of them looked like a place.
        ------------------------------------------------------------

        -- CanvasGroup so the whole page can fade as one object. Falls back
        -- to a plain Frame on a client old enough not to have it, in which
        -- case the transition is movement-only rather than broken.
        local pageWrap
        local okWrap = pcall(function()
            pageWrap = New("CanvasGroup", {
                Name                   = tabName .. "Wrap",
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                GroupTransparency      = 0,
                BorderSizePixel        = 0,
                Visible                = false,
                ZIndex                 = 16,
                Parent                 = content,
            })
        end)
        if not okWrap or not pageWrap then
            pageWrap = New("Frame", {
                Name                   = tabName .. "Wrap",
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Visible                = false,
                ZIndex                 = 16,
                Parent                 = content,
            })
        end

        local page = New("ScrollingFrame", {
            Name                   = tabName .. "Page",
            Size                   = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
            ScrollBarThickness     = 3,
            ScrollBarImageColor3   = theme.Border,
            ScrollBarImageTransparency = 0.35,
            CanvasSize             = UDim2.new(),
            AutomaticCanvasSize    = Enum.AutomaticSize.Y,
            ScrollingDirection     = Enum.ScrollingDirection.Y,
            ElasticBehavior        = Enum.ElasticBehavior.WhenScrollable,
            Visible                = true,
            ZIndex                 = 16,
            Parent                 = pageWrap,
        }, {
            List(Design.Spacing.LG),
            Pad(Design.Spacing.XL, Design.Spacing.XL, Design.Spacing.XL, Design.Spacing.MD),
        })

        -- Page header ------------------------------------------------
        local pageHeader = New("Frame", {
            Name                   = "PageHeader",
            Size                   = UDim2.new(1, 0, 0, 0),
            AutomaticSize          = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder            = 0,
            ZIndex                 = 17,
            Parent                 = page,
        }, { List(2) })

        local pageTitle = New("TextLabel", {
            Name                   = "PageTitle",
            Size                   = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            Text                   = tabOpts.Title or tabName,
            TextColor3             = theme.Text,
            TextSize               = Design.Text.PageTitle,
            Font                   = Enum.Font.GothamBold,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextTruncate           = Enum.TextTruncate.AtEnd,
            LayoutOrder            = 1,
            ZIndex                 = 18,
            Parent                 = pageHeader,
        })
        if localeKey then BindText(pageTitle, "Text", localeKey) end

        local pageDesc
        if tabOpts.Description or tabOpts.DescKey then
            pageDesc = New("TextLabel", {
                Name                   = "PageDescription",
                Size                   = UDim2.new(1, -40, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Text                   = tabOpts.DescKey and L(tabOpts.DescKey)
                                         or tabOpts.Description,
                TextColor3             = theme.TextDim,
                TextSize               = Design.Text.Meta + 1,
                Font                   = Enum.Font.Gotham,
                TextXAlignment         = Enum.TextXAlignment.Left,
                TextWrapped            = true,
                LayoutOrder            = 2,
                ZIndex                 = 18,
                Parent                 = pageHeader,
            })
            if tabOpts.DescKey then BindText(pageDesc, "Text", tabOpts.DescKey) end
        end

        -- Column grid --------------------------------------------------
        local grid = New("Frame", {
            Name                   = "Grid",
            Size                   = UDim2.new(1, 0, 0, 0),
            AutomaticSize          = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder            = 1,
            ZIndex                 = 16,
            Parent                 = page,
        }, { List(Design.Spacing.LG, Enum.FillDirection.Horizontal) })

        local function Column(order)
            return New("Frame", {
                Name                   = "Col" .. order,
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = order,
                ZIndex                 = 16,
                Parent                 = grid,
            }, { List(Design.Spacing.LG) })
        end

        local colA, colB = Column(1), Column(2)

        -- Two columns is opt-in per tab and only ever on a wide viewport.
        -- Forcing it everywhere produces two unreadable 150px columns on a
        -- phone, which is worse than one honest column.
        local wantColumns = (tabOpts.Columns == 2) or (tabOpts.Columns == true)
        -- Rows in a half-width column are titles and values only.
        local narrowRows  = wantColumns
        local twoCol      = false
        local estA, estB  = 0, 0

        local function ApplyColumns()
            local on = wantColumns and Window.Mode == "desktop"
            if on == twoCol then return end
            twoCol = on
            colB.Visible = on
            if on then
                colA.Size = UDim2.new(0.5, -Design.Spacing.LG / 2, 0, 0)
                colB.Size = UDim2.new(0.5, -Design.Spacing.LG / 2, 0, 0)
            else
                colA.Size = UDim2.new(1, 0, 0, 0)
                colB.Size = UDim2.new(1, 0, 0, 0)
                -- Collapsing back to one column: everything returns to A in
                -- its original order, so the page does not shuffle itself.
                local moving = {}
                for _, child in ipairs(colB:GetChildren()) do
                    if child:IsA("GuiObject") then table.insert(moving, child) end
                end
                table.sort(moving, function(x, y) return x.LayoutOrder < y.LayoutOrder end)
                for _, child in ipairs(moving) do child.Parent = colA end
                estA, estB = estA + estB, 0
            end
        end
        ApplyColumns()
        Window:OnResize(function() ApplyColumns() end)

        local pageScale
        Tab.Page   = page       -- kept: hubs reference this
        Tab._wrap  = pageWrap
        Tab.Button = btn
        Tab._order = 0

        local function Activate()
            if Window.ActiveTab == Tab then return end
            local previous = Window.ActiveTab
            Window.ActiveTab = Tab

            PaintTabs(true)

            -- Latest selection always wins. The outgoing page's cleanup is
            -- stamped with the generation that scheduled it, so hammering
            -- five tabs cannot leave a stale timer hiding the page you
            -- actually landed on.
            local token = Generation()

            if previous and previous._wrap then
                local old = previous._wrap
                -- Out fast: 0.12s, and only 8px. The page you just left
                -- should not linger long enough to compete with the one
                -- you asked for.
                Tween(old, { Position = UDim2.fromOffset(-8, 0) }, EASE.Instant)
                if old:IsA("CanvasGroup") then
                    Tween(old, { GroupTransparency = 1 }, EASE.Snap)
                end
                task.delay(0.2, function()
                    if Window.Destroyed then return end
                    -- Only hide it if it is still not the active page AND
                    -- nothing newer has been scheduled since.
                    if Window.ActiveTab ~= previous and old.Parent then
                        old.Visible = true
                        if old:IsA("CanvasGroup") then old.GroupTransparency = 1 end
                        old.Visible = false
                    end
                end)
            end

            -- First reveal of a page staggers its cards in. Only the first
            -- time: on every later visit the page is already assembled and
            -- re-animating it would just feel slow.
            if not Tab._revealed then
                Tab._revealed = true
                local n = 0
                for _, col in ipairs({ colA, colB }) do
                    for _, child in ipairs(col:GetChildren()) do
                        if child:IsA("GuiObject") then
                            n = n + 1
                            local startY = child.Position
                            child.Position = startY + UDim2.fromOffset(0, 6)
                            local delay = math.min(n, 6) * 0.026
                            task.delay(delay, function()
                                if child.Parent then
                                    Tween(child, { Position = startY }, EASE.Page)
                                end
                            end)
                        end
                    end
                end
            end

            -- In slower and further, with a touch of scale so the page
            -- arrives rather than simply appearing.
            -- Always open at the top. A grid that renders in batches
            -- grows the canvas under a preserved scroll offset, which is
            -- why the crosshair page opened 200px down.
            page.CanvasPosition = Vector2.zero

            pageWrap.Visible  = true
            pageWrap.Position = UDim2.fromOffset(14, 0)
            if pageWrap:IsA("CanvasGroup") then pageWrap.GroupTransparency = 1 end
            if not pageScale then
                pageScale = New("UIScale", { Scale = 1, Parent = pageWrap })
            end
            pageScale.Scale = 0.985
            Tween(pageWrap,  { Position = UDim2.fromOffset(0, 0) }, EASE.Smooth)
            Tween(pageScale, { Scale = 1 }, EASE.Smooth)
            if pageWrap:IsA("CanvasGroup") then
                Tween(pageWrap, { GroupTransparency = 0 }, EASE.Smooth)
            end

        end

        Tab._label  = label
        Tab._icon   = icon
        Tab._marker = marker
        Tab.Activate = Activate

        -- Hover moves the whole row, not just its background. Previously
        -- the chip and glyph stayed frozen while the row lit up underneath
        -- them, which made the tab look like two things that happened to
        -- be next to each other.
        Hover(btn, function(inside)
            if Window.ActiveTab == Tab then return end
            Tween(btn,   { BackgroundColor3       = theme.Elevated,
                           BackgroundTransparency = inside and 0.6 or 1 }, EASE.Snap)
            Tween(label, { TextColor3 = inside and theme.Text or theme.TextSub }, EASE.Snap)
            Tween(icon,  { ImageTransparency = inside and 0.15 or 0.45 }, EASE.Snap)
        end)
        btn.MouseButton1Click:Connect(function()
            -- Ripple sat at ZIndex 19, above the icon (18) and label (18), so
            -- every click swept a white disc across them. It belongs behind
            -- the content, not over it.
            Ripple(btn, 17)
            Activate()
        end)

        -- MANDATORY: every decoration on this row is made inert so the
        -- button underneath receives clicks anywhere in its rectangle --
        -- on the glyph, on the words, on the empty right-hand side.
        NoInput(btn)

        table.insert(Window.Tabs, Tab)

        -- Only while railed. With the sidebar expanded the name is already
        -- sitting right there, and a tooltip repeating it is just noise.
        btn.MouseEnter:Connect(function()
            if Window.Railed then ShowTip(tabName, btn) end
        end)
        btn.MouseLeave:Connect(HideTip)

        ------------------------------------------------------------
        -- Element scaffolding
        ------------------------------------------------------------

        local function NextOrder()
            Tab._order = Tab._order + 1
            return Tab._order
        end

        ------------------------------------------------------------
        -- Info dot
        --
        -- Sits immediately after an element's name, so it has to know how
        -- wide that name rendered. GetTextSize measures it without waiting
        -- for a layout pass, which matters because AbsoluteSize is still
        -- zero on the frame an element is built in.
        ------------------------------------------------------------

        local function InfoDot(row, labelInst, text, zindex)
            if not text or text == "" or not labelInst then return nil end

            local width
            local ok, measured = pcall(function()
                return TextService:GetTextSize(
                    labelInst.Text, labelInst.TextSize, labelInst.Font,
                    Vector2.new(4096, 64))
            end)
            if ok and measured then
                width = measured.X
            else
                width = #labelInst.Text * labelInst.TextSize * 0.52
            end
            -- Names longer than this are truncated by the label anyway, so
            -- following the untruncated width would park the dot on top of
            -- whatever control sits on the right.
            width = math.min(width, 190)

            local dot = New("TextButton", {
                Name                   = "Info",
                Size                   = UDim2.fromOffset(15, 15),
                Position               = UDim2.new(
                    labelInst.Position.X.Scale, labelInst.Position.X.Offset + math.ceil(width) + 7,
                    labelInst.Position.Y.Scale, labelInst.Position.Y.Offset),
                AnchorPoint            = Vector2.new(0, labelInst.AnchorPoint.Y),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = zindex or 19,
                Parent                 = row,
            })

            local glyph = Icons.Render("info", dot, 12, theme.TextDim, (zindex or 19) + 1)
            glyph.Position    = UDim2.fromScale(0.5, 0.5)
            glyph.AnchorPoint = Vector2.new(0.5, 0.5)

            dot.MouseEnter:Connect(function() TintIcon(glyph, theme.Accent) end)
            dot.MouseLeave:Connect(function() TintIcon(glyph, theme.TextDim) end)
            AttachTooltip(dot, text)
            return dot
        end

        ------------------------------------------------------------
        -- Locking
        --
        -- A greyed-out row has to stop responding, not just look dim. The
        -- scrim handles the look; hiding the interactive children is what
        -- actually blocks input, since a TextButton keeps receiving clicks
        -- even with Active off.
        ------------------------------------------------------------

        local function Lockable(row, api, radius)
            local scrim = New("Frame", {
                Name                   = "Lock",
                Size                   = UDim2.fromScale(1, 1),
                BackgroundColor3       = theme.Backdrop,
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                Visible                = false,
                ZIndex                 = 30,
                Parent                 = row,
            }, { Corner(radius or 11) })

            local stash = nil
            api.Enabled = true

            api.SetEnabled = function(_, state)
                state = state ~= false
                if api.Enabled == state then return end
                api.Enabled = state

                if not state then
                    stash = {}
                    for _, d in ipairs(row:GetDescendants()) do
                        if d ~= scrim
                        and (d:IsA("TextButton") or d:IsA("TextBox") or d:IsA("ImageButton")) then
                            stash[d] = d.Visible
                            d.Visible = false
                        end
                    end
                    scrim.Visible = true
                    Tween(scrim, { BackgroundTransparency = 0.45 }, EASE.Snap)
                else
                    if stash then
                        for d, wasVisible in pairs(stash) do
                            if d.Parent then d.Visible = wasVisible end
                        end
                        stash = nil
                    end
                    Tween(scrim, { BackgroundTransparency = 1 }, EASE.Snap)
                    task.delay(0.2, function()
                        if api.Enabled then scrim.Visible = false end
                    end)
                end
            end

            api.SetLocked = function(_, locked) api:SetEnabled(not locked) end
            return api
        end

        -- `Depends = "SomeFlag"` greys the row out whenever that flag is
        -- false, and `Depends = "!SomeFlag"` inverts it. Saves every hub
        -- writing the same "if not enabled then return end" in ten
        -- callbacks and then forgetting to grey the control out.
        local function BindDepend(api, spec)
            if not spec or not api.SetEnabled then return end
            local invert = false
            local flag = spec
            if string.sub(spec, 1, 1) == "!" then
                invert = true
                flag = string.sub(spec, 2)
            end
            Window._dependents[flag] = Window._dependents[flag] or {}
            table.insert(Window._dependents[flag], { api = api, invert = invert })

            local current = Nely.Flags[flag] and true or false
            if invert then current = not current end
            api:SetEnabled(current)
        end

        ------------------------------------------------------------
        -- Where new elements go
        --
        -- `currentHost` is the page by default and is swapped to a group or
        -- column body while Adopt is running, so a section opened inside a
        -- group belongs to that group rather than leaking to the page.
        ------------------------------------------------------------

        local currentHost = page
        local sectionOf   = {}     -- host -> { body, count, card }

        -- Which column a new top-level card should join. Two-column pages
        -- fill the shorter side rather than alternating, so one section
        -- with twelve rows does not leave the other column empty.
        local function ColumnFor(weight)
            if not twoCol then return colA end
            if estA <= estB then
                estA = estA + (weight or 1)
                return colA
            end
            estB = estB + (weight or 1)
            return colB
        end

        -- The frame a free-standing element (paragraph, grid, group) should
        -- parent to. Inside a container it is that container; at page level
        -- it is a column.
        local function ElementHost(weight)
            if currentHost ~= page then return currentHost end
            return ColumnFor(weight)
        end

        ------------------------------------------------------------
        -- Section card
        ------------------------------------------------------------

        local function BuildSection(title, sectionKey, description, descKey, icon)
            local card = New("Frame", {
                Name                   = "Section",
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                Themed                 = { BackgroundColor3 = "Card" },
                BackgroundColor3       = theme.Card,
                BackgroundTransparency = 0.10,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ZIndex                 = 17,
                Parent                 = ElementHost(2),
            }, {
                Corner(Design.Radius.LG),
                Stroke(theme.CardEdge, 1, 0.55),
                List(0),
                Pad(0, 0, 0, 0),
            })
            card:SetAttribute("NelyContainer", true)
            local cardEdge = card:FindFirstChildOfClass("UIStroke")
            if cardEdge then Bind(cardEdge, "Color", "CardEdge") end

            -- Header. Skipped entirely for an implicit section so a hub that
            -- never calls CreateSection gets a clean unlabelled card rather
            -- than an empty heading strip.
            if title or sectionKey then
                local header = New("Frame", {
                    Name                   = "Header",
                    Size                   = UDim2.new(1, 0, 0, 0),
                    AutomaticSize          = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    LayoutOrder            = 0,
                    ZIndex                 = 18,
                    Parent                 = card,
                }, { List(1), Pad(14, 10, 16, 16) })
                header:SetAttribute("NelySticky", true)

                local left = 0
                if icon then
                    local mark = Icons.Render(icon, header, 13, theme.Accent, 19)
                    mark.Position    = UDim2.fromOffset(0, 2)
                    mark.AnchorPoint = Vector2.new(0, 0)
                    left = 19
                end

                local titleLabel = New("TextLabel", {
                    Name                   = "SectionTitle",
                    Size                   = UDim2.new(1, -left, 0, 16),
                    Position               = UDim2.fromOffset(left, 0),
                    BackgroundTransparency = 1,
                    Text                   = sectionKey and L(sectionKey) or (title or ""),
                    TextColor3             = theme.Text,
                    TextSize               = Design.Text.Section + 2,
                    Font                   = Enum.Font.GothamBold,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    LayoutOrder            = 1,
                    ZIndex                 = 19,
                    Parent                 = header,
                })
                if sectionKey then BindText(titleLabel, "Text", sectionKey) end

                if description or descKey then
                    local d = New("TextLabel", {
                        Name                   = "SectionDescription",
                        Size                   = UDim2.new(1, -left, 0, 0),
                        AutomaticSize          = Enum.AutomaticSize.Y,
                        BackgroundTransparency = 1,
                        Text                   = descKey and L(descKey) or description,
                        TextColor3             = theme.TextDim,
                        TextSize               = Design.Text.Meta,
                        Font                   = Enum.Font.Gotham,
                        TextXAlignment         = Enum.TextXAlignment.Left,
                        TextWrapped            = true,
                        LayoutOrder            = 2,
                        ZIndex                 = 19,
                        Parent                 = header,
                    })
                    if descKey then BindText(d, "Text", descKey) end
                end
            end

            local body = New("Frame", {
                Name                   = "Body",
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = 1,
                ZIndex                 = 17,
                Parent                 = card,
            }, { List(0), Pad(2, 8, 0, 0) })

            local entry = { card = card, body = body, count = 0 }
            sectionOf[currentHost] = entry
            return entry
        end

        -- Opens an unnamed card on demand, so hubs that never call
        -- CreateSection still get the new look instead of loose rows.
        local function CurrentSection()
            local entry = sectionOf[currentHost]
            if not entry or not entry.card.Parent then
                entry = BuildSection(nil, nil, nil, nil, nil)
            end
            return entry
        end

        ------------------------------------------------------------
        -- Row
        --
        -- Flat. No card, no stroke, no corner -- the section around it
        -- supplies all of that. A hairline separates it from the row above,
        -- which is the entire visual cost of grouping N controls.
        ------------------------------------------------------------

        local function RowSlot()
            local section = CurrentSection()
            section.count = section.count + 1
            if currentHost == page then
                if section.body.Parent and section.body.Parent.Parent == colB then
                    estB = estB + 1
                else
                    estA = estA + 1
                end
            end
            if section.count > 1 then
                New("Frame", {
                    Name             = "Sep",
                    Themed           = { BackgroundColor3 = "Divider" },
                    Size             = UDim2.new(1, -32, 0, 1),
                    Position         = UDim2.fromOffset(16, 0),
                    BackgroundColor3 = theme.Divider,
                    BackgroundTransparency = 0.4,
                    BorderSizePixel  = 0,
                    LayoutOrder      = NextOrder(),
                    ZIndex           = 17,
                    Parent           = section.body,
                })
            end
            return section.body
        end

        -- Ends the open card. Blocks (grids, profile cards, groups) call
        -- this so they sit between cards rather than inside one.
        local function CloseSection()
            sectionOf[currentHost] = nil
        end

        -- In a narrow column a row never carries a description, so it
        -- never needs the taller variant either.
        local function RowHeight(h)
            if narrowRows and h == ROW_HD then return ROW_H end
            return h
        end

        local function Row(height, parent)
            height = RowHeight(height)
            if parent then
                -- Explicit parent: legacy callers that place their own rows.
                return New("Frame", {
                    Size                   = UDim2.new(1, 0, 0, height or 50),
                    BackgroundTransparency = 1,
                    BorderSizePixel        = 0,
                    LayoutOrder            = NextOrder(),
                    ClipsDescendants       = true,
                    ZIndex                 = 17,
                    Parent                 = parent,
                })
            end

            local __slot = RowSlot()
            local row = New("Frame", {
                Name                   = "Row",
                Size                   = UDim2.new(1, 0, 0, height or 50),
                BackgroundColor3       = theme.Hover,
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 17,
                Parent                 = __slot,
            })
            return row
        end

        -- Optional leading icon. Every element accepts `Icon = "name"`;
        -- when one is present the text block shifts right to make room,
        -- so a tab can mix decorated and plain rows without misaligning.
        -- Pinned to the top of the row, not centred in it. A 0.5 scale
        -- anchor re-centres itself every time the row grows, which is why
        -- the badge slid down the moment a dropdown or colorpicker opened.
        -- Offset from the row's *collapsed* height keeps it beside the name.
        -- Bare glyph, vertically pinned to where the title sits rather than
        -- centred in the row -- a 0.5 anchor re-centres itself every time a
        -- dropdown or colorpicker expands the row, which is what used to
        -- make the icon slide down the card.
        local function RowIcon(row, iconName)
            if not iconName then return 16 end
            local top = math.floor(row.Size.Y.Offset / 2) - 8

            local glyph = Icons.Render(iconName, row, 15, theme.TextDim, 18)
            glyph.Position    = UDim2.fromOffset(16, top)
            glyph.AnchorPoint = Vector2.new(0, 0)

            row:SetAttribute("HasIcon", true)
            return 42
        end

        -- 16px gutters and a 20px gap between title and description. The
        -- previous 14/17 pairing put the two lines close enough that they
        -- read as one block.
        -- nameKey / descKey are localization keys. When present the label
        -- is BOUND rather than assigned, so SetLanguage repaints it in
        -- place. Hub-supplied strings pass no key and are never translated.
        local function RowText(row, name, description, leftPad, info, nameKey, descKey, reserveW)
            leftPad = leftPad or 16
            if nameKey then name = L(nameKey) end
            if descKey then description = L(descKey) end
            -- Half-width columns show the setting and its value, nothing
            -- more. There is no honest way to fit a sentence beside a
            -- control in 251px.
            if narrowRows then description = nil end
            local hasDesc = description and description ~= ""

            -- How much room the control on the right actually occupies.
            -- Supplied by the caller because only it knows; the old flat
            -- 134 starved a toggle row of 80px it did not need, which is
            -- why the longer French labels truncated.
            local reserve = reserveW or (narrowRows and 96 or 134)
            local nameLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -leftPad - reserve, 0, 16),
                Position               = UDim2.new(0, leftPad, 0.5, hasDesc and -11 or 0),
                AnchorPoint            = Vector2.new(0, 0.5),
                BackgroundTransparency = 1,
                Text                   = name,
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                TextTruncate           = Enum.TextTruncate.AtEnd,
                ZIndex                 = 18,
                Parent                 = row,
            })
            if nameKey then BindText(nameLabel, "Text", nameKey) end
            InfoDot(row, nameLabel, info, 19)
            if hasDesc then
                local descLabel = New("TextLabel", {
                    Size                   = UDim2.new(1, -leftPad - reserve, 0, 14),
                    Position               = UDim2.new(0, leftPad, 0.5, 10),
                    AnchorPoint            = Vector2.new(0, 0.5),
                    BackgroundTransparency = 1,
                    Text                   = description,
                    TextColor3             = theme.TextDim,
                    TextSize               = 11,
                    Font                   = Enum.Font.Gotham,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 18,
                    Parent                 = row,
                })
                if descKey then BindText(descLabel, "Text", descKey) end
            end
        end

        ------------------------------------------------------------
        -- Containers: groups and columns
        --
        -- Every element constructor below parents straight to `page`, and
        -- there are two dozen of them. Rather than thread a container
        -- argument through all of them, Adopt snapshots the page's children,
        -- runs the constructor, and moves whatever is new into the container.
        --
        -- That is deliberately not a ChildAdded hook: with deferred signal
        -- behaviour, ChildAdded fires at the end of the resumption cycle
        -- rather than the moment Parent is assigned, so the element would
        -- already have been handed back to the caller before we saw it.
        -- Comparing before and after is immune to that.
        --
        -- Because the constructors always target `page`, this nests: a group
        -- built inside a column is adopted by the column, and its own
        -- children are adopted by the group.
        ------------------------------------------------------------

        local ELEMENT_METHODS = {
            "CreateSection", "CreateDivider", "CreateParagraph", "CreateButton",
            "CreateToggle", "CreateSlider", "CreateInput", "CreateDropdown",
            "CreateKeybind", "CreateLabel", "CreateSpace", "CreateProgressBar",
            "CreateColorpicker", "CreateCode", "CreateCurve", "CreateGameGrid",
            "CreateProfileCard", "CreateServerCard", "CreateFriendsCard",
            "CreateDiscordCard", "CreateGroup", "CreateColumns",
        }

        local function Adopt(container, method, ...)
            -- Point new elements at the container for the duration of the
            -- call. Sections opened inside a group belong to that group.
            local previousHost = currentHost
            currentHost = container

            local watch = { page, colA, colB }
            local before = {}
            for _, host in ipairs(watch) do
                for _, child in ipairs(host:GetChildren()) do before[child] = true end
            end

            local args = table.pack(...)
            local ok, results = pcall(function()
                return table.pack(method(table.unpack(args, 1, args.n)))
            end)

            -- Anything that still hardcoded a page parent gets relocated.
            for _, host in ipairs(watch) do
                for _, child in ipairs(host:GetChildren()) do
                    if not before[child] and child:IsA("GuiObject") then
                        child.Parent = container
                    end
                end
            end

            currentHost = previousHost
            if not ok then error(results, 0) end
            return table.unpack(results, 1, results.n)
        end

        local function Proxy(container)
            local proxy = { Instance = container }
            for _, name in ipairs(ELEMENT_METHODS) do
                proxy[name] = function(_, ...)
                    local fn = Tab[name]
                    if not fn then return nil end
                    return Adopt(container, fn, Tab, ...)
                end
            end
            proxy.Destroy = function() container:Destroy() end
            return proxy
        end

        ------------------------------------------------------------
        -- Group
        --
        -- A titled card that owns its rows. Collapsing is driven by the
        -- body's AutomaticSize rather than a stored height, so a group whose
        -- contents grow later still opens to the right size.
        ------------------------------------------------------------

        function Tab:CreateGroup(cfg)
            CloseSection()   -- a block sits between cards, not inside one
            cfg = type(cfg) == "string" and { Title = cfg } or (cfg or {})

            local card = New("Frame", {
                Name                   = "Group",
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.55,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 16,
                Parent                 = ElementHost(),
            }, {
                Corner(13),
                Stroke(theme.BorderSoft, 1, 0.5),
                Pad(10, 10, 10, 10),
                List(8),
            })
            -- The card is a container so search descends into it rather than
            -- matching the whole group on any one row's text.
            card:SetAttribute("NelyContainer", true)

            local body

            if cfg.Title then
                local header = New("Frame", {
                    Name                   = "GroupHeader",
                    Size                   = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    LayoutOrder            = 1,
                    ZIndex                 = 17,
                    Parent                 = card,
                })
                header:SetAttribute("NelySticky", true)

                local left = 2
                if cfg.Icon then
                    local mark = Icons.Render(cfg.Icon, header, 13, theme.Accent, 18)
                    mark.Position    = UDim2.new(0, 2, 0.5, 0)
                    mark.AnchorPoint = Vector2.new(0, 0.5)
                    left = 21
                end

                local titleLabel = New("TextLabel", {
                    Size                   = UDim2.new(1, -left - 26, 1, 0),
                    Position               = UDim2.new(0, left, 0, 0),
                    BackgroundTransparency = 1,
                    Text                   = cfg.Title,
                    TextColor3             = theme.Text,
                    TextSize               = 13,
                    Font                   = Enum.Font.GothamBold,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 18,
                    Parent                 = header,
                })
                InfoDot(header, titleLabel, cfg.Info, 19)

                if cfg.Collapsible ~= false then
                    local caret = Icons.Render("chevron", header, 13, theme.TextDim, 18)
                    caret.Position    = UDim2.new(1, -2, 0.5, 0)
                    caret.AnchorPoint = Vector2.new(1, 0.5)

                    local hit = New("TextButton", {
                        Size                   = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        AutoButtonColor        = false,
                        Text                   = "",
                        ZIndex                 = 20,
                        Parent                 = header,
                    })

                    local collapsed = cfg.Collapsed == true
                    local function ApplyCollapse(animate)
                        Tween(caret, { Rotation = collapsed and -90 or 0 },
                            animate == false and EASE.Instant or EASE.Glide)
                        if body then body.Visible = not collapsed end
                    end

                    hit.MouseEnter:Connect(function() TintIcon(caret, theme.Accent) end)
                    hit.MouseLeave:Connect(function() TintIcon(caret, theme.TextDim) end)
                    hit.MouseButton1Click:Connect(function()
                        collapsed = not collapsed
                        ApplyCollapse(true)
                    end)

                    task.defer(function() ApplyCollapse(false) end)
                end
            end

            body = New("Frame", {
                Name                   = "GroupBody",
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = 2,
                ZIndex                 = 16,
                Parent                 = card,
            }, { List(cfg.Gap or 7) })
            body:SetAttribute("NelyContainer", true)

            local group = Proxy(body)
            group.Card    = card
            group.Destroy = function() card:Destroy() end
            group.SetTitle = function(_, text)
                local header = card:FindFirstChild("GroupHeader")
                local lbl = header and header:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.Text = text end
            end
            return group
        end

        ------------------------------------------------------------
        -- Columns
        --
        -- Splits the page horizontally. Each column is its own container,
        -- so a settings page can put the switches on the left and the
        -- graphs on the right instead of running one long ribbon.
        --
        -- Falls back to a single column on a compact window: two 130px
        -- columns are worse than one readable one.
        ------------------------------------------------------------

        function Tab:CreateColumns(cfg)
            CloseSection()   -- a block sits between cards, not inside one
            cfg = type(cfg) == "number" and { Count = cfg } or (cfg or {})
            local count = math.clamp(cfg.Count or 2, 1, 4)
            local gap   = cfg.Gap or 10
            if compact and not cfg.ForceMulti then count = 1 end

            local holder = New("Frame", {
                Name                   = "Columns",
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = NextOrder(),
                ZIndex                 = 16,
                Parent                 = ElementHost(),
            }, {
                New("UIListLayout", {
                    Padding             = UDim.new(0, gap),
                    FillDirection       = Enum.FillDirection.Horizontal,
                    VerticalAlignment   = Enum.VerticalAlignment.Top,
                    HorizontalAlignment = Enum.HorizontalAlignment.Left,
                    SortOrder           = Enum.SortOrder.LayoutOrder,
                }),
            })

            local columns = {}
            for index = 1, count do
                -- Each column loses its share of the gutters, otherwise the
                -- last one wraps onto a second line the moment gap > 0.
                local col = New("Frame", {
                    Name                   = "Column" .. index,
                    Size                   = UDim2.new(1 / count, -gap * (count - 1) / count, 0, 0),
                    AutomaticSize          = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    LayoutOrder            = index,
                    ZIndex                 = 16,
                    Parent                 = holder,
                }, { List(cfg.RowGap or 10) })
                col:SetAttribute("NelyContainer", true)
                columns[index] = Proxy(col)
            end

            columns.Instance = holder
            columns.Count    = count
            columns.Destroy  = function() holder:Destroy() end
            return columns
        end

        ------------------------------------------------------------
        -- Section
        ------------------------------------------------------------

        -- Opens a new section card. Everything created afterwards lands
        -- inside it until the next CreateSection.
        --
        -- Old signature CreateSection("Name") still works; the extra
        -- arguments are optional.
        function Tab:CreateSection(name, sectionKey, description, descKey, icon)
            if type(name) == "table" then
                local cfg   = name
                name        = cfg.Name or cfg.Title
                sectionKey  = cfg.NameKey or cfg.LocaleKey
                description = cfg.Description
                descKey     = cfg.DescKey
                icon        = cfg.Icon
            end

            local entry = BuildSection(name, sectionKey, description, descKey, icon)
            local titleLabel = entry.card:FindFirstChild("Header")
                and entry.card.Header:FindFirstChild("SectionTitle")

            return {
                Set = function(_, newName)
                    if titleLabel then titleLabel.Text = tostring(newName) end
                end,
                Destroy  = function()
                    if sectionOf[currentHost] == entry then sectionOf[currentHost] = nil end
                    entry.card:Destroy()
                end,
                Instance = entry.card,
            }
        end

        -- Inside a section this is a heavier separator between groups of
        -- rows. Outside one it simply ends the current card, so the next
        -- control starts a fresh surface -- which is what hubs were using
        -- CreateDivider for anyway.
        function Tab:CreateDivider()
            local entry = sectionOf[currentHost]
            if entry and entry.count > 0 then
                local pad = New("Frame", {
                    Name                   = "GroupBreak",
                    Size                   = UDim2.new(1, 0, 0, 9),
                    BackgroundTransparency = 1,
                    LayoutOrder            = NextOrder(),
                    ZIndex                 = 17,
                    Parent                 = entry.body,
                })
                New("Frame", {
                    Size             = UDim2.new(1, -32, 0, 1),
                    Position         = UDim2.new(0, 16, 0.5, 0),
                    BackgroundColor3 = theme.Divider,
                    BorderSizePixel  = 0,
                    ZIndex           = 18,
                    Parent           = pad,
                })
                return { Destroy = function() pad:Destroy() end, Instance = pad }
            end
            sectionOf[currentHost] = nil
            return { Destroy = function() end }
        end

