            if needle == "" then return 0 end
            local hi, score, streak = 1, 0, 0
            for i = 1, #needle do
                local c     = string.sub(needle, i, i)
                local found = string.find(haystack, c, hi, true)
                if not found then return nil end
                if found == hi then
                    streak = streak + 1
                    score  = score + 4 + streak
                else
                    streak = 0
                    score  = score + 1
                end
                if found == 1 then score = score + 8 end
                hi = found + 1
            end

            return score - (#haystack * 0.05)
        end

