    Glide = TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    Pop   = TweenInfo.new(0.34, Enum.EasingStyle.Back,  Enum.EasingDirection.Out),
    Slow  = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

--==================================================================
--  BUILD HELPERS
--==================================================================
local function New(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r) }) end

local function Stroke(color, thickness, transparency)
    return New("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function Pad(t, b, l, r)
    return New("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or l or 0),
    })
end

local function List(padding, dir)
    return New("UIListLayout", {
        Padding       = UDim.new(0, padding or 8),
        FillDirection = dir or Enum.FillDirection.Vertical,
        SortOrder     = Enum.SortOrder.LayoutOrder,
    })
end

local function Gradient(seq, rotation, transparency)
    return New("UIGradient", {
        Color = seq,
        Rotation = rotation or 0,
        Transparency = transparency or NumberSequence.new(0),
    })
end

local function Tween(inst, props, info)
    local t = TweenService:Create(inst, info or EASE.Snap, props)
    t:Play()
    return t
end

-- Soft drop shadow. A single scaled image behind the frame reads better
-- than stacked translucent frames and costs one draw call.
local function Shadow(parent, spread, transparency, corner)
    return New("ImageLabel", {
        Name = "Shadow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, spread or 30, 1, spread or 30),
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = transparency or 0.55,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = (parent.ZIndex or 1) - 1,
        Parent = parent,
    })
end

-- Click ripple. Clipped to the row so it never bleeds past the corners.
local function Ripple(host, x, y)
    if not host:IsA("GuiObject") then return end
    local abs = host.AbsolutePosition
    local px = (x or (abs.X + host.AbsoluteSize.X / 2)) - abs.X
    local py = (y or (abs.Y + host.AbsoluteSize.Y / 2)) - abs.Y
    local circle = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(px, py),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        ZIndex = (host.ZIndex or 1) + 3,
        Parent = host,
    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    local reach = math.max(host.AbsoluteSize.X, host.AbsoluteSize.Y) * 2
    Tween(circle, { Size = UDim2.fromOffset(reach, reach), BackgroundTransparency = 1 }, EASE.Slow)
    task.delay(0.5, function() pcall(function() circle:Destroy() end) end)
end

-- Hue wheel walked by the golden ratio: any number of tabs land on
-- distinct, evenly spread colours without a hand-picked palette.
local function AutoHue(index)
    return Color3.fromHSV(((index - 1) * 0.618033988749895) % 1, 0.55, 1)
end

--==================================================================
--  ICONS
--
--  The same Lucide pack Nely Lib v3 uses, so every existing
--  Icon = "crosshair" keeps working. A raw asset id is passed through
--  untouched and never tinted -- a glyph is a silhouette meant to take a
--  colour, a photograph is not.
--==================================================================
local LUCIDE_URL = "https://raw.githubusercontent.com/nlzzpro/nelylib/refs/heads/main/icons"
local Icons = { Set = nil }
do
    local ok, pack = pcall(function() return loadstring(game:HttpGet(LUCIDE_URL))() end)
    if ok and type(pack) == "table" then Icons.Set = pack end
end

local ALIASES = {
    home = "house", grid = "layout-grid", gamepad = "gamepad-2",
    sliders = "sliders-horizontal", close = "x", minimize = "minus",
    chevron = "chevron-down", bolt = "zap", alert = "triangle-alert",
    pulse = "activity", edit = "pencil", checkCircle = "circle-check",
    xCircle = "circle-x", arrowRight = "arrow-right",
}

local function IsRaw(name)
    return type(name) == "string"
       and (name:sub(1, 13) == "rbxassetid://" or name:sub(1, 10) == "rbxthumb://"
         or name:sub(1, 11) == "rbxasset://" or name:sub(1, 4) == "http")
end

local function IconAsset(name)
    if IsRaw(name) then return name end
    if not (Icons.Set and name) then return nil end
    return Icons.Set[ALIASES[name] or name]
end

local function RenderIcon(name, parent, size, color, zindex)
    local raw = IsRaw(name)
    local img = New("ImageLabel", {
        Name = "Icon",
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        Image = IconAsset(name) or "",
        ImageColor3 = raw and Color3.fromRGB(255, 255, 255) or (color or Theme.TextSub),
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = zindex or ((parent.ZIndex or 1) + 1),
        Parent = parent,
    })
    if raw then img:SetAttribute("RawArt", true) end
    return img
end

local function TintIcon(icon, color)
    if icon and icon:IsA("ImageLabel") and not icon:GetAttribute("RawArt") then
        Tween(icon, { ImageColor3 = color }, EASE.Snap)
    end
end

