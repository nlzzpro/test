local function ShowTip(text, anchor)
    EnsureTip()
    local theme = Nely.Theme
    Tip.Frame.BackgroundColor3 = theme.Elevated
    Tip.Label.TextColor3       = theme.TextSub
    local stroke = Tip.Frame:FindFirstChildOfClass("UIStroke")
    if stroke then stroke.Color = theme.Border end

    Tip.Label.Text    = text
    Tip.Frame.Visible = true
    Tip.Frame.BackgroundTransparency = 1
    Tip.Label.TextTransparency = 1

    task.defer(function()
        if not (Tip.Frame and Tip.Frame.Visible and anchor.Parent) then return end

        local pos  = anchor.AbsolutePosition
        local size = anchor.AbsoluteSize
        local tip  = Tip.Frame.AbsoluteSize
        local view = workspace.CurrentCamera
            and workspace.CurrentCamera.ViewportSize
            or Vector2.new(1280, 720)

        local x = pos.X + size.X / 2 - tip.X / 2
        local y = pos.Y - tip.Y - 8

        if y < 8 then y = pos.Y + size.Y + 8 end
        x = math.clamp(x, 8, math.max(8, view.X - tip.X - 8))

        Tip.Frame.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
        Tip.Fade = Tween(Tip.Frame, { BackgroundTransparency = 0.02 }, EASE.Snap)
        Tween(Tip.Label, { TextTransparency = 0 }, EASE.Snap)
    end)
end

local function AttachTooltip(obj, text)
    if not text or text == "" then return end
    obj.MouseEnter:Connect(function() ShowTip(text, obj) end)
    obj.MouseLeave:Connect(HideTip)
end

