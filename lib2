local function BuildCursor(theme)
    if Cursor.Built then return end
    Cursor.Built = true

    Cursor.Ring = New("Frame", {
        Name                   = "CursorRing",
        Size                   = UDim2.fromOffset(24, 24),
        AnchorPoint            = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Visible                = false,
        ZIndex                 = 990,
        Parent                 = Root,
    }, {
        New("UICorner", { CornerRadius = UDim.new(1, 0) }),
        New("UIStroke", { Color = theme.Accent, Thickness = 1.5, Transparency = 0.25 }),
    })

    Cursor.Dot = New("Frame", {
        Name             = "CursorDot",
        Size             = UDim2.fromOffset(5, 5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.AccentSoft,
        BorderSizePixel  = 0,
        Visible          = false,
        ZIndex           = 991,
        Parent           = Root,
    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    Cursor.Targets  = {}
    Cursor.RingPos  = GetPointer()
    Cursor.Held     = false

    local function PointerInsideAnyTarget(point)
        for _, target in ipairs(Cursor.Targets) do
            if target.Visible then
                local pos, size = target.AbsolutePosition, target.AbsoluteSize
                if point.X >= pos.X and point.X <= pos.X + size.X
               and point.Y >= pos.Y and point.Y <= pos.Y + size.Y then
                    return true
                end
            end
        end
        return false
    end

    local function SetActive(active)
        if Cursor.Active == active then return end
        Cursor.Active = active
        Cursor.Ring.Visible = active
        Cursor.Dot.Visible  = active
        UserInputService.MouseIconEnabled = not active
        if active then
            Cursor.Ring.Size = UDim2.fromOffset(34, 34)
            Tween(Cursor.Ring, { Size = UDim2.fromOffset(24, 24) }, EASE.Pop)
        end
    end

    local moveConn = RunService.RenderStepped:Connect(function(dt)
        if not Cursor.Enabled then
            if Cursor.Active then SetActive(false) end
            return
        end

        local point = GetPointer()

        SetActive(PointerInsideAnyTarget(point))
        if not Cursor.Active then return end

        Cursor.Dot.Position = UDim2.fromOffset(point.X, point.Y)

        local alpha = 1 - math.exp(-16 * dt)
        Cursor.RingPos = Cursor.RingPos:Lerp(point, alpha)
        Cursor.Ring.Position = UDim2.fromOffset(Cursor.RingPos.X, Cursor.RingPos.Y)
    end)
    table.insert(Nely.Connections, moveConn)

    local downConn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not Cursor.Active then return end
        Cursor.Held = true
        Tween(Cursor.Ring, { Size = UDim2.fromOffset(16, 16) }, EASE.Pop)
        Tween(Cursor.Dot, { Size = UDim2.fromOffset(8, 8) }, EASE.Pop)
    end)
    table.insert(Nely.Connections, downConn)

    local upConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not Cursor.Held then return end
        Cursor.Held = false
        Tween(Cursor.Ring, { Size = UDim2.fromOffset(24, 24) }, EASE.Pop)
        Tween(Cursor.Dot, { Size = UDim2.fromOffset(5, 5) }, EASE.Pop)
    end)
    table.insert(Nely.Connections, upConn)
end

