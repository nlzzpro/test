                badge.Visible = false
                if divider then divider.Visible = false end
                return
            end

            local fitted = fullName
            if Measure(fitted, 11, Enum.Font.GothamMedium) > room then

                local n = #fullName
                while n > 1 do
                    local try = string.sub(fullName, 1, n) .. "\u{2026}"
                    if Measure(try, 11, Enum.Font.GothamMedium) <= room then
                        fitted = try
                        break
                    end
                    n = n - 1
