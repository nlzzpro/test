        local entries, shown, cursor = {}, {}, 1

        local function PrimaryText(row)
            -- The first non-empty label in a row is its name. Everything
            -- after it is a description, a value readout or a unit.
            for _, child in ipairs(row:GetDescendants()) do
                if child:IsA("TextLabel") and child.Text ~= "" then
                    return child.Text
                end
            end
            return nil
        end

        local function Collect(host, tab, out)
            for _, child in ipairs(host:GetChildren()) do
                if child:IsA("GuiObject") then
                    if child:GetAttribute("NelyContainer") then
                        Collect(child, tab, out)
                    elseif not child:GetAttribute("NelySticky") then
                        local name = PrimaryText(child)
                        if name and #name > 0 then
                            table.insert(out, {
                                Name  = name,
                                Lower = string.lower(name),
                                Tab   = tab,
                                Row   = child,
                            })
                        end
                    end
                end
            end
        end

        local function BuildIndex()
            entries = {}
            for _, tab in ipairs(Window.Tabs) do
                -- Tab names are jump targets in their own right.
                table.insert(entries, {
                    Name    = tab.Name,
                    Lower   = string.lower(tab.Name),
                    Tab     = tab,
                    IsTab   = true,
                })
                Collect(tab.Page, tab, entries)
            end
        end

        -- Subsequence score. Returns nil when the query does not fit at
        -- all, otherwise higher is better.
        local function Score(haystack, needle)
            if needle == "" then return 0 end
            local hi, score, streak = 1, 0, 0
            for i = 1, #needle do
                local c     = string.sub(needle, i, i)
                local found = string.find(haystack, c, hi, true)
                if not found then return nil end
                if found == hi then
                    streak = streak + 1
                    score  = score + 4 + streak
                else
                    streak = 0
                    score  = score + 1
                end
                if found == 1 then score = score + 8 end
                hi = found + 1
            end
            -- Shorter names that contain the query are the better match.
            return score - (#haystack * 0.05)
        end

        ------------------------------------------------------------
        -- Jump
        ------------------------------------------------------------

        local function Pulse(row)
            local stroke = row:FindFirstChildOfClass("UIStroke")
            if stroke then
                local c, t = stroke.Color, stroke.Transparency
                stroke.Color, stroke.Transparency = theme.Accent, 0
                task.delay(0.1, function()
                    if stroke.Parent then
                        Tween(stroke, { Color = c, Transparency = t }, EASE.Glide)
                    end
                end)
                return
            end
            -- No stroke to borrow, so flash the background instead.
            local was = row.BackgroundTransparency
            if was >= 1 then return end
            row.BackgroundTransparency = math.max(0, was - 0.35)
            Tween(row, { BackgroundTransparency = was }, EASE.Glide)
        end

        local ClosePalette   -- defined below, referenced here

        local function Jump(entry)
            ClosePalette()
            if entry.Tab and Window.ActiveTab ~= entry.Tab then
                entry.Tab.Activate()
            end
            if entry.IsTab or not entry.Row or not entry.Row.Parent then return end

            -- One frame for the tab swap to lay out, otherwise AbsolutePosition
            -- is still whatever it was while the page was hidden.
            task.defer(function()
                local page = entry.Tab.Page
                if not (page and entry.Row.Parent) then return end
                local offset = entry.Row.AbsolutePosition.Y
                            - page.AbsolutePosition.Y
                            + page.CanvasPosition.Y
                Tween(page, {
                    CanvasPosition = Vector2.new(0, math.max(0, offset - 60)),
                }, EASE.Glide)
                Pulse(entry.Row)
            end)
        end

        ------------------------------------------------------------
        -- Rendering
        ------------------------------------------------------------

        local rowButtons = {}

        local function Highlight()
            for i, btn in ipairs(rowButtons) do
                local on = (i == cursor)
                Tween(btn, { BackgroundTransparency = on and 0.25 or 1 }, EASE.Snap)
            end
        end

        local function Render(query)
            for _, child in ipairs(results:GetChildren()) do
                if child:IsA("GuiObject") then child:Destroy() end
            end
            rowButtons, shown, cursor = {}, {}, 1

            local scored = {}
            for _, entry in ipairs(entries) do
                local s = query == "" and 0 or Score(entry.Lower, query)
                if s then table.insert(scored, { entry = entry, score = s }) end
            end
            table.sort(scored, function(a, b) return a.score > b.score end)

            for i = 1, math.min(#scored, 40) do
                local entry = scored[i].entry
                table.insert(shown, entry)

                local btn = New("TextButton", {
                    Size                   = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3       = theme.Elevated,
                    BackgroundTransparency = 1,
                    AutoButtonColor        = false,
                    Text                   = "",
                    LayoutOrder            = i,
                    ZIndex                 = 903,
                    Parent                 = results,
                }, { Corner(8) })

                Icons.Render(entry.IsTab and "layout-grid" or "chevron-right",
                    btn, 13, theme.TextDim, 904).Position = UDim2.fromOffset(11, 11)

                New("TextLabel", {
                    Size                   = UDim2.new(1, -140, 1, 0),
                    Position               = UDim2.fromOffset(34, 0),
                    BackgroundTransparency = 1,
                    Text                   = entry.Name,
                    TextColor3             = theme.Text,
                    TextSize               = 13,
                    Font                   = Enum.Font.Gotham,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 904,
                    Parent                 = btn,
                })

                New("TextLabel", {
                    Size                   = UDim2.fromOffset(110, 1),
                    Position               = UDim2.new(1, -12, 0.5, 0),
                    AnchorPoint            = Vector2.new(1, 0.5),
                    AutomaticSize          = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Text                   = entry.IsTab and "tab" or entry.Tab.Name,
                    TextColor3             = theme.TextDim,
                    TextSize               = 10,
                    Font                   = Enum.Font.GothamMedium,
                    TextXAlignment         = Enum.TextXAlignment.Right,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 904,
                    Parent                 = btn,
                })

                btn.MouseEnter:Connect(function()
                    cursor = i
                    Highlight()
                end)
                btn.MouseButton1Click:Connect(function() Jump(entry) end)

                table.insert(rowButtons, btn)
            end

            -- 60px of input row, 34 per result, 10 of breathing room.
            local height = 60 + math.min(#rowButtons, 8) * 36 + (#rowButtons > 0 and 10 or 0)
            Tween(box, { Size = UDim2.fromOffset(520, height) }, EASE.Glide)
            Highlight()
        end

        ------------------------------------------------------------
        -- Open / close
        ------------------------------------------------------------

        local function OpenPalette()
            if paletteOpen then return end
            paletteOpen   = true
            scrim.Visible = true
            BuildIndex()
            pBox.Text = ""
            Render("")
            Tween(scrim, { BackgroundTransparency = 0.45 }, EASE.Smooth)
            box.Position = UDim2.new(0.5, 0, 0, 100)
            Tween(box, { Position = UDim2.new(0.5, 0, 0, 120) }, EASE.Pop)
            task.defer(function() pBox:CaptureFocus() end)
        end

        ClosePalette = function()
            if not paletteOpen then return end
            paletteOpen = false
            pBox:ReleaseFocus()
            Tween(scrim, { BackgroundTransparency = 1 }, EASE.Smooth)
            task.delay(0.18, function()
                if not paletteOpen then scrim.Visible = false end
            end)
        end

        pBox:GetPropertyChangedSignal("Text"):Connect(function()
            Render(string.lower(pBox.Text))
        end)

        scrim.MouseButton1Click:Connect(ClosePalette)

        local paletteKey = UserInputService.InputBegan:Connect(function(input, typing)
            if input.KeyCode == Enum.KeyCode.K
               and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                if paletteOpen then ClosePalette() else OpenPalette() end
                return
            end
            if not paletteOpen then return end

            if input.KeyCode == Enum.KeyCode.Escape then
                ClosePalette()
            elseif input.KeyCode == Enum.KeyCode.Down then
                cursor = math.min(cursor + 1, math.max(#rowButtons, 1))
                Highlight()
            elseif input.KeyCode == Enum.KeyCode.Up then
                cursor = math.max(cursor - 1, 1)
                Highlight()
            elseif input.KeyCode == Enum.KeyCode.Return and shown[cursor] then
                Jump(shown[cursor])
            end
            -- `typing` is deliberately ignored: the palette's own TextBox is
            -- what has focus, and every branch above is a key it owns.
        end)

        table.insert(Nely.Connections, paletteKey)

        function Window:OpenPalette()  OpenPalette()  end
        function Window:ClosePalette() ClosePalette() end
    end

    ----------------------------------------------------------------
    -- Config persistence
    --
    -- Flags are the source of truth, so anything with a flag persists
    -- without registering a save handler. Elements expose :Set, and the
    -- loader calls it, so restoring a value fires its callback exactly
    -- as a user click would — no divergence between the two paths.
    ----------------------------------------------------------------

    local configFolder = opts.Folder or "NelyLib"
    Window.Elements = Window.Elements or {}

    function Window:RegisterElement(flag, element)
        if flag then Window.Elements[flag] = element end
        return element
    end

    function Window:SaveConfig(name)
        if not (writefile and isfolder and makefolder) then return false, "no filesystem" end
        local ok, err = pcall(function()
            if not isfolder(configFolder) then makefolder(configFolder) end

            -- JSONEncode rejects a table holding both string keys and array
            -- entries, so the payload goes under its own key rather than
            -- being splatted alongside __type.
            local plain = {}
            for flag, value in pairs(Nely.Flags) do
                if typeof(value) == "Color3" then
                    plain[flag] = {
                        __type = "Color3",
                        rgb    = { value.R, value.G, value.B },
                    }
                elseif type(value) == "table" then
                    local list = {}
                    for key, on in pairs(value) do
                        if on then table.insert(list, key) end
                    end
                    table.sort(list)
                    plain[flag] = { __type = "set", values = list }
                else
                    plain[flag] = value
                end
            end

            writefile(("%s/%s.json"):format(configFolder, name or "default"),
                game:GetService("HttpService"):JSONEncode(plain))
        end)
        return ok, err
    end

    function Window:LoadConfig(name)
        if not (isfile and readfile) then return false, "no filesystem" end
        local path = ("%s/%s.json"):format(configFolder, name or "default")

        local ok, err = pcall(function()
            if not isfile(path) then return end
            local saved = game:GetService("HttpService"):JSONDecode(readfile(path))

            for flag, value in pairs(saved) do
                local element = Window.Elements[flag]
                if element and element.Set then
                    if type(value) == "table" and value.__type == "Color3" then
                        local rgb = value.rgb or { 1, 1, 1 }
                        element:Set(Color3.new(rgb[1], rgb[2], rgb[3]))
                    elseif type(value) == "table" and value.__type == "set" then
                        element:Set({ CurrentOption = value.values or {} })
                    else
                        element:Set(value)
                    end
                end
            end
        end)
        return ok, err
    end

    function Window:ListConfigs()
        if not listfiles then return {} end
        local names = {}
        pcall(function()
            for _, path in ipairs(listfiles(configFolder)) do
                local name = path:match("([^/\\]+)%.json$")
                if name then table.insert(names, name) end
            end
        end)
        table.sort(names)
        return names
    end

    ----------------------------------------------------------------
    -- PREFERENCES
    --
    -- Deliberately NOT stored in Nely.Flags, and deliberately not in the
    -- hub's config files.
    --
    -- Flags are the hub's state: aimbot on, FOV 90, target = head. A user
    -- who saves a config called "legit" and loads it later wants those
    -- back. They do not want the interface language to change because the
    -- config was written by someone using French, and a hub author
    -- exporting a default config should not be shipping their own
    -- preferred UI scale to everyone who installs it.
    --
    -- So preferences live in one file per executor, shared across every
    -- hub built on this library, and configs never touch them.
    ----------------------------------------------------------------

    local PREFS_FILE = "NelyLib/preferences.json"

    local Prefs = {
        Theme          = Nely.ThemeName or "Metallic",
        Language       = Nely.Language or "en",
        UIScale        = 1,
        Animations     = true,
        AnimationSpeed = 1,
        ReduceMotion   = false,
        Blur           = true,
        BlurSize       = 14,
        Cursor         = true,
        Notifications  = true,
    }
    Window.Prefs = Prefs

    local function PrefsSave()
        if not (writefile and isfolder and makefolder) then return false end
        return (pcall(function()
            if not isfolder("NelyLib") then makefolder("NelyLib") end
            writefile(PREFS_FILE, HttpService:JSONEncode(Prefs))
        end))
    end

    local function PrefsRead()
        if not (isfile and readfile) then return nil end
        local ok, data = pcall(function()
            if not isfile(PREFS_FILE) then return nil end
            return HttpService:JSONDecode(readfile(PREFS_FILE))
        end)
        return ok and type(data) == "table" and data or nil
    end

    -- Blur is a Lighting effect, not a GUI property -- Roblox has no
    -- backdrop filter -- so it is the 3D scene behind the window that
    -- softens. Cheap, but it is the single most expensive thing this
    -- library does on a weak device, hence the switch.
    -- Non-zero while ApplyPrefs is restoring from disk, so the setters it
    -- calls do not write the file back out mid-restore.
    local suppressSave = 0
    local function Persist()
        if suppressSave == 0 then PrefsSave() end
    end

    local blurTarget = 14

    function Window:SetBlur(enabled, size)
        Prefs.Blur = enabled and true or false
        if size then Prefs.BlurSize = math.clamp(size, 0, 40) end
        blurTarget     = Prefs.Blur and Prefs.BlurSize or 0
        Nely.BlurDepth = blurTarget
        if not Window.Minimized and not Window.Destroyed then
            Tween(Blur, { Size = blurTarget }, EASE.Smooth)
        end
        Persist()
        return blurTarget
    end
    Window.BlurTarget = function() return blurTarget end

    function Window:SetUIScale(scale)
        scale = math.clamp(tonumber(scale) or 1, 0.7, 1.4)
        Prefs.UIScale = scale
        Tween(shellScale, { Scale = scale }, EASE.Smooth)
        Tween(orbScale, { Scale = scale }, EASE.Smooth)
        Persist()
        return scale
    end

    -- Apply a whole preferences table. Used at startup and by the reset
    -- button, so there is exactly one code path that turns preferences
    -- into interface state.
    function Window:ApplyPrefs(p, save)
        p = p or Prefs
        for key, value in pairs(p) do
            if Prefs[key] ~= nil then Prefs[key] = value end
        end

        if Prefs.Theme and Prefs.Theme ~= Nely.ThemeName then
            Nely:SetTheme(Prefs.Theme, { Animate = false })
        end
        if Prefs.Language then Nely:SetLanguage(Prefs.Language) end

        Nely:SetMotion({
            Enabled      = Prefs.Animations,
            Speed        = Prefs.AnimationSpeed,
            ReduceMotion = Prefs.ReduceMotion,
        })

        suppressSave = suppressSave + 1
        Window:SetBlur(Prefs.Blur, Prefs.BlurSize)
        Window:SetUIScale(Prefs.UIScale)
        suppressSave = suppressSave - 1

        if Cursor then Cursor.Enabled = Prefs.Cursor ~= false end
        Nely.NotificationsEnabled = Prefs.Notifications ~= false

        if save ~= false then PrefsSave() end
        return Prefs
    end

    function Window:ResetPrefs()
        local defaults = {
            Theme = "Metallic", Language = "en", UIScale = 1,
            Animations = true, AnimationSpeed = 1, ReduceMotion = false,
            Blur = true, BlurSize = 14, Cursor = true, Notifications = true,
        }
        return Window:ApplyPrefs(defaults, true)
    end

    -- Restore on open, unless the hub opted out. RememberPrefs = false is
    -- for a hub that wants to dictate its own look every launch.
    if opts.RememberPrefs ~= false then
        local saved = PrefsRead()
        if saved then
            -- Applied without saving back: this is a read, and writing here
            -- would rewrite the file on every launch for no reason.
            pcall(Window.ApplyPrefs, Window, saved, false)
        end
    end

    ----------------------------------------------------------------
    -- SETTINGS PAGE
    --
    -- Opt in with Settings = true. It is a normal tab built from the same
    -- controls a hub uses, not a special-cased panel -- which means it
    -- inherits every future control improvement, and a hub author can read
    -- the source to see how the controls are meant to be used.
    ----------------------------------------------------------------

    function Window:CreateSettingsTab(cfg)
        cfg = cfg or {}
        -- LocaleKey rather than a translated Name: the sidebar label binds
        -- to the key, so switching language renames the tab in place.
        local tab = Window:CreateTab({
            Name      = cfg.Name or "Settings",
            LocaleKey = (cfg.Name == nil) and "settings.title" or nil,
            Icon      = cfg.Icon or "settings",
            -- The showcase for the two-column layout: five small cards
            -- read far better side by side than stacked into one column
            -- of near-identical rows.
            Columns   = 2,
        })

        ------------------------------------------------ appearance
        tab:CreateSection(nil, "settings.appearance")

        tab:CreateDropdown({
            NameKey       = "settings.theme",
            Icon          = "palette",
            Options       = Nely:GetThemes(),
            CurrentOption = { Prefs.Theme },
            Callback      = function(choice)
                local name = type(choice) == "table" and choice[1] or choice
                if not name then return end
                Nely:SetTheme(name)
                Prefs.Theme = Nely.ThemeName
                PrefsSave()
            end,
        })

        local langNames, langByName = {}, {}
        for _, entry in ipairs(Nely.Languages) do
            table.insert(langNames, entry.Name)
            langByName[entry.Name] = entry.Code
        end
        local currentLangName = "English"
        for _, entry in ipairs(Nely.Languages) do
            if entry.Code == Prefs.Language then currentLangName = entry.Name end
        end

        -- Language names are deliberately NOT translated: a Russian speaker
        -- looking for their language scans for "Русский", not for whatever
        -- the current interface language calls Russian.
        tab:CreateDropdown({
            NameKey       = "settings.language",
            Icon          = "languages",
            Options       = langNames,
            CurrentOption = { currentLangName },
            Callback      = function(choice)
                local name = type(choice) == "table" and choice[1] or choice
                local code = langByName[name]
                if not code then return end
                Nely:SetLanguage(code)
                Prefs.Language = code
                PrefsSave()
            end,
        })

        tab:CreateSlider({
            NameKey      = "settings.ui_scale",
            Icon         = "scaling",
            Range        = { 70, 140 },
            Increment    = 5,
            CurrentValue = math.floor(Prefs.UIScale * 100),
            Suffix       = "%",
            Callback     = function(value) Window:SetUIScale(value / 100) end,
        })

        tab:CreateToggle({
            NameKey      = "settings.blur",
            DescKey      = "settings.desc.blur",
            Icon         = "droplet",
            CurrentValue = Prefs.Blur,
            Callback     = function(state) Window:SetBlur(state, Prefs.BlurSize) end,
        })

        ------------------------------------------------ motion
        tab:CreateSection(nil, "settings.motion")

        tab:CreateToggle({
            NameKey      = "settings.animations",
            DescKey      = "settings.desc.animations",
            Icon         = "zap",
            CurrentValue = Prefs.Animations,
            Callback     = function(state)
                Prefs.Animations = state
                Nely:SetMotion({ Enabled = state })
                PrefsSave()
            end,
        })

        tab:CreateSlider({
            NameKey      = "settings.animation_speed",
            Icon         = "gauge",
            Range        = { 50, 200 },
            Increment    = 10,
            CurrentValue = math.floor(Prefs.AnimationSpeed * 100),
            Suffix       = "%",
            Callback     = function(value)
                Prefs.AnimationSpeed = value / 100
                Nely:SetMotion({ Speed = Prefs.AnimationSpeed })
                PrefsSave()
            end,
        })

        tab:CreateToggle({
            NameKey      = "settings.reduce_motion",
            DescKey      = "settings.desc.reduce",
            Icon         = "accessibility",
            CurrentValue = Prefs.ReduceMotion,
            Callback     = function(state)
                Prefs.ReduceMotion = state
                Nely:SetMotion({ ReduceMotion = state })
                PrefsSave()
            end,
        })

        ------------------------------------------------ interface
        tab:CreateSection(nil, "settings.interface")

        tab:CreateToggle({
            NameKey      = "settings.cursor",
            DescKey      = "settings.desc.cursor",
            Icon         = "mouse-pointer-2",
            CurrentValue = Prefs.Cursor,
            Callback     = function(state)
                Prefs.Cursor = state
                if Cursor then Cursor.Enabled = state end
                PrefsSave()
            end,
        })

        tab:CreateToggle({
            NameKey      = "settings.notifications",
            DescKey      = "settings.desc.notifs",
            Icon         = "bell",
            CurrentValue = Prefs.Notifications,
            Callback     = function(state)
                Prefs.Notifications = state
                Nely.NotificationsEnabled = state
                PrefsSave()
            end,
        })

        -- "Colourful tabs" deliberately removed from the visible settings.
        -- It is a branding decision, not a user preference, and offering it
        -- here invited people to break the cohesive look. Window.ColorfulTabs
        -- and the ColorfulTabs option remain for hub developers.

        ------------------------------------------------ reset
        tab:CreateSection(nil, "settings.configuration")

        tab:CreateButton({
            NameKey    = "settings.reset_all",
            DescKey    = "settings.desc.reset",
            Icon       = "rotate-ccw",
            ButtonText = L("common.reset"),
            ButtonKey  = "common.reset",
            Callback = function()
                Window:ResetPrefs()
                Nely:Notify({
                    Title   = L("settings.title"),
                    Content = L("settings.reset_done"),
                    Icon    = "check",
                })
            end,
        })

        return tab
    end

