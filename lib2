    ----------------------------------------------------------------
    -- Loading screen
    ----------------------------------------------------------------

    if opts.LoadingEnabled ~= false then
        shell.Visible = false

        ------------------------------------------------------------
        -- Loading sequence
        --
        -- No card, no spinner. A spinner-in-a-box is what every script
        -- loader on the platform looks like, and it says nothing about
        -- whose loader it is.
        --
        -- Instead: the mark sits alone on a dimmed screen, starts as dead
        -- graphite, and a narrow band of light sweeps across it left to
        -- right, leaving it platinum. That sweep is the whole identity --
        -- brushed metal catching a light source -- and it is the same
        -- gesture the shell's top edge makes when the window opens.
        ------------------------------------------------------------

        local scrim = New("Frame", {
            Name                   = "SplashScrim",
            Size                   = UDim2.fromScale(1, 1),
            BackgroundColor3       = theme.Backdrop,
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
            ZIndex                 = 799,
            Parent                 = Root,
        })
        Tween(scrim, { BackgroundTransparency = 0.18 }, EASE.Smooth)

        -- Bare holder. It has no fill and no stroke, so nothing frames the
        -- logo -- the logo IS the loading screen.
        local splash = New("Frame", {
            Name                   = "Splash",
            Size                   = UDim2.fromOffset(260, 150),
            Position               = UDim2.fromScale(0.5, 0.5),
            AnchorPoint            = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
            ZIndex                 = 800,
            Parent                 = Root,
        })
        local splashScale = New("UIScale", { Scale = 0.94, Parent = splash })

        ------------------------------------------------------------
        -- The mark
        ------------------------------------------------------------

        local MARK = 62

        local markHolder = New("Frame", {
            Name                   = "Mark",
            Size                   = UDim2.fromOffset(MARK, MARK),
            Position               = UDim2.new(0.5, 0, 0, 4),
            AnchorPoint            = Vector2.new(0.5, 0),
            BackgroundTransparency = 1,
            ClipsDescendants       = true,
            ZIndex                 = 801,
            Parent                 = splash,
        })

        -- Starts unlit. The sweep below is what brings it up to platinum,
        -- so the logo visibly *arrives* rather than just being present.
        BrandMark(markHolder, title, opts.Logo, 34, 14, 802,
                  opts.LogoStyle ~= "tile")
        for _, child in ipairs(markHolder:GetDescendants()) do
            if child:IsA("TextLabel") then
                child.TextColor3 = theme.MetalDeep
            elseif child:IsA("ImageLabel") then
                child.ImageColor3 = theme.MetalDeep
            end
        end

        -- The light band. A narrow white gradient window travelling across
        -- a copy of the mark's bounding box; masked by ClipsDescendants on
        -- the holder so it never spills onto the backdrop.
        local sweep = New("Frame", {
            Name                   = "Sweep",
            Size                   = UDim2.new(0.55, 0, 1.6, 0),
            Position               = UDim2.new(-0.7, 0, 0.5, 0),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundColor3       = theme.Sheen,
            BackgroundTransparency = 0.55,
            BorderSizePixel        = 0,
            Rotation               = 14,
            ZIndex                 = 804,
            Parent                 = markHolder,
        }, {
            New("UIGradient", {
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0,   1),
                    NumberSequenceKeypoint.new(0.5, 0),
                    NumberSequenceKeypoint.new(1,   1),
                }),
            }),
        })

        ------------------------------------------------------------
        -- Text
        ------------------------------------------------------------

        local wordmark = New("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 22),
            Position               = UDim2.fromOffset(0, MARK + 16),
            BackgroundTransparency = 1,
            Text                   = opts.LoadingTitle or title,
            TextColor3             = theme.Text,
            TextTransparency       = 1,
            TextSize               = 19,
            Font                   = Enum.Font.GothamBold,
            ZIndex                 = 801,
            Parent                 = splash,
        })

        local status = New("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 14),
            Position               = UDim2.fromOffset(0, MARK + 39),
            BackgroundTransparency = 1,
            Text                   = opts.LoadingSubtitle or L("loading.starting"),
            TextColor3             = theme.TextDim,
            TextTransparency       = 1,
            TextSize               = 11,
            Font                   = Enum.Font.Gotham,
            ZIndex                 = 801,
            Parent                 = splash,
        })

        -- One hairline, full width of the block. A 4px rounded bar looks
        -- like a progress widget; a 1px line looks like a measurement.
        local bar = New("Frame", {
            Size             = UDim2.new(0, 168, 0, 1),
            Position         = UDim2.new(0.5, 0, 0, MARK + 66),
            AnchorPoint      = Vector2.new(0.5, 0),
            BackgroundColor3 = theme.Border,
            BackgroundTransparency = 0.4,
            BorderSizePixel  = 0,
            ClipsDescendants = true,
            ZIndex           = 801,
            Parent           = splash,
        })

        local barFill = New("Frame", {
            Size             = UDim2.fromScale(0, 1),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel  = 0,
            ZIndex           = 802,
            Parent           = bar,
        })

        ------------------------------------------------------------
        -- Run it
        ------------------------------------------------------------

        Tween(splashScale, { Scale = 1 }, EASE.Smooth)
        Tween(Blur, { Size = BlurDepth(1.15) }, EASE.Glide)
        Tween(wordmark, { TextTransparency = 0 }, EASE.Smooth)
        Tween(status,   { TextTransparency = 0 }, EASE.Smooth)

        local duration = opts.LoadingTime or 1.5
        local started  = os.clock()
        local done     = false
        local lit      = false

        local spin
        spin = RunService.RenderStepped:Connect(function()
            if done then return end

            local progress = math.clamp((os.clock() - started) / duration, 0, 1)
            -- Eased so it does not crawl at a constant rate; a bar that
            -- slows near the end reads as waiting on something, which is
            -- exactly what it is doing.
            local eased = 1 - (1 - progress) ^ 3
            barFill.Size = UDim2.fromScale(eased, 1)

            -- The sweep crosses once, in the first 55% of the load, and
            -- leaves the mark lit behind it.
            local sweepAt = math.clamp(progress / 0.55, 0, 1)
            sweep.Position = UDim2.new(-0.7 + sweepAt * 1.85, 0, 0.5, 0)
            if sweepAt >= 1 then
                sweep.BackgroundTransparency = 1
                if not lit then
                    lit = true
                    for _, child in ipairs(markHolder:GetDescendants()) do
                        if child:IsA("TextLabel") then
                            Tween(child, { TextColor3 = theme.Accent }, EASE.Smooth)
                        elseif child:IsA("ImageLabel") then
                            Tween(child, { ImageColor3 = Color3.new(1, 1, 1) }, EASE.Smooth)
                        end
                    end
                end
            end

            if progress < 0.34 then
                status.Text = L(Icons.Loaded and "loading.icons_ready" or "loading.icons")
            elseif progress < 0.72 then
                status.Text = L("loading.building")
            elseif progress < 1 then
                status.Text = L("loading.almost")
            else
                status.Text = L("loading.ready")
            end
        end)
        table.insert(Nely.Connections, spin)

        task.delay(duration + 0.1, function()
            done = true
            spin:Disconnect()
            if Window.Destroyed then
                scrim:Destroy()
                splash:Destroy()
                return
            end

            -- Hand-off. Text goes first, the mark holds a beat longer, then
            -- everything lifts as the shell springs up behind it. The
            -- overlap is what stops there being a blank frame in the middle.
            Tween(wordmark, { TextTransparency = 1 }, EASE.Snap)
            Tween(status,   { TextTransparency = 1 }, EASE.Snap)
            Tween(bar,      { BackgroundTransparency = 1 }, EASE.Snap)
            Tween(barFill,  { BackgroundTransparency = 1 }, EASE.Snap)
            Tween(scrim,    { BackgroundTransparency = 1 }, EASE.Smooth)

            task.delay(0.1, function()
                Tween(splashScale, { Scale = 1.08 }, EASE.Smooth)
                for _, child in ipairs(markHolder:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        Tween(child, { TextTransparency = 1 }, EASE.Smooth)
                    elseif child:IsA("ImageLabel") then
                        Tween(child, { ImageTransparency = 1 }, EASE.Smooth)
                    end
                end
            end)

            local token = Generation()
            task.delay(0.18, function()
                if Current(token) then OpenWindow(true) end
            end)
            task.delay(0.52, function()
                pcall(function() scrim:Destroy() end)
                pcall(function() splash:Destroy() end)
            end)
        end)
    else
        OpenWindow(true)
    end

    Nely.Window = Window
    -- Settings = true builds the page for you. Deferred by one frame so a
    -- hub that creates its own tabs immediately after CreateWindow still
    -- gets them in the order it wrote them, with Settings last -- which is
    -- where anyone looking for it will go first.
    if opts.Settings == true then
        task.defer(function()
            if not Window.Destroyed then
                pcall(function() Window:CreateSettingsTab() end)
            end
        end)
    end

    return Window
end

--==================================================================
--  KEY SYSTEM
--
--  Gate a script behind a key. Keys can be a fixed list or fetched from
--  a URL that returns the key as plain text. Saves on success so the
--  prompt only appears once per machine.
--
--  Worth being clear about what this is: client-side gating. Anyone who
--  can read the script can read past it. It's for distribution control,
--  not security — treat it that way.
--==================================================================

function Nely:KeySystem(opts)
    opts = opts or {}
    local theme    = LiveTheme
    local title    = opts.Title or "Key required"
    local note     = opts.Note or "Enter your key to continue."
    local saveFile = opts.SaveKey ~= false and ((opts.Folder or "NelyLib") .. "/key.txt") or nil
    local resolved = false
    local granted  = false

    local function Accepts(candidate)
        if opts.Keys then
            for _, key in ipairs(opts.Keys) do
                if candidate == key then return true end
            end
        end
        if opts.KeyUrl then
            local ok, remote = pcall(function() return game:HttpGet(opts.KeyUrl) end)
            if ok and remote then
                return candidate == (remote:gsub("%s+$", ""):gsub("^%s+", ""))
            end
        end
        return false
    end

    -- an already-saved key skips the prompt entirely
    if saveFile and isfile and readfile then
        local ok, saved = pcall(function()
            return isfile(saveFile) and readfile(saveFile) or nil
        end)
        if ok and saved and Accepts(saved) then
            return true
        end
    end

    local overlay = New("Frame", {
        Name                   = "KeyOverlay",
        Size                   = UDim2.fromScale(1, 1),
        BackgroundColor3       = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ZIndex                 = 900,
        Parent                 = Root,
    })

    local card = New("Frame", {
        Size             = UDim2.fromOffset(320, 0),
        Position         = UDim2.fromScale(0.5, 0.5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.SurfaceAlt,
        BorderSizePixel  = 0,
        ZIndex           = 902,
        Parent           = overlay,
    }, { Corner(16), Stroke(theme.Border, 1, 0.35), Pad(20, 18, 20, 20), List(0) })

    local iconWrap = New("Frame", {
        Size                   = UDim2.fromOffset(42, 42),
        BackgroundColor3       = theme.Accent,
        BackgroundTransparency = 0.86,
        BorderSizePixel        = 0,
        LayoutOrder            = 1,
        ZIndex                 = 903,
        Parent                 = card,
    }, { Corner(12) })
    local kIcon = Icons.Render("key", iconWrap, 22, theme.Accent, 904)
    kIcon.Position    = UDim2.fromScale(0.5, 0.5)
    kIcon.AnchorPoint = Vector2.new(0.5, 0.5)

    New("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
        LayoutOrder = 2, ZIndex = 903, Parent = card })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = theme.Text,
        TextSize               = 17,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        LayoutOrder            = 3,
        ZIndex                 = 903,
        Parent                 = card,
    })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text                   = note,
        TextColor3             = theme.TextSub,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Top,
        TextWrapped            = true,
        LineHeight             = 1.25,
        LayoutOrder            = 4,
        ZIndex                 = 903,
        Parent                 = card,
    })

    New("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
        LayoutOrder = 5, ZIndex = 903, Parent = card })

    local field = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = theme.Elevated,
        BorderSizePixel  = 0,
        LayoutOrder      = 6,
        ZIndex           = 903,
        Parent           = card,
    }, { Corner(9), Stroke(theme.Border, 1, 0.5) })

    local box = New("TextBox", {
        Size                   = UDim2.new(1, -20, 1, 0),
        Position               = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text                   = "",
        PlaceholderText        = opts.Placeholder or "Paste your key",
        PlaceholderColor3      = theme.TextDim,
        TextColor3             = theme.Text,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ClearTextOnFocus       = false,
        ZIndex                 = 904,
        Parent                 = field,
    })

    New("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1,
        LayoutOrder = 7, ZIndex = 903, Parent = card })

    local row = New("Frame", {
        Size                   = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        LayoutOrder            = 8,
        ZIndex                 = 903,
        Parent                 = card,
    }, {
        New("UIListLayout", {
            Padding       = UDim.new(0, 8),
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder     = Enum.SortOrder.LayoutOrder,
        }),
    })

    local function MakeButton(text, primary, order)
        local btn = New("TextButton", {
            Size             = UDim2.new(opts.GetKeyUrl and 0.5 or 1, -4, 1, 0),
            BackgroundColor3 = primary and theme.Accent or theme.Elevated,
            AutoButtonColor  = false,
            Text             = text,
            TextColor3       = primary and Color3.new(1, 1, 1) or theme.TextSub,
            TextSize         = 13,
            Font             = Enum.Font.GothamBold,
            LayoutOrder      = order,
            ZIndex           = 904,
            Parent           = row,
        }, { Corner(9) })
        return btn
    end

    if opts.GetKeyUrl then
        local getBtn = MakeButton("Get key", false, 1)
        getBtn.MouseButton1Click:Connect(function()
            local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
            if copy then
                copy(opts.GetKeyUrl)
                getBtn.Text = "Link copied"
                task.delay(2, function() getBtn.Text = "Get key" end)
            end
        end)
    end

    local submitBtn = MakeButton("Unlock", true, 2)

    local fieldStroke = field:FindFirstChildOfClass("UIStroke")

    local function Submit()
        local candidate = (box.Text or ""):gsub("%s+$", ""):gsub("^%s+", "")
        if candidate == "" then return end

        if Accepts(candidate) then
            granted = true
            if saveFile and writefile and isfolder and makefolder then
                pcall(function()
                    local folder = opts.Folder or "NelyLib"
                    if not isfolder(folder) then makefolder(folder) end
                    writefile(saveFile, candidate)
                end)
            end
            Tween(fieldStroke, { Color = theme.Success, Transparency = 0.1 }, EASE.Snap)
            Tween(overlay, { BackgroundTransparency = 1 }, EASE.Smooth)
            Tween(card, { Size = UDim2.fromOffset(300, 0) }, EASE.Smooth)
            task.delay(0.3, function() overlay:Destroy() end)
            resolved = true
        else
            Tween(fieldStroke, { Color = theme.Danger, Transparency = 0.1 }, EASE.Snap)
            local origin = card.Position
            for offset = 1, 3 do
                Tween(card, { Position = origin + UDim2.fromOffset(6, 0) }, EASE.Instant)
                task.wait(0.05)
                Tween(card, { Position = origin - UDim2.fromOffset(6, 0) }, EASE.Instant)
                task.wait(0.05)
            end
            Tween(card, { Position = origin }, EASE.Instant)
            task.delay(1.2, function()
                Tween(fieldStroke, { Color = theme.Border, Transparency = 0.5 }, EASE.Snap)
            end)
        end
    end

    submitBtn.MouseButton1Click:Connect(Submit)
    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then Submit() end
    end)

    card.Size = UDim2.fromOffset(300, 0)
    Tween(overlay, { BackgroundTransparency = 0.4 }, EASE.Smooth)
    Tween(card, { Size = UDim2.fromOffset(320, 0) }, EASE.Pop)
    Tween(Blur, { Size = BlurDepth(0.85) }, EASE.Glide)

    repeat task.wait(0.1) until resolved
    return granted
end

--==================================================================
--  GLOBAL API
--==================================================================

-- Hooks for code that computes a colour rather than storing one -- a
-- lerp between Surface and Accent, say. Those cannot be expressed as a
-- binding, so they re-run here instead.
local ThemeHooks = {}

function Nely:OnTheme(fn)
    if type(fn) ~= "function" then return function() end end
    table.insert(ThemeHooks, fn)
    -- Returns its own disconnector, so a component that dies can stop
    -- being called instead of leaking a reference to a dead frame.
    return function()
        for i, entry in ipairs(ThemeHooks) do
            if entry == fn then table.remove(ThemeHooks, i) return end
        end
    end
end

function Nely:SetTheme(name, opts)
    local newTheme, canonical = ResolveTheme(name)
    if not newTheme then return false end
    CompleteTheme(newTheme)

    local oldTheme = Nely.Theme
    if newTheme == oldTheme then return true end

    opts = opts or {}
    local animated = opts.Animate
    if animated == nil then animated = true end
    animated = animated and Motion.Enabled

    -- Reverse map has to be built from the OLD palette, before the swap.
    local function Key(color)
        return ("%d|%d|%d"):format(
            math.round(color.R * 255),
            math.round(color.G * 255),
            math.round(color.B * 255)
        )
    end

    local slotOf = {}
    for _, slot in ipairs(CLASSIC_SLOTS) do
        local color = oldTheme[slot]
        if typeof(color) == "Color3" then slotOf[Key(color)] = slot end
    end

    -- Swap first, so anything that reads Nely.Theme during the repaint --
    -- a hook, a binding, a handler firing mid-tween -- already sees the
    -- new palette. This ordering is the whole point: under the old code a
    -- hover during the swap could repaint from the outgoing theme.
    Nely.Theme = newTheme

    -- 1. Bound properties. Authoritative, and animated.
    ApplyThemeBindings(animated)

    -- 2. Everything not yet migrated to a binding. Same reverse-lookup
    --    trick as before -- it is still the only way to recolour an
    --    instance that never told us what its colours meant -- but it now
    --    yields to bindings, so a bound property is never fought over by
    --    a colour coincidence.
    local function isBound(inst, prop)
        local props = ThemeBindings[inst]
        return props ~= nil and props[prop] ~= nil
    end

    local function Swap(inst, prop)
        if isBound(inst, prop) then return end
        local ok, current = pcall(function() return inst[prop] end)
        if not ok or typeof(current) ~= "Color3" then return end
        local slot = slotOf[Key(current)]
        if not slot then return end
        local target = newTheme[slot]
        if not target then return end
        if animated then
            Tween(inst, { [prop] = target }, EASE.Theme)
        else
            pcall(function() inst[prop] = target end)
        end
    end

    for _, inst in ipairs(Root:GetDescendants()) do
        if inst:IsA("GuiObject") then
            Swap(inst, "BackgroundColor3")
        end
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            Swap(inst, "TextColor3")
        end
        if inst:IsA("TextBox") then
            Swap(inst, "PlaceholderColor3")
        end
        if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
            Swap(inst, "ImageColor3")
        end
        if inst:IsA("ScrollingFrame") then
            Swap(inst, "ScrollBarImageColor3")
        end
        if inst:IsA("UIStroke") then
            Swap(inst, "Color")
        end
        if inst:IsA("UIGradient") then
            -- Gradients are a single property, so "is it bound" is asked
            -- once for the whole sequence.
            if not isBound(inst, "Color") then
                local points, changed = {}, false
                for _, keypoint in ipairs(inst.Color.Keypoints) do
                    local slot = slotOf[Key(keypoint.Value)]
                    local swapped = slot and newTheme[slot] or nil
                    if swapped then changed = true end
                    table.insert(points,
                        ColorSequenceKeypoint.new(keypoint.Time, swapped or keypoint.Value))
                end
                if changed then inst.Color = ColorSequence.new(points) end
            end
        end
    end

    -- 3. Derived colours nobody could have stored.
    for i = #ThemeHooks, 1, -1 do
        local ok = pcall(ThemeHooks[i], newTheme, oldTheme)
        -- A hook that throws is a dead component; drop it rather than
        -- letting it break every future theme change.
        if not ok then table.remove(ThemeHooks, i) end
    end

    Nely.ThemeName = canonical or Nely.ThemeName
    return true
end

function Nely:GetTheme() return Nely.Theme end

function Nely:Destroy()
    if Nely.Window then Nely.Window:Destroy() end
end

return Nely
