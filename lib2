function NelyX:Notify(cfg)
    cfg = cfg or {}
    local colour = cfg.Color or Theme.Accent
    local card = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ZIndex = 501,
        Parent = NotifyHost,
    }, {
        Corner(12), Stroke(colour, 1, 0.55), Pad(11, 11, 12, 12),
        List(3),
    })
    Shadow(card, 22, 0.7, 12)

    -- accent rail so the toast reads at a glance
    New("Frame", {
        Size = UDim2.new(0, 3, 1, -14),
        Position = UDim2.fromOffset(0, 7),
        BackgroundColor3 = colour,
        BorderSizePixel = 0,
        ZIndex = 503,
        Parent = card,
    }, { Corner(2) })

    local head = New("Frame", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        ZIndex = 502,
        Parent = card,
    })
    local ic = RenderIcon(cfg.Icon or "bolt", head, 14, colour, 503)
    ic.Position = UDim2.fromOffset(0, 2)
    New("TextLabel", {
        Position = UDim2.fromOffset(20, 0),
        Size = UDim2.new(1, -20, 1, 0),
        BackgroundTransparency = 1,
        Text = tostring(cfg.Title or "Notice"),
        TextColor3 = Theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 503,
        Parent = head,
    })
    if cfg.Content and cfg.Content ~= "" then
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = tostring(cfg.Content),
            TextColor3 = Theme.TextSub,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            LayoutOrder = 2,
            ZIndex = 502,
            Parent = card,
        })
    end

    card.BackgroundTransparency = 1
    card.Position = UDim2.fromOffset(40, 0)
    Tween(card, { BackgroundTransparency = 0.08, Position = UDim2.fromOffset(0, 0) }, EASE.Pop)

    task.delay(cfg.Duration or 4, function()
        Tween(card, { BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 0) }, EASE.Glide)
        task.delay(0.3, function() pcall(function() card:Destroy() end) end)
    end)
end

