        ZIndex                 = 703,
        Parent                 = card,
    })

    New("Frame", {
        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
        LayoutOrder = 5, ZIndex = 703, Parent = card,
    })

    local row = New("Frame", {
        Size                   = UDim2.new(1, 0, 0, 38),
        BackgroundTransparency = 1,
        LayoutOrder            = 6,
        ZIndex                 = 703,
        Parent                 = card,
    }, {
        New("UIListLayout", {
            Padding       = UDim.new(0, 8),
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder     = Enum.SortOrder.LayoutOrder,
        }),
    })

    local function close()
        Tween(overlay, { BackgroundTransparency = 1 }, EASE.Smooth)
        Tween(cardScale, { Scale = 0.96 }, EASE.Smooth)
        task.delay(0.3, function() overlay:Destroy() end)
    end

    local width = 1 / math.max(#buttons, 1)
    for index, spec in ipairs(buttons) do
        local isPrimary = spec.Primary == true
        local base      = isPrimary and theme.Accent or theme.Elevated
        local btn = New("TextButton", {
            Size             = UDim2.new(width, -4, 1, 0),
            BackgroundColor3 = base,
            AutoButtonColor  = false,
            Text             = "",
            LayoutOrder      = index,
            ZIndex           = 704,
            ClipsDescendants = true,
            Parent           = row,
        }, { Corner(10) })

        New("TextLabel", {
            Size                   = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text                   = spec.Title or "OK",
            TextColor3             = isPrimary and Color3.new(1, 1, 1) or theme.TextSub,
            TextSize               = 13,
            Font                   = Enum.Font.GothamBold,
            ZIndex                 = 705,
            Parent                 = btn,
        })

        btn.MouseEnter:Connect(function()
            Tween(btn, { BackgroundColor3 = isPrimary and theme.AccentSoft or theme.Hover }, EASE.Snap)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, { BackgroundColor3 = base }, EASE.Snap)
        end)
        btn.MouseButton1Click:Connect(function()
            Ripple(btn, 706)
            task.wait(0.05)
            close()
            if spec.Callback then task.spawn(spec.Callback) end
        end)
    end

    card.Size = UDim2.fromOffset(310, 0)
    Tween(overlay, { BackgroundTransparency = 0.5 }, EASE.Smooth)
    Tween(cardScale, { Scale = 1 }, EASE.Modal)

    return { Close = close }
end

--==================================================================
--  BRAND MARK
--  Draws the hub's monogram, with a custom logo layered over it when one
--  is supplied. The letter stays underneath on purpose: if the logo is
--  still downloading, was rejected, or is awaiting Roblox moderation, the
--  mark reads as intentional instead of collapsing into an empty square.
--==================================================================

-- plain = true strips the coloured tile once the artwork loads, so the logo
-- stands on its own instead of sitting on an accent square. That is what the
-- topbar and the splash want; the orb keeps its tile, because a logo floating
-- with no disc behind it has no edge to read against the game world.
local function BrandMark(parent, title, logo, textSize, radius, zindex, plain)
    local letter = New("TextLabel", {
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text                   = string.sub(title, 1, 1):upper(),
        TextColor3             = Color3.new(1, 1, 1),
        TextSize               = textSize,
        Font                   = Enum.Font.GothamBold,
        ZIndex                 = zindex,
        Parent                 = parent,
    })

    if not logo or logo == "" then return end

    local image = New("ImageLabel", {
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image                  = "",
        ImageTransparency      = 1,
        ScaleType              = Enum.ScaleType.Fit,
        ZIndex                 = zindex + 1,
        Parent                 = parent,
    }, { Corner(radius) })

    ResolveImageAsync(logo, function(content)
        image.Image = content
        Tween(image, { ImageTransparency = 0 }, EASE.Smooth)

        -- The letter is the fallback, not a backdrop. Logos are very often
        -- transparent PNGs, and leaving it lit meant a big "N" showing
        -- straight through the artwork. It fades out on the same beat the
        -- logo fades in, and stays put if the lookup never returns.
        Tween(letter, { TextTransparency = 1 }, EASE.Smooth)

        if plain then
            Tween(parent, { BackgroundTransparency = 1 }, EASE.Smooth)
            local gradient = parent:FindFirstChildOfClass("UIGradient")
            if gradient then gradient:Destroy() end
            local stroke = parent:FindFirstChildOfClass("UIStroke")
            if stroke then Tween(stroke, { Transparency = 1 }, EASE.Smooth) end
        end
    end)
end

--==================================================================
--  WATERMARK
--
--  A small always-on-top strip: your label, then live FPS, ping and
--  clock. Drag it anywhere. It is independent of the window, so it
--  stays put while the hub is minimised — which is the point, since
--  that is when you actually want to see your framerate.
--
--  FPS is a one-second rolling count rather than 1/DeltaTime, which
--  jitters far too much to read. Ping comes from Stats and is only
--  polled every second; it is a server round trip, not a per-frame
--  number, so sampling it faster just burns CPU.
--==================================================================

function Nely:Watermark(opts)
    opts = opts or {}
    local theme = LiveTheme

    if Nely._watermark then Nely._watermark:Destroy() end

    local pill = New("Frame", {
        Name                   = "Watermark",
        Size                   = UDim2.fromOffset(0, 30),
        Position               = opts.Position or UDim2.fromOffset(18, 18),
        AutomaticSize          = Enum.AutomaticSize.X,
        BackgroundColor3       = theme.Surface,
        BackgroundTransparency = 0.1,
        BorderSizePixel        = 0,
        ZIndex                 = 800,
        Parent                 = Root,
    }, { Corner(9), Stroke(theme.BorderSoft, 1, 0.35) })

    Shadow(pill, 22, 0.75)

    -- Accent bar down the left edge.
    New("Frame", {
        Size             = UDim2.new(0, 2, 1, -12),
        Position         = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint      = Vector2.new(0, 0.5),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel  = 0,
        ZIndex           = 801,
        Parent           = pill,
    }, { Corner(2) })

    -- The cells live in their own row rather than straight on the pill: a
    -- UIListLayout positions every GuiObject child it can see, and on the
    -- pill that would have included the drop shadow and the accent bar.
    local row = New("Frame", {
        Name                   = "Row",
        Size                   = UDim2.fromOffset(0, 30),
        Position               = UDim2.fromOffset(12, 0),
        AutomaticSize          = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex                 = 801,
        Parent                 = pill,
    }, {
        Pad(0, 0, 0, 12),
        New("UIListLayout", {
            Padding           = UDim.new(0, 9),
            FillDirection     = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder         = Enum.SortOrder.LayoutOrder,
        }),
    })

    local order = 0
    local function Cell(text, color, font, size)
        order = order + 1
        return New("TextLabel", {
            Size                   = UDim2.fromOffset(0, 30),
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text                   = text,
            TextColor3             = color,
            TextSize               = size or 12,
            Font                   = font or Enum.Font.GothamMedium,
            LayoutOrder            = order,
            ZIndex                 = 802,
            Parent                 = row,
        })
    end

    local function Sep()
        order = order + 1
        New("Frame", {
            Size             = UDim2.fromOffset(1, 12),
            BackgroundColor3 = theme.Border,
            BackgroundTransparency = 0.4,
            BorderSizePixel  = 0,
            LayoutOrder      = order,
            ZIndex           = 802,
            Parent           = row,
        })
    end

    local label = Cell(opts.Text or "Nely", theme.Text, Enum.Font.GothamBold, 13)
    Sep()
    local fpsCell  = opts.ShowFPS  ~= false and Cell("-- fps", theme.TextSub, Enum.Font.Code) or nil
    local pingCell = opts.ShowPing ~= false and Cell("-- ms",  theme.TextSub, Enum.Font.Code) or nil
    local timeCell = opts.ShowTime ~= false and Cell("--:--",  theme.TextDim, Enum.Font.Code) or nil

    Draggable(pill, pill)

    local frames, window, conn = 0, 0, nil

    conn = RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        window = window + dt

        if window >= 1 then
            if fpsCell then
                fpsCell.Text = string.format("%d fps", math.floor(frames / window + 0.5))
            end
            frames, window = 0, 0

            if pingCell then
                local ok, ms = pcall(function()
                    return game:GetService("Stats").Network
                        .ServerStatsItem["Data Ping"]:GetValue()
                end)
                pingCell.Text = ok and string.format("%d ms", math.floor(ms)) or "-- ms"
            end
            if timeCell then
                timeCell.Text = os.date("%H:%M")
            end
        end
    end)

    local api = { Instance = pill }

    function api:SetText(text) label.Text = text end

    function api:SetEnabled(state)
        pill.Visible = state and true or false
    end

    function api:Destroy()
        if conn then conn:Disconnect() end
        pill:Destroy()
        if Nely._watermark == api then Nely._watermark = nil end
    end

    if opts.Enabled == false then pill.Visible = false end

    -- Registered so Window:Destroy tears the render loop down with
    -- everything else, rather than leaving it ticking on a dead frame.
    table.insert(Nely.Connections, conn)

    Nely._watermark = api
    return api
end

--==================================================================
--  WINDOW
--==================================================================

function Nely:CreateWindow(opts)
    opts = opts or {}
    -- Resolve once into the real table, then hand the window the live
    -- proxy. Everything the window builds from here captures the proxy,
    -- so SetTheme later is a genuine change of mind rather than a repaint
    -- that the next hover undoes.
    local resolved, canonical = ResolveTheme(opts.Theme)
    resolved  = resolved or Nely.Themes.Metallic
    canonical = canonical or "Metallic"
    CompleteTheme(resolved)
    Nely.Theme     = resolved
    Nely.ThemeName = canonical
    local theme    = LiveTheme

    local title     = opts.Title     or "Nely Hub"
    local subtitle  = opts.Subtitle or opts.SubTitle or ""
    local toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift

    ----------------------------------------------------------------
    -- Responsive sizing
    --
    -- A fixed 660x470 is fine on a desktop monitor and enormous on a
    -- phone, where it can exceed the screen. Size is derived from the
    -- viewport instead, then clamped, so the same script is usable on
    -- both without a separate mobile build.
    ----------------------------------------------------------------

    local viewport = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize
        or Vector2.new(1280, 720)

    local compact = viewport.X < Design.Breakpoint.Compact
    local touch   = UserInputService.TouchEnabled

    local function Fit(fraction, low, high, axis)
        return math.floor(math.clamp(axis * fraction, low, high))
    end

    -- Deliberately smaller than the last build. Rows grew at the same
    -- time, so a tab holding two elements now fills its page instead of
    -- leaving a dead area below them.
    local winSize = opts.Size or UDim2.fromOffset(
        Fit(compact and 0.92 or 0.40, 310, 560, viewport.X),
        Fit(compact and 0.68 or 0.54, 280, 410, viewport.Y)
    )

    -- 146px truncated real tab names ("Skin Changer" became "Skin..."),
    -- which defeats the point of having names at all. Widened to fit the
    -- longest label a hub realistically uses; the rail toggle is still
    -- there for anyone who wants the space back.
    local sidebarW = opts.SidebarWidth or (compact and 156 or 196)
    local topbarH  = compact and 42 or 46

    -- Rows are taller on desktop than the previous build. Paired with the
    -- smaller window above, a tab with one or two elements now reads as
    -- full rather than mostly empty.
    --
    -- Density = "compact" trades that breathing room for reach: a settings
    -- page with twenty rows stops needing three screens of scrolling. The
    -- rows keep their internals, they just lose vertical padding.
    local dense  = opts.Density == "compact"
    local ROW_H  = dense and (compact and 42 or 46) or (compact and 50 or 56)
    local ROW_HD = dense and (compact and 54 or 60) or (compact and 62 or 70)
    -- Touch never gets a row shorter than the 44px minimum target, whatever
    -- the width said.
    if touch then
        ROW_H  = math.max(ROW_H,  Design.Touch.Min)
        ROW_HD = math.max(ROW_HD, Design.Touch.Min + 18)
    end

    local Window = {
        Tabs        = {},
        ActiveTab   = nil,
        Minimized   = false,
        Destroyed   = false,
        CurrentSize = winSize,
        Compact     = compact,
        Dense       = dense,
        TabSections = {},
        -- Opt in to the rainbow sidebar. Off by default in v4 -- see
        -- TabHue below for why.
        ColorfulTabs = opts.ColorfulTabs == true,
        _tabOrder   = 0,
        _dependents = {},
        _conns      = {},
        _themeHooks = {},
        _gen        = 0,
    }

    -- Connection audit. Every long-lived listener the window opens goes
    -- through here, so Destroy can actually close them. Previously a
    -- destroyed window left RenderStepped and InputBegan handlers running
    -- against dead frames -- harmless once, but running a hub twice in a
    -- session stacked them.
    local function Track(conn)
        if conn then table.insert(Window._conns, conn) end
        return conn
    end
    Window._Track = function(_, conn) return Track(conn) end

    -- Generation token. Bumped whenever the window changes state in a way
    -- that invalidates work already queued with task.delay -- a tab
    -- transition, a dropdown close, a destroy. A delayed callback compares
    -- the token it captured against the current one and does nothing if it
    -- has been superseded, which is what stops a half-finished tab fade
    -- from reappearing over the tab you actually clicked.
    local function Generation()
        Window._gen = Window._gen + 1
        return Window._gen
    end
    local function Current(token)
        return not Window.Destroyed and Window._gen == token
    end

    -- Called by any flagged toggle after it settles, so rows that declared
    -- `Depends = "ThatFlag"` grey themselves out without polling.
    function Window:_Sync(flag, value)
        local list = Window._dependents[flag]
        if not list then return end
        for _, entry in ipairs(list) do
            local want = value and true or false
            if entry.invert then want = not want end
            if entry.api and entry.api.SetEnabled then
                entry.api:SetEnabled(want)
            end
        end
    end

    local minSize = opts.MinSize or Vector2.new(
        math.min(compact and 300 or 480, winSize.X.Offset),
        math.min(compact and 260 or 340, winSize.Y.Offset)
    )
    local maxSize = opts.MaxSize or Vector2.new(
        math.max(math.floor(viewport.X * 0.96), winSize.X.Offset),
        math.max(math.floor(viewport.Y * 0.92), winSize.Y.Offset)
    )

    ----------------------------------------------------------------
    -- Shell
    ----------------------------------------------------------------

    -- V4 glass shell.
    --
    -- Roblox has no backdrop blur for GUI, so "glass" is built out of what
    -- it does have: a translucent base so the game reads through, a
    -- diagonal accent wash for depth, and a one pixel top highlight that
    -- catches the eye the way a lit edge does. Three cheap layers beat one
    -- flat panel, and none of them cost a frame of work to maintain.
    --
    -- Glass = 0 gives the old opaque look; the default leans translucent.
    local glass = opts.Glass
    if glass == nil then glass = 0.18 end
    if opts.Transparent == false then glass = 0 end

    local shell = New("Frame", {
        Name             = "Window",
        Themed           = { BackgroundColor3 = "Backdrop" },
        Size             = winSize,
        Position         = UDim2.fromScale(0.5, 0.5),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Backdrop,
        BackgroundTransparency = glass,
        BorderSizePixel  = 0,
        -- must stay false: the shadow lives inside the shell and would be clipped away.
        -- the content frame does its own clipping for page transitions.
        ClipsDescendants = false,
        ZIndex           = 10,
        Parent           = Root,
    }, {
        Corner(18),
        Stroke(theme.Border, 1, 0.15),
    })
    Shadow(shell, 42, 0.72, 18)
    Window.Frame = shell

    -- Layer 1: diagonal accent wash, strongest at the top left corner so
    -- the window reads as lit from one side rather than evenly filled.
    New("Frame", {
        Name                   = "Wash",
        Size                   = UDim2.fromScale(1, 1),
        BackgroundColor3       = theme.Accent,
        BackgroundTransparency = 0.93,
        BorderSizePixel        = 0,
        ZIndex                 = 10,
        Parent                 = shell,
    }, {
        Corner(18),
        Gradient(ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Accent),
            ColorSequenceKeypoint.new(0.45, theme.Backdrop),
            ColorSequenceKeypoint.new(1, theme.Backdrop),
        }), 135),
    })

    -- Layer 2: vertical depth, darkening toward the bottom so content
    -- sitting low on the page still separates from the edge.
    New("Frame", {
        Name                   = "Depth",
        Size                   = UDim2.fromScale(1, 1),
        BackgroundColor3       = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.90,
        BorderSizePixel        = 0,
        ZIndex                 = 10,
        Parent                 = shell,
    }, {
        Corner(18),
        New("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.6, 0.96),
                NumberSequenceKeypoint.new(1, 0.86),
            }),
        }),
    })

    -- Layer 3: the lit top edge. One pixel, fading out toward the sides.
    New("Frame", {
        Name                   = "Sheen",
        Size                   = UDim2.new(1, -36, 0, 1),
        Position               = UDim2.new(0, 18, 0, 1),
        BackgroundColor3       = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.75,
        BorderSizePixel        = 0,
        ZIndex                 = 21,
        Parent                 = shell,
    }, {
        New("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.5, 0),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }),
    })

    ----------------------------------------------------------------
    -- Topbar
    ----------------------------------------------------------------

    local topbar = New("Frame", {
        Name                   = "Topbar",
        Size                   = UDim2.new(1, 0, 0, topbarH),
        BackgroundTransparency = 1,
        ZIndex                 = 20,
        Parent                 = shell,
    })

    -- Full-bleed, not inset. An inset hairline under the header reads as
    -- a decorative underline; edge to edge it reads as the boundary
    -- between two regions of the layout, which is what it is.
    New("Frame", {
        Name             = "TopbarEdge",
        Themed           = { BackgroundColor3 = "Divider" },
        Size             = UDim2.new(1, 0, 0, 1),
        Position         = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = theme.Divider,
        BorderSizePixel  = 0,
        ZIndex           = 20,
        Parent           = topbar,
    })

    ----------------------------------------------------------------
    -- Brand block
    --
    -- A supplied logo gets real presence: 34px square with no tile
    -- behind it, which is roughly the size a wordmark occupies in the
    -- tools this is modelled on. Without a logo it falls back to the
    -- old 26px accent tile with the hub initial, because a lone letter
    -- blown up to 34px just looks like a typo.
    --
    -- LogoSize overrides the square. LogoStyle = "tile" keeps the
    -- accent square under the artwork if that is the look you want.
    ----------------------------------------------------------------

    local hasLogo   = opts.Logo ~= nil and opts.Logo ~= ""
    local plainLogo = hasLogo and opts.LogoStyle ~= "tile"
    local logoSize  = opts.LogoSize or (hasLogo and (compact and 28 or 34) or 26)
    local titleX    = 16 + logoSize + (hasLogo and 13 or 10)

    local logo = New("Frame", {
        Name             = "Brand",
        Size             = UDim2.fromOffset(logoSize, logoSize),
        Position         = UDim2.new(0, 16, 0.5, 0),
        AnchorPoint      = Vector2.new(0, 0.5),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel  = 0,
        ZIndex           = 21,
        Parent           = topbar,
    }, {
        Corner(math.floor(logoSize * 0.3)),
        Gradient(ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.AccentSoft),
            ColorSequenceKeypoint.new(1, theme.AccentDeep),
        }), 135),
    })

    BrandMark(logo, title, opts.Logo, math.floor(logoSize * 0.58),
        math.floor(logoSize * 0.3), 22, plainLogo)

    New("TextLabel", {
        Name                   = "Title",
        Size                   = UDim2.fromOffset(240, 18),
        Position               = UDim2.new(0, titleX, 0.5, subtitle ~= "" and -8 or 0),
        AnchorPoint            = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = theme.Text,
        TextSize               = hasLogo and 16 or 15,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 21,
        Parent                 = topbar,
    })

    if subtitle ~= "" then
        New("TextLabel", {
            Size                   = UDim2.fromOffset(240, 14),
            Position               = UDim2.new(0, titleX, 0.5, 9),
            AnchorPoint            = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Text                   = subtitle,
            TextColor3             = theme.TextDim,
            TextSize               = 11,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            ZIndex                 = 21,
            Parent                 = topbar,
        })
    end

    ----------------------------------------------------------------
    -- Current-game badge
    --
    -- Sits beside the hub name so you can see at a glance which place
    -- the script is running in. The name comes from MarketplaceService
    -- and the thumbnail from the same universe resolver the game grid
    -- uses, so this costs one lookup that is already cached.
    --
    -- It lives on the LEFT, immediately after the title, separated by a
    -- hairline. That is where the free width is: the right-hand side has
    -- to share with the credit pill and three window controls, which is
    -- what was squeezing long place names down to an ellipsis.
    -- GameBadge = "right" puts it back beside the credit.
    ----------------------------------------------------------------

    -- CONTROLS_W has to clear every window control. Three 28px buttons at
    -- -14 / -48 / -82 means the leftmost one ends at -110, so anything that
    -- starts at -88 lands underneath the rail button. That was the credit
    -- pill sitting on top of the collapse button.
    local CONTROLS_W  = 108
    local badgeOnLeft = opts.GameBadge ~= "right"

    -- Right rail: the credit pill, and the game badge too when it has been
    -- sent back over here. Laid out on one line and right-aligned so neither
    -- has to know how wide the other is.
    local topbarRight = New("Frame", {
        Name                   = "TopbarRight",
        Size                   = UDim2.fromOffset(0, 24),
        Position               = UDim2.new(1, -CONTROLS_W, 0.5, 0),
        AnchorPoint            = Vector2.new(1, 0.5),
        AutomaticSize          = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex                 = 21,
        Parent                 = topbar,
    }, {
        New("UIListLayout", {
            Padding             = UDim.new(0, 10),
            FillDirection       = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment   = Enum.VerticalAlignment.Center,
            SortOrder           = Enum.SortOrder.LayoutOrder,
        }),
    })

    -- Forward declarations: the badge measures itself against whatever else
    -- ends up on the topbar, and both of those are built further down.
    local creditPill
    local topbarSearch
    local FitGameBadge = function() end

    -- Where the title block ends, so the badge and the divider know where
    -- to start. Measured rather than guessed, because the fixed 220px title
    -- label is a container, not the width of the text inside it.
    local function TitleBlockEnd()
        local titleW = TextService:GetTextSize(
            title, hasLogo and 16 or 15, Enum.Font.GothamBold,
            Vector2.new(9999, 40)).X
        local subW = subtitle ~= "" and TextService:GetTextSize(
            subtitle, 11, Enum.Font.Gotham, Vector2.new(9999, 40)).X or 0
        return titleX + math.max(titleW, subW)
    end

    -- On by default, as it always was. It is how you tell at a glance
    -- which place the script is attached to. ShowGame = false removes it.
    if opts.ShowGame ~= false then
        local divider
        if badgeOnLeft then
            divider = New("Frame", {
                Name             = "TopbarDivider",
                Size             = UDim2.fromOffset(1, 20),
                Position         = UDim2.new(0, TitleBlockEnd() + 16, 0.5, 0),
                AnchorPoint      = Vector2.new(0, 0.5),
                BackgroundColor3 = theme.BorderSoft,
                BorderSizePixel  = 0,
                Visible          = false,
                ZIndex           = 21,
                Parent           = topbar,
            })
        end

        local badge = New("Frame", {
            Name                   = "GameBadge",
            Size                   = UDim2.fromOffset(0, 24),
            Position               = badgeOnLeft
                and UDim2.new(0, TitleBlockEnd() + 33, 0.5, 0) or nil,
            AnchorPoint            = badgeOnLeft and Vector2.new(0, 0.5) or nil,
            AutomaticSize          = Enum.AutomaticSize.X,
            BackgroundColor3       = theme.Elevated,
            BackgroundTransparency = 0.3,
            BorderSizePixel        = 0,
            Visible                = false,
            LayoutOrder            = 1,
            ZIndex                 = 21,
            Parent                 = badgeOnLeft and topbar or topbarRight,
        }, { Corner(7), Stroke(theme.BorderSoft, 1, 0.5), Pad(0, 0, 5, 9) })

        local thumb = New("ImageLabel", {
