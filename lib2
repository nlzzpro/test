    -- Sidebar rail
    --
    -- Collapses the sidebar down to its icons and gives the page the
    -- reclaimed width. Tab names move into tooltips rather than being
    -- dropped, so a railed sidebar is still navigable by someone who
    -- doesn't recognise every glyph yet.
    ----------------------------------------------------------------

    local RAIL_W  = 58
    local railed  = false
    local searchWrap                       -- assigned by the search block below

    -- One place that owns the tab list's geometry. Three things want to move
    -- it — the sidebar search, the player card, and the rail — and when each
    -- of them set it directly the last one to run won.
    local function LayoutTabList()
        local top    = (searchWrap and searchWrap.Visible) and 46 or 10
        local bottom = playerCard and (PLAYER_CARD_H + 4) or 10
        tabList.Position = UDim2.fromOffset(7, top)
        tabList.Size     = UDim2.new(1, -14, 1, -(top + bottom))
    end

    local function ApplyRail(state, animate)
        railed = state and true or false
        Window.Railed = railed
        local width = railed and RAIL_W or sidebarW
        local ease  = animate == false and EASE.Instant or EASE.Glide

        Tween(sidebar, { Size = UDim2.new(0, width, 1, -topbarH) }, ease)
        Tween(content, {
            Size     = UDim2.new(1, -width, 1, -topbarH),
            Position = UDim2.new(0, width, 0, topbarH),
        }, ease)

        for _, tab in ipairs(Window.Tabs) do
            if tab._label then
                Tween(tab._label, { TextTransparency = railed and 1 or 0 }, EASE.Snap)
                -- Deliberately does NOT touch Active. Setting it true put
                -- the label on top of its own button in the input pass and
                -- made the tab text unclickable; see NoInput.
            end
            if tab._icon then
                -- 44px of usable button width inside the rail, 16px glyph.
                Tween(tab._icon, {
                    Position = UDim2.new(0, railed and 14 or 13, 0.5, 0),
                }, ease)
            end
        end

        for _, section in ipairs(Window.TabSections) do
            local header = section._header
            if header then
                local lbl = header:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.Visible = not railed end
                local pad = header:FindFirstChildOfClass("UIPadding")
                if pad then
                    pad.PaddingLeft = UDim.new(0, railed and 16 or 5)
                end
            end
        end

        -- The sidebar search box has nowhere to go at 58px wide, so it
        -- steps aside and the tab list takes back the space.
        if searchWrap then
            searchWrap.Visible = not railed
        end

        -- The player card keeps its avatar and drops the text, so the rail
        -- still shows you who you are logged in as.
        -- Railed: the avatar centres and the name goes. It is the one part
        -- still recognisable at 58px wide.
        if playerCard then
            Tween(playerAvatar, {
                Position = railed and UDim2.new(0.5, 0, 0.5, 0)
                                  or  UDim2.new(0, 6, 0.5, 0),
                AnchorPoint = railed and Vector2.new(0.5, 0.5) or Vector2.new(0, 0.5),
            }, ease)
            Tween(playerName, { TextTransparency = railed and 1 or 0 }, EASE.Snap)
        end

        LayoutTabList()
    end

    Window.Railed = false
    LayoutTabList()   -- SearchBar = false never reaches the search block

    -- Once the rail is set deliberately -- by the hub or by the user
    -- clicking the toggle -- the responsive manager stops choosing for
