        function Tab:CreateItemGrid(cfg)
            cfg = cfg or {}
            local cell   = cfg.CellSize or Vector2.new(104, 122)
            local cap    = cfg.MaxCards or 300
            local batch  = cfg.Batch or 36

            local function OnScreen(inst)
                local size = inst.AbsoluteSize
                if size.X < 1 or size.Y < 1 then return false end
                local pos  = inst.AbsolutePosition
                local view = workspace.CurrentCamera
                            and workspace.CurrentCamera.ViewportSize
                            or Vector2.new(1920, 1080)
                return pos.X + size.X > 0 and pos.X < view.X
                   and pos.Y + size.Y > 0 and pos.Y < view.Y
            end

            local holder = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 0),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = NextOrder(),
