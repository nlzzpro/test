--==================================================================
--  SOFT SHADOW  (layered frames, zero asset dependency)
--==================================================================

local function Shadow(parent, spread, opacity, radius)
    spread  = spread  or 18
    opacity = opacity or 0.55
    radius  = radius  or 14
    local holder = New("Frame", {
        Name                   = "Shadow",
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex                 = (parent.ZIndex or 1) - 1,
        Parent                 = parent,
    })
    local layers = 4
    for i = 1, layers do
        local ratio = i / layers
        New("Frame", {
            Size                   = UDim2.new(1, spread * ratio * 2, 1, spread * ratio * 2),
            Position               = UDim2.fromScale(0.5, 0.5),
            AnchorPoint            = Vector2.new(0.5, 0.5),
            BackgroundColor3       = Color3.new(0, 0, 0),
            BackgroundTransparency = 1 - (opacity / layers) * (1 - ratio * 0.55),
            BorderSizePixel        = 0,
            ZIndex                 = holder.ZIndex,
            Parent                 = holder,
        }, { Corner(radius + spread * ratio) })
    end
    return holder
end

