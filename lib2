local function SaveUniverseCache()
    if not (writefile and isfolder and makefolder) then return end
    pcall(function()
        if not isfolder("nely_cache") then makefolder("nely_cache") end
        local plain = {}
        for placeId, universeId in pairs(universeCache) do
            plain[tostring(placeId)] = universeId
        end
        writefile(UNIVERSE_CACHE_FILE, HttpService:JSONEncode(plain))
    end)
end

LoadUniverseCache()

local function ProcessUniverseQueue()
    if universeRunning then return end
    universeRunning = true

    task.spawn(function()
        local fetched = false

        while #universeQueue > 0 do
            local job = table.remove(universeQueue, 1)
            local cached = universeCache[job.placeId]

            if cached then
                job.callback(cached)
            else
                local data = HttpGetJson(
                    ("https://apis.roblox.com/universes/v1/places/%d/universe"):format(job.placeId))
                local universeId = data and data.universeId

                if universeId then
                    universeCache[job.placeId] = universeId
                    fetched = true
                    job.callback(universeId)
                end

                task.wait(0.12)
            end
        end

        universeRunning = false
        if fetched then SaveUniverseCache() end
    end)
end

local remoteCache = {}

local function cachePath(url)
    local hash = 5381
    for i = 1, #url do
        hash = (hash * 33 + string.byte(url, i)) % 4294967296
    end
    return ("nely_cache/%d.png"):format(hash)
end

local function CacheRemoteImage(url)

    local hit = remoteCache[url]
    if hit then
        if isfile and isfile(hit.path) then
            return hit.asset
        end
        remoteCache[url] = nil
    end

    if not (writefile and getcustomasset and isfolder and makefolder) then
        return nil
    end

    local path = cachePath(url)

    if isfile and isfile(path) then
        local okReuse, asset = pcall(getcustomasset, path)
        if okReuse and asset then
            remoteCache[url] = { path = path, asset = asset }
            return asset
        end
    end

    local httpRequest = (syn and syn.request) or (http and http.request)
                        or http_request or request
    if not httpRequest then return nil end

    local ok, asset = pcall(function()
        if not isfolder("nely_cache") then makefolder("nely_cache") end

        local target = url:gsub("/Webp/", "/Png/")

        local response = httpRequest({ Url = target, Method = "GET" })
        local body = response and (response.Body or response.body)
        if not body or #body == 0 then return nil end

        writefile(path, body)
        return getcustomasset(path)
    end)

    if ok and asset then
        remoteCache[url] = { path = path, asset = asset }
        return asset
    end
    return nil
end

local function ResolveImageAsync(source, callback)
    if not source or source == "" then return end

    if tonumber(source) then
        callback("rbxassetid://" .. source)
        return
    end
    if string.match(source, "^rbx") then
        callback(source)
        return
    end

    task.spawn(function()
        local cached = CacheRemoteImage(source)
        if cached then callback(cached) end
    end)
end

local function ResolveGameImage(entry, callback)
    local function Thumb(universeId)
        callback(("rbxthumb://type=GameIcon&id=%d&w=256&h=256"):format(universeId))
    end

    if entry.UniverseId then
        Thumb(entry.UniverseId)
        return
    end

    local image = entry.Image
    if image and image ~= "" then
        if tonumber(image) then
            callback("rbxassetid://" .. image)
            return
        end
        if string.match(image, "^rbx") then
            callback(image)
            return
        end
    end

    if entry.PlaceId then
        local cached = universeCache[entry.PlaceId]
        if cached then
            Thumb(cached)
        else
            table.insert(universeQueue, { placeId = entry.PlaceId, callback = Thumb })
            ProcessUniverseQueue()
        end
        return
    end

    if image and image ~= "" then
        ResolveImageAsync(image, callback)
    end
end

