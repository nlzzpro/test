    local function setOpen(state, instant)
        W.Open = state
        local info = instant and TweenInfo.new(0) or EASE.Glide
        if state then
            shell.Visible = true
            shell.Size = UDim2.fromOffset(size.X.Offset * 0.93, size.Y.Offset * 0.93)
            shell.BackgroundTransparency = 1
            Tween(shell, { Size = size, BackgroundTransparency = 0.05 }, EASE.Pop)
            Tween(blur, { Size = opts.Blur or 16 }, info)
            Tween(scrim, { BackgroundTransparency = 0.5 }, info)
        else
            Tween(shell, { Size = UDim2.fromOffset(size.X.Offset * 0.95, size.Y.Offset * 0.95),
                           BackgroundTransparency = 1 }, EASE.Glide)
            Tween(blur, { Size = 0 }, info)
            Tween(scrim, { BackgroundTransparency = 1 }, info)
            task.delay(0.28, function() if not W.Open then shell.Visible = false end end)
        end
    end
