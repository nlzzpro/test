--------------------------------------------------------------------
--  TOKEN NORMALIZER
--
--  The binder resolves colours by semantic name, which only works if
--  every theme answers to every name. Themes in the wild -- including
--  ones hub authors define with four slots -- do not.
--
--  So each theme is completed here: the extra tokens are DERIVED from
--  the ramp it already has, rather than defaulted to some fixed grey
--  that would look wrong on a warm or a light palette. A theme still
--  only has to define the classic slots; it gets the rest for free and
--  in its own colour.
--------------------------------------------------------------------

local function Mix(a, b, t) return a:Lerp(b, t) end

local function Luma(c)
    return c.R * 0.299 + c.G * 0.587 + c.B * 0.114
end

local function CompleteTheme(theme)
    if type(theme) ~= "table" then return theme end

    local backdrop = theme.Backdrop   or Color3.fromRGB(13, 13, 15)
    local surface  = theme.Surface    or Mix(backdrop, Color3.new(1,1,1), 0.05)
    local accent   = theme.Accent     or Color3.fromRGB(200, 204, 214)
    local text     = theme.Text       or Color3.fromRGB(240, 240, 244)
    local light    = Luma(backdrop) > 0.5   -- a light theme inverts the lifts

    local function default(slot, value)
        if theme[slot] == nil then theme[slot] = value end
    end

    -- Structure
    default("SurfaceAlt", Mix(surface, light and Color3.new(0,0,0) or Color3.new(1,1,1), 0.05))
    default("Elevated",   Mix(surface, light and Color3.new(0,0,0) or Color3.new(1,1,1), 0.10))
    default("Hover",      Mix(theme.Elevated, light and Color3.new(0,0,0) or Color3.new(1,1,1), 0.08))
    default("Border",     Mix(theme.Elevated, text, 0.18))
    default("BorderSoft", Mix(surface, text, 0.07))

    -- Accent family
    default("AccentSoft", Mix(accent, Color3.new(1, 1, 1), 0.35))
    default("AccentDeep", Mix(accent, Color3.new(0, 0, 0), 0.35))

    -- Text ramp
    default("TextSub", Mix(text, backdrop, 0.38))
    default("TextDim", Mix(text, backdrop, 0.60))

    -- Status
    default("Success", Color3.fromRGB(92, 206, 137))
    default("Danger",  Color3.fromRGB(237, 102, 106))
    default("Warning", Color3.fromRGB(233, 182, 90))
    default("Info",    theme.Accent)

    -- Derived surfaces the v4 components bind against.
    -- A card sits one step above the shell so a page of cards reads as
    -- objects on a surface rather than holes cut in it.
    default("Card",      Mix(surface, light and Color3.new(0,0,0) or Color3.new(1,1,1), 0.07))
    default("CardEdge",  Mix(surface, text, 0.10))
    default("Sidebar",   Mix(backdrop, surface, 0.45))
    default("Topbar",    Mix(surface, backdrop, 0.30))
    default("Divider",   theme.BorderSoft)
    default("Overlay",   Mix(backdrop, Color3.new(0, 0, 0), 0.35))
    default("Shadow",    Color3.fromRGB(0, 0, 0))
    -- A wash is the accent at ~8% over the surface: enough to say
    -- "selected" without turning the row into a coloured block.
    default("Wash",      Mix(surface, accent, 0.08))
    default("Selection", Mix(surface, accent, 0.16))
    default("Track",     Mix(surface, text, 0.10))
    default("Knob",      text)
    default("Sheen",     Mix(accent, Color3.new(1, 1, 1), 0.55))
    default("Metal",     Mix(accent, backdrop, 0.22))
    default("MetalDeep", Mix(accent, backdrop, 0.55))
    default("Placeholder", theme.TextDim)
    default("Disabled",    Mix(theme.TextDim, backdrop, 0.35))

    return theme
end
Nely.CompleteTheme = CompleteTheme

for _, theme in pairs(Nely.Themes) do CompleteTheme(theme) end

-- Resolve a theme by name, honouring aliases and ignoring case so
-- "metallic", "Metallic" and "Nely Metallic" all land in the same place.
-- Returns the theme AND its canonical name. The second return value
-- matters more than it looks: Nely.ThemeName is what the Settings
-- dropdown highlights and what gets written to preferences, so storing
-- the alias the caller happened to type ("Nely Metallic") would leave the
-- dropdown with nothing selected and the saved preference unresolvable
-- against Nely:GetThemes().
local function ResolveTheme(name)
    if type(name) == "table" then return CompleteTheme(name), nil end
    if type(name) ~= "string" then return nil, nil end

    local direct = Nely.Themes[name]
    if direct then return direct, name end

    local alias = Nely.ThemeAliases[name]
    if alias and Nely.Themes[alias] then return Nely.Themes[alias], alias end

    local lower = string.lower(name)
    for key, theme in pairs(Nely.Themes) do
        if string.lower(key) == lower then return theme, key end
    end
    for key, target in pairs(Nely.ThemeAliases) do
        if string.lower(key) == lower and Nely.Themes[target] then
            return Nely.Themes[target], target
        end
    end
    return nil, nil
end
Nely.ResolveTheme = ResolveTheme

Nely.Theme     = Nely.Themes.Metallic
Nely.ThemeName = "Metallic"

--------------------------------------------------------------------
--  CUSTOM THEMES
--  Only the slots you care about need supplying. Anything left out is
--  inherited from Base (default Cobalt), so a two-line theme is a
--  legitimate theme — you aren't forced to hand-pick seventeen greys
--  to change the accent colour.
--------------------------------------------------------------------

-- Slots CompleteTheme derives. They are deliberately NOT inherited from
-- the base theme: if you say Base = "Cobalt" and then hand me a red
-- accent, you want a red wash and a red sheen, not Cobalt's blue ones
-- surviving underneath your accent. Dropping them here forces a fresh
-- derivation from whatever ramp the finished theme actually has.
-- The palette as it existed before v4. This is the contract the
-- reverse-lookup compatibility pass honours; see Nely:SetTheme.
local CLASSIC_SLOTS = {
    "Backdrop", "Surface", "SurfaceAlt", "Elevated", "Hover",
    "Border", "BorderSoft", "Accent", "AccentSoft", "AccentDeep",
    "Text", "TextSub", "TextDim", "Success", "Danger", "Warning",
}

local DERIVED_SLOTS = {
    Card = true, CardEdge = true,
    Sidebar = true, Topbar = true, Divider = true, Overlay = true,
    Shadow  = true, Wash   = true, Selection = true, Track = true,
    Knob    = true, Sheen  = true, Metal  = true, MetalDeep = true,
    Placeholder = true, Disabled = true, Info = true,
}

function Nely:AddTheme(spec)
    assert(type(spec) == "table" and spec.Name, "AddTheme needs a table with a Name")

    local base = ResolveTheme(spec.Base or "Cobalt") or Nely.Themes.Cobalt
    local theme = {}
    for slot, color in pairs(base) do
        if not DERIVED_SLOTS[slot] then
            theme[slot] = color
        end
    end
    for slot, color in pairs(spec) do
        if slot ~= "Name" and slot ~= "Base" and typeof(color) == "Color3" then
            theme[slot] = color
        end
    end

    CompleteTheme(theme)
    Nely.Themes[spec.Name] = theme
    return theme
end

function Nely:GetThemes()
    local names = {}
    for name in pairs(Nely.Themes) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

