--==================================================================
--  WINDOW
--==================================================================
function NelyX:CreateWindow(opts)
    opts = opts or {}
    local Window = { Tabs = {}, Sections = {}, Elements = {}, _order = 0, Open = true }

    local viewport = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
    local compact  = viewport.X < 900
    local size     = opts.Size or UDim2.fromOffset(compact and 620 or 760, compact and 420 or 540)
    local railW    = opts.SidebarWidth or (compact and 156 or 196)

    ------------------------------------------------------------------
    -- background blur
    --
    -- The only honest way to get frosted glass in Roblox: blur the scene
    -- behind the panel. It is created once, animated on open/close, and
    -- destroyed with the window so it can never be left behind.
    ------------------------------------------------------------------
    local blur = New("BlurEffect", { Name = "NelyXBlur", Size = 0, Parent = Lighting })
    local scrim = New("Frame", {
        Name = "Scrim",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = Root,
    })

    ------------------------------------------------------------------
    -- shell
    ------------------------------------------------------------------
    local shell = New("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = size,
        BackgroundColor3 = Theme.Backdrop,
        BackgroundTransparency = 0.06,
        BorderSizePixel = 0,
        ZIndex = 10,
        Parent = Root,
    }, { Corner(18), Stroke(Theme.Border, 1, 0.25) })
    Shadow(shell, 46, 0.72, 18)
    Window.Frame = shell

    -- layer: diagonal accent wash, brightest top-left
    New("Frame", {
        Name = "Wash", Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.93,
        BorderSizePixel = 0, ZIndex = 10, Parent = shell,
    }, {
        Corner(18),
        Gradient(ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Accent),
            ColorSequenceKeypoint.new(0.5, Theme.Backdrop),
            ColorSequenceKeypoint.new(1, Theme.Backdrop),
        }), 135),
    })

    -- layer: vertical depth so low content still separates from the edge
    New("Frame", {
        Name = "Depth", Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.9,
        BorderSizePixel = 0, ZIndex = 10, Parent = shell,
    }, {
        Corner(18),
        New("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.65, 0.94),
                NumberSequenceKeypoint.new(1, 0.75),
            }),
        }),
    })

    -- layer: lit top edge
    New("Frame", {
        Name = "Sheen",
        Size = UDim2.new(1, -40, 0, 1), Position = UDim2.new(0, 20, 0, 1),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.72,
        BorderSizePixel = 0, ZIndex = 30, Parent = shell,
    }, {
        New("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.5, 0),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }),
    })

    ------------------------------------------------------------------
    -- topbar
    ------------------------------------------------------------------
    local topH = 52
    local topbar = New("Frame", {
        Name = "Topbar", Size = UDim2.new(1, 0, 0, topH),
        BackgroundTransparency = 1, ZIndex = 20, Parent = shell,
    })

    if opts.Logo then
        local logo = New("ImageLabel", {
            Size = UDim2.fromOffset(26, 26),
            Position = UDim2.fromOffset(18, 13),
            BackgroundTransparency = 1,
            Image = opts.Logo,
            ZIndex = 21, Parent = topbar,
        }, { Corner(7) })
        logo.Name = "Logo"
    end
    local titleX = opts.Logo and 54 or 20

    New("TextLabel", {
        Position = UDim2.fromOffset(titleX, 9),
        Size = UDim2.fromOffset(240, 18),
        BackgroundTransparency = 1,
        Text = tostring(opts.Title or "Nely X"),
        TextColor3 = Theme.Text, TextSize = 15, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 21, Parent = topbar,
    })
    if opts.Subtitle then
        -- subtitle sits in a tinted chip rather than as loose grey text
        local chip = New("Frame", {
            Position = UDim2.fromOffset(titleX, 28),
            Size = UDim2.fromOffset(0, 16),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.82,
            BorderSizePixel = 0, ZIndex = 21, Parent = topbar,
        }, { Corner(5), Stroke(Theme.Accent, 1, 0.6), Pad(0, 0, 7, 7) })
        New("TextLabel", {
            Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text = tostring(opts.Subtitle),
            TextColor3 = Theme.Accent, TextSize = 10, Font = Enum.Font.GothamBold,
            ZIndex = 22, Parent = chip,
        })
    end

    local function TopButton(icon, offset, colour, fn)
        local b = New("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -offset, 0.5, 0),
            Size = UDim2.fromOffset(28, 28),
            BackgroundColor3 = Theme.Elevated, BackgroundTransparency = 0.45,
            AutoButtonColor = false, Text = "",
            ZIndex = 21, Parent = topbar,
        }, { Corner(9) })
        local ic = RenderIcon(icon, b, 14, Theme.TextSub, 22)
        ic.AnchorPoint = Vector2.new(0.5, 0.5)
        ic.Position = UDim2.fromScale(0.5, 0.5)
        b.MouseEnter:Connect(function()
            Tween(b, { BackgroundTransparency = 0.15 }, EASE.Snap)
            TintIcon(ic, colour)
        end)
        b.MouseLeave:Connect(function()
            Tween(b, { BackgroundTransparency = 0.45 }, EASE.Snap)
            TintIcon(ic, Theme.TextSub)
        end)
        b.MouseButton1Click:Connect(fn)
        return b
    end

    ------------------------------------------------------------------
    -- sidebar + content
    ------------------------------------------------------------------
    local rail = New("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, topH),
        Size = UDim2.new(0, railW, 1, -topH),
        BackgroundColor3 = Theme.Base, BackgroundTransparency = 0.55,
        BorderSizePixel = 0, ZIndex = 15, Parent = shell,
    })
    New("Frame", {
        Size = UDim2.new(0, 1, 1, -20), Position = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = Theme.BorderSoft, BackgroundTransparency = 0.4,
        BorderSizePixel = 0, ZIndex = 16, Parent = rail,
    })

    local searchWrap, searchBox
    if opts.SearchBar ~= false then
        searchWrap = New("Frame", {
            Position = UDim2.fromOffset(12, 10),
            Size = UDim2.new(1, -24, 0, 30),
            BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.3,
            BorderSizePixel = 0, ZIndex = 17, Parent = rail,
        }, { Corner(9), Stroke(Theme.BorderSoft, 1, 0.5) })
        local si = RenderIcon("search", searchWrap, 13, Theme.TextDim, 18)
        si.Position = UDim2.fromOffset(9, 8)
        searchBox = New("TextBox", {
            Position = UDim2.fromOffset(29, 0), Size = UDim2.new(1, -36, 1, 0),
            BackgroundTransparency = 1,
            Text = "", PlaceholderText = "Search",
            PlaceholderColor3 = Theme.TextDim,
            TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
            ZIndex = 18, Parent = searchWrap,
        })
    end

    local tabList = New("ScrollingFrame", {
        Name = "Tabs",
        Position = UDim2.fromOffset(0, searchWrap and 48 or 8),
        Size = UDim2.new(1, 0, 1, searchWrap and -56 or -16),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ZIndex = 16, Parent = rail,
    }, { List(4), Pad(4, 8, 10, 10) })

    local content = New("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(railW, topH),
        Size = UDim2.new(1, -railW, 1, -topH),
        BackgroundTransparency = 1, ClipsDescendants = true,
        ZIndex = 14, Parent = shell,
    })

    ------------------------------------------------------------------
    -- open / close, drag, blur animation
    ------------------------------------------------------------------
    local function setOpen(state, instant)
        Window.Open = state
        local info = instant and TweenInfo.new(0) or EASE.Glide
        if state then
            shell.Visible = true
            shell.Size = UDim2.fromOffset(size.X.Offset * 0.92, size.Y.Offset * 0.92)
            shell.BackgroundTransparency = 1
            Tween(shell, { Size = size, BackgroundTransparency = 0.06 }, EASE.Pop)
            Tween(blur, { Size = 14 }, info)
            Tween(scrim, { BackgroundTransparency = 0.55 }, info)
        else
            Tween(shell, { Size = UDim2.fromOffset(size.X.Offset * 0.94, size.Y.Offset * 0.94),
                           BackgroundTransparency = 1 }, EASE.Glide)
            Tween(blur, { Size = 0 }, info)
            Tween(scrim, { BackgroundTransparency = 1 }, info)
            task.delay(0.28, function() if not Window.Open then shell.Visible = false end end)
        end
    end
    Window.SetOpen = function(_, s) setOpen(s) end
    Window.Toggle  = function() setOpen(not Window.Open) end

    TopButton("minus", 52, Theme.Warning, function() setOpen(false) end)
    TopButton("x", 18, Theme.Danger, function()
        setOpen(false)
        task.delay(0.4, function()
            pcall(function() blur:Destroy() end)
            pcall(function() scrim:Destroy() end)
            pcall(function() shell:Destroy() end)
        end)
    end)

    do -- drag by the topbar
        local dragging, startPos, startInput
        topbar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
               or i.UserInputType == Enum.UserInputType.Touch then
                dragging, startPos, startInput = true, shell.Position, i.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not dragging then return end
            if i.UserInputType == Enum.UserInputType.MouseMovement
               or i.UserInputType == Enum.UserInputType.Touch then
                local d = i.Position - startInput
                shell.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                           startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
               or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
    end

    if opts.ToggleKey then
        UserInputService.InputBegan:Connect(function(i, typing)
            if typing then return end
            if i.KeyCode == opts.ToggleKey then Window.Toggle() end
        end)
    end

    setOpen(true, true)
    Tween(blur, { Size = 14 }, EASE.Slow)
    Tween(scrim, { BackgroundTransparency = 0.55 }, EASE.Slow)

    ------------------------------------------------------------------
    -- element registry / config
    ------------------------------------------------------------------
    function Window:RegisterElement(flag, api)
        if flag then Window.Elements[flag] = api end
        return api
    end

    local folder = opts.Folder or "NelyX"
    function Window:SaveConfig(name)
        if not (writefile and isfolder and makefolder) then return false, "no filesystem" end
        local ok, err = pcall(function()
            if not isfolder(folder) then makefolder(folder) end
            local plain = {}
            for flag, value in pairs(NelyX.Flags) do
                local t = typeof(value)
                if t == "Color3" then
                    plain[flag] = { __type = "Color3", r = value.R, g = value.G, b = value.B }
                elseif t == "EnumItem" then
                    plain[flag] = { __type = "Enum", name = value.Name }
                elseif t == "table" or t == "number" or t == "string" or t == "boolean" then
                    plain[flag] = value
                end
            end
            writefile(folder .. "/" .. name .. ".json",
                HttpService:JSONEncode({ payload = plain }))
        end)
        return ok, err
    end

    function Window:LoadConfig(name)
        if not (readfile and isfile) then return false, "no filesystem" end
        local path = folder .. "/" .. tostring(name) .. ".json"
        if not isfile(path) then return false, "no such config" end
        local ok, err = pcall(function()
            local data = HttpService:JSONDecode(readfile(path)).payload or {}
            for flag, value in pairs(data) do
                local api = Window.Elements[flag]
                if api and api.Set then
                    if type(value) == "table" and value.__type == "Color3" then
                        api:Set(Color3.new(value.r, value.g, value.b))
                    elseif type(value) == "table" and value.__type == "Enum" then
                        api:Set(Enum.KeyCode[value.name])
                    else
                        api:Set(value)
                    end
                end
            end
        end)
        return ok, err
    end

    function Window:ListConfigs()
        if not listfiles then return {} end
        local out = {}
        pcall(function()
            for _, p in ipairs(listfiles(folder)) do
                local n = p:match("([^/\\]+)%.json$")
                if n then out[#out + 1] = n end
            end
        end)
        table.sort(out)
        return out
    end

