function Nely.AnimateGradient(gradient, opts)
    opts = opts or {}
    local conn

    if opts.Mono ~= false then

        local dark = opts.Dark  or Color3.fromRGB(105, 108, 118)
        local mid  = opts.Light or Color3.fromRGB(255, 255, 255)
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, dark),
            ColorSequenceKeypoint.new(0.35, mid),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(228, 231, 238)),
            ColorSequenceKeypoint.new(0.65, mid),
            ColorSequenceKeypoint.new(1.00, dark),
        })
        local speed = opts.Speed or 0.35
        local x = -1
        conn = RunService.RenderStepped:Connect(function(dt)
            if not gradient.Parent then conn:Disconnect() return end
            x = x + dt * speed
            if x > 1 then x = -1 end
            gradient.Offset = Vector2.new(x, 0)
        end)
    else
        local speed  = opts.Speed or 0.14
        local spread = opts.Spread or 0.16
        local sat    = opts.Saturation or 0.55
        local val    = opts.Value or 1
        local hue    = 0
        conn = RunService.RenderStepped:Connect(function(dt)
            if not gradient.Parent then conn:Disconnect() return end
            hue = (hue + dt * speed) % 1
            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, sat, val)),
                ColorSequenceKeypoint.new(0.5,
                    Color3.fromHSV((hue + spread) % 1, sat * 0.8, val)),
                ColorSequenceKeypoint.new(1,
                    Color3.fromHSV((hue + spread * 2) % 1, sat, val)),
            })
        end)
    end

    table.insert(Nely.Connections, conn)
    return conn
end

local function ColorKey(c)
    return ("%d|%d|%d"):format(
        math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
end
Nely._ColorKey = ColorKey

local function TranslateTree(map)
    local function Swap(inst, prop)
        local swapped = map[ColorKey(inst[prop])]
        if swapped then inst[prop] = swapped end
    end
    for _, inst in ipairs(Root:GetDescendants()) do
        if inst:IsA("GuiObject") then
            Swap(inst, "BackgroundColor3")
        end
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            Swap(inst, "TextColor3")
        end
        if inst:IsA("TextBox") then
            Swap(inst, "PlaceholderColor3")
        end
        if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
            Swap(inst, "ImageColor3")
        end
        if inst:IsA("ScrollingFrame") then
            Swap(inst, "ScrollBarImageColor3")
        end
        if inst:IsA("UIStroke") then
            Swap(inst, "Color")
        end
        if inst:IsA("UIGradient") then
            local points, changed = {}, false
            for _, keypoint in ipairs(inst.Color.Keypoints) do
                local swapped = map[ColorKey(keypoint.Value)]
                if swapped then changed = true end
                table.insert(points,
                    ColorSequenceKeypoint.new(keypoint.Time, swapped or keypoint.Value))
            end
            if changed then inst.Color = ColorSequence.new(points) end
        end
    end
end
Nely._TranslateTree = TranslateTree

