            })
            if nameKey then BindText(nameLabel, "Text", nameKey) end
            InfoDot(row, nameLabel, info, 19)

            local descTop  = 17 + 16 + 6
            local lineH    = 14
            local maxLines = 3
            local descWidth = math.max(60, (row.Parent and row.Parent.AbsoluteSize.X or 300) - leftPad - 134)

            local descLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -leftPad - 134, 0, lineH),
                Position               = UDim2.new(0, leftPad, 0, descTop),
                BackgroundTransparency = 1,
                Text                   = description,
                TextColor3             = theme.TextDim,
                TextSize               = 11,
                Font                   = Enum.Font.Gotham,
                TextXAlignment         = Enum.TextXAlignment.Left,
                TextYAlignment         = Enum.TextYAlignment.Top,
                TextWrapped            = true,
                TextTruncate           = Enum.TextTruncate.AtEnd,
                ZIndex                 = 18,
                Parent                 = row,
            })
            if descKey then BindText(descLabel, "Text", descKey) end

            local baseRowH = row.Size.Y.Offset
            local function fit()
                local ok, bounds = pcall(function()
                    return TextService:GetTextSize(descLabel.Text, 11, Enum.Font.Gotham,
                        Vector2.new(descWidth, 4096))
                end)
                local lines = ok and math.clamp(math.ceil(bounds.Y / lineH), 1, maxLines) or 1
                local descH = lines * lineH
                descLabel.Size = UDim2.new(1, -leftPad - 134, 0, descH)
                local neededH = descTop + descH + 17
                row.Size = UDim2.new(1, 0, 0, math.max(baseRowH, neededH))
            end
            fit()
            if descKey then BindText(descLabel, "Text", descKey) end
        end

        local ELEMENT_METHODS = {
            "CreateSection", "CreateDivider", "CreateParagraph", "CreateButton",
            "CreateToggle", "CreateSlider", "CreateInput", "CreateDropdown",
            "CreateKeybind", "CreateLabel", "CreateSpace", "CreateProgressBar",
