local function ApplyAccentMask(t)
    if type(t) ~= "table" then return t end
    if t.AccentTrue == nil then
        t.AccentTrue     = t.Accent
        t.AccentSoftTrue = t.AccentSoft
        t.AccentDeepTrue = t.AccentDeep
    end
    local m = Nely.Themes and Nely.Themes.Metallic
    if Nely.ColoredUI or not m then
        t.Accent     = t.AccentTrue
        t.AccentSoft = t.AccentSoftTrue
        t.AccentDeep = t.AccentDeepTrue
    else

        t.Accent     = m.AccentTrue     or m.Accent
        t.AccentSoft = m.AccentSoftTrue or m.AccentSoft
        t.AccentDeep = m.AccentDeepTrue or m.AccentDeep
    end
    return t
end
Nely.ApplyAccentMask = ApplyAccentMask

local function FindTheme(name)
    if type(name) == "table" then return name, nil end
    if type(name) ~= "string" then return nil, nil end
    if Nely.Themes[name] then return Nely.Themes[name], name end
    local alias = Nely.ThemeAliases[name]
    if alias and Nely.Themes[alias] then return Nely.Themes[alias], alias end
    local lower = string.lower(name)
    for key, theme in pairs(Nely.Themes) do
        if string.lower(key) == lower then return theme, key end
    end
    for key, target in pairs(Nely.ThemeAliases) do
        if string.lower(key) == lower and Nely.Themes[target] then
            return Nely.Themes[target], target
        end
    end
    return nil, nil
end

function Nely.ResolveTheme(name)
    local theme, canonical = FindTheme(name)
    return ApplyAccentMask(theme), canonical
end
local ResolveTheme = Nely.ResolveTheme

function Nely:AddTheme(spec)
    assert(type(spec) == "table" and spec.Name, "AddTheme needs a table with a Name")

    local base = Nely.Themes[spec.Base or "Cobalt"] or Nely.Themes.Cobalt
    local theme = {}
    for slot, color in pairs(base) do
        theme[slot] = color
    end

    theme.Accent     = base.AccentTrue     or base.Accent
    theme.AccentSoft = base.AccentSoftTrue or base.AccentSoft
    theme.AccentDeep = base.AccentDeepTrue or base.AccentDeep

    for slot, color in pairs(spec) do
        if slot ~= "Name" and slot ~= "Base" and typeof(color) == "Color3" then
            theme[slot] = color
        end
    end

    theme.AccentTrue, theme.AccentSoftTrue, theme.AccentDeepTrue = nil, nil, nil

    Nely.Themes[spec.Name] = theme
    return theme
end

function Nely:GetThemes()
    local names = {}
    for name in pairs(Nely.Themes) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

