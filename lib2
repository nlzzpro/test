--==================================================================
--  MOTION
--
--  Central motion configuration plus a tween registry.
--
--  The old helper created a tween per call and forgot about it, so a
--  control clicked twice quickly ended up with two tweens driving the
--  same property in opposite directions and the loser won at random.
--  Every animation now goes through Motion.Tween, which cancels any
--  in-flight tween on the same instance+property before starting the new
--  one. Newest intent always wins.
--
--  Durations derive from Motion settings rather than being multiplied at
--  each call site, so AnimationSpeed and ReduceMotion take effect
--  everywhere at once.
--==================================================================

Nely.Motion = {
    Enabled      = true,
    Speed        = 1,      -- >1 faster, <1 slower
    ReduceMotion = false,
}
local Motion = Nely.Motion

local BASE_EASE = {
    Instant  = { 0.10, Enum.EasingStyle.Quad,        Enum.EasingDirection.Out },
    Snap     = { 0.16, Enum.EasingStyle.Quart,       Enum.EasingDirection.Out },
    Smooth   = { 0.28, Enum.EasingStyle.Quint,       Enum.EasingDirection.Out },
    Glide    = { 0.42, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out },
    Pop      = { 0.38, Enum.EasingStyle.Back,        Enum.EasingDirection.Out },
    Collapse = { 0.30, Enum.EasingStyle.Back,        Enum.EasingDirection.In  },
    Spring   = { 0.46, Enum.EasingStyle.Back,        Enum.EasingDirection.Out },
    Fly      = { 0.34, Enum.EasingStyle.Quint,       Enum.EasingDirection.InOut },
    Page     = { 0.22, Enum.EasingStyle.Quint,       Enum.EasingDirection.Out },
    Modal    = { 0.26, Enum.EasingStyle.Quint,       Enum.EasingDirection.Out },
    Theme    = { 0.28, Enum.EasingStyle.Quad,        Enum.EasingDirection.Out },
}

-- EASE stays a plain table of TweenInfo so the ~200 existing call sites
-- keep working untouched; it is rebuilt whenever motion settings change.
local EASE = {}

local function RebuildEase()
    local speed = math.clamp(tonumber(Motion.Speed) or 1, 0.25, 3)
    local reduce = Motion.ReduceMotion == true
    for name, spec in pairs(BASE_EASE) do
        local duration, style, dir = spec[1], spec[2], spec[3]
        if reduce then
            -- Reduce motion keeps the feedback and drops the theatre:
            -- shorter, and no overshoot to track across the screen.
            duration = duration * 0.55
            if style == Enum.EasingStyle.Back then
                style, dir = Enum.EasingStyle.Quad, Enum.EasingDirection.Out
            end
        end
        if not Motion.Enabled then duration = 0 end
        EASE[name] = TweenInfo.new(duration / speed, style, dir)
    end
end
RebuildEase()

function Nely:SetMotion(opts)
    opts = opts or {}
    if opts.Enabled      ~= nil then Motion.Enabled      = opts.Enabled == true end
    if opts.Speed        ~= nil then Motion.Speed        = tonumber(opts.Speed) or 1 end
    if opts.ReduceMotion ~= nil then Motion.ReduceMotion = opts.ReduceMotion == true end
    RebuildEase()
    return true
end

-- instance -> { [propertyName] = Tween }
local ActiveTweens = setmetatable({}, { __mode = "k" })

local function CancelProps(inst, props)
    local live = ActiveTweens[inst]
    if not live then return end
    for prop in pairs(props) do
        local running = live[prop]
        if running then
            pcall(function() running:Cancel() end)
            live[prop] = nil
        end
    end
end

local function Tween(inst, props, preset)
    if typeof(inst) ~= "Instance" then return nil end
    local info = preset or EASE.Smooth

    -- Take control from whatever was already animating these properties.
    CancelProps(inst, props)

    -- Motion off, or a caller that explicitly asked for no transition:
    -- land on the final value immediately rather than paying for a tween.
    -- EASE.Instant matters here beyond performance -- a tween approaches
    -- its target asymptotically and stops an epsilon short, so a colour
    -- set "instantly" via a tween is not bit-identical to the palette
    -- value it came from. Assigning directly keeps them comparable.
    if not Motion.Enabled or info == EASE.Instant then
        for prop, value in pairs(props) do
            pcall(function() inst[prop] = value end)
        end
        return nil
    end

    local tw = TweenService:Create(inst, info, props)
    local live = ActiveTweens[inst]
    if not live then
        live = {}
        ActiveTweens[inst] = live
    end
    for prop in pairs(props) do live[prop] = tw end

    tw.Completed:Connect(function()
        local set = ActiveTweens[inst]
        if not set then return end
        for prop in pairs(props) do
            if set[prop] == tw then set[prop] = nil end
        end
        if next(set) == nil then ActiveTweens[inst] = nil end
    end)

    tw:Play()
    return tw
end

-- Public so components can stop an animation without starting another,
-- e.g. a dropdown abandoning its open tween the instant it is closed.
local function CancelTweens(inst)
    local live = ActiveTweens[inst]
    if not live then return end
    for _, tw in pairs(live) do pcall(function() tw:Cancel() end) end
    ActiveTweens[inst] = nil
end

