-- Always returns a container so callers never have to nil-check and
-- layouts hold their shape even when the pack fails to download.
-- V4: every icon slot in the library also accepts a raw asset, so
-- anywhere you can name a lucide glyph you can hand over a picture
-- instead -- an item thumbnail, a game logo, a weapon skin.
--
-- Passed-through art keeps its own colours. A glyph is a silhouette meant
-- to be tinted; a photograph tinted to the accent colour just looks
-- broken, so raw images are flagged and the tinting skips them.
local function IsRawAsset(name)
    return type(name) == "string"
       and (string.sub(name, 1, 13) == "rbxassetid://"
         or string.sub(name, 1, 10) == "rbxthumb://"
         or string.sub(name, 1, 11) == "rbxasset://"
         or string.sub(name, 1, 4)  == "http")
end
