            Window:RegisterElement(flag, api)
            return api
        end

        function Tab:CreateKeybind(cfg, flag)
            cfg = cfg or {}
            local api
            local current = cfg.CurrentBind or cfg.Default or "None"

            local row = Row(cfg.Description and ROW_HD or ROW_H)
            RowText(row, cfg.Name or "Keybind", cfg.Description,
                    RowIcon(row, cfg.Icon), cfg.Info, cfg.NameKey, cfg.DescKey)

            local pill = New("TextButton", {
                Name             = "KeyPill",
                Size             = UDim2.fromOffset(72, 27),
                Position         = UDim2.new(1, -14, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = theme.Elevated,
                AutoButtonColor  = false,
                Text             = current,
                TextColor3       = theme.TextSub,
                TextSize         = 12,
                Font             = Enum.Font.GothamBold,
                ZIndex           = 19,
                Parent           = row,
            }, { Corner(8), Stroke(theme.Border, 1, 0.55) })

            local listening = false
            local restore   = current
            local dotToken  = 0

            local pillPressAt = -1

            local function Paint()
                Tween(pill, {
                    BackgroundColor3 = listening and Nely.AccentColor() or theme.Elevated,
                    TextColor3       = listening and theme.Backdrop or theme.TextSub,
                }, EASE.Snap)
            end

            local function StopListening(keepOld)
                if not listening then return end
                listening = false
                dotToken  = dotToken + 1
                if ActiveKeybind == api then ActiveKeybind = nil end
                if keepOld then current = restore end
                pill.Text = current
                Paint()
            end

            local function StartListening()

                if ActiveKeybind and ActiveKeybind ~= api then
                    ActiveKeybind:Cancel()
                end
                listening     = true
                restore       = current
                ActiveKeybind = api
                Paint()

                dotToken = dotToken + 1
                local mine = dotToken
                task.spawn(function()
                    local n = 0
                    while listening and dotToken == mine do
                        n = (n % 3) + 1
                        pill.Text = string.rep("\u{00B7} ", n)
                        task.wait(0.2)
                    end
                end)
            end

            pill.InputBegan:Connect(function(input)
                local it = input.UserInputType
                if it ~= Enum.UserInputType.MouseButton1
                and it ~= Enum.UserInputType.Touch then return end
                pillPressAt = os.clock()

                if listening then

                    current, restore = "Unknown", "Unknown"
                    StopListening(false)
                    api.CurrentBind = current
                    if flag then Nely.Flags[flag] = current end
                    if cfg.OnChanged then task.spawn(cfg.OnChanged, nil) end
                    return
                end
                StartListening()
            end)

            pill.MouseEnter:Connect(function()
                if listening then return end
                Tween(pill, { TextColor3 = theme.Text }, EASE.Snap)
            end)
            pill.MouseLeave:Connect(function()
                if listening then return end
                Tween(pill, { TextColor3 = theme.TextSub }, EASE.Snap)
            end)

            local inputConn = UserInputService.InputBegan:Connect(function(input, processed)
                if listening then
                    local it = input.UserInputType

                    if it == Enum.UserInputType.MouseButton1
                    or it == Enum.UserInputType.MouseButton2
                    or it == Enum.UserInputType.MouseButton3
                    or it == Enum.UserInputType.Touch then
                        local pressed = os.clock()
                        task.defer(function()

                            if not listening then return end
                            if pressed - pillPressAt < 0.05 then return end
                            StopListening(true)
                        end)
                        return
                    end
                    if it ~= Enum.UserInputType.Keyboard then return end

                    local key = input.KeyCode
                    if key == Enum.KeyCode.Escape then
                        StopListening(true)
                        return
                    end
                    if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                        current, restore = "None", "None"
                        StopListening(false)
                        api.CurrentBind = current
                        if flag then Nely.Flags[flag] = current end
                        if cfg.OnChanged then task.spawn(cfg.OnChanged, nil) end
                        return
                    end
                    if not AcceptableKey(key) then return end

                    current, restore = key.Name, key.Name
                    StopListening(false)
                    api.CurrentBind = current
                    if flag then Nely.Flags[flag] = current end
                    if cfg.OnChanged then task.spawn(cfg.OnChanged, key) end
                    return
                end

                if TypingNow() then return end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if current == "None" or current == "Unknown" then return end
                if input.KeyCode.Name ~= current then return end
                if cfg.Callback then task.spawn(cfg.Callback) end
            end)
            table.insert(Nely.Connections, inputConn)

            api = {
                CurrentBind = current,
                Set = function(_, key)
                    current = tostring(key or "None")
                    restore = current
                    api.CurrentBind = current
                    if not listening then pill.Text = current end
                    if flag then Nely.Flags[flag] = current end

                    if cfg.OnChanged then
                        local kc
                        if current ~= "None" and current ~= "Unknown" then
                            pcall(function() kc = Enum.KeyCode[current] end)
                        end
                        task.spawn(cfg.OnChanged, kc)
                    end
                end,
                Cancel  = function() StopListening(true) end,

                SetMode = function() end,
                Mode    = "Press",
                Destroy = function() StopListening(true) row:Destroy() end,
            }

            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

