        if not resizing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta  = input.Position - resizeStart
        local width  = math.clamp(sizeStart.X + delta.X, minSize.X, maxSize.X)
        local height = math.clamp(sizeStart.Y + delta.Y, minSize.Y, maxSize.Y)
        local grown  = Vector2.new(width - sizeStart.X, height - sizeStart.Y)

        shell.Size = UDim2.fromOffset(width, height)
        -- the shell is centre-anchored, so growth pushes out in both directions.
        -- shifting by half the growth keeps the grabbed corner under the pointer.
