        function Tab:CreateDropdown(cfg, flag)
            cfg = cfg or {}
            local options  = cfg.Options or {}
            local multi    = cfg.MultipleOptions == true
            local selected = {}
            for _, v in ipairs(cfg.CurrentOption or {}) do selected[v] = true end

            local expanded = false
            local rowHeight = ROW_H

            local __slot = RowSlot()
            local row = New("Frame", {
                Name                   = "Row",
                Size                   = UDim2.new(1, 0, 0, rowHeight),
                BackgroundColor3       = theme.Hover,
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                LayoutOrder            = NextOrder(),
                ClipsDescendants       = true,
                ZIndex                 = 17,
                Parent                 = __slot,
            })

            local lp = RowIcon(row, cfg.Icon)

            local ddLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -lp - (narrowRows and 104 or 144), 0, 16),
                Position               = UDim2.new(0, lp, 0, math.floor(rowHeight / 2) - 8),
                BackgroundTransparency = 1,
                Text                   = cfg.NameKey and L(cfg.NameKey) or (cfg.Name or "Dropdown"),
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })
            if cfg.NameKey then BindText(ddLabel, "Text", cfg.NameKey) end
            InfoDot(row, ddLabel, cfg.Info, 22)

            local function SummaryText()
                local picked = {}
                for _, opt in ipairs(options) do
                    if selected[opt] then table.insert(picked, opt) end
                end
                if #picked == 0 then return "None" end
                if #picked <= 2 then return table.concat(picked, ", ") end
                return #picked .. " selected"
            end

            -- Value chip. Sized to its text so a short value does not sit
            -- in a wide empty box.
            local valueChip = New("Frame", {
                Name                   = "Value",
                Size                   = UDim2.fromOffset(0, 26),
                AutomaticSize          = Enum.AutomaticSize.X,
                Position               = UDim2.new(1, -16, 0, math.floor(rowHeight / 2) - 13),
                AnchorPoint            = Vector2.new(1, 0),
                BackgroundColor3       = theme.Elevated,
                BackgroundTransparency = 0.28,
                BorderSizePixel        = 0,
                ZIndex                 = 18,
                Parent                 = row,
            }, {
                Corner(Design.Radius.SM + 1),
                Stroke(theme.Border, 1, 0.55),
                Pad(0, 0, 10, 8),
                List(5, Enum.FillDirection.Horizontal),
            })

            local summary = New("TextLabel", {
                Size                   = UDim2.fromOffset(0, 26),
                AutomaticSize          = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text                   = SummaryText(),
                TextColor3             = theme.TextSub,
                TextSize               = Design.Text.Meta + 1,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Right,
                LayoutOrder            = 1,
                ZIndex                 = 19,
                Parent                 = valueChip,
            })

            local caretWrap = New("Frame", {
                Size                   = UDim2.fromOffset(12, 26),
                BackgroundTransparency = 1,
                LayoutOrder            = 2,
                ZIndex                 = 19,
                Parent                 = valueChip,
            })
            local caret = Icons.Render("chevron", caretWrap, 12, theme.TextDim, 20)
            caret.Position    = UDim2.fromScale(0.5, 0.5)
            caret.AnchorPoint = Vector2.new(0.5, 0.5)

            -- The option list is an elevated panel inset from the row, so
            -- an open dropdown reads as a surface on top of the card rather
            -- than as the card having grown taller.
            local optionHost = New("Frame", {
                Name                   = "Options",
                Size                   = UDim2.new(1, -32, 0, 0),
                Position               = UDim2.fromOffset(16, rowHeight - 2),
                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundColor3       = theme.Backdrop,
                BackgroundTransparency = 0.15,
                BorderSizePixel        = 0,
                ZIndex                 = 18,
                Parent                 = row,
            }, {
                Corner(Design.Radius.MD),
                Stroke(theme.Border, 1, 0.5),
                List(2),
                Pad(6, 6, 6, 6),
            })

            local entries = {}

            local function Refresh()
                summary.Text = SummaryText()
                for opt, entry in pairs(entries) do
                    local on = selected[opt] == true
                    -- Selected rows lift slightly rather than filling with
                    -- accent; the check and the platinum text carry the
                    -- state. A tinted fill across several rows stopped the
                    -- list reading as one list.
                    Tween(entry.frame, {
                        BackgroundColor3       = theme.Elevated,
                        BackgroundTransparency = on and 0.25 or 1,
                    }, EASE.Snap)
                    Tween(entry.label, {
                        TextColor3 = on and theme.Text or theme.TextSub,
                    }, EASE.Snap)
                    entry.label.Font = on and Enum.Font.GothamBold or Enum.Font.Gotham
                    entry.check.Visible = on
                end
            end

            local function BuildOptions()
                for _, child in ipairs(optionHost:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                entries = {}
                -- V4: an option can carry a picture. Pass OptionIcons as
                -- {[optionText] = "rbxassetid://..."} and the row grows a
                -- thumbnail. Picking a skin by name is guesswork; picking
                -- it by its picture is not. Rows without an entry in the
                -- map keep the plain layout, so a partly illustrated list
                -- still lines up.
                local icons  = cfg.OptionIcons
                local rowH   = icons and 34 or 30
                for index, opt in ipairs(options) do
                    local entry = New("TextButton", {
                        Size                   = UDim2.new(1, 0, 0, rowH),
                        BackgroundColor3       = theme.Elevated,
                        BackgroundTransparency = 1,
                        AutoButtonColor        = false,
                        Text                   = "",
                        LayoutOrder            = index,
                        ZIndex                 = 19,
                        Parent                 = optionHost,
                    }, { Corner(8) })

                    local textX = 11
                    local art   = icons and icons[opt]
                    if art then
                        New("ImageLabel", {
                            Name                   = "Thumb",
                            Size                   = UDim2.fromOffset(22, 22),
                            Position               = UDim2.new(0, 8, 0.5, 0),
                            AnchorPoint            = Vector2.new(0, 0.5),
                            BackgroundColor3       = theme.Base,
                            BackgroundTransparency = 0.4,
                            Image                  = art,
                            ScaleType              = Enum.ScaleType.Fit,
                            ZIndex                 = 20,
                            Parent                 = entry,
                        }, { Corner(6) })
                        textX = 38
                    end

                    local label = New("TextLabel", {
                        Size                   = UDim2.new(1, -(textX + 29), 1, 0),
                        Position               = UDim2.fromOffset(textX, 0),
                        BackgroundTransparency = 1,
                        Text                   = opt,
                        TextColor3             = theme.TextSub,
                        TextSize               = 12,
                        Font                   = Enum.Font.Gotham,
                        TextXAlignment         = Enum.TextXAlignment.Left,
                        TextTruncate           = Enum.TextTruncate.AtEnd,
                        ZIndex                 = 20,
                        Parent                 = entry,
                    })

                    local check = Icons.Render("check", entry, 13, theme.Accent, 20)
                    check.Position    = UDim2.new(1, -10, 0.5, 0)
                    check.AnchorPoint = Vector2.new(1, 0.5)
                    check.Visible     = selected[opt] == true

                    entry.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt] or nil
                        else
                            selected = { [opt] = true }
                        end
                        Refresh()
                        if flag then Nely.Flags[flag] = multi and selected or opt end
                        if cfg.Callback then
                            if multi then
                                local picked = {}
                                for _, o in ipairs(options) do
                                    if selected[o] then table.insert(picked, o) end
                                end
                                task.spawn(cfg.Callback, picked)
                            else
                                task.spawn(cfg.Callback, opt)
                            end
                        end
                    end)

                    entries[opt] = { frame = entry, label = label, check = check }
                end
                Refresh()
            end

            BuildOptions()

            local header = New("TextButton", {
                Size                   = UDim2.new(1, 0, 0, rowHeight),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 21,
                Parent                 = row,
            })

            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                local target = expanded
                    and (rowHeight + optionHost.AbsoluteSize.Y + 4)
                    or rowHeight
                Tween(row, { Size = UDim2.new(1, 0, 0, target) }, EASE.Glide)
                Tween(caret, { Rotation = expanded and 180 or 0 }, EASE.Glide)
            end)

            local api = {
                CurrentOption = selected,
                Set = function(_, newCfg)
                    if newCfg.Options then options = newCfg.Options; BuildOptions() end
                    if newCfg.CurrentOption then
                        selected = {}
                        for _, v in ipairs(newCfg.CurrentOption) do selected[v] = true end
                        Refresh()
                    end
                end,
                Destroy = function() row:Destroy() end,
            }
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

        ------------------------------------------------------------
        -- Keybind
        ------------------------------------------------------------

        -- Mode decides what the key actually does, and the chip in front of
        -- the key shows which one is live:
        --
        --   Press   fires the callback once per press          (the default,
        --           and what every existing script already expects)
        --   Hold    fires Callback(true) down, Callback(false) up
        --   Toggle  flips a state and fires Callback(state)
        --
        -- Clicking the chip cycles it, so a hub gets all three without
        -- shipping three separate controls.
        ------------------------------------------------------------
        -- Keybind
        --
        -- One job: hold a key, fire the callback when that key is pressed.
        --
        -- The Press / Hold / Toggle selector is gone. It put a three-way
        -- decision in front of the user for something the hub author had
        -- already decided, and the extra chip made one control read as two
        -- ([ HOLD ][ E ]). A hub that wants toggle semantics keeps its own
        -- boolean -- it always did anyway.
        --
        -- Mode, LockMode and OnModeChanged are still accepted and ignored,
        -- so hubs written against the old signature keep loading. They
        -- render nothing.
        ------------------------------------------------------------

        function Tab:CreateKeybind(cfg, flag)
            cfg = cfg or {}
            local api
            local current = cfg.CurrentBind or cfg.Default or "None"

            local row = Row(cfg.Description and ROW_HD or ROW_H)
            RowText(row, cfg.Name or "Keybind", cfg.Description, RowIcon(row, cfg.Icon), cfg.Info, cfg.NameKey, cfg.DescKey, 92)

            local pill = New("TextButton", {
                Name             = "KeyPill",
                Size             = UDim2.fromOffset(66, 26),
                Position         = UDim2.new(1, -14, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = theme.Elevated,
                BackgroundTransparency = 0.15,
                AutoButtonColor  = false,
                Text             = current,
                TextColor3       = theme.TextSub,
                TextSize         = 11,
                Font             = Enum.Font.GothamBold,
                ZIndex           = 19,
                Parent           = row,
            }, { Corner(7), Stroke(theme.Border, 1, 0.5) })

            ----------------------------------------------------------
            -- Listening
            --
            -- Entering listening mode must never be a trap. Four ways out,
            -- three of which leave the existing bind untouched:
            --   Escape          cancel, restore
            --   click elsewhere cancel, restore
            --   click the pill  cancel, restore
            --   a valid key     assign
            -- plus Backspace/Delete to clear it to None deliberately.
            ----------------------------------------------------------

            local listening = false
            local restore   = current
            local dotToken  = 0

            local function Paint()
                Tween(pill, {
                    BackgroundColor3       = listening and theme.Accent or theme.Elevated,
                    BackgroundTransparency = listening and 0.02 or 0.15,
                    TextColor3             = listening and theme.Backdrop or theme.TextSub,
                }, EASE.Snap)
            end

            local function StopListening(keepOld)
                if not listening then return end
                listening = false
                dotToken  = dotToken + 1        -- kills the ellipsis loop
                KeybindCancelBy = pill
                KeybindCancelAt = os.clock()
                if ActiveKeybind == api then ActiveKeybind = nil end
                if keepOld then current = restore end
                pill.Text = current
                Paint()
            end

            local function StartListening()
                -- One listener at a time. Whatever was waiting gives up
                -- rather than two pills both racing for the next keypress.
                if ActiveKeybind and ActiveKeybind ~= api then
                    ActiveKeybind:Cancel()
                end
                listening     = true
                restore       = current
                ActiveKeybind = api
                Paint()

                -- Animated ellipsis so the state reads as "waiting" rather
                -- than "broken". Token-guarded: a stale loop must not write
                -- over a pill that has since been assigned.
                dotToken = dotToken + 1
                local mine = dotToken
                task.spawn(function()
                    local n = 0
                    while listening and dotToken == mine do
                        n = (n % 3) + 1
                        pill.Text = string.rep("\u{00B7} ", n)
                        task.wait(0.2)
                    end
                end)
            end

            pill.MouseButton1Click:Connect(function()
                -- The mouse-down half of this very click already cancelled
                -- THIS pill; do not turn the release into a re-open.
                if KeybindCancelBy == pill and os.clock() - KeybindCancelAt < 0.2 then
                    return
                end
                if listening then StopListening(true) return end
                StartListening()
            end)

            Hover(pill, function(inside)
                if listening then return end
                Tween(pill, {
                    BackgroundTransparency = inside and 0.02 or 0.15,
                    TextColor3             = inside and theme.Text or theme.TextSub,
                }, EASE.Snap)
            end)

            local inputConn = UserInputService.InputBegan:Connect(function(input, processed)
                if listening then
                    local it = input.UserInputType
                    -- Any press of any pointer, anywhere, cancels and keeps
                    -- the existing bind. This is mouse-DOWN, which is why
                    -- clicking the pill again cancels rather than re-opening.
                    if it == Enum.UserInputType.MouseButton1
                    or it == Enum.UserInputType.MouseButton2
                    or it == Enum.UserInputType.Touch then
                        StopListening(true)
                        return
                    end
                    if it ~= Enum.UserInputType.Keyboard then return end

                    local key = input.KeyCode
                    if key == Enum.KeyCode.Escape then
                        StopListening(true)
                        return
                    end
                    if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                        current, restore = "None", "None"
                        StopListening(false)
                        api.CurrentBind = current
                        if flag then Nely.Flags[flag] = current end
                        if cfg.OnChanged then task.spawn(cfg.OnChanged, nil) end
                        return
                    end
                    if not AcceptableKey(key) then return end

                    current, restore = key.Name, key.Name
                    StopListening(false)
                    api.CurrentBind = current
                    if flag then Nely.Flags[flag] = current end
                    if cfg.OnChanged then task.spawn(cfg.OnChanged, key) end
                    return
                end

                -- Not listening: this is the bind firing. Once per press.
                if processed then return end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if current == "None" or input.KeyCode.Name ~= current then return end
                if cfg.Callback then task.spawn(cfg.Callback) end
            end)
            table.insert(Nely.Connections, inputConn)

            api = {
                CurrentBind = current,
                Set = function(_, key)
                    current = tostring(key or "None")
                    restore = current
                    api.CurrentBind = current
                    if not listening then pill.Text = current end
                    if flag then Nely.Flags[flag] = current end
                end,
                Cancel  = function() StopListening(true) end,
                -- Accepted and ignored, for hubs written against the old API.
                SetMode = function() end,
                Mode    = "Press",
                Destroy = function() StopListening(true) row:Destroy() end,
            }

            -- Decoration must not intercept the pill or the row.
            NoInput(row, pill)

            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

