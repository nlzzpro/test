        local function Activate()
            if Window.ActiveTab == Tab then return end
            local previous = Window.ActiveTab
            Window.ActiveTab = Tab

            PaintSidebar(true)

            local dir = 1
            if previous and previous._index and previous._index > order then
                dir = -1
            end

            if previous then
                local leaving = previous.Page
                Tween(leaving, {
                    Position = UDim2.fromOffset(0, -dir * TAB_TRAVEL),
                }, EASE.Snap)
                task.delay(0.18, function()

                    if Window.ActiveTab ~= previous then
                        leaving.Visible  = false
                        leaving.Position = UDim2.fromOffset(0, 0)
                    end
                end)
            end

            page.Visible  = true
            page.Position = UDim2.fromOffset(0, dir * TAB_TRAVEL)
            Tween(page, { Position = UDim2.fromOffset(0, 0) }, EASE.Glide)

            local index = 0
            for _, child in ipairs(page:GetChildren()) do
                if child:IsA("GuiObject") and child.Visible then
                    index = index + 1
                    if index > 12 then break end
                    local scale = child:FindFirstChild("EntryScale")
                    if not scale then
                        scale = Instance.new("UIScale")
                        scale.Name   = "EntryScale"
                        scale.Parent = child
                    end
                    scale.Scale = 0.90

                    task.delay(index * 0.038, function()
                        if scale.Parent and Window.ActiveTab == Tab then
                            Tween(scale, { Scale = 1 }, EASE.Pop)
                        elseif scale.Parent then
