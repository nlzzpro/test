    local function PaintSidebar(animate)
        local ease = (animate == false) and EASE.Instant or EASE.Snap
        local accent = Nely.AccentColor()
        for _, tab in ipairs(Window.Tabs) do
            local active = (Window.ActiveTab == tab)

            local hue = tab.IconColor or accent

            Tween(tab.Button, {
                BackgroundTransparency = active and 0.55 or 1,
            }, ease)
            if tab._label then
                Tween(tab._label, {
                    TextColor3 = active and theme.Text or theme.TextDim,
                }, ease)
            end
            if tab._icon then

                local resting = Nely.ColoredUI and hue or theme.TextSub
                TintIcon(tab._icon, active and hue or resting)
                if tab._chip then

                    Tween(tab._chip, {
                        BackgroundTransparency = active and 0 or 0.1,
                    }, ease)
                    local edge = tab._chip:FindFirstChildOfClass("UIStroke")
                    if edge then
                        Tween(edge, {
                            Color        = active and hue or theme.Border,
                            Transparency = active and 0.15 or 0.4,
                        }, ease)
                    end
                end
                Tween(tab._icon, {
                    ImageTransparency = active and 0 or 0.42,
                }, ease)
            end
            if tab._marker then
                Tween(tab._marker, { BackgroundColor3 = hue }, ease)
                Tween(tab._marker, {
                    Size = UDim2.fromOffset(3, active and 20 or 0),
                }, (animate == false) and EASE.Instant or EASE.Glide)
            end
        end
    end
