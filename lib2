-- Text bindings. A label registered here re-reads its key when the
-- language changes, so switching does not rebuild the window.
local TextBindings = setmetatable({}, { __mode = "k" })

-- `transform` runs on the translated string before it is written -- the
-- section headings are rendered in caps, and upper-casing the key would
-- be wrong while upper-casing the translation is right.
local function BindText(inst, prop, key, args, transform)
    if typeof(inst) ~= "Instance" then return inst end
    args = args or {}
    local function value()
        local text = L(key, table.unpack(args))
        if transform then text = transform(text) end
        return text
    end
    TextBindings[inst] = TextBindings[inst] or {}
    TextBindings[inst][prop] = { render = value }
    pcall(function() inst[prop] = value() end)
    return inst
end

function Nely:SetLanguage(code)
    if not STRINGS[code] then return false end
    Nely.Language = code
    for inst, props in pairs(TextBindings) do
        if inst.Parent then
            for prop, spec in pairs(props) do
                pcall(function() inst[prop] = spec.render() end)
            end
        else
            TextBindings[inst] = nil
        end
    end
    return true
end

function Nely:GetLanguages() return Nely.Languages end

-- Semantic theme bindings. Weak-keyed so a destroyed instance drops out
-- of the registry on its own. Declared here because New() writes to it.
local ThemeBindings = setmetatable({}, { __mode = "k" })

--==================================================================
--  THEME BINDING
--
--  The old SetTheme reverse-matched every painted colour against the old
--  palette and swapped what it recognised. Clever, and it worked for
--  static pixels -- but components close over the window's `theme` local,
--  so the next hover or focus repainted from the OLD table and the
--  interface drifted back a colour at a time.
--
--  Components now bind semantically: Bind(inst, "BackgroundColor3",
--  "Surface"). The binding survives theme changes, and Tok("Surface")
--  resolves at interaction time rather than at construction time, so a
--  hover handler written today is correct after any number of theme
--  switches.
--
--  The reverse-lookup pass is kept as a safety net for anything not yet
--  migrated, so this is an upgrade rather than a breaking change.
--==================================================================


-- Resolve a token against the CURRENT theme. Components should call this
-- inside handlers instead of capturing a colour.
local function Tok(token, fallback)
    local t = Nely.Theme or {}
    return t[token] or fallback or Color3.fromRGB(255, 255, 255)
end
Nely.Tok = Tok

-- The live theme table.
--
-- Components are written as `local theme = Nely.Theme` and then capture
-- `theme` in every hover, focus and click handler they create. That is
-- the actual bug behind "the interface drifts back to the old colours":
-- the handler is holding the table the window was BUILT with, and no
-- amount of repainting existing pixels changes what a future handler
-- will paint.
--
-- Rather than rewrite two hundred call sites -- and require every future
-- component to remember a rule -- the capture itself is made live. This
-- proxy holds no colours; it forwards every read to whatever Nely.Theme
-- currently is. So `theme.Accent` inside a handler written today returns
-- the accent of the theme selected a minute ago, and the component
-- author never has to think about it.
local LiveTheme = setmetatable({}, {
    __index = function(_, slot)
        local t = Nely.Theme
        return t and t[slot] or nil
    end,
    -- Writes go to the real table, so `theme.Accent = c` still means what
    -- it looks like it means instead of silently shadowing.
    __newindex = function(_, slot, value)
        local t = Nely.Theme
        if t then rawset(t, slot, value) end
    end,
    __metatable = "locked",
})
Nely.LiveTheme = LiveTheme

local function Bind(inst, prop, token)
    if typeof(inst) ~= "Instance" then return inst end
    ThemeBindings[inst] = ThemeBindings[inst] or {}
    ThemeBindings[inst][prop] = token
    pcall(function() inst[prop] = Tok(token) end)
    return inst
end
Nely.Bind = Bind

-- Repaint every registered binding. Animated when motion allows, so a
-- theme change reads as the interface changing its mind rather than a
-- hard cut.
local function ApplyThemeBindings(animated)
    for inst, props in pairs(ThemeBindings) do
        if inst.Parent then
            for prop, token in pairs(props) do
                local target = Tok(token)
                if animated and Motion.Enabled then
                    Tween(inst, { [prop] = target }, EASE.Theme)
                else
                    pcall(function() inst[prop] = target end)
                end
            end
        else
            ThemeBindings[inst] = nil
        end
    end
end

--==================================================================
--  SPRING SOLVER  (critically-ish damped, frame independent)
--==================================================================

local Spring = {}
Spring.__index = Spring

function Spring.new(initial, stiffness, damping)
    return setmetatable({
        Position  = initial,
        Velocity  = 0,
        Target    = initial,
        Stiffness = stiffness or 180,
        Damping   = damping or 22,
    }, Spring)
end

function Spring:Step(dt)
    dt = math.min(dt, 1 / 30)
    local displacement = self.Position - self.Target
    local accel = (-self.Stiffness * displacement) - (self.Damping * self.Velocity)
    self.Velocity = self.Velocity + accel * dt
    self.Position = self.Position + self.Velocity * dt
    return self.Position
end

function Spring:Settled()
    return math.abs(self.Position - self.Target) < 0.001 and math.abs(self.Velocity) < 0.001
end

