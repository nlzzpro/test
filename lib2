    ------------------------------------------------------------------
    function W:RegisterElement(flag, api)
        if flag then W.Elements[flag] = api end
        return api
    end

    local folder = opts.Folder or "NelyHubUI"
    function W:SaveConfig(name)
        if not (writefile and isfolder and makefolder) then return false, "no filesystem" end
        return pcall(function()
            if not isfolder(folder) then makefolder(folder) end
            local plain = {}
            for flag, value in pairs(Nely.Flags) do
                local t = typeof(value)
                if t == "Color3" then
                    plain[flag] = { __type = "Color3", r = value.R, g = value.G, b = value.B }
                elseif t == "EnumItem" then
                    plain[flag] = { __type = "Enum", name = value.Name }
                elseif t == "table" or t == "number" or t == "string" or t == "boolean" then
                    plain[flag] = value
                end
            end
            writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode({ payload = plain }))
        end)
    end

    function W:LoadConfig(name)
        if not (readfile and isfile) then return false, "no filesystem" end
        local path = folder .. "/" .. tostring(name) .. ".json"
        if not isfile(path) then return false, "no such config" end
        return pcall(function()
            local data = HttpService:JSONDecode(readfile(path)).payload or {}
            for flag, value in pairs(data) do
                local api = W.Elements[flag]
                if api and api.Set then
                    if type(value) == "table" and value.__type == "Color3" then
                        api:Set(Color3.new(value.r, value.g, value.b))
                    elseif type(value) == "table" and value.__type == "Enum" then
                        api:Set(Enum.KeyCode[value.name])
                    else
                        api:Set(value)
                    end
                end
            end
        end)
    end

    function W:ListConfigs()
        if not listfiles then return {} end
        local out = {}
        pcall(function()
            for _, p in ipairs(listfiles(folder)) do
                local n = p:match("([^/\\]+)%.json$")
                if n then out[#out + 1] = n end
            end
        end)
        table.sort(out)
        return out
    end

