        function Tab:CreateDropdown(cfg, flag)
            cfg = cfg or {}
            local options  = cfg.Options or {}
            local multi    = cfg.MultiSelect == true
            local selected = {}
            for _, v in ipairs(cfg.CurrentOption or {}) do selected[v] = true end

            local row = New("Frame", {
                Size = UDim2.new(1, 0, 0, ROW),
                BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.3,
                BorderSizePixel = 0, ClipsDescendants = true,
                ZIndex = 16, Parent = page,
            }, { Corner(11), Stroke(Theme.BorderSoft, 1, 0.55) })
            RowText(row, cfg.Name or "Dropdown", nil, cfg.Icon)

            local valueLabel = New("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -32, 0, 0),
                Size = UDim2.fromOffset(150, ROW),
                BackgroundTransparency = 1,
                Text = "", TextColor3 = Theme.TextSub, TextSize = 12,
                Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 19, Parent = row,
            })
            local caret = RenderIcon("chevron-down", row, 13, Theme.TextDim, 19)
            caret.AnchorPoint = Vector2.new(1, 0)
            caret.Position = UDim2.new(1, -14, 0, 13)

            local host = New("Frame", {
                Position = UDim2.fromOffset(0, ROW),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, ZIndex = 18, Parent = row,
            }, { List(3), Pad(2, 8, 10, 10) })

            local function summary()
                local picked = {}
                for _, o in ipairs(options) do if selected[o] then picked[#picked + 1] = o end end
                valueLabel.Text = #picked > 0 and table.concat(picked, ", ") or "--"
            end

            local entries, expanded = {}, false
            local function build()
                for _, c in ipairs(host:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                entries = {}
                for i, opt in ipairs(options) do
                    local e = New("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = Theme.Elevated, BackgroundTransparency = 0.4,
                        AutoButtonColor = false, Text = "", LayoutOrder = i,
                        ZIndex = 19, Parent = host,
                    }, { Corner(7) })
                    New("TextLabel", {
                        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -34, 1, 0),
                        BackgroundTransparency = 1, Text = tostring(opt),
                        TextColor3 = Theme.TextSub, TextSize = 11.5, Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        ZIndex = 20, Parent = e,
                    })
                    local tick = RenderIcon("check", e, 12, hue, 20)
                    tick.AnchorPoint = Vector2.new(1, 0.5)
                    tick.Position = UDim2.new(1, -9, 0.5, 0)
                    tick.Visible = selected[opt] == true
                    entries[opt] = tick
                    e.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = (not selected[opt]) or nil
                        else
                            selected = { [opt] = true }
                        end
                        for o, t in pairs(entries) do t.Visible = selected[o] == true end
                        summary()
                        if flag then NelyX.Flags[flag] = multi and selected or opt end
                        if cfg.Callback then
                            if multi then
                                local picked = {}
                                for _, o in ipairs(options) do
                                    if selected[o] then picked[#picked + 1] = o end
                                end
                                task.spawn(cfg.Callback, picked)
                            else
                                task.spawn(cfg.Callback, opt)
                            end
                        end
                    end)
                end
            end
            build()
            summary()

            local header = New("TextButton", {
                Size = UDim2.new(1, 0, 0, ROW), BackgroundTransparency = 1,
                AutoButtonColor = false, Text = "", ZIndex = 21, Parent = row,
            })
            header.MouseButton1Click:Connect(function()
                expanded = not expanded
                local target = expanded and (ROW + host.AbsoluteSize.Y + 6) or ROW
                Tween(row, { Size = UDim2.new(1, 0, 0, target) }, EASE.Glide)
                Tween(caret, { Rotation = expanded and 180 or 0 }, EASE.Glide)
            end)

            local api = { Instance = row }
            function api:Set(newCfg)
                if type(newCfg) == "table" and newCfg.Options then
                    options = newCfg.Options
                    build()
                end
                if type(newCfg) == "table" and newCfg.CurrentOption then
                    selected = {}
                    for _, v in ipairs(newCfg.CurrentOption) do selected[v] = true end
                    for o, t in pairs(entries) do t.Visible = selected[o] == true end
                end
                summary()
            end
            return Window:RegisterElement(flag, api)
        end

        function Tab:CreateKeybind(cfg, flag)
            cfg = cfg or {}
            local row = Row(cfg.Description and ROW_D or ROW)
            RowText(row, cfg.Name or "Keybind", cfg.Description, cfg.Icon)
            local current = cfg.CurrentBind or "Unknown"
            local listening = false
            local chip = New("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(72, 25),
                BackgroundColor3 = Theme.Elevated, BackgroundTransparency = 0.25,
                AutoButtonColor = false,
                Text = tostring(current), TextColor3 = Theme.TextSub,
                TextSize = 11.5, Font = Enum.Font.GothamMedium,
                ZIndex = 19, Parent = row,
            }, { Corner(8), Stroke(Theme.BorderSoft, 1, 0.5) })

            chip.MouseButton1Click:Connect(function()
                listening = true
                chip.Text = "..."
                Tween(chip, { BackgroundTransparency = 0.05 }, EASE.Snap)
            end)
            UserInputService.InputBegan:Connect(function(i, typing)
                if not listening or typing then return end
                if i.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    current = i.KeyCode
                    chip.Text = i.KeyCode.Name
                    Tween(chip, { BackgroundTransparency = 0.25 }, EASE.Snap)
                    if flag then NelyX.Flags[flag] = i.KeyCode end
                    if cfg.OnChanged then task.spawn(cfg.OnChanged, i.KeyCode) end
                end
            end)

            local api = { Instance = row }
            function api:Set(k)
                if typeof(k) == "EnumItem" then
                    current = k
                    chip.Text = k.Name
                    if flag then NelyX.Flags[flag] = k end
                    if cfg.OnChanged then task.spawn(cfg.OnChanged, k) end
                end
            end
            return Window:RegisterElement(flag, api)
        end

        function Tab:CreateColorpicker(cfg, flag)
            cfg = cfg or {}
            local colour = cfg.CurrentValue or hue
            local row = Row(cfg.Description and ROW_D or ROW)
            RowText(row, cfg.Name or "Colour", cfg.Description, cfg.Icon or "palette")

            local swatch = New("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(38, 22),
                BackgroundColor3 = colour, AutoButtonColor = false, Text = "",
                BorderSizePixel = 0, ZIndex = 19, Parent = row,
            }, { Corner(7), Stroke(Theme.Border, 1, 0.4) })

            -- A full HSV wheel is overkill in a hub; a hue strip covers
            -- every practical ESP/crosshair choice and stays usable on a
            -- phone screen.
            local strip = New("Frame", {
                Position = UDim2.new(0, 14, 0, ROW - 4),
                Size = UDim2.new(1, -28, 0, 0),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0, ClipsDescendants = true,
                ZIndex = 19, Parent = row,
            }, {
                Corner(6),
                Gradient(ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(0.34, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(0.51, Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(0.68, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(0.85, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
                })),
            })

            local api = { Instance = row }
            function api:Set(c, silent)
                if typeof(c) ~= "Color3" then return end
                colour = c
                swatch.BackgroundColor3 = c
                if flag then NelyX.Flags[flag] = c end
                if cfg.Callback and not silent then task.spawn(cfg.Callback, c) end
            end

            local open = false
            swatch.MouseButton1Click:Connect(function()
                open = not open
                Tween(row, { Size = UDim2.new(1, 0, 0, open and (ROW + 34) or ROW) }, EASE.Glide)
                Tween(strip, { Size = UDim2.new(1, -28, 0, open and 20 or 0) }, EASE.Glide)
            end)
            local picking = false
            local function pick(px)
                local a = math.clamp((px - strip.AbsolutePosition.X) / math.max(strip.AbsoluteSize.X, 1), 0, 1)
                api:Set(Color3.fromHSV(a, 0.75, 1))
            end
            strip.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                   or i.UserInputType == Enum.UserInputType.Touch then
                    picking = true pick(i.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if picking and (i.UserInputType == Enum.UserInputType.MouseMovement
                   or i.UserInputType == Enum.UserInputType.Touch) then pick(i.Position.X) end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                   or i.UserInputType == Enum.UserInputType.Touch then picking = false end
            end)

            if flag then NelyX.Flags[flag] = colour end
            return Window:RegisterElement(flag, api)
        end

        ----------------------------------------------------------------
        -- ITEM GRID
        --
        -- Cards of real artwork. Picking a weapon skin by name means
        -- knowing 170 names; picking it by its picture means looking at
        -- it. Items are { Id, Name, Image, Badge, BadgeRainbow }.
        ----------------------------------------------------------------
        function Tab:CreateItemGrid(cfg)
            cfg = cfg or {}
            local items   = cfg.Items or {}
            local cardW   = cfg.CardWidth or 96
            local cardH   = cfg.CardHeight or 112

            local shellFrame = New("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, ZIndex = 16, Parent = page,
            }, { List(8) })

            local countLabel = New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                Text = "", TextColor3 = Theme.TextDim, TextSize = 11,
                Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = 1, ZIndex = 17, Parent = shellFrame,
            })

            local grid = New("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = 2,
                ZIndex = 17, Parent = shellFrame,
            }, {
                New("UIGridLayout", {
                    CellSize = UDim2.fromOffset(cardW, cardH),
                    CellPadding = UDim2.fromOffset(8, 8),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    HorizontalAlignment = Enum.HorizontalAlignment.Left,
                }),
            })

            local api = { Instance = shellFrame }

            local function card(item, order)
                local c = New("TextButton", {
                    BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.25,
                    AutoButtonColor = false, Text = "", LayoutOrder = order,
                    ClipsDescendants = true, ZIndex = 18, Parent = grid,
                }, { Corner(10), Stroke(Theme.BorderSoft, 1, 0.45) })

                New("ImageLabel", {
                    Name = "Art",
                    Position = UDim2.fromOffset(0, 6),
                    Size = UDim2.new(1, 0, 1, -30),
                    BackgroundTransparency = 1,
                    Image = tostring(item.Image or ""),
                    ScaleType = Enum.ScaleType.Fit,
                    ZIndex = 19, Parent = c,
                })

                New("TextLabel", {
                    AnchorPoint = Vector2.new(0, 1),
                    Position = UDim2.new(0, 0, 1, -5),
                    Size = UDim2.new(1, -8, 0, 14),
                    BackgroundTransparency = 1,
                    Text = tostring(item.Name or "?"),
                    TextColor3 = Theme.TextSub, TextSize = 10.5,
                    Font = Enum.Font.GothamMedium,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 19, Parent = c,
                }, { Pad(0, 0, 6, 0) })

                if item.Badge and item.Badge ~= "" then
                    local badge = New("Frame", {
                        Position = UDim2.fromOffset(5, 5),
                        Size = UDim2.fromOffset(0, 14),
                        AutomaticSize = Enum.AutomaticSize.X,
                        BackgroundColor3 = item.BadgeRainbow and Color3.fromRGB(255, 255, 255)
                                            or (item.BadgeColor or hue),
                        BorderSizePixel = 0, ZIndex = 21, Parent = c,
                    }, { Corner(4), Pad(0, 0, 5, 5) })
                    if item.BadgeRainbow then
                        -- chromas advertise themselves in chroma
                        Gradient(ColorSequence.new({
                            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 90, 90)),
                            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 120)),
                            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(120, 240, 190)),
                            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(170, 140, 255)),
                        })).Parent = badge
                    end
                    New("TextLabel", {
                        Size = UDim2.fromOffset(0, 14), AutomaticSize = Enum.AutomaticSize.X,
                        BackgroundTransparency = 1,
                        Text = string.upper(tostring(item.Badge)),
                        TextColor3 = Color3.fromRGB(22, 22, 30),
                        TextSize = 8.5, Font = Enum.Font.GothamBold,
                        ZIndex = 22, Parent = badge,
                    })
                end

                c.MouseEnter:Connect(function()
                    Tween(c, { BackgroundTransparency = 0.05 }, EASE.Snap)
                    local st = c:FindFirstChildOfClass("UIStroke")
                    if st then Tween(st, { Color = hue, Transparency = 0 }, EASE.Snap) end
                end)
                c.MouseLeave:Connect(function()
                    Tween(c, { BackgroundTransparency = 0.25 }, EASE.Snap)
                    local st = c:FindFirstChildOfClass("UIStroke")
                    if st then Tween(st, { Color = Theme.BorderSoft, Transparency = 0.45 }, EASE.Snap) end
                end)
                c.MouseButton1Click:Connect(function()
                    Ripple(c)
                    if cfg.Callback then task.spawn(cfg.Callback, item.Id or item.Name, item) end
                end)
                return c
            end

            -- Rendering 900 cards at once locks the client, so the grid
            -- draws a page at a time and yields between batches.
            local BATCH, cap = 40, cfg.MaxCards or 300
            function api:Render(list)
                for _, c in ipairs(grid:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                local shown = math.min(#list, cap)
                countLabel.Text = #list .. " items"
                    .. (#list > cap and ("  (showing first " .. cap .. " -- narrow the filter)") or "")
                task.spawn(function()
                    for i = 1, shown do
                        card(list[i], i)
                        if i % BATCH == 0 then task.wait() end
                    end
                end)
            end

            function api:Set(list)
                items = list or {}
                api:Render(items)
            end

            api:Render(items)
            return api
        end

        return Tab
    end

    -- sidebar search filters the tab list
    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local q = string.lower(searchBox.Text)
            for _, tab in ipairs(Window.Tabs) do
                tab.Button.Visible = q == "" or string.find(string.lower(tab.Name), q, 1, true) ~= nil
            end
        end)
    end

    table.insert(NelyX.Windows, Window)
    return Window
end

return NelyX
