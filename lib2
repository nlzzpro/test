        function Tab:CreateViewportCard(cfg)
            cfg = cfg or {}
            local fov = cfg.FieldOfView or 40

            local card = New("Frame", {
                Name                   = "ViewportCard",
                Size                   = UDim2.new(1, 0, 0, cfg.Height or 220),
                BackgroundColor3       = theme.Surface,
                BackgroundTransparency = 0.15,
                BorderSizePixel        = 0,
                ClipsDescendants       = true,
                LayoutOrder            = NextOrder(),
                ZIndex                 = 17,
                Parent                 = page,
            }, { Corner(14), Stroke(theme.BorderSoft, 1, 0.4) })

            local titleLabel
            if cfg.Title and cfg.Title ~= "" then
                titleLabel = New("TextLabel", {
                    Size                   = UDim2.new(1, -24, 0, 18),
                    Position               = UDim2.fromOffset(12, 10),
                    BackgroundTransparency = 1,
                    Text                   = cfg.Title,
                    TextColor3             = theme.Text,
                    TextSize               = 13,
                    Font                   = Enum.Font.GothamBold,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 21,
                    Parent                 = card,
                })
            end

            local emptyLabel = New("TextLabel", {
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text                   = cfg.EmptyText or "No preview available",
                TextColor3             = theme.TextDim,
                TextSize               = 12,
                Font                   = Enum.Font.Gotham,
                ZIndex                 = 19,
                Visible                = true,
                Parent                 = card,
            })

            local viewport = New("ViewportFrame", {
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Ambient                = Color3.fromRGB(150, 150, 160),
                LightColor             = Color3.fromRGB(255, 255, 255),
                LightDirection         = Vector3.new(-0.6, -1, -0.35),
                ZIndex                 = 18,
                Parent                 = card,
            })

            local worldModel = Instance.new("WorldModel")
            worldModel.Parent = viewport

            local camera = Instance.new("Camera")
            camera.FieldOfView = fov
            camera.CFrame = CFrame.new(Vector3.new(0, 0, 5), Vector3.new(0, 0, 0))
            camera.Parent = viewport
            viewport.CurrentCamera = camera

            local currentModel, rotConn
            local dragging, lastX, lastY, dragConnA, dragConnB, dragConnC

            local function clearModel()
                if rotConn then rotConn:Disconnect() rotConn = nil end
                if currentModel then
                    pcall(function() currentModel:Destroy() end)
                    currentModel = nil
                end
            end

            local api = { Instance = card }

            function api:Set(source, title)
                clearModel()
                if title ~= nil and titleLabel then titleLabel.Text = tostring(title) end
                if not source then
                    emptyLabel.Visible = true
                    return
                end
                local ok, clone = pcall(function() return source:Clone() end)
                if not (ok and clone) then
                    emptyLabel.Visible = true
                    return
                end

                local model
                if clone:IsA("Model") then
                    model = clone
                elseif clone:IsA("BasePart") then
                    model = Instance.new("Model")
                    clone.Parent = model
                    model.PrimaryPart = clone
                else
                    emptyLabel.Visible = true
                    pcall(function() clone:Destroy() end)
                    return
                end

                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") or d:IsA("Sound") then
                        pcall(function() d:Destroy() end)
                    end
                end

                if model:GetChildren()[1] == nil or not model:FindFirstChildWhichIsA("BasePart", true) then
                    emptyLabel.Visible = true
                    pcall(function() model:Destroy() end)
                    return
                end

                model.Parent = worldModel
                currentModel = model
                emptyLabel.Visible = false

                local okBox, boxCF, boxSize = pcall(function() return model:GetBoundingBox() end)
                if okBox and boxCF then
                    pcall(function() model:PivotTo(model:GetPivot() - boxCF.Position) end)
                    local radius = math.max(boxSize.Magnitude / 2, 0.5)
                    local dist = (radius / math.tan(math.rad(fov / 2))) * 1.35
                    camera.CFrame = CFrame.new(Vector3.new(0, 0, dist), Vector3.new(0, 0, 0))
                end

                if cfg.Rotate ~= false then
                    local speed = cfg.RotateSpeed or 0.35
                    rotConn = RunService.Heartbeat:Connect(function(dt)
                        if not (currentModel and currentModel.Parent) then return end
                        pcall(function()
                            currentModel:PivotTo(currentModel:GetPivot() * CFrame.Angles(0, speed * dt, 0))
                        end)
                    end)
                end
            end

            if cfg.Model then api:Set(cfg.Model, nil) end

            if cfg.Drag ~= false then
                dragConnA = viewport.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        lastX = input.Position.X
                    end
                end)
                dragConnB = viewport.InputChanged:Connect(function(input)
                    if not dragging then return end
                    if input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch then
                        local dx = input.Position.X - lastX
                        lastX = input.Position.X
                        if currentModel and currentModel.Parent then
                            pcall(function()
                                currentModel:PivotTo(currentModel:GetPivot() * CFrame.Angles(0, math.rad(dx) * 0.5, 0))
                            end)
                        end
                    end
                end)
                dragConnC = UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

            function api:Destroy()
                clearModel()
                if dragConnA then dragConnA:Disconnect() end
                if dragConnB then dragConnB:Disconnect() end
                if dragConnC then dragConnC:Disconnect() end
                pcall(function() camera:Destroy() end)
                pcall(function() worldModel:Destroy() end)
                card:Destroy()
            end
            return api
        end

