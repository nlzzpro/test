local remoteCache = {}

local function CacheRemoteImage(url)
    if remoteCache[url] then return remoteCache[url] end

    local httpRequest = (syn and syn.request) or (http and http.request)
                        or http_request or request
    if not (httpRequest and writefile and getcustomasset and isfolder and makefolder) then
        return nil
    end

    local ok, asset = pcall(function()
        if not isfolder("nely_cache") then makefolder("nely_cache") end

        -- rbxcdn hands back WebP by default and Roblox's decoder wants PNG
        local target = url:gsub("/Webp/", "/Png/")

        local response = httpRequest({ Url = target, Method = "GET" })
        local body = response and (response.Body or response.body)
        if not body or #body == 0 then return nil end

        local hash = 5381
        for i = 1, #url do
            hash = (hash * 33 + string.byte(url, i)) % 4294967296
        end

        local path = ("nely_cache/%d.png"):format(hash)
        writefile(path, body)
        return getcustomasset(path)
    end)

    if ok and asset then
        remoteCache[url] = asset
        return asset
    end
    return nil
end

-- Calls back with a usable content string, possibly several frames later.
-- Never calls back at all if the source can't be resolved on this executor.
local function ResolveImageAsync(source, callback)
    if not source or source == "" then return end

    if tonumber(source) then
        callback("rbxassetid://" .. source)
        return
    end
    if string.match(source, "^rbx") then
        callback(source)
        return
    end

    task.spawn(function()
        local cached = CacheRemoteImage(source)
        if cached then callback(cached) end
    end)
end

local function ResolveGameImage(entry, callback)
    local function Thumb(universeId)
        callback(("rbxthumb://type=GameIcon&id=%d&w=256&h=256"):format(universeId))
    end

    -- explicit universe id: renders on the spot, nothing to look up
    if entry.UniverseId then
        Thumb(entry.UniverseId)
        return
    end

    local image = entry.Image
    if image and image ~= "" then
        if tonumber(image) then
            callback("rbxassetid://" .. image)
            return
        end
        if string.match(image, "^rbx") then
            callback(image)
            return
        end
    end

    -- place id: needs the universe lookup before rbxthumb will accept it
    if entry.PlaceId then
        local cached = universeCache[entry.PlaceId]
        if cached then
            Thumb(cached)
        else
            table.insert(universeQueue, { placeId = entry.PlaceId, callback = Thumb })
            ProcessUniverseQueue()
        end
        return
    end

    if image and image ~= "" then
        ResolveImageAsync(image, callback)
    end
end

