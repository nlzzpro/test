        local currentGroup

        function Tab:CreateGroup(gcfg)
            gcfg = type(gcfg) == "string" and { Title = gcfg } or (gcfg or {})

            -- drop the card into the column holding the fewest so far;
            -- with two columns that alternates, and it still balances if
            -- a tab is mostly one big card
            local target, best = 1, math.huge
            for i = 1, colCount do
                if colFill[i] < best then best, target = colFill[i], i end
            end
            colFill[target] = colFill[target] + 1

            local G = { Tab = Tab }

            local holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = colFill[target],
                ZIndex = 16, Parent = cols[target],
