        BackgroundTransparency = 1,
        Image                  = raw and name or (Icons.Asset(name) or ""),
        ImageColor3            = raw and Color3.fromRGB(255, 255, 255) or color,
        ScaleType              = Enum.ScaleType.Fit,
        ZIndex                 = zindex or (parent.ZIndex + 1),
