        ------------------------------------------------------------
        -- Button
        ------------------------------------------------------------

        function Tab:CreateButton(cfg)
            cfg = cfg or {}
            local row = Row(cfg.Description and ROW_HD or ROW_H)
            RowText(row, cfg.Name or "Button", cfg.Description, RowIcon(row, cfg.Icon), cfg.Info, cfg.NameKey, cfg.DescKey, narrowRows and 78 or 96)

            local hit = New("TextButton", {
                Size             = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                AutoButtonColor  = false,
                Text             = "",
                ZIndex           = 19,
                Parent           = row,
            })

            -- Action chip. Primary buttons get a restrained metallic fill;
            -- everything else stays graphite and only lifts on hover.
            local primary = cfg.Primary == true
            local chipW   = narrowRows and 56
                         or (UserInputService.TouchEnabled and 74 or 66)

            local action = New("Frame", {
                Name                   = "Action",
                Size                   = UDim2.fromOffset(chipW, 26),
                Position               = UDim2.new(1, -16, 0.5, 0),
                AnchorPoint            = Vector2.new(1, 0.5),
                BackgroundColor3       = primary and theme.Accent or theme.Elevated,
                BackgroundTransparency = primary and 0.04 or 0.3,
                BorderSizePixel        = 0,
                ZIndex                 = 18,
                Parent                 = row,
            }, {
                Corner(Design.Radius.SM + 1),
                Stroke(primary and theme.AccentSoft or theme.Border, 1, primary and 0.6 or 0.5),
            })
            local actionScale = New("UIScale", { Scale = 1, Parent = action })

            local actionLabel = New("TextLabel", {
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text                   = cfg.ButtonText or "Run",
                TextColor3             = primary and theme.Backdrop or theme.TextSub,
                TextSize               = Design.Text.Meta + 1,
                Font                   = Enum.Font.GothamBold,
                ZIndex                 = 19,
                Parent                 = action,
            })
            if cfg.ButtonKey then BindText(actionLabel, "Text", cfg.ButtonKey) end

            Hover(hit, function(inside)
                Tween(row, {
                    BackgroundColor3       = theme.Hover,
                    BackgroundTransparency = inside and 0.93 or 1,
                }, EASE.Snap)
                Tween(action, {
                    BackgroundTransparency = inside and (primary and 0 or 0.12)
                                                     or (primary and 0.04 or 0.3),
                }, EASE.Snap)
                if not primary then
                    Tween(actionLabel, { TextColor3 = inside and theme.Text or theme.TextSub }, EASE.Snap)
                end
            end)

            -- Tactile press. Scale down on the way in, spring back out --
            -- the release is what makes it feel like a button rather than
            -- a link.
            hit.MouseButton1Down:Connect(function()
                Tween(actionScale, { Scale = 0.94 }, EASE.Instant)
            end)
            local function ReleaseScale()
                Tween(actionScale, { Scale = 1 }, EASE.Spring)
            end
            hit.MouseButton1Up:Connect(ReleaseScale)
            hit.MouseLeave:Connect(ReleaseScale)

            hit.MouseButton1Click:Connect(function()
                Ripple(row, 20)
                if cfg.Callback then task.spawn(cfg.Callback) end
            end)
            NoInput(row, hit)

            local api = { Instance = row, Destroy = function() row:Destroy() end }
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            return api
        end

        ------------------------------------------------------------
        -- Toggle
        ------------------------------------------------------------

        function Tab:CreateToggle(cfg, flag)
            cfg = cfg or {}
            -- Default is accepted as an alias; see the note on aliases in
            -- CreateSlider.
            local state = (cfg.CurrentValue == nil) and (cfg.Default == true)
                       or (cfg.CurrentValue == true)
            -- Per-control colour. A hub is full of switches that mean very
            -- different things, and "everything is the accent colour" makes
            -- them read as one undifferentiated wall. Pass Color to give a
            -- switch its own meaning -- green for the innocent role, red for
            -- the murderer, blue for a utility -- and it carries through the
            -- track, the glow and the hover.
            local hue = cfg.Color or theme.Accent
            local row = Row(cfg.Description and ROW_HD or ROW_H)
            RowText(row, cfg.Name or "Toggle", cfg.Description, RowIcon(row, cfg.Icon), cfg.Info, cfg.NameKey, cfg.DescKey, 62)

            local TRACK_W, TRACK_H, KNOB = 34, 18, 14
            local KNOB_ON, KNOB_OFF = TRACK_W - KNOB - 2, 2

            local track = New("Frame", {
                Name             = "Track",
                Size             = UDim2.fromOffset(TRACK_W, TRACK_H),
                Position         = UDim2.new(1, -16, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = state and hue or theme.Track,
                BorderSizePixel  = 0,
                ZIndex           = 18,
                Parent           = row,
            }, {
                New("UICorner", { CornerRadius = UDim.new(1, 0) }),
                -- Rim only in the off state, so the empty slot has an edge
                -- to read against the card behind it.
                Stroke(theme.Border, 1, state and 1 or 0.4),
            })
            local trackRim = track:FindFirstChildOfClass("UIStroke")

            local knob = New("Frame", {
                Name             = "Knob",
                Size             = UDim2.fromOffset(KNOB, KNOB),
                Position         = UDim2.new(0, state and KNOB_ON or KNOB_OFF, 0.5, 0),
                AnchorPoint      = Vector2.new(0, 0.5),
                BackgroundColor3 = state and theme.Backdrop or theme.TextSub,
                BorderSizePixel  = 0,
                ZIndex           = 19,
                Parent           = track,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            -- No glyph inside the switch. On a light accent (the grey
            -- theme's platinum) a white check disappears, and on a dark
            -- one it is redundant next to the knob. The state is carried
            -- by inverting the knob instead, which works in every theme:
            --   off -> dark track, light knob
            --   on  -> light track, dark knob
            -- so there is always full contrast whichever way it sits.

            local hit = New("TextButton", {
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 20,
                Parent                 = row,
            })

            local api = {}

            local function Apply(value, fire)
                state = value
                Tween(track, { BackgroundColor3 = state and hue or theme.Track }, EASE.Snap)
                if trackRim then
                    Tween(trackRim, { Transparency = state and 1 or 0.4 }, EASE.Snap)
                end
                -- The knob springs, the colours do not. Overshooting a
                -- colour looks like a rendering fault; overshooting a
                -- position reads as weight.
                Tween(knob, { Position = UDim2.new(0, state and KNOB_ON or KNOB_OFF, 0.5, 0) }, EASE.Spring)
                Tween(knob, { BackgroundColor3 = state and theme.Backdrop or theme.TextSub }, EASE.Snap)
                if flag then
                    Nely.Flags[flag] = state
                    -- anything that declared Depends = "<flag>" greys itself
                    -- in or out from here
                    Window:_Sync(flag, state)
                end
                api.CurrentValue = state
                if fire and cfg.Callback then task.spawn(cfg.Callback, state) end
            end

            Hover(hit, function(inside)
                Tween(row, {
                    BackgroundColor3       = theme.Hover,
                    BackgroundTransparency = inside and 0.93 or 1,
                }, EASE.Snap)
                if not state then
                    Tween(knob, { BackgroundColor3 = inside and theme.Text or theme.TextSub }, EASE.Snap)
                end
            end)
            hit.MouseButton1Click:Connect(function() Apply(not state, true) end)
            NoInput(row, hit)

            api.CurrentValue = state
            api.Set     = function(_, value) Apply(value, true) end
            api.Destroy = function() row:Destroy() end
            if flag then
                Nely.Flags[flag] = state
                task.defer(function() Window:_Sync(flag, state) end)
            end
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

        ------------------------------------------------------------
        -- Slider
        ------------------------------------------------------------

        function Tab:CreateSlider(cfg, flag)
            cfg = cfg or {}
            -- Range = {min, max} is canonical. Min/Max are accepted
            -- because every other library in this space uses them, and a
            -- misspelt bound produces a silently wrong slider rather than
            -- an error -- the worst kind of API to get wrong.
            local range = cfg.Range
            if not range then
                if cfg.Min or cfg.Max then
                    range = { cfg.Min or 0, cfg.Max or 100 }
                else
                    range = { 0, 100 }
                end
            end
            local increment = cfg.Increment or 1
            local value     = cfg.CurrentValue or cfg.Default or range[1]
            local suffix    = cfg.Suffix or ""
            -- Same reasoning as the toggle: a slider can carry its own
            -- colour so a group of them is readable at a glance.
            local hue = cfg.Color or theme.Accent

            -- Everything inside a slider is positioned off the bottom of the
            -- row, so the track and its hit strip follow the row height
            -- instead of being pinned to the old 70px assumption.
            local rowH   = dense and (compact and 56 or 60) or (compact and 64 or 70)
            if narrowRows then rowH = rowH - 6 end
            local titleY = dense and 11 or (compact and 13 or 16)
            local trackY = rowH - 20
            local hitY   = trackY - 8

            local row = Row(rowH)
            local lp  = RowIcon(row, cfg.Icon)
            local sliderLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -lp - 74, 0, 15),
                Position               = UDim2.fromOffset(lp, titleY),
                BackgroundTransparency = 1,
                Text                   = cfg.NameKey and L(cfg.NameKey) or (cfg.Name or "Slider"),
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })
            if cfg.NameKey then BindText(sliderLabel, "Text", cfg.NameKey) end
            InfoDot(row, sliderLabel, cfg.Info, 19)

            -- Value readout. Small, right-aligned, and quiet: it is a
            -- reading, not a heading. Filled only faintly so it reads as
            -- part of the row rather than as a second control.
            local readout = New("TextLabel", {
                Name                   = "Value",
                Size                   = UDim2.fromOffset(52, 18),
                Position               = UDim2.new(1, -16, 0, compact and 12 or 15),
                AnchorPoint            = Vector2.new(1, 0),
                BackgroundColor3       = theme.Elevated,
                BackgroundTransparency = 0.35,
                BorderSizePixel        = 0,
                Text                   = tostring(value) .. suffix,
                TextColor3             = theme.Text,
                TextSize               = Design.Text.Meta + 1,
                Font                   = Enum.Font.GothamMedium,
                ZIndex                 = 18,
                Parent                 = row,
            }, { Corner(Design.Radius.SM) })

            local track = New("Frame", {
                Name             = "Track",
                Size             = UDim2.new(1, -lp - 16, 0, 3),
                Position         = UDim2.fromOffset(lp, trackY + 1),
                BackgroundColor3 = theme.Track,
                BorderSizePixel  = 0,
                ZIndex           = 18,
                Parent           = row,
            }, { Corner(2) })

            local ratio = (value - range[1]) / math.max(range[2] - range[1], 1)

            -- Flat platinum. No gradient: a two-stop ramp across a 3px bar
            -- is invisible at rest and muddy in motion.
            local fill = New("Frame", {
                Name             = "Fill",
                Size             = UDim2.fromScale(ratio, 1),
                BackgroundColor3 = hue,
                BorderSizePixel  = 0,
                ZIndex           = 19,
                Parent           = track,
            }, { Corner(2) })

            local knob = New("Frame", {
                Name             = "Knob",
                Size             = UDim2.fromOffset(11, 11),
                Position         = UDim2.fromScale(ratio, 0.5),
                AnchorPoint      = Vector2.new(0.5, 0.5),
                BackgroundColor3 = theme.Sheen,
                BorderSizePixel  = 0,
                ZIndex           = 21,
                Parent           = track,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local api = {}
            local dragging = false

            local function Apply(newRatio, fire)
                newRatio = math.clamp(newRatio, 0, 1)
                local raw = range[1] + (range[2] - range[1]) * newRatio
                value = math.floor(raw / increment + 0.5) * increment
                value = math.clamp(value, range[1], range[2])
                local display = (increment % 1 == 0) and string.format("%d", value)
                                                      or string.format("%.2f", value)
                readout.Text = display .. suffix
                local settled = (value - range[1]) / math.max(range[2] - range[1], 1)
                Tween(fill, { Size = UDim2.fromScale(settled, 1) }, EASE.Instant)
                Tween(knob, { Position = UDim2.fromScale(settled, 0.5) }, EASE.Instant)
                if flag then Nely.Flags[flag] = value end
                api.CurrentValue = value
                if fire and cfg.Callback then task.spawn(cfg.Callback, value) end
            end

            -- A 3px bar is impossible to grab on a phone, so the hit strip
            -- is deliberately far taller than the thing it controls.
            local HIT_H = UserInputService.TouchEnabled and 34 or 26
            local hit = New("TextButton", {
                Size                   = UDim2.new(1, 0, 0, HIT_H),
                Position               = UDim2.fromOffset(0, hitY - (HIT_H - 26) / 2),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 22,
                Parent                 = row,
            })

            local function PointerRatio()
                local mouse = GetPointer()
                return (mouse.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
            end

            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Tween(knob, { Size = UDim2.fromOffset(15, 15) }, EASE.Pop)
                    Apply(PointerRatio(), true)
                end
            end)

            local moveConn = UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                              or input.UserInputType == Enum.UserInputType.Touch) then
                    Apply(PointerRatio(), true)
                end
            end)
            table.insert(Nely.Connections, moveConn)

            local endConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        Tween(knob, { Size = UDim2.fromOffset(11, 11) }, EASE.Pop)
                    end
                end
            end)
            table.insert(Nely.Connections, endConn)

            api.CurrentValue = value
            api.Set     = function(_, newValue)
                Apply((newValue - range[1]) / math.max(range[2] - range[1], 1), true)
            end
            api.Destroy = function() row:Destroy() end
            if flag then Nely.Flags[flag] = value end
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

