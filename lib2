            end

            local _,        gameValue   = DetailRow("Game", 1)
            local jobHolder, jobValue   = DetailRow("Job ID", 2)
            local _,        uptimeValue = DetailRow("Uptime", 3)

            gameValue.Text = "Loading"
            task.spawn(function()
                local ok, info = pcall(function()
                    return game:GetService("MarketplaceService")
                        :GetProductInfo(game.PlaceId)
                end)
                gameValue.Text = (ok and info and info.Name) or "Place " .. game.PlaceId
            end)

            jobValue.Text = game.JobId ~= "" and game.JobId or "Studio"

