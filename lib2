        function Tab:CreateToggle(cfg, flag)
            cfg = cfg or {}
            local state = cfg.CurrentValue == true
            local row = Row(cfg.Description and ROW_HD or ROW_H)
            RowText(row, cfg.Name or "Toggle", cfg.Description, RowIcon(row, cfg.Icon), cfg.Info, cfg.NameKey, cfg.DescKey)

            local track = New("ImageLabel", {
                Size                   = UDim2.fromOffset(38, 21),
                Position               = UDim2.new(1, -14, 0.5, 0),
                AnchorPoint            = Vector2.new(1, 0.5),
                BackgroundTransparency = 1,
                Image                  = PILL,
                ScaleType              = Enum.ScaleType.Slice,
                SliceCenter            = Rect.new(512, 512, 512, 512),
                SliceScale             = 0.0205,
                ImageColor3            = state and Nely.AccentColor() or theme.Elevated,
                ZIndex                 = 18,
                Parent                 = row,
            })

            local customRamp = cfg.Gradient and ColorSequence.new(cfg.Gradient) or nil
            local trackGrad = New("UIGradient", {
                Rotation = customRamp and 0 or 90,
                Color    = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 190, 200)),
                }),
                Parent   = track,
            })

            local knob = New("ImageLabel", {
                Size                   = UDim2.fromOffset(15, 15),
                Position               = UDim2.new(0, state and 20 or 3, 0.5, 0),
                AnchorPoint            = Vector2.new(0, 0.5),
                BackgroundTransparency = 1,
                Image                  = PILL,
                ScaleType              = Enum.ScaleType.Slice,
                SliceCenter            = Rect.new(512, 512, 512, 512),
                SliceScale             = 0.0205,
                ImageColor3            = state and Color3.new(1, 1, 1) or theme.TextSub,
                ZIndex                 = 19,
                Parent                 = track,
            })

            local hit = New("TextButton", {
                Size                   = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 20,
                Parent                 = row,
            })

            local api = {}

            local function Paint(animate)
                local ease = (animate == false) and EASE.Instant or EASE.Snap
                Tween(track, {
                    ImageColor3 = state and Nely.AccentColor() or theme.Elevated,
                }, ease)

                trackGrad.Color = state
                    and (customRamp or ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(178, 178, 190)),
                    }))
                    or ColorSequence.new(Color3.new(1, 1, 1))
                Tween(knob, {
                    ImageColor3 = state and Color3.new(1, 1, 1) or theme.TextSub,
                }, ease)
            end

            local unregister = RegisterAccent(function()
                if row.Parent then Paint(false) else error("gone", 0) end
            end)

            local function Apply(value, fire)
                state = value
                Paint(true)

                Tween(knob, { Position = UDim2.new(0, state and 20 or 3, 0.5, 0) }, EASE.Pop)
                if flag then
                    Nely.Flags[flag] = state

                    Window:_Sync(flag, state)
                end
                api.CurrentValue = state
                if fire then
                    FireToggleHooks(state)
                    if cfg.Callback then task.spawn(cfg.Callback, state) end
                end
            end

            hit.MouseEnter:Connect(function()
                Tween(row, { BackgroundTransparency = 0.05, BackgroundColor3 = theme.SurfaceAlt }, EASE.Snap)
            end)
            hit.MouseLeave:Connect(function()
                Tween(row, { BackgroundTransparency = 0.25, BackgroundColor3 = theme.Surface }, EASE.Snap)
            end)
            hit.MouseButton1Click:Connect(function() Apply(not state, true) end)

            api.CurrentValue = state
            api.Set     = function(_, value) Apply(value, true) end
            api.Destroy = function() unregister() row:Destroy() end
            if flag then
                Nely.Flags[flag] = state
                task.defer(function() Window:_Sync(flag, state) end)
            end
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

        function Tab:CreateSlider(cfg, flag)
            cfg = cfg or {}
            local range     = cfg.Range     or { 0, 100 }
            local increment = cfg.Increment or 1
            local value     = cfg.CurrentValue or range[1]
            local suffix    = cfg.Suffix or ""

            local rowH   = dense and (compact and 56 or 60) or (compact and 64 or 70)
            local titleY = dense and 11 or (compact and 13 or 16)
            local trackY = rowH - 20
            local hitY   = trackY - 8

            local row = Row(rowH)
            local lp  = RowIcon(row, cfg.Icon)
            local sliderLabel = New("TextLabel", {
                Size                   = UDim2.new(1, -lp - 74, 0, 15),
                Position               = UDim2.fromOffset(lp, titleY),
                BackgroundTransparency = 1,
                Text                   = cfg.NameKey and L(cfg.NameKey) or (cfg.Name or "Slider"),
                TextColor3             = theme.Text,
                TextSize               = 13,
                Font                   = Enum.Font.GothamMedium,
                TextXAlignment         = Enum.TextXAlignment.Left,
                ZIndex                 = 18,
                Parent                 = row,
            })
            if cfg.NameKey then BindText(sliderLabel, "Text", cfg.NameKey) end
            InfoDot(row, sliderLabel, cfg.Info, 19)

            local readout = New("TextLabel", {
                Size                   = UDim2.fromOffset(64, 18),
                Position               = UDim2.new(1, -16, 0, compact and 12 or 15),
                AnchorPoint            = Vector2.new(1, 0),
                BackgroundColor3       = theme.Elevated,
                BorderSizePixel        = 0,
                Text                   = tostring(value) .. suffix,
                TextColor3             = theme.Accent,
                TextSize               = 12,
                Font                   = Enum.Font.GothamBold,
                ZIndex                 = 18,
                Parent                 = row,
            }, { Corner(6) })

            local track = New("Frame", {
                Size             = UDim2.new(1, -lp - 16, 0, 5),
                Position         = UDim2.fromOffset(lp, trackY),
                BackgroundColor3 = theme.Elevated,
                BorderSizePixel  = 0,
                ZIndex           = 18,
                Parent           = row,
            }, { Corner(3) })

            local ratio = (value - range[1]) / math.max(range[2] - range[1], 1)
            local fill = New("Frame", {
                Size             = UDim2.fromScale(ratio, 1),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel  = 0,
                ZIndex           = 19,
                Parent           = track,
            }, {
                Corner(3),
                Gradient(ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.AccentDeep),
                    ColorSequenceKeypoint.new(1, theme.AccentSoft),
                }), 0),
            })

            local knob = New("Frame", {
                Size             = UDim2.fromOffset(13, 13),
                Position         = UDim2.fromScale(ratio, 0.5),
                AnchorPoint      = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel  = 0,
                ZIndex           = 21,
                Parent           = track,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }), Stroke(theme.Accent, 2, 0) })

            local api = {}
            local dragging = false

            local function Apply(newRatio, fire)
                newRatio = math.clamp(newRatio, 0, 1)
                local raw = range[1] + (range[2] - range[1]) * newRatio
                value = math.floor(raw / increment + 0.5) * increment
                value = math.clamp(value, range[1], range[2])
                local display = (increment % 1 == 0) and string.format("%d", value)
                                                      or string.format("%.2f", value)
                readout.Text = display .. suffix
                local settled = (value - range[1]) / math.max(range[2] - range[1], 1)
                Tween(fill, { Size = UDim2.fromScale(settled, 1) }, EASE.Instant)
                Tween(knob, { Position = UDim2.fromScale(settled, 0.5) }, EASE.Instant)
                if flag then Nely.Flags[flag] = value end
                api.CurrentValue = value
                if fire and cfg.Callback then task.spawn(cfg.Callback, value) end
            end

            local hit = New("TextButton", {
                Size                   = UDim2.new(1, 0, 0, 26),
                Position               = UDim2.fromOffset(0, hitY),
                BackgroundTransparency = 1,
                AutoButtonColor        = false,
                Text                   = "",
                ZIndex                 = 22,
                Parent                 = row,
            })

            local function PointerRatio()
                local mouse = GetPointer()
                return (mouse.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
            end

            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Tween(knob, { Size = UDim2.fromOffset(17, 17) }, EASE.Pop)
                    Apply(PointerRatio(), true)
                end
            end)

            local moveConn = UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                              or input.UserInputType == Enum.UserInputType.Touch) then
                    Apply(PointerRatio(), true)
                end
            end)
            table.insert(Nely.Connections, moveConn)

            local endConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        Tween(knob, { Size = UDim2.fromOffset(13, 13) }, EASE.Pop)
                    end
                end
            end)
            table.insert(Nely.Connections, endConn)

            api.CurrentValue = value
            api.Set     = function(_, newValue)
                Apply((newValue - range[1]) / math.max(range[2] - range[1], 1), true)
            end
            api.Destroy = function() row:Destroy() end
            if flag then Nely.Flags[flag] = value end
            Lockable(row, api)
            BindDepend(api, cfg.Depends)
            Window:RegisterElement(flag, api)
            return api
        end

