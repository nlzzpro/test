--==================================================================
--  5. THEME APPLICATION
--==================================================================
function Nely:SetTheme(name)
    local preset = PRESETS[name]
    if not preset then return false end
    for k, v in pairs(preset) do Theme[k] = v end
    Nely.ThemeName = name
    local alive = {}
    for _, rec in ipairs(Nely._themed) do
        if rec.inst and rec.inst.Parent then
            pcall(function() Tween(rec.inst, { [rec.prop] = Theme[rec.key] }, EASE.Glide) end)
            alive[#alive + 1] = rec
        end
    end
    Nely._themed = alive
    return true
end

function Nely:SetCursorEnabled() end

