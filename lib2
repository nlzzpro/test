                AutomaticSize          = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder            = 2,
                ZIndex                 = 18,
                Parent                 = holder,
            }, {
                New("UIGridLayout", {
                    CellSize            = UDim2.fromOffset(cell.X, cell.Y),
                    CellPadding         = UDim2.fromOffset(9, 9),
                    SortOrder           = Enum.SortOrder.LayoutOrder,
                    HorizontalAlignment = Enum.HorizontalAlignment.Left,
                }),
            })

            local api = { Instance = holder }

            local function BuildCard(item, index)
                local card = New("TextButton", {
                    Name                   = tostring(item.Name or item.Id or index),
                    BackgroundColor3       = theme.Surface,
                    BackgroundTransparency = 0.15,
                    AutoButtonColor        = false,
                    Text                   = "",
                    LayoutOrder            = index,
                    ClipsDescendants       = true,
                    ZIndex                 = 19,
                    Parent                 = grid,
                }, { Corner(12), Stroke(theme.BorderSoft, 1, 0.4) })

                local art = New("Frame", {
                    Size                   = UDim2.new(1, -12, 1, -34),
                    Position               = UDim2.fromOffset(6, 6),
                    BackgroundColor3       = theme.SurfaceAlt,
                    BackgroundTransparency = 0.35,
                    BorderSizePixel        = 0,
                    ClipsDescendants       = true,
                    ZIndex                 = 20,
                    Parent                 = card,
                }, { Corner(9) })

                local letter = New("TextLabel", {
                    Size                   = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text                   = string.upper(string.sub(tostring(item.Name or "?"), 1, 1)),
                    TextColor3             = theme.TextDim,
                    TextTransparency       = 0.35,
                    TextSize               = 26,
                    Font                   = Enum.Font.GothamBold,
                    ZIndex                 = 21,
                    Parent                 = art,
                })

                if item.Image and item.Image ~= "" then

                    local pic = New("ImageLabel", {
                        Size                   = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        Image                  = tostring(item.Image),
                        ImageTransparency      = 0,
                        ScaleType              = Enum.ScaleType.Fit,
                        ZIndex                 = 22,
                        Parent                 = art,
                    })

                    letter.TextTransparency = 1
                    task.spawn(function()
                        local seen, swapped = 0, false
                        while pic.Parent do
                            if pic.IsLoaded then
                                if letter.TextTransparency < 1 then
                                    Tween(letter, { TextTransparency = 1 }, EASE.Smooth)
                                end
                                return
                            end
                            local visible = OnScreen(pic)
                            if visible then

                                seen = seen + 0.25
                                if seen > 0.6 and letter.TextTransparency > 0.9 then
                                    Tween(letter, { TextTransparency = 0.4 }, EASE.Smooth)
                                end

                                if not swapped and seen > 1.5 then
                                    swapped = true
                                    local id = tostring(pic.Image):match("^rbxassetid://(%d+)$")
                                    if id then
                                        pic.Image = "rbxthumb://type=Asset&w=420&h=420&id=" .. id
                                    end
                                end

                                if seen > 20 then return end
                            end
                            task.wait(visible and 0.25 or 1)
                        end
                    end)
                end

                New("TextLabel", {
                    AnchorPoint            = Vector2.new(0, 1),
                    Position               = UDim2.new(0, 8, 1, -6),
                    Size                   = UDim2.new(1, -16, 0, 14),
                    BackgroundTransparency = 1,
                    Text                   = tostring(item.Name or "?"),
                    TextColor3             = theme.TextSub,
                    TextSize               = 11,
                    Font                   = Enum.Font.GothamMedium,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    TextTruncate           = Enum.TextTruncate.AtEnd,
                    ZIndex                 = 21,
                    Parent                 = card,
                })

                if item.Badge and item.Badge ~= "" then
                    local badge = New("Frame", {
                        Position               = UDim2.fromOffset(9, 9),
                        Size                   = UDim2.fromOffset(0, 15),
                        AutomaticSize          = Enum.AutomaticSize.X,
                        BackgroundColor3       = item.BadgeRainbow
                                                  and Color3.fromRGB(255, 255, 255)
                                                  or (item.BadgeColor or theme.Accent),
                        BorderSizePixel        = 0,
                        ZIndex                 = 24,
                        Parent                 = card,
                    }, { Corner(5), Pad(0, 0, 6, 6) })

                    if item.BadgeRainbow then
                        Gradient(ColorSequence.new({
                            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 108, 108)),
                            ColorSequenceKeypoint.new(0.30, Color3.fromRGB(255, 214, 122)),
                            ColorSequenceKeypoint.new(0.62, Color3.fromRGB(122, 238, 190)),
                            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(168, 150, 255)),
                        })).Parent = badge
                    end

                    New("TextLabel", {
                        Size                   = UDim2.fromOffset(0, 15),
                        AutomaticSize          = Enum.AutomaticSize.X,
                        BackgroundTransparency = 1,
                        Text                   = string.upper(tostring(item.Badge)),
                        TextColor3             = Color3.fromRGB(18, 18, 22),
                        TextSize               = 8.5,
                        Font                   = Enum.Font.GothamBold,
                        ZIndex                 = 25,
                        Parent                 = badge,
                    })
                end

                if cfg.OnFavorite then
                    local favBtn = New("TextButton", {
                        AnchorPoint             = Vector2.new(1, 0),
                        Position                = UDim2.new(1, -6, 0, 6),
                        Size                    = UDim2.fromOffset(20, 20),
                        BackgroundColor3        = theme.Backdrop,
                        BackgroundTransparency  = 0.35,
                        AutoButtonColor         = false,
                        Text                    = "",
                        ZIndex                  = 24,
                        Parent                  = card,
                    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
                    local favIcon = Icons.Render("star", favBtn, 12, item.Favorite and theme.Accent or theme.TextDim, 25)
                    favIcon.AnchorPoint = Vector2.new(0.5, 0.5)
                    favIcon.Position    = UDim2.fromScale(0.5, 0.5)
                    favBtn.MouseButton1Click:Connect(function()
                        Ripple(favBtn, 10)
                        task.spawn(cfg.OnFavorite, item.Id or item.Name, item)
                    end)
                end

                local stroke = card:FindFirstChildOfClass("UIStroke")
                card.MouseEnter:Connect(function()
                    Tween(card, { BackgroundTransparency = 0 }, EASE.Snap)
                    if stroke then
                        Tween(stroke, { Color = theme.Accent, Transparency = 0.1 }, EASE.Snap)
                    end
                end)
                card.MouseLeave:Connect(function()
                    Tween(card, { BackgroundTransparency = 0.15 }, EASE.Snap)
                    if stroke then
                        Tween(stroke, { Color = theme.BorderSoft, Transparency = 0.4 }, EASE.Snap)
                    end
                end)
                card.MouseButton1Click:Connect(function()
                    Ripple(card, 22)

                    local fn = cfg.OnSelect or cfg.Callback
                    if fn then task.spawn(fn, item.Id or item.Name, item) end
                end)
                return card
            end

            local token = 0
            function api:Render(list)
                list = list or {}
                token = token + 1
                local mine = token
                for _, c in ipairs(grid:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                local shown = math.min(#list, cap)
                status.Text = (#list == 0) and (cfg.Empty or "Nothing matches")
                    or (#list .. " items" .. (#list > cap and ("  --  showing " .. cap) or ""))
                task.spawn(function()
                    for i = 1, shown do
                        if token ~= mine then return end
                        BuildCard(list[i], i)
                        if i % batch == 0 then task.wait() end
                    end
                end)
            end

            api.Set = function(_, list) api:Render(list) end
            api.Destroy = function() holder:Destroy() end
            api:Render(cfg.Items)
            return api
        end

