        local function ScoreEntry(entry, query)
            if query == "" then return 0 end
            local score = 0
            for word in string.gmatch(query, "%S+") do
                local hit =
                    string.find(entry.NameLower, word, 1, true) and 1
                    or string.find(entry.SectionLower, word, 1, true) and 2
                    or string.find(entry.ExtraLower, word, 1, true) and 3
                    or string.find(entry.TabLower, word, 1, true) and 4
                if not hit then return nil end
                score = score + ({ [1] = 100, [2] = 40, [3] = 20, [4] = 5 })[hit]
                if hit == 1 and entry.NameLower == word then score = score + 60
                elseif hit == 1 and string.sub(entry.NameLower, 1, #word) == word then score = score + 25 end
            end

            return score - (#entry.NameLower * 0.1)
        end

