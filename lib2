                    local g = RenderIcon("info", dot, 12, "TextDim", 21)
                    AttachTip(dot, info)
                    dot.MouseEnter:Connect(function() TintIcon(g, Theme.Accent) end)
                    dot.MouseLeave:Connect(function() TintIcon(g, Theme.TextDim) end)
                end

                if desc then
                    Themed(New("TextLabel", {
                        Position = UDim2.fromOffset(x, 24),
