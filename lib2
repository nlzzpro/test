-- Instances register the theme key they follow, so a theme change can
-- repaint what is already on screen instead of demanding a reload.
local function Themed(inst, prop, key)
    table.insert(Nely._themed, { inst = inst, prop = prop, key = key })
    return inst
end

function Nely:GetThemes()
    local out = {}
    for name in pairs(PRESETS) do out[#out + 1] = name end
    table.sort(out)
    return out
end

function Nely:AddTheme(cfg)
    if type(cfg) ~= "table" or not cfg.Name then return end
    local base = PRESETS[cfg.Base or "Nely Violet"] or PRESETS["Nely Violet"]
    local t = {}
    for k, v in pairs(base) do t[k] = v end
    for k, v in pairs(cfg) do
        if typeof(v) == "Color3" then t[k] = v end
    end
    PRESETS[cfg.Name] = t
end

--==================================================================
--  2. EASING + BUILD HELPERS
--==================================================================
local EASE = {
    Snap  = TweenInfo.new(0.13, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out),
    Glide = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    Pop   = TweenInfo.new(0.32, Enum.EasingStyle.Back,  Enum.EasingDirection.Out),
    Slow  = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

local function New(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function Round() return New("UICorner", { CornerRadius = UDim.new(1, 0) }) end

local function Stroke(colorKey, thickness, transparency)
    local s = New("UIStroke", {
        Color = Theme[colorKey] or Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    if Theme[colorKey] then Themed(s, "Color", colorKey) end
    return s
end

local function Pad(t, b, l, r)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or l or 0),
    })
end

local function List(padding, dir, align)
    return New("UIListLayout", {
        Padding = UDim.new(0, padding or 8),
        FillDirection = dir or Enum.FillDirection.Vertical,
        HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
end

local function Tween(inst, props, info)
    local t = TweenService:Create(inst, info or EASE.Snap, props)
    t:Play()
    return t
end

local function Shadow(parent, spread, transparency)
    return New("ImageLabel", {
        Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, spread or 30, 1, spread or 30),
        BackgroundTransparency = 1, Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = transparency or 0.55,
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = (parent.ZIndex or 1) - 1, Parent = parent,
    })
end

local function Ripple(host, x, y)
    if not host:IsA("GuiObject") then return end
    local abs = host.AbsolutePosition
    local px = (x or (abs.X + host.AbsoluteSize.X / 2)) - abs.X
    local py = (y or (abs.Y + host.AbsoluteSize.Y / 2)) - abs.Y
    local c = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(px, py),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0.78, BorderSizePixel = 0,
        ZIndex = (host.ZIndex or 1) + 4, Parent = host,
    }, { Round() })
    local reach = math.max(host.AbsoluteSize.X, host.AbsoluteSize.Y) * 2.1
    Tween(c, { Size = UDim2.fromOffset(reach, reach), BackgroundTransparency = 1 }, EASE.Slow)
    task.delay(0.5, function() pcall(function() c:Destroy() end) end)
end

local function AutoHue(i)
    return Color3.fromHSV(((i - 1) * 0.618033988749895) % 1, 0.52, 1)
end

