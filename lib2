        function Tab:CreateSlider(cfg, flag)
            cfg = cfg or {}
            local range = cfg.Range or { 0, 100 }
            local inc   = cfg.Increment or 1
            local value = cfg.CurrentValue or range[1]
            local row = Row(cfg.Description and 62 or 50)
            RowText(row, cfg.Name or "Slider", cfg.Description, cfg.Icon)

            local readout = New("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -14, 0, 9),
                Size = UDim2.fromOffset(64, 16),
                BackgroundTransparency = 1,
                Text = tostring(value) .. (cfg.Suffix or ""),
                TextColor3 = hue, TextSize = 12, Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = 19, Parent = row,
            })

            local barY = cfg.Description and 46 or 34
            local bar = New("Frame", {
                Position = UDim2.new(0, 14, 0, barY),
                Size = UDim2.new(1, -28, 0, 5),
                BackgroundColor3 = Theme.Elevated, BackgroundTransparency = 0.3,
                BorderSizePixel = 0, ZIndex = 19, Parent = row,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local fill = New("Frame", {
                Size = UDim2.fromScale((value - range[1]) / math.max(range[2] - range[1], 1), 1),
                BackgroundColor3 = hue, BorderSizePixel = 0,
                ZIndex = 20, Parent = bar,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local grip = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(fill.Size.X.Scale, 0.5),
                Size = UDim2.fromOffset(13, 13),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0, ZIndex = 21, Parent = bar,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local api = {}
            function api:Set(v, silent)
                v = math.clamp(v, range[1], range[2])
                v = math.floor(v / inc + 0.5) * inc
                if inc < 1 then v = tonumber(string.format("%.2f", v)) end
                value = v
                if flag then NelyX.Flags[flag] = v end
                local a = (v - range[1]) / math.max(range[2] - range[1], 1)
                Tween(fill, { Size = UDim2.fromScale(a, 1) }, EASE.Snap)
                Tween(grip, { Position = UDim2.fromScale(a, 0.5) }, EASE.Snap)
                readout.Text = tostring(v) .. (cfg.Suffix or "")
                if cfg.Callback and not silent then task.spawn(cfg.Callback, v) end
            end
            api.Instance = row

            local dragging = false
            local function fromX(px)
                local a = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                api:Set(range[1] + a * (range[2] - range[1]))
            end
            local hit = New("TextButton", {
                Position = UDim2.new(0, 8, 0, barY - 10),
                Size = UDim2.new(1, -16, 0, 25),
                BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
                ZIndex = 22, Parent = row,
            })
            hit.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                   or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Tween(grip, { Size = UDim2.fromOffset(17, 17) }, EASE.Snap)
                    fromX(i.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                   or i.UserInputType == Enum.UserInputType.Touch) then
                    fromX(i.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1
                   or i.UserInputType == Enum.UserInputType.Touch) then
                    dragging = false
                    Tween(grip, { Size = UDim2.fromOffset(13, 13) }, EASE.Snap)
                end
            end)

            if flag then NelyX.Flags[flag] = value end
            return Window:RegisterElement(flag, api)
        end

