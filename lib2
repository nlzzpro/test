--  INTERACTION HELPERS
--==================================================================

-- Root runs IgnoreGuiInset = true, which means its coordinate space already
-- lines up with what GetMouseLocation returns. Adding GetGuiInset() on top
-- shifts everything down by the height of the Roblox topbar, so the drawn
-- cursor sits ~36px below the real pointer and every click lands above its
-- target. One helper, used everywhere, so this can't drift apart again.
local function GetPointer()
    return UserInputService:GetMouseLocation()
end

local function Ripple(button, zindex)
    local pos  = GetPointer()
    local abs  = button.AbsolutePosition
    local size = button.AbsoluteSize
    local rx = math.clamp((pos.X - abs.X) / math.max(size.X, 1), 0, 1)
    local ry = math.clamp((pos.Y - abs.Y) / math.max(size.Y, 1), 0, 1)

    local ripple = New("Frame", {
        Size                   = UDim2.fromOffset(0, 0),
        Position               = UDim2.fromScale(rx, ry),
        AnchorPoint            = Vector2.new(0.5, 0.5),
        BackgroundColor3       = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.86,
        BorderSizePixel        = 0,
        ZIndex                 = zindex or (button.ZIndex + 3),
        Parent                 = button,
    }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local reach = math.max(size.X, size.Y) * 2.2
    local tw = TweenService:Create(ripple, EASE.Glide, {
        Size                   = UDim2.fromOffset(reach, reach),
        BackgroundTransparency = 1,
    })
    tw:Play()
    tw.Completed:Connect(function() ripple:Destroy() end)
end

local function Draggable(handle, target, onDragEnd)
    local dragging, dragStart, startPos = false, nil, nil
    local moved = 0

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            moved     = 0
            dragStart = input.Position
            startPos  = target.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                    if onDragEnd then onDragEnd(moved) end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            moved = math.max(moved, delta.Magnitude)
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--------------------------------------------------------------------
--  INPUT HYGIENE
--
--  Roblox routes a click to the topmost object whose Active is true. A
--  decorative TextLabel with Active = true therefore eats the click meant
--  for the button underneath it -- which is exactly the sidebar bug: the
--  rail code set `label.Active = not railed`, so with the sidebar expanded
--  every tab's text label swallowed clicks and only the gap around the
--  icon still worked.
--
--  NoInput walks a control's decoration and makes all of it inert, so the
--  one intended TextButton is the only thing that can receive input. Call
--  it AFTER building a control's children.
--------------------------------------------------------------------

local function NoInput(root, keep)
    for _, child in ipairs(root:GetDescendants()) do
        if child ~= keep and child:IsA("GuiObject") then
            -- TextBoxes must stay interactive or you cannot type in them,
            -- and a nested button is presumably there on purpose.
            if not (child:IsA("TextBox") or child:IsA("GuiButton")) then
                child.Active = false
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    child.Selectable = false
                end
            end
        end
    end
    return root
end

-- Hover pair. Every control was writing the same two Connects by hand and
-- half of them disagreed about which properties to restore.
local function Hover(button, fn)
    button.MouseEnter:Connect(function() fn(true) end)
    button.MouseLeave:Connect(function() fn(false) end)
    return button
end

-- Keys a keybind will accept. Modifiers alone are not a bind (you cannot
-- press "Shift" as a shortcut without also meaning something else), and
-- Unknown is what Roblox reports for input it could not classify.
local NON_BINDABLE = {
    [Enum.KeyCode.Unknown]      = true,
    [Enum.KeyCode.Escape]       = true,
    [Enum.KeyCode.LeftShift]    = true,
    [Enum.KeyCode.RightShift]   = true,
    [Enum.KeyCode.LeftControl]  = true,
    [Enum.KeyCode.RightControl] = true,
    [Enum.KeyCode.LeftAlt]      = true,
    [Enum.KeyCode.RightAlt]     = true,
    [Enum.KeyCode.LeftSuper]    = true,
    [Enum.KeyCode.RightSuper]   = true,
    [Enum.KeyCode.CapsLock]     = true,
    [Enum.KeyCode.NumLock]      = true,
}

local function AcceptableKey(keyCode)
    return not NON_BINDABLE[keyCode]
end

-- Exactly one keybind may be listening at a time. Holds the cancel
-- function of whichever control currently owns the keyboard; starting a
-- new listen calls it first.
local ActiveKeybind = nil

-- Which pill last cancelled itself on a mouse-down, and when. The
-- mouse-UP that follows lands on that same pill and would otherwise
-- re-open it, so a click arriving on it within the window is treated as
-- the tail of the cancel rather than a new request.
--
-- Keyed by pill, not global: clicking keybind B while keybind A is
-- listening must cancel A and open B, and a shared timestamp made B's
-- click look like A's tail.
local KeybindCancelBy = nil
local KeybindCancelAt = 0

