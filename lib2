            end

            -- label + optional info dot + optional description
            local function RowText(row, title, desc, info, dim)
                local x = 12
                local titleLabel = New("TextLabel", {
                    Position = UDim2.fromOffset(x, desc and 7 or 0),
                    Size = UDim2.new(1, -x - 92, 0, desc and 16 or row.Size.Y.Offset),
                    BackgroundTransparency = 1, Text = tostring(title),
                    TextColor3 = dim and Theme.TextDim or Theme.Text,
                    TextSize = 12.5, Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 19, Parent = row,
                })
                Themed(titleLabel, "TextColor3", dim and "TextDim" or "Text")

                if info and info ~= "" then
                    -- an info dot keeps long explanations out of the row
                    -- while leaving them one hover away
                    local dot = New("TextButton", {
                        Size = UDim2.fromOffset(13, 13),
                        Position = UDim2.fromOffset(x + math.min(#tostring(title) * 6.6, 210) + 5,
                                                     desc and 9 or (row.Size.Y.Offset / 2 - 6)),
                        BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
                        ZIndex = 20, Parent = row,
