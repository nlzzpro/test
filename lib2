function Nely:AddStrings(code, map)
    if type(code) ~= "string" or type(map) ~= "table" then return false end
    STRINGS[code] = STRINGS[code] or {}
    for key, value in pairs(map) do STRINGS[code][key] = tostring(value) end
    return true
end

local TextBindings = {}

local function BindText(inst, prop, key, args, transform)
    if typeof(inst) ~= "Instance" then return inst end
    args = args or {}
    local function render()
        local text = L(key, table.unpack(args))
        if transform then text = transform(text) end
        return text
    end
    TextBindings[inst] = TextBindings[inst] or {}
    TextBindings[inst][prop] = render
    pcall(function() inst[prop] = render() end)
    return inst
end
Nely.BindText = BindText

local LanguageHooks = {}
function Nely:OnLanguage(fn)
    if type(fn) ~= "function" then return function() end end
    table.insert(LanguageHooks, fn)
    return function()
        for i, entry in ipairs(LanguageHooks) do
            if entry == fn then table.remove(LanguageHooks, i) return end
        end
    end
end

function Nely:SetLanguage(code)
    if not STRINGS[code] then return false end
    Nely.Language = code
    for inst, props in pairs(TextBindings) do
        if inst.Parent then
            for prop, render in pairs(props) do
                pcall(function() inst[prop] = render() end)
            end
        else
            TextBindings[inst] = nil
        end
    end
    for i = #LanguageHooks, 1, -1 do
        local ok = pcall(LanguageHooks[i], code)
        if not ok then table.remove(LanguageHooks, i) end
    end
    return true
end

