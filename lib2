    -- glyph itself readable and the card visually quieter.
    New("Frame", {
        Name             = "Edge",
        Size             = UDim2.new(0, 3, 1, -16),
        Position         = UDim2.new(0, -9, 0.5, 0),
        AnchorPoint      = Vector2.new(0, 0.5),
        BackgroundColor3 = tint,
        BorderSizePixel  = 0,
        ZIndex           = 504,
        Parent           = card,
    }, { Corner(2) })

    local row = New("Frame", {
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder            = 1,
        ZIndex                 = 503,
        Parent                 = card,
    })

    local iconWrap = New("Frame", {
        Size                   = UDim2.fromOffset(18, 18),
        BackgroundTransparency = 1,
        ZIndex                 = 503,
        Parent                 = row,
    })
    local icon = Icons.Render(iconName, iconWrap, 13, tint, 504)
    icon.Position    = UDim2.fromScale(0.5, 0.5)
    icon.AnchorPoint = Vector2.new(0.5, 0.5)

    local textCol = New("Frame", {
        Size                   = UDim2.new(1, -26, 0, 0),
        Position               = UDim2.fromOffset(26, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex                 = 503,
        Parent                 = row,
    }, { List(2) })

    New("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        Text                   = title,
        TextColor3             = theme.Text,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        LayoutOrder            = 1,
        ZIndex                 = 504,
        Parent                 = textCol,
    })

    if content ~= "" then
        New("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 0),
            AutomaticSize          = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text                   = content,
            TextColor3             = theme.TextSub,
            TextSize               = 11,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextYAlignment         = Enum.TextYAlignment.Top,
            TextWrapped            = true,
            LayoutOrder            = 2,
            ZIndex                 = 504,
            Parent                 = textCol,
        })
    end

    local track = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = theme.Border,
        BorderSizePixel  = 0,
        LayoutOrder      = 2,
        ZIndex           = 503,
        Parent           = card,
    }, { Corner(2) })

    local fill = New("Frame", {
        Size             = UDim2.fromScale(1, 1),
        BackgroundColor3 = tint,
        BorderSizePixel  = 0,
        ZIndex           = 504,
        Parent           = track,
    }, { Corner(2) })

    -- In: slide from the right AND scale up from 0.94. Position alone
    -- reads as a panel appearing; adding scale reads as an object arriving.
    card.Position   = UDim2.fromScale(1.05, 0)
    cardScale.Scale = 0.94
    Tween(card, { Position = UDim2.fromScale(0, 0) }, EASE.Smooth)
    Tween(cardScale, { Scale = 1 }, EASE.Spring)

    TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.fromScale(0, 1),
    }):Play()

    task.delay(duration, function()
        if not slot.Parent then return end
        Tween(card, { Position = UDim2.fromScale(1.05, 0) }, EASE.Smooth)
        Tween(cardScale, { Scale = 0.96 }, EASE.Smooth)
        task.delay(0.32, function() slot:Destroy() end)
    end)

    return card
end

