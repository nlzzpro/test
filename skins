-- Held-item positioning
-------------------------------------------------------------------------------

-- Orientation the game itself specifies for a weapon, if any. Returns nil
-- when the item has no opinion, which is most of them.
local function metaAngles(data)
    local m = data and data.Meta
    local a = m and m.Angles
    if not a then return nil end
    return CFrame.Angles(tonumber(a.X) or 0, tonumber(a.Y) or 0, tonumber(a.Z) or 0)
end

-- The weapon's inventory icon, normalised to something Roblox will load.
-- The database stores two legacy URL shapes; both carry the asset id.
-- MM2's item "Image" ids are MODEL assets, not image assets. rbxassetid://
-- renders nothing at all for a model, which is why every backpack slot fell
-- back to the default gun picture: the game hands us a perfectly good
-- rbxthumb:// URL and this used to rewrite it into a dead rbxassetid.
-- rbxthumb renders a model's thumbnail, so that form is what must survive.
local function metaImage(data)
    -- Two shapes call this: a MESHES entry, whose image lives at data.Meta.Image,
    -- and a raw WeaponDB record (any skin outside Ancient/Godly/Chroma/Unique),
    -- whose image is data.Image directly with no Meta wrapper. Reading only the
    -- first shape is why any other-rarity skin kept its default backpack icon --
    -- applyToolIcon falls back to WeaponDB for exactly those, so this path was
    -- silently hit every time one got equipped.
    local m = data and data.Meta
    local img = (m and m.Image) or (data and data.Image)
    if type(img) ~= "string" or img == "" then return nil end
    img = (img:gsub("^%s+", ""):gsub("%s+$", ""))
    -- Already usable: a thumbnail URL, or a genuine image asset.
    if img:match("^rbxthumb://") or img:match("^rbxassetid://") then return img end
    -- Legacy Thumbs.ashx / catalog links carry the model id in the query.
    local id = img:match("assetId=(%d+)") or img:match("[?&]id=(%d+)")
    if id then return "rbxthumb://type=Asset&w=150&h=150&id=" .. id end
    return img
end

