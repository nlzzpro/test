    -- stand-in (0, -0.313, 0.631) -- which makes sense, since that
    -- constant was originally measured off a plain gun like this one --
    -- so this mostly just makes it exact instead of approximate.
    -- Celestial is the first Knife whose real grip differs meaningfully
    -- from Beachy's, confirming per-mesh Grip varies for knives too.
    Blossom_G = CFrame.new(0, -0.31302, 0.63121, 1, 0, 0, 0, 1, 0, 0, 0, 1),
    Celestial = CFrame.new(0, -0.04442, 0.23832, 1, 0, 0, 0, 1, 0, 0, 0, 1),
}

-- Bounding box of a built overlay expressed in ROOT-LOCAL space. Parts are
-- placed at targetCF * relcf, so relcf IS the root-local transform; the
-- root itself contributes its own half-extents at identity.
local function overlayBounds(built)
    local minV, maxV
    local function acc(cf, size)
        local half = size / 2
        -- Axis-aligned extent of a rotated box: project each half-extent
        -- onto the root axes. Cheap and exact enough for placement.
        local r = Vector3.new(
            math.abs(cf.RightVector.X)   * half.X + math.abs(cf.UpVector.X) * half.Y + math.abs(cf.LookVector.X) * half.Z,
            math.abs(cf.RightVector.Y)   * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z,
            math.abs(cf.RightVector.Z)   * half.X + math.abs(cf.UpVector.Z) * half.Y + math.abs(cf.LookVector.Z) * half.Z)
        local lo, hi = cf.Position - r, cf.Position + r
        minV = minV and Vector3.new(math.min(minV.X, lo.X), math.min(minV.Y, lo.Y), math.min(minV.Z, lo.Z)) or lo
        maxV = maxV and Vector3.new(math.max(maxV.X, hi.X), math.max(maxV.Y, hi.Y), math.max(maxV.Z, hi.Z)) or hi
    end

    if built.root then acc(CFrame.new(), built.root.Size) end
    for _, p in ipairs(built.parts or {}) do
        if p.inst and p.relcf then
            local ok, sz = pcall(function() return p.inst.Size end)
            if ok and sz then acc(p.relcf, sz) end
        end
    end
    if not minV then return Vector3.zero, Vector3.one end
    return (minV + maxV) / 2, (maxV - minV)
end

-- The grip point the GAME uses, read out of the scraped tree.
--
-- Every display in the dump carries an Attachment -- named CustomAttachment
-- where the weapon needs an offset, plain "Attachment" where it does not --
-- and MM2 binds that attachment to a body attachment (RightGripAttachment
-- in hand, GunBelt / KnifeBack when holstered) with a RigidConstraint.
-- The attachment's RelCF is therefore the authored distance from the
-- display's origin to the hand. It is a direct child of the root node.
local function skinGripRelCF(data)
    local rn = data and data.Model
    if not rn then return nil end
    local fallback
    for _, child in ipairs(rn.Children or {}) do
        if child.Class == "Attachment" and child.Props and child.Props.RelCF then
            if child.Name == "CustomAttachment" then return child.Props.RelCF end
            fallback = fallback or child.Props.RelCF
        end
    end
    return fallback
end

-- The same point on the weapon we are covering up, in world space.
--
-- Measured directly against MM2's own rendering rather than reasoned about.
-- With Harvester equipped -- whose CustomAttachment is most of a right angle,
-- so it actually discriminates -- the game placed its skin part at
--     relBase = (0.000002, 0.12988, 0.07520), rotation = attachment transpose
-- against the hidden original. Harvester's authored RelCF is
--     (0.12991, 0, 0.07501); -R^T*p works out to (0.000002, 0.12993, 0.07500).
-- That is exactly RelCF:Inverse(), and Celestial (identity attachment, placed
-- at identity) agrees.
--
-- Tool.Grip does NOT enter into it. An earlier version used it for the held
-- case on the reasoning that a Tool Handle has no attachment of its own; that
-- was wrong and is what threw held skins off beside the character. The base
-- part's own CFrame is the reference in both the held and holstered paths.
local function baseGripWorldCF(handle)
    local att
    for _, d in ipairs(handle:GetChildren()) do
        if d:IsA("Attachment") then
            if d.Name == "CustomAttachment" then att = d break end
            att = att or d
        end
    end
    if att then
        local ok, cf = pcall(function() return handle.CFrame * att.CFrame end)
        if ok then return cf end
    end
    return handle.CFrame
end

-- The transform to hand finalizeOverlay so the skin sits in the hand the
-- way the real weapon does.
--
-- This used to guess: match the longest axis of the overlay to the longest
-- axis of the handle, then align bounding-box centres. That is why items
-- sat wrong -- a guess about orientation and a guess about where the pivot
-- is, multiplied together.
--
-- The dump already carries the answer. Put the skin's grip attachment
-- exactly where the original weapon's grip attachment is and the rest
-- follows, which is precisely what MM2 does. Verified against the live
-- Workspace.WeaponDisplays: for every display checked, including
-- non-identity ones (Harvester 0.150, Lightbringer 0.224),
--     displayCF == bodyAttachment.WorldCFrame * attachment.CFrame:Inverse()
-- held to a position error under 0.001 stud and 0.0000 degrees. Meta.Angles
-- plays no part in it -- that field is for the inventory preview, not the
-- world -- so it is no longer applied here.
local function gripCFrame(built, handle, skinName, data)
    local rule = GRIP[skinName]
    local base = handle.CFrame

    if rule and rule.Raw then
        return base * (rule.CFrame or CFrame.new()) + (rule.Offset or Vector3.zero)
    end

    local cf
    local relcf = skinGripRelCF(data)
    local held  = handle.Parent and handle.Parent:IsA("Tool") and handle.Parent or nil
    local sg    = SKIN_GRIP[skinName]

    if held and sg then
        -- In hand. handle.CFrame * tool.Grip IS the hand's grip point, and the
        -- real skinned weapon sits at that point offset by its own grip, so
        -- undo ours and apply the skin's.
        local ok, v = pcall(function() return handle.CFrame * held.Grip * sg:Inverse() end)
        cf = ok and v or nil
    end

    if not cf and relcf then
        -- Unified fallback for guns AND knives, held or holstered, when
        -- there is no measured SKIN_GRIP. This used to split in two: held
        -- guns got a generic constant (0, -0.313, 0.631), measured off one
        -- plain gun (Blossom_G) and known not to generalise (0.7-stud error
        -- live-tested on Watergun); held knives fell through to this same
        -- attachment formula but flagged as an unverified "known gap".
        --
        -- An independent reference implementation (mm2things/"message (3).txt",
        -- functions HoldC0/BindHeld) welds its overlay onto the REAL equipped
        -- Handle using exactly this formula -- the item's own attachment
        -- RelCF, inverted, against the handle's own attachment -- for every
        -- held item, gun or knife, with no special case for guns at all.
        -- That is independent confirmation of what baseGripWorldCF already
        -- does, which this file separately verified for the HOLSTERED case
        -- against live Workspace.WeaponDisplays: position error under 0.001
        -- stud, 0.0000 degrees, across every display checked including
        -- non-identity ones (Harvester 0.150, Lightbringer 0.224).
        --
        -- Two sources agreeing independently is why the held-gun special
        -- case is gone rather than just widened -- but the HELD case
        -- specifically has not been live-verified the way the holstered
        -- case has (no Roblox client was connected when this was written).
        -- Confirm against a real held Watergun/Harvester before trusting
        -- this the way the holstered formula is trusted.
        cf = baseGripWorldCF(handle) * relcf:Inverse()
    elseif not cf then
        -- No attachment in the dump (the old flat-format weapons). Fall
        -- back to the previous inference rather than dropping them.
        --
        -- axisMatch used to guess a rotation here by comparing the
        -- overlay's longest axis to the real handle's. Live-tested against
        -- two flat guns (Cursed_G_2024, Ginger_G_2018) and confirmed wrong
        -- both times: their "(root)" Part is the generic flat-format
        -- placeholder box (0.2, 1.83, 1.03, shared verbatim by ~200+
        -- entries in this database), not the item's real visual extent --
        -- the actual shape lives in a child SpecialMesh with its own
        -- Scale, which this box says nothing about. Matching axes against
        -- that placeholder produced a spurious 90-degree rotation that
        -- swung the mesh's visible mass off to the side, reading as the
        -- weapon floating away from the hand instead of sitting in it.
        -- Dropping the guess and keeping the handle's own orientation
        -- (identity, unless Meta.Angles says otherwise) put both back in
        -- the hand correctly.
        local centre = overlayBounds(built)
        local rot = metaAngles(data) or CFrame.new()
        cf = base * rot * CFrame.new(-centre.X, -centre.Y, -centre.Z)
    end

    if rule then
        cf = cf * (rule.CFrame or CFrame.new())
        if rule.Offset then cf = cf + rule.Offset end
    end
    return cf
end

-- Exposed so the positioning can be measured and tuned against the real
-- game rather than guessed at.
local GripAPI = { Table = GRIP, Bounds = overlayBounds, Compute = gripCFrame }

-- PHASE 2: SYNCHRONOUS. Place root at targetCF, children at targetCF*RelCF, weld.
local function finalizeOverlay(built, targetCF)
    local root = built.root
    pcall(function() root.CFrame = targetCF end)
    for _, p in ipairs(built.parts) do
        if p.relcf then pcall(function() p.inst.CFrame = targetCF * p.relcf end) end
        local w = Instance.new("WeldConstraint"); w.Part0 = p.inst; w.Part1 = root; w.Parent = p.inst
    end
    return root
end

-- Every remaining entry has a .Model tree, so building is always the
-- full-tree path -- the old flat-format builder (and the guessed rotation
-- it needed once relcf/SKIN_GRIP data ran out) is gone with MESHES_OLD.
local function buildAnyOverlay(data)
    if data.Model then return buildFullOverlay(data) end
    return nil
end

-- mesh id of a weapon (for the "is the game already showing this?" check)
local function targetMeshId(data)
    if not data.Model then return "" end
    local rn = data.Model
    if rn.Class == "MeshPart" then return trimAsset(rn.Props.MeshId or "") end
    for _, c in ipairs(rn.Children or {}) do
        if c.Class == "SpecialMesh" then return trimAsset(c.Props.MeshId or "") end
    end
    return ""
end
local function baseMeshId(base)
    if not base then return "" end
    if base:IsA("MeshPart") then return trimAsset(base.MeshId or "") end
    local sm = base:FindFirstChildWhichIsA("SpecialMesh", true)
    return sm and trimAsset(sm.MeshId or "") or ""
end

-------------------------------------------------------------------------------
-- hide / restore
-------------------------------------------------------------------------------
local function hideInto(list, inst)
    if inst:IsA("BasePart") or inst:IsA("Decal") then
        list[#list+1] = { inst = inst, prop = "Transparency", val = inst.Transparency }
        pcall(function() inst.Transparency = 1 end)
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
        list[#list+1] = { inst = inst, prop = "Enabled", val = inst.Enabled }
        pcall(function() inst.Enabled = false end)
    end
end
local function restore(hidden)
    -- toolState[tool] can legitimately hold only {texture=...} with no
    -- .hidden -- overlayTool sets that much before it can bail out (icon
    -- first, on purpose), then returns early if the mesh build fails or the
    -- skin has no MESHES entry. unoverlayTool/refreshTool call restore(st.hidden)
    -- unconditionally, so an ipairs(nil) here throws and aborts whichever of
    -- them was running -- observed live when a tag was removed mid-build.
    for _, h in ipairs(hidden or {}) do pcall(function() h.inst[h.prop] = h.val end) end
end

-------------------------------------------------------------------------------
-- Character / display refs
-------------------------------------------------------------------------------
local function char() return LocalPlayer.Character end
local function displayValue(slot)
    local c = char(); if not c then return nil end
    local ref = c:FindFirstChild("DisplayRef" .. slot)
    return ref and ref.Value or nil
end
local function waitDisplay(slot, timeout)
    local deadline = os.clock() + (timeout or 1)
    while os.clock() < deadline do
        local v = displayValue(slot); if v then return v end
        task.wait(0.05)
    end
    return displayValue(slot)
end

-------------------------------------------------------------------------------
-- LOBBY overlay (weld skin over the holstered DisplayRef weapon)
-------------------------------------------------------------------------------
local state, lastApplied, token = {}, {}, {}
local setStatus

local function cleanup(slot)
    local st = state[slot]; if not st then return end
    if st.chroma then pcall(function() st.chroma:Disconnect() end) end
    if st.overlay then pcall(function() st.overlay:Destroy() end) end
    restore(st.hidden)
    state[slot] = nil
end

local function apply(slot, name)
    if state[slot] and lastApplied[slot] == name and name ~= nil then return end
    token[slot] = (token[slot] or 0) + 1
    local myToken = token[slot]
    cleanup(slot)
    local data = name and MESHES[name]
    if not data then lastApplied[slot] = name; return end
    lastApplied[slot] = name
    local base = displayValue(slot) or waitDisplay(slot, 1.5)
    if token[slot] ~= myToken then return end
    if not base then
        if setStatus then setStatus("No " .. slot .. " shown — equip a normal " .. slot .. " first.", Color3.fromRGB(240, 200, 120)) end
        return
    end
    if baseMeshId(base) == targetMeshId(data) and baseMeshId(base) ~= "" then return end
    local hidden = {}
    hideInto(hidden, base)
    for _, d in ipairs(base:GetDescendants()) do hideInto(hidden, d) end
    local built = buildAnyOverlay(data)                       -- phase 1 (may yield)
    if not built or not built.root or token[slot] ~= myToken or not base.Parent then
        restore(hidden); if built and built.root then built.root:Destroy() end; return
    end
    -- Same alignment as the in-round path: centres, not origins.
    finalizeOverlay(built, gripCFrame(built, base, name, data))
    local overlay = built.root
    overlay.Parent = base.Parent or base
    local w = Instance.new("WeldConstraint"); w.Part0 = overlay; w.Part1 = base; w.Parent = overlay
    local chroma = isChroma(name, data) and startChroma(overlay) or nil
    state[slot] = { overlay = overlay, hidden = hidden, chroma = chroma }
    if setStatus then setStatus("Showing: " .. name .. " (" .. slot .. ")", Color3.fromRGB(150, 230, 170)) end
end

-------------------------------------------------------------------------------
-- IN-ROUND overlay (weld skin over the real murderer/sheriff weapon Handle)
-------------------------------------------------------------------------------
local toolState = {}
local function isMine(inst)
    if inst:IsDescendantOf(LocalPlayer) then return true end
    local c = char(); return c ~= nil and inst:IsDescendantOf(c)
end
-- Applies the equipped skin's inventory picture to a Tool AND to every
-- other GUI surface MM2 shows the same picture on -- the HUD hotbar slot
-- (MainGUI.Game.Gun/Knife.ImageLabel) and the backpack tile (any ImageLabel
-- named ToolIcon under BackpackUI) -- so switching skins updates
-- everywhere at once instead of leaving the hotbar/backpack showing the
-- old (or default) art until the next equip cycle. Paths verified live
-- against this game's actual PlayerGui rather than assumed. Independent
-- of the 3D overlay -- this runs even for skins with no mesh.
local iconHook, guiIconHook, kindIcon = {}, {}, {}
local function pinGuiIcon(inst, slot, icon)
    if not (inst and (inst:IsA("ImageLabel") or inst:IsA("ImageButton"))) then return end
    pcall(function() inst.Image = icon end)
    if guiIconHook[inst] then return end
    inst:SetAttribute("MM2VizSlot", slot)
    guiIconHook[inst] = inst:GetPropertyChangedSignal("Image"):Connect(function()
        local s = inst:GetAttribute("MM2VizSlot")
        local target = s and kindIcon[s]
        if target and inst.Image ~= target then pcall(function() inst.Image = target end) end
    end)
end
local function applyToolIcon(tool, skin, slot)
    if not skin then return nil end
    local info = MESHES[skin] or WeaponDB[skin]
    local icon = metaImage(info)
    if not icon then return nil end
    local previous = tool.TextureId
    local ok = pcall(function() tool.TextureId = icon end)

    if slot then
        kindIcon[slot] = icon
        if not iconHook[tool] then
            iconHook[tool] = tool:GetPropertyChangedSignal("TextureId"):Connect(function()
                local target = kindIcon[slot]
                if target and tool.Parent and tool.TextureId ~= target then
                    pcall(function() tool.TextureId = target end)
                end
            end)
        end
    end

    if slot then
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local hud = pg and pg:FindFirstChild("MainGUI")
            hud = hud and hud:FindFirstChild("Game")
            hud = hud and hud:FindFirstChild(slot)
            local label = hud and hud:FindFirstChild("ImageLabel")
            if label then pinGuiIcon(label, slot, icon) end
        end)
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local backpack = pg and pg:FindFirstChild("BackpackUI")
            if backpack then
                for _, d in ipairs(backpack:GetDescendants()) do
                    if d.Name == "ToolIcon" then pinGuiIcon(d, slot, icon) end
                end
            end
        end)
    end

    return ok and previous or nil
end

local function overlayTool(tool, slot)
    if toolState[tool] then return end
    local handle = tool:FindFirstChild("Handle") or tool:WaitForChild("Handle", 5)
    if not handle then return end
    local skin = ProfileData.Weapons.Equipped[slot]

    -- Icon first, before anything that can bail out. Every item in the
    -- database has one, including the Uniques that have no mesh.
    local prevTexture = applyToolIcon(tool, skin, slot)
    if prevTexture then
        toolState[tool] = { texture = prevTexture }
    end

    local data = skin and MESHES[skin]
    if not data then return end
    local built = buildAnyOverlay(data)              -- phase 1 (may yield)
    if not built or not built.root then return end
    local hidden = {}
    hideInto(hidden, handle)
    for _, d in ipairs(handle:GetDescendants()) do hideInto(hidden, d) end
    -- Aligned, not merely co-located: see gripCFrame.
    finalizeOverlay(built, gripCFrame(built, handle, skin, data))
    local overlay = built.root
    overlay.Parent = handle
    local w = Instance.new("WeldConstraint"); w.Part0 = overlay; w.Part1 = handle; w.Parent = overlay
    local chroma = isChroma(skin, data) and startChroma(overlay) or nil

    -- Keep whatever texture was recorded above; the icon was applied
    -- before the overlay was built.
    local existing = toolState[tool]
    toolState[tool] = { overlay = overlay, hidden = hidden, chroma = chroma,
                        texture = existing and existing.texture or nil }
end
-- Re-applies whatever is equipped now. Called when the skin changes while
-- the tool is still in hand, which the plain add/remove watcher misses --
-- the Tool never leaves the character, so nothing else would fire.
local function refreshTool(tool, slot)
    if not tool or not tool.Parent then return end
    local st = toolState[tool]
    if st then
        if st.chroma then pcall(function() st.chroma:Disconnect() end) end
        if st.overlay then pcall(function() st.overlay:Destroy() end) end
        if st.texture then pcall(function() tool.TextureId = st.texture end) end
        restore(st.hidden)
        toolState[tool] = nil
    end
    overlayTool(tool, slot)
end

local function unoverlayTool(tool)
    local st = toolState[tool]; if not st then return end
    if st.chroma then pcall(function() st.chroma:Disconnect() end) end
    if st.overlay then pcall(function() st.overlay:Destroy() end) end
    if st.texture then pcall(function() tool.TextureId = st.texture end) end
    restore(st.hidden)
    toolState[tool] = nil
end

