local wiredLists = {}
local function wireAll()
    local pg = LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d.Name == "ItemList" or d.Name == "Container") and d:IsA("GuiObject") then
            local p, inW = d.Parent, false
            for _ = 1, 6 do if not p then break end; if p.Name == "Weapons" or p.Name == "Inventory2" or p.Name == "MyInventory" or p.Name == "Inventory" then inW = true break end; p = p.Parent end
            if inW then
                if not wiredLists[d] then wiredLists[d] = true; table.insert(SELF.conns, d.ChildAdded:Connect(function(ch) task.defer(wireTile, ch) end)) end
                for _, tile in ipairs(d:GetChildren()) do wireTile(tile) end
            end
        end
    end
end
task.spawn(function() while _G.__MM2Viz == SELF do pcall(wireAll); task.wait(2) end end)


SELF.destroy = function()
    for _, cn in ipairs(SELF.conns) do pcall(function() cn:Disconnect() end) end
    for slot in pairs(state) do pcall(cleanup, slot) end
    for tool in pairs(toolState) do pcall(unoverlayTool, tool) end
    if SELF.gui then pcall(function() SELF.gui:Destroy() end) end
end

-------------------------------------------------------------------------------
-- Module API (replaces the original standalone GUI)
-------------------------------------------------------------------------------
local API = {}

-- Held-item positioning. GripAPI.Table is the per-item override map:
-- writing to it takes effect on the next equip, which is what makes
-- measuring against the real game practical.
API.Grip    = GripAPI
-- Re-skins whatever the character is holding right now. The equip path
-- calls this so switching skins mid-round updates the held weapon and its
-- backpack icon without needing to unequip.
API.RefreshHeld = function()
    local c = char(); if not c then return false end
    local n = 0
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local slot = (t.Name == "Gun") and "Gun" or "Knife"
            pcall(refreshTool, t, slot)
            n = n + 1
        end
    end
    return n > 0
end

API.IconFor = function(key)
    local data = MESHES[key] or WeaponDB[key]
    return metaImage(data)
end
API.Meshes  = MESHES
API.Weapons = WeaponDB
API.List    = weaponList
API.Resolve = resolveInput
API.Spawn   = spawnWeapon

function API.HasMesh(key)
    return key ~= nil and MESHES[key] ~= nil
end

function API.Equipped()
    local eq = ProfileData.Weapons and ProfileData.Weapons.Equipped or {}
    return eq.Knife, eq.Gun
end

-- Spawn then equip. EquipService:EquipItem is the path MM2's own inventory
-- tiles use, so it keeps the game's bookkeeping consistent; if it is
-- refused, the slot is written directly, which the poll loop above picks
-- up on its next tick either way.
function API.Equip(key)
    if not key then return false, "no key" end
    local info = WeaponDB[key]
    local slot = info and info.ItemType
    if slot ~= "Knife" and slot ~= "Gun" then return false, "not a knife or gun" end
    spawnWeapon(key, 1)
    local ok = pcall(function() EquipService:EquipItem("Weapons", key) end)
    if not ok then
        pcall(function() ProfileData.Weapons.Equipped[slot] = key end)
    end
    return true, slot
end

function API.Destroy()
    pcall(function() if SELF.destroy then SELF.destroy() end end)
end

return API
