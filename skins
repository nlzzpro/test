local lastEquipped = { Knife = nil, Gun = nil }
pcall(function() lastEquipped.Knife = ProfileData.Weapons.Equipped.Knife; lastEquipped.Gun = ProfileData.Weapons.Equipped.Gun end)
task.spawn(function()
    for _, slot in ipairs({ "Knife", "Gun" }) do
